<UserControl x:Class="GeoChemistryNexus.Controls.GeothermometerEditorPanels.GeoTScriptPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:views="clr-namespace:GeoChemistryNexus.Views"
             xmlns:ctrl="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls.GeothermometerEditorPanels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="600"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GeoChemistryNexus;component/Themes/EditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <cvs:BorderClipConverter x:Key="RoundedClip"/>

            <Style x:Key="FormulaColumnHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#66768B"/>
            </Style>

            <Style x:Key="FormulaBadge" TargetType="Border">
                <Setter Property="Height" Value="32"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="#F5F7FA"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ScriptPageScroll" Grid.Row="0" Margin="0,0,4,0" Background="Transparent"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <StackPanel Margin="0,0,16,16">

                <!-- 输入列 / 输出列（与 EPMA 新建计算模板窗口同款） -->
                <local:GeoTColumnTables Margin="0,0,0,16"/>

                <!-- Grid 公式：标题与“添加附加公式”独立放在卡片外，与输入/输出列的分区标题一致 -->
                <DockPanel Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GeoTSectionHeading}" Margin="2,4"
                               Text="{Binding [geo_formulas_title], Source={x:Static lg:LanguageService.Instance}, FallbackValue=Grid 公式 *}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource EditorLink}"
                            Command="{Binding AddAdditionalFormulaCommand}"
                            Visibility="{Binding IsContentReadOnly, Converter={StaticResource BooleanToVisibilityReConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [geo_btn_add_additional_formula], Source={x:Static lg:LanguageService.Instance}, FallbackValue=添加附加公式}"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
                <Border Style="{StaticResource GeoTSectionCard}" Margin="0,0,0,16">
                    <StackPanel Margin="16,14">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2" Style="{StaticResource FormulaColumnHeader}"
                                       Text="{Binding [geo_additional_formula_name], Source={x:Static lg:LanguageService.Instance}, FallbackValue=Grid 公式名}"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource FormulaColumnHeader}"
                                       Text="{Binding [geo_additional_function_name], Source={x:Static lg:LanguageService.Instance}, FallbackValue=JS 函数名}"/>
                        </Grid>

                        <!-- 主公式 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource FormulaBadge}" Background="{DynamicResource ThemeAccentSoftBrush}">
                                <TextBlock FontSize="11" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding [geo_main_formula_badge], Source={x:Static lg:LanguageService.Instance}, FallbackValue=主公式}"/>
                            </Border>
                            <TextBox Grid.Column="2" Style="{StaticResource GeoTFieldBox}"
                                     Text="{Binding FormulaName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding [geo_tooltip_formula_name], Source={x:Static lg:LanguageService.Instance}, FallbackValue=仅限字母、数字和下划线，如 MyFormula_v1}"/>
                            <Border Grid.Column="4" Style="{StaticResource FormulaBadge}" Padding="10,4">
                                <TextBlock FontSize="12" Foreground="#758195" FontFamily="Consolas" VerticalAlignment="Center"
                                           Text="{Binding MainFunctionName, Mode=OneWay}"/>
                            </Border>
                        </Grid>

                        <!-- 附加公式 -->
                        <ItemsControl ItemsSource="{Binding AdditionalFormulaItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource FormulaBadge}">
                                            <TextBlock FontSize="11" Foreground="#758195" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"
                                                       Text="{Binding [geo_additional_formula_badge], Source={x:Static lg:LanguageService.Instance}, FallbackValue=附加}"/>
                                        </Border>
                                        <TextBox Grid.Column="2" Style="{StaticResource GeoTFieldBox}"
                                                 Text="{Binding FormulaName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding [geo_tooltip_formula_name], Source={x:Static lg:LanguageService.Instance}, FallbackValue=仅限字母、数字和下划线，如 MyFormula_v1}"
                                                 IsReadOnly="{Binding DataContext.IsContentReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        <TextBox Grid.Column="4" Style="{StaticResource GeoTFieldBox}"
                                                 Text="{Binding FunctionName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding [geo_tooltip_additional_function_name], Source={x:Static lg:LanguageService.Instance}, FallbackValue=脚本中的 JS 函数名，如 calcPressure}"
                                                 IsReadOnly="{Binding DataContext.IsContentReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        <Button Grid.Column="5"
                                                Command="{Binding DataContext.RemoveAdditionalFormulaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GeoTRemoveButton}"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding [Delete], Source={x:Static lg:LanguageService.Instance}, FallbackValue=删除}"
                                                Visibility="{Binding DataContext.IsContentReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityReConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 脚本编辑器 -->
                <TextBlock Style="{StaticResource GeoTSectionHeading}" Margin="2,4,2,10"
                           Text="{Binding [script_definition], Source={x:Static lg:LanguageService.Instance}}"/>
                <Border x:Name="ScriptEditorPanel" Height="520" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6">
                    <!-- ClipToBounds 只裁成矩形，子元素的直角会盖住圆角；按圆角几何裁剪 -->
                    <DockPanel LastChildFill="True">
                        <DockPanel.Clip>
                            <MultiBinding Converter="{StaticResource RoundedClip}">
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                <Binding Path="CornerRadius" ElementName="ScriptEditorPanel"/>
                                <Binding Path="BorderThickness" ElementName="ScriptEditorPanel"/>
                            </MultiBinding>
                        </DockPanel.Clip>
                        <Border DockPanel.Dock="Top" Background="#F7F9FC" BorderBrush="#E1E7EF" BorderThickness="0,0,0,1" Padding="12,6">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="JS" Background="#F5D76E" Foreground="#574800" FontFamily="Consolas"
                                           FontWeight="Bold" Padding="5,2" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Left" Text="calculate(args) + calculateDetailed(inputs)" FontFamily="Consolas"
                                           Foreground="#475569" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource EditorAction}" Padding="12,5"
                                        Command="{Binding RunExampleTestCommand}" ToolTip="Ctrl+Enter">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [geo_script_run_test], Source={x:Static lg:LanguageService.Instance}, FallbackValue=运行测试}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Background="#F7F9FC" BorderBrush="#E1E7EF" BorderThickness="0,1,0,0" Padding="12,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="JavaScript · UTF-8" Foreground="#64748B" FontSize="11"/>
                                <TextBlock Text="{Binding CaretLocation, ElementName=ScriptSource}" Foreground="#64748B" FontFamily="Consolas" FontSize="11"/>
                            </DockPanel>
                        </Border>

                        <ctrl:EpmaCodeEditor x:Name="ScriptSource" Style="{StaticResource GeoTSourceBox}"
                                              Text="{Binding ScriptContent, UpdateSourceTrigger=PropertyChanged}">
                            <ctrl:EpmaCodeEditor.InputBindings>
                                <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding RunExampleTestCommand}"/>
                            </ctrl:EpmaCodeEditor.InputBindings>
                        </ctrl:EpmaCodeEditor>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 按示例测试的反馈 -->
        <Border Grid.Row="1" Margin="0,8,8,0" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                Visibility="{Binding HasScriptStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F4F9F5"/>
                    <Setter Property="MaxHeight" Value="112"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ScriptHasError}" Value="True">
                            <Setter Property="Background" Value="#FFF4F2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="12,7,12,0"
                           Text="{Binding [geo_script_run_test], Source={x:Static lg:LanguageService.Instance}, FallbackValue=运行测试}"/>
                <TextBox Text="{Binding ScriptStatus, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" Padding="12,5" Background="Transparent" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="#25613C"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScriptHasError}" Value="True">
                                    <Setter Property="Foreground" Value="#AD3027"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
