<UserControl x:Class="GeoChemistryNexus.Controls.GeothermometerEditorPanels.GeoTPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="236">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GeoChemistryNexus;component/Themes/EditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PreviewLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#66768B"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="PreviewSample" TargetType="Border">
                <Setter Property="Background" Value="#F5F7FA"/>
                <Setter Property="BorderBrush" Value="#E5E5EA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Key="PreviewChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#DFE5ED" BorderThickness="1" CornerRadius="9">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,14" BorderBrush="#DFE5ED" BorderThickness="0,0,0,1">
                <TextBlock FontSize="12" FontWeight="SemiBold"
                           Text="{Binding [geo_preview_title], Source={x:Static lg:LanguageService.Instance}, FallbackValue=效果预览}"/>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock Style="{StaticResource PreviewLabel}"
                               Text="{Binding [geo_preview_list_item], Source={x:Static lg:LanguageService.Instance}, FallbackValue=温压计列表项预览}"/>
                    <Border Style="{StaticResource PreviewSample}" Padding="10,8" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding PreviewName, Mode=OneWay}" FontSize="13" Foreground="#263549"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PreviewMetaLine, Mode=OneWay}" FontSize="11" Foreground="#7A8798"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource PreviewChip}" Background="#FFF3E0" Padding="6,1"
                                    VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{Binding [geo_label_custom_chip], Source={x:Static lg:LanguageService.Instance}, FallbackValue=自定义}"
                                           FontSize="10" Foreground="#E65100"/>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource PreviewLabel}"
                               Text="{Binding [geo_preview_detail_header], Source={x:Static lg:LanguageService.Instance}, FallbackValue=详情顶部预览}"/>
                    <Border Style="{StaticResource PreviewSample}" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="#263549"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12" Foreground="#66768B" Margin="0,4,0,8"
                                       Text="{Binding PreviewReference, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding PreviewTags, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PreviewChip}" Background="{DynamicResource ThemeAccentSoftBrush}">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource ThemeAccentBrush}" Text="{Binding Mode=OneWay}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding PreviewCapabilities, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PreviewChip}" Background="#EAF7EE">
                                                <TextBlock FontSize="11" Foreground="#2D7A49" FontWeight="SemiBold" Text="{Binding Mode=OneWay}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource PreviewChip}" Background="#EDF1F6">
                                    <TextBlock FontSize="11" Foreground="#758195">
                                        <Run Text="v"/><Run Text="{Binding PreviewVersion, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource PreviewChip}" Background="#FFF3E0">
                                    <TextBlock FontSize="11" Foreground="#E65100"
                                               Text="{Binding [geo_label_custom_chip], Source={x:Static lg:LanguageService.Instance}, FallbackValue=自定义}"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
