<UserControl x:Class="GeoChemistryNexus.Controls.GeothermometerEditorPanels.GeoTBasicInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GeoChemistryNexus;component/Themes/EditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- 支持语言（与 EPMA 新建计算模板窗口一致） -->
        <DockPanel Margin="4,0,4,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource GeoTSectionHeading}"
                       Text="{Binding [epma_editor_supported_languages], Source={x:Static lg:LanguageService.Instance}}"/>
            <ctrl:LanguagePicker x:Name="AddLanguageButton" DockPanel.Dock="Right"
                                 Candidates="{Binding LanguageCandidates}"
                                 ToggleCommand="{Binding ToggleLanguageCommand}"
                                 SelectAllCommand="{Binding SelectAllLanguagesCommand}"
                                 Visibility="{Binding IsContentReadOnly, Converter={StaticResource BooleanToVisibilityReConverter}}"/>
        </DockPanel>
        <Border Style="{StaticResource GeoTSectionCard}" Padding="14,14,6,6">
            <ItemsControl ItemsSource="{Binding LanguageParts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GeoTLanguageTokenBorder}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding [epma_editor_set_default_language], Source={x:Static lg:LanguageService.Instance}}"
                                              Command="{Binding PlacementTarget.Tag.SetDefaultLanguageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EditorLanguageContent}"
                                                FontSize="12" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                                <Button Click="RemoveLanguage_Click" Tag="{Binding}"
                                        Style="{StaticResource GeoTLanguageRemoveButton}"
                                        ToolTip="{Binding [epma_editor_remove_language], Source={x:Static lg:LanguageService.Instance}}"
                                        Visibility="{Binding DataContext.IsContentReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityReConverter}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 模板标识 -->
        <DockPanel Margin="4,16,4,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource GeoTSectionHeading}"
                       Text="{Binding [epma_editor_template_identity], Source={x:Static lg:LanguageService.Instance}}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource EditorLink}" Click="LocalizationClick"
                    Content="{Binding [epma_editor_edit_localization], Source={x:Static lg:LanguageService.Instance}}"
                    ToolTip="{Binding [epma_editor_localization_tooltip], Source={x:Static lg:LanguageService.Instance}}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 1,3 H 9 M 5,1 V 3 M 3,3 C 3,6 5,8 8,9 M 7,3 C 7,6 5,8 2,9 M 8,15 L 11,6 L 14,15 M 9,12 H 13"/>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </DockPanel>
        <Border Style="{StaticResource GeoTSectionCard}">
            <StackPanel>
                <Border Style="{StaticResource EditorFormRow}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource EditorFormLabel}"
                                   Text="{Binding [geo_field_name], Source={x:Static lg:LanguageService.Instance}, FallbackValue=名称 *}"/>
                        <TextBox Style="{StaticResource GeoTFormValue}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding [geo_example_name], Source={x:Static lg:LanguageService.Instance}, FallbackValue=例如：石英温压计}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource EditorFormRow}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource EditorFormLabel}"
                                   Text="{Binding [geo_field_author], Source={x:Static lg:LanguageService.Instance}, FallbackValue=作者 *}"/>
                        <TextBox Style="{StaticResource GeoTFormValue}" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding [geo_example_author], Source={x:Static lg:LanguageService.Instance}, FallbackValue=例如：Smith 等}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource EditorFormRow}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource EditorFormLabel}"
                                   Text="{Binding [geo_field_year], Source={x:Static lg:LanguageService.Instance}, FallbackValue=年份 *}"/>
                        <TextBox Style="{StaticResource GeoTFormValue}" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding [geo_example_year], Source={x:Static lg:LanguageService.Instance}, FallbackValue=例如：2020}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource EditorFormRow}" BorderThickness="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource EditorFormLabel}"
                                   Text="{Binding [geo_field_reference], Source={x:Static lg:LanguageService.Instance}, FallbackValue=参考文献 *}"/>
                        <TextBox Style="{StaticResource GeoTFormValue}" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding [geo_example_reference], Source={x:Static lg:LanguageService.Instance}, FallbackValue='例如：Smith (2020) Geochim. Cosmochim. Acta 280, 123-145'}"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 分类与标签 -->
        <TextBlock Style="{StaticResource GeoTSectionHeading}" Margin="4,16,0,10"
                   Text="{Binding [epma_editor_classification], Source={x:Static lg:LanguageService.Instance}}"/>
        <Border Style="{StaticResource GeoTSectionCard}">
            <StackPanel>
                <Border Style="{StaticResource EditorFormRow}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource EditorFormLabel}"
                                   Text="{Binding [geo_field_category], Source={x:Static lg:LanguageService.Instance}, FallbackValue=类别 *}"/>
                        <ComboBox ItemsSource="{Binding CategoryOptions}"
                                     DisplayMemberPath="DisplayName"
                                     SelectedValuePath="Key"
                                     SelectedValue="{Binding SelectedCategory}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GeoTFormComboBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContentReadOnly}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </DockPanel>
                </Border>

                <!-- 温压计标签 -->
                <StackPanel Margin="16,12,16,6">
                    <TextBlock Style="{StaticResource GeoTFieldLabel}"
                               Text="{Binding [geo_field_tags], Source={x:Static lg:LanguageService.Instance}, FallbackValue=温压计标签 *}"/>
                    <ItemsControl ItemsSource="{Binding TagParts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GeoTTokenBorderStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                        <Button Tag="{Binding}" Click="RemoveTag_Click"
                                                Style="{StaticResource GeoTTokenCloseButtonStyle}"
                                                Foreground="{DynamicResource ThemeAccentBrush}"
                                                Visibility="{Binding DataContext.IsContentReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityReConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource FieldControlHostStyle}" Margin="0,0,0,4"
                            Visibility="{Binding IsContentReadOnly, Converter={StaticResource BooleanToVisibilityReConverter}}">
                        <ComboBox x:Name="TagCombo"
                                     IsEditable="True"
                                     StaysOpenOnEdit="True"
                                     ctrl:ControlAssist.Placeholder="{Binding [geo_tag_enter_hint], Source={x:Static lg:LanguageService.Instance}, FallbackValue=输入标签后按 Enter 确认}"
                                     DisplayMemberPath="DisplayName"
                                     SelectedValuePath="DisplayName"
                                     SelectionChanged="TagCombo_SelectionChanged"
                                     PreviewKeyDown="TagCombo_PreviewKeyDown"
                                     HorizontalAlignment="Stretch"
                                     Style="{StaticResource GeoTFormComboBox}"/>
                    </Border>
                </StackPanel>

                <Border Height="1" Background="#E7EBF0" Margin="16,6,0,0"/>

                <!-- 能力标签 -->
                <StackPanel Margin="16,12,16,10">
                    <TextBlock Style="{StaticResource GeoTFieldLabel}"
                               Text="{Binding [geo_field_capabilities], Source={x:Static lg:LanguageService.Instance}, FallbackValue=能力标签}"/>
                    <ItemsControl ItemsSource="{Binding CapabilityParts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GeoTCapabilityTokenBorderStyle}" ToolTip="{Binding Tooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="#2D7A49" VerticalAlignment="Center"/>
                                        <Button Tag="{Binding}" Click="RemoveCapability_Click"
                                                Style="{StaticResource GeoTTokenCloseButtonStyle}"
                                                Foreground="#2D7A49"
                                                Visibility="{Binding DataContext.IsContentReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityReConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource FieldControlHostStyle}" Margin="0,0,0,4"
                            Visibility="{Binding IsContentReadOnly, Converter={StaticResource BooleanToVisibilityReConverter}}">
                        <ComboBox x:Name="CapabilityCombo"
                                     IsEditable="True"
                                     StaysOpenOnEdit="True"
                                     ctrl:ControlAssist.Placeholder="{Binding [geo_capability_enter_hint], Source={x:Static lg:LanguageService.Instance}, FallbackValue=输入能力简写后按 Enter 确认}"
                                     SelectionChanged="CapabilityCombo_SelectionChanged"
                                     PreviewKeyDown="CapabilityCombo_PreviewKeyDown"
                                     HorizontalAlignment="Stretch"
                                     Style="{StaticResource GeoTFormComboBox}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <ctrl:ContentVersionCard IsEnabled="{Binding CanEdit}"/>
    </StackPanel>
</UserControl>
