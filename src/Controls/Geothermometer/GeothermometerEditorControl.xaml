<UserControl x:Class="GeoChemistryNexus.Controls.GeothermometerEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:panels="clr-namespace:GeoChemistryNexus.Controls.GeothermometerEditorPanels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1180"
             Background="#F5F7FA">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GeoChemistryNexus;component/Themes/EditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="GeoTPageTitle" TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding [geo_step_basic], Source={x:Static lg:LanguageService.Instance}}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                        <Setter Property="Text" Value="{Binding [geo_step_script], Source={x:Static lg:LanguageService.Instance}}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                        <Setter Property="Text" Value="{Binding [geo_step_help_doc], Source={x:Static lg:LanguageService.Instance}}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="EditorSurface">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧栏 -->
        <Border Background="#EBEEF3" BorderBrush="#DFE5ED" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,16">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="20,2,12,24">
                        <Border Width="34" Height="34" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="9" DockPanel.Dock="Left" Margin="0,0,10,0">
                            <TextBlock Text="T" Foreground="White" FontSize="22" FontFamily="Georgia" FontStyle="Italic"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding EditorTitle}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Foreground="#7A8798" FontSize="10" Margin="0,5,0,0">
                                <Run Text="v"/><Run Text="{Binding FormatVersionBaseline, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding [epma_editor_workflow], Source={x:Static lg:LanguageService.Instance}}"
                               Foreground="#7A8798" FontSize="11" Margin="22,0,0,6"/>
                </StackPanel>

                <Border x:Name="TemplateStatusPanel" DockPanel.Dock="Bottom" Margin="18,16,14,0" Padding="0,12,0,0"
                        BorderBrush="#DCE2EB" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [epma_editor_state_title], Source={x:Static lg:LanguageService.Instance}}"
                                   Foreground="#66768B" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TemplateStatusList" ItemsSource="{Binding TemplateStatusItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="•"/>
                                                        <Setter Property="Foreground" Value="#B7791F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="False">
                                                                <Setter Property="Text" Value="✓"/>
                                                                <Setter Property="Foreground" Value="#2D7A49"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="#66768B"
                                                       FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <ListBox x:Name="EditorNavigation" SelectedIndex="{Binding CurrentStep, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource GeoTNavigationItem}"
                         Background="Transparent" BorderThickness="0" VerticalAlignment="Top">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource GeoTNavigationIcon}"
                                  Data="M 1,3 H 4 M 7,3 H 15 M 4,3 A 1.5,1.5 0 1 0 7,3 A 1.5,1.5 0 1 0 4,3 M 1,8 H 9 M 12,8 H 15 M 9,8 A 1.5,1.5 0 1 0 12,8 A 1.5,1.5 0 1 0 9,8 M 1,13 H 3 M 6,13 H 15 M 3,13 A 1.5,1.5 0 1 0 6,13 A 1.5,1.5 0 1 0 3,13"/>
                            <TextBlock Text="{Binding [geo_step_basic], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource GeoTNavigationIcon}" Data="M 5,3 L 1,8 L 5,13 M 11,3 L 15,8 L 11,13 M 9.5,1.5 L 6.5,14.5"/>
                            <TextBlock Text="{Binding [geo_step_script], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource GeoTNavigationIcon}"
                                  Data="M 3,2 A 1,1 0 0 1 4,1 H 9 L 13,5 V 14 A 1,1 0 0 1 12,15 H 4 A 1,1 0 0 1 3,14 Z M 9,1 V 5 H 13 M 6,8 H 10 M 6,11 H 9"/>
                            <TextBlock Text="{Binding [geo_step_help_doc], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧：标题栏 + 内容 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（兼作窗口拖动区域） -->
            <Border BorderBrush="#DFE5ED" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- 预览开关（仅基本信息页） -->
                        <Button x:Name="PreviewToggleButton" Command="{Binding TogglePreviewCommand}"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource EditorAction}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Path Data="M 2,1.5 H 12 Q 13,1.5 13,2.5 V 11.5 Q 13,12.5 12,12.5 H 2 Q 1,12.5 1,11.5 V 2.5 Q 1,1.5 2,1.5 Z M 9.5,1.5 V 12.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" StrokeLineJoin="Round"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="M 4.25,4.5 L 6.75,7 L 4.25,9.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewExpanded}" Value="False">
                                                        <Setter Property="Data" Value="M 6.5,4.5 L 4,7 L 6.5,9.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding [epma_editor_hide_preview], Source={x:Static lg:LanguageService.Instance}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPreviewExpanded}" Value="False">
                                                    <Setter Property="Text" Value="{Binding [epma_editor_show_preview], Source={x:Static lg:LanguageService.Instance}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- 保存 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsContentReadOnly, Converter={StaticResource BooleanToVisibilityReConverter}}">
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource EditorAction}"
                                    Content="{Binding [epma_editor_save_action], Source={x:Static lg:LanguageService.Instance}}"
                                    Background="{DynamicResource ThemeAccentBrush}" Foreground="White" BorderBrush="{DynamicResource ThemeAccentBrush}" Padding="16,5"/>
                        </StackPanel>

                        <Border Width="1" Height="18" Background="#DFE5ED" Margin="12,0,8,0"/>
                        <Button x:Name="CaptionMinimizeButton" Style="{StaticResource EditorCaption}" Content="&#xe67a;" Click="MinimizeClick"
                                AutomationProperties.Name="{Binding [epma_editor_minimize], Source={x:Static lg:LanguageService.Instance}}"
                                ToolTip="{Binding [epma_editor_minimize], Source={x:Static lg:LanguageService.Instance}}"/>
                        <Button x:Name="CaptionMaximizeButton" Style="{StaticResource EditorCaptionMaximize}" Click="MaximizeClick"
                                AutomationProperties.Name="{Binding [epma_editor_maximize], Source={x:Static lg:LanguageService.Instance}}"
                                ToolTip="{Binding [epma_editor_maximize], Source={x:Static lg:LanguageService.Instance}}"/>
                        <Button x:Name="CaptionCloseButton" Style="{StaticResource EditorCaptionClose}" Content="&#xeaf2;" Command="{Binding CancelCommand}"
                                AutomationProperties.Name="{Binding [close], Source={x:Static lg:LanguageService.Instance}}"
                                ToolTip="{Binding [close], Source={x:Static lg:LanguageService.Instance}}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource GeoTPageTitle}" Margin="24,0,12,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                </DockPanel>
            </Border>

            <!-- 只读提示 -->
            <Border Grid.Row="1" Background="#FFF8E1" CornerRadius="6" Padding="12,8" Margin="24,12,24,0"
                    Visibility="{Binding IsContentReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding [geo_editor_readonly_hint], Source={x:Static lg:LanguageService.Instance}}"
                           Foreground="#795548" TextWrapping="Wrap"/>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Row="2" Margin="24,16,16,16">
                <!-- 基本信息 + 预览 -->
                <Grid Margin="0,0,8,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Padding="0,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <panels:GeoTBasicInfoPanel x:Name="BasicPanel" DataContext="{Binding}" Margin="0,0,12,8"/>
                    </ScrollViewer>

                    <panels:GeoTPreviewPanel Grid.Column="1" DataContext="{Binding}" Width="236" Margin="18,26,0,0" VerticalAlignment="Top">
                        <panels:GeoTPreviewPanel.Style>
                            <Style TargetType="panels:GeoTPreviewPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </panels:GeoTPreviewPanel.Style>
                    </panels:GeoTPreviewPanel>
                </Grid>

                <!-- 公式脚本：占满高度 -->
                <panels:GeoTScriptPanel x:Name="ScriptPanel" DataContext="{Binding}" Margin="0,0,8,0">
                    <panels:GeoTScriptPanel.Style>
                        <Style TargetType="panels:GeoTScriptPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </panels:GeoTScriptPanel.Style>
                </panels:GeoTScriptPanel>

                <!-- 帮助文档：占满高度 -->
                <panels:GeoTHelpDocPanel x:Name="HelpPanel" DataContext="{Binding}" Margin="0,0,8,0">
                    <panels:GeoTHelpDocPanel.Style>
                        <Style TargetType="panels:GeoTHelpDocPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </panels:GeoTHelpDocPanel.Style>
                </panels:GeoTHelpDocPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
