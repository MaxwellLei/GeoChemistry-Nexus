<UserControl x:Class="GeoChemistryNexus.Controls.FunctionPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
        <cvs:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:FunctionPropertyControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe63a;"
                               Title="{Binding [function],Source={x:Static lg:LanguageService.Instance}}"
                               Summary="{Binding Formula, Mode=OneWay, StringFormat='y = {0}'}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,18" Grid.IsSharedSizeScope="True">

                <!-- 公式：带 “y =” 前缀的等宽输入框，写错时下方出现一行红字 -->
                <local:InspectorGroup Header="{Binding [formula],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorStack Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="y =" Margin="0,0,8,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource InspectorMonoFont}" FontSize="13" FontStyle="Italic"
                                       Foreground="{StaticResource InspectorHintBrush}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                     Style="{StaticResource InspectorMonoTextBoxStyle}"
                                     AcceptsReturn="False" SpellCheck.IsEnabled="False"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasFormulaError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Path Data="M 6.5,1.5 L 12,11.5 H 1 Z M 6.5,5 V 8 M 6.5,9.6 V 9.7"
                                  Stroke="#E5484D" StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="None" Margin="0,2,6,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding FormulaErrorMessage}" Foreground="#E5484D" FontSize="12"
                                       TextWrapping="Wrap" MaxWidth="240"/>
                        </StackPanel>
                    </local:InspectorStack>
                </local:InspectorGroup>

                <!-- 范围：X / Y 各一行“从 – 到”，Y 留空 = 不限制；采样点用滑块 -->
                <local:InspectorGroup Header="{Binding [range],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorStack Spacing="10">
                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [x_coordinate],Source={x:Static lg:LanguageService.Instance}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:NumericUpDown Grid.Column="0"
                                                     Value="{Binding MinX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                     local:ControlAssist.Title="{Binding [from],Source={x:Static lg:LanguageService.Instance}}"
                                                     local:ControlAssist.Placeholder="-10.0"
                                                     Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                <TextBlock Grid.Column="1" Text="–" Margin="8,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource InspectorHintBrush}"/>
                                <local:NumericUpDown Grid.Column="2"
                                                     Value="{Binding MaxX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                     local:ControlAssist.Title="{Binding [to],Source={x:Static lg:LanguageService.Instance}}"
                                                     local:ControlAssist.Placeholder="10.0"
                                                     Style="{StaticResource InspectorNumericUpDownStyle}"/>
                            </Grid>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [y_coordinate],Source={x:Static lg:LanguageService.Instance}}">
                            <!-- NaN = 不限制：使用支持“留空”的数值框 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:AutoNumericUpDown Grid.Column="0"
                                                         Title="{Binding [from],Source={x:Static lg:LanguageService.Instance}}"
                                                         NumericStyle="{StaticResource InspectorNumericUpDownStyle}"
                                                         Value="{Binding MinY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1" Text="–" Margin="8,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource InspectorHintBrush}"/>
                                <local:AutoNumericUpDown Grid.Column="2"
                                                         Title="{Binding [to],Source={x:Static lg:LanguageService.Instance}}"
                                                         NumericStyle="{StaticResource InspectorNumericUpDownStyle}"
                                                         Value="{Binding MaxY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [point_count],Source={x:Static lg:LanguageService.Instance}}">
                            <local:InspectorSliderBox Minimum="2" Maximum="5000" Step="100"
                                                      Value="{Binding PointCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"/>
                        </HeaderedContentControl>
                    </local:InspectorStack>
                </local:InspectorGroup>

                <!-- 线条：颜色 + 线宽 + 线型 -->
                <local:InspectorGroup Header="{Binding [line],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorStrokeEditor
                        StrokeColor="{Binding Color, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"
                        StrokeWidth="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                        LineStyle="{Binding Style, Mode=TwoWay}"/>
                </local:InspectorGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
