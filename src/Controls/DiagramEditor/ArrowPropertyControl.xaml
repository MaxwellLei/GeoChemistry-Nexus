<UserControl x:Class="GeoChemistryNexus.Controls.ArrowPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
        <cvs:DoublePrecisionConverter x:Key="DoublePrecisionConverter" Precision="4"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:ArrowPropertyControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe61c;" Title="{Binding [arrow],Source={x:Static lg:LanguageService.Instance}}">
            <local:InspectorHeader.Summary>
                <MultiBinding StringFormat="({0:0.##}, {1:0.##}) → ({2:0.##}, {3:0.##})">
                    <Binding Path="Start.X"/>
                    <Binding Path="Start.Y"/>
                    <Binding Path="End.X"/>
                    <Binding Path="End.Y"/>
                </MultiBinding>
            </local:InspectorHeader.Summary>
        </local:InspectorHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,18">

                <!-- 端点：起点（绿点）/ 终点（红点），标题栏右侧为交换按钮 -->
                <local:InspectorEndpointsGroup Start="{Binding Start}" End="{Binding End}"/>

                <!-- 线身：颜色 + 线条宽度 -->
                <local:InspectorGroup Header="{Binding [insp_arrow_body],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorColumns Spacing="8">
                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [color],Source={x:Static lg:LanguageService.Instance}}">
                            <local:TextPropertyColorPicker
                                SelectedColor="{Binding Color, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [line_width],Source={x:Static lg:LanguageService.Instance}}">
                            <local:NumericUpDown Value="{Binding ArrowWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                 Increment="0.5"
                                                 Style="{StaticResource InspectorNumericUpDownStyle}"/>
                        </HeaderedContentControl>
                    </local:InspectorColumns>
                </local:InspectorGroup>

                <!-- 箭头头部：头宽 + 头长 -->
                <local:InspectorGroup Header="{Binding [insp_arrow_head],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorColumns Spacing="8">
                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [insp_head_width],Source={x:Static lg:LanguageService.Instance}}">
                            <local:NumericUpDown Value="{Binding ArrowheadWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                 Style="{StaticResource InspectorNumericUpDownStyle}"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [insp_head_length],Source={x:Static lg:LanguageService.Instance}}">
                            <local:NumericUpDown Value="{Binding ArrowheadLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                 Style="{StaticResource InspectorNumericUpDownStyle}"/>
                        </HeaderedContentControl>
                    </local:InspectorColumns>
                </local:InspectorGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
