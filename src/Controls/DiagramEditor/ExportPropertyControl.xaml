<UserControl x:Class="GeoChemistryNexus.Controls.ExportPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:viewmodels="clr-namespace:GeoChemistryNexus.ViewModels"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:UpperCaseConverter x:Key="UpperCaseConverter"/>

        <!-- 格式卡片：格式名 + 一行说明 -->
        <DataTemplate x:Key="ExportFormatCardTemplate">
            <StackPanel>
                <TextBlock x:Name="Name" Text="{Binding Converter={StaticResource UpperCaseConverter}}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InspectorTextBrush}"/>
                <TextBlock x:Name="Hint" FontSize="11.5" Foreground="{StaticResource InspectorHintBrush}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="png">
                    <Setter TargetName="Hint" Property="Text" Value="{Binding [insp_fmt_png],Source={x:Static lg:LanguageService.Instance}}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="jpg">
                    <Setter TargetName="Hint" Property="Text" Value="{Binding [insp_fmt_jpg],Source={x:Static lg:LanguageService.Instance}}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="bmp">
                    <Setter TargetName="Hint" Property="Text" Value="{Binding [insp_fmt_bmp],Source={x:Static lg:LanguageService.Instance}}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="svg">
                    <Setter TargetName="Hint" Property="Text" Value="{Binding [insp_fmt_svg],Source={x:Static lg:LanguageService.Instance}}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 软件卡片：首字母头像 + 名称 + 单选圆点 -->
        <DataTemplate x:Key="ExportAppCardTemplate">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Avatar" Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="#EDF0F5"
                        Margin="0,0,10,0">
                    <TextBlock x:Name="AvatarText" Text="…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource InspectorMonoFont}" FontSize="11" FontWeight="Bold"
                               Foreground="#5C6B7F"/>
                </Border>

                <TextBlock x:Name="AppName" Grid.Column="1" Text="{Binding}" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource InspectorTextBrush}"/>

                <Border x:Name="Radio" Grid.Column="2" Width="16" Height="16" CornerRadius="8"
                        BorderThickness="1.5" BorderBrush="#C5CCD8"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="CorelDRAW">
                    <Setter TargetName="AvatarText" Property="Text" Value="C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Inkscape">
                    <Setter TargetName="AvatarText" Property="Text" Value="I"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Adobe Illustrator">
                    <Setter TargetName="AvatarText" Property="Text" Value="Ai"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Custom">
                    <Setter TargetName="AppName" Property="Text" Value="{Binding [geo_label_custom], Source={x:Static lg:LanguageService.Instance}, FallbackValue=自定义}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Avatar" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                    <Setter TargetName="AvatarText" Property="Foreground" Value="White"/>
                    <Setter TargetName="Radio" Property="BorderThickness" Value="5"/>
                    <Setter TargetName="Radio" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ExportAppNameStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding SelectedThirdPartyApp}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedThirdPartyApp}" Value="Custom">
                    <Setter Property="Text" Value="{Binding [geo_label_custom], Source={x:Static lg:LanguageService.Instance}, FallbackValue=自定义}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe648;"
                               Title="{Binding [export_and_tools], Source={x:Static lg:LanguageService.Instance}, TargetNullValue='导出/工具'}">
            <local:InspectorHeader.Summary>
                <MultiBinding StringFormat="{}{0} · {1}">
                    <Binding Path="SelectedFormat" Converter="{StaticResource UpperCaseConverter}"/>
                    <Binding Path="SelectedThirdPartyApp"/>
                </MultiBinding>
            </local:InspectorHeader.Summary>
        </local:InspectorHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,10,12,18" Grid.IsSharedSizeScope="True">

                <!-- 导出图片：格式卡片 + “导出为 PNG” -->
                <local:InspectorGroup Header="{Binding [export_image], Source={x:Static lg:LanguageService.Instance}, TargetNullValue='导出图片'}">
                    <local:InspectorStack Spacing="12">
                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [format], Source={x:Static lg:LanguageService.Instance}, TargetNullValue='格式'}">
                            <ListBox Margin="-4" ItemsSource="{Binding Formats}"
                                     SelectedItem="{Binding SelectedFormat}"
                                     ItemTemplate="{StaticResource ExportFormatCardTemplate}"
                                     Style="{StaticResource InspectorCardGridListBoxStyle}"/>
                        </HeaderedContentControl>

                        <Button Command="{Binding ExportCommand}"
                                Style="{StaticResource InspectorPrimaryButtonStyle}"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe648;" FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Margin="0,1,8,0" FontSize="15"/>
                                <TextBlock Text="{Binding [insp_export_as], Source={x:Static lg:LanguageService.Instance}}"/>
                                <TextBlock Text="{Binding SelectedFormat, Converter={StaticResource UpperCaseConverter}}" FontWeight="Bold" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </local:InspectorStack>
                </local:InspectorGroup>

                <!-- 第三方软件：软件卡片 + “用 Inkscape 打开” -->
                <local:InspectorGroup Header="{Binding [third_party_software], Source={x:Static lg:LanguageService.Instance}, TargetNullValue='第三方软件'}">
                    <local:InspectorStack Spacing="12">
                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [select_software], Source={x:Static lg:LanguageService.Instance}, TargetNullValue='选择软件'}">
                            <ListBox ItemsSource="{Binding ThirdPartyApps}"
                                     SelectedItem="{Binding SelectedThirdPartyApp}"
                                     ItemTemplate="{StaticResource ExportAppCardTemplate}"
                                     Style="{StaticResource InspectorCardListBoxStyle}"/>
                        </HeaderedContentControl>

                        <Button Command="{Binding OpenThirdPartyCommand}"
                                Style="{StaticResource InspectorSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe612;" FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Margin="0,1,8,0" FontSize="15"/>
                                <TextBlock Text="{Binding [insp_open_with_prefix], Source={x:Static lg:LanguageService.Instance}}"/>
                                <TextBlock Style="{StaticResource ExportAppNameStyle}"/>
                                <TextBlock Text="{Binding [insp_open_with_suffix], Source={x:Static lg:LanguageService.Instance}}"/>
                            </StackPanel>
                        </Button>
                    </local:InspectorStack>
                </local:InspectorGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
