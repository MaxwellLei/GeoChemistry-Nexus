<UserControl x:Class="GeoChemistryNexus.Controls.AxisPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
        <cvs:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
        <cvs:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:AxisPropertyControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe605;"
                               Title="{Binding [axes],Source={x:Static lg:LanguageService.Instance}}"/>

        <!-- 页签：标题 / 范围 / 刻度。刻度页收纳轴线、主次刻度和刻度标签 -->
        <Border Grid.Row="1" Style="{StaticResource InspectorTabBarStyle}">
            <local:InspectorColumns Spacing="0">
                <RadioButton x:Name="TabTitle" GroupName="AxisTabs" IsChecked="True"
                             Style="{StaticResource InspectorTabRadioStyle}"
                             Content="{Binding [axis_tab_title],Source={x:Static lg:LanguageService.Instance}}"/>
                <RadioButton x:Name="TabScale" GroupName="AxisTabs"
                             Style="{StaticResource InspectorTabRadioStyle}"
                             Content="{Binding [range],Source={x:Static lg:LanguageService.Instance}}"
                             Visibility="{Binding ShowAxisStyleOptions, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <RadioButton x:Name="TabTicks" GroupName="AxisTabs"
                             Style="{StaticResource InspectorTabRadioStyle}"
                             Content="{Binding [axis_tab_ticks],Source={x:Static lg:LanguageService.Instance}}"/>
            </local:InspectorColumns>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,18" Grid.IsSharedSizeScope="True">

                <!-- ============ 标题 ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=TabTitle, Converter={StaticResource BoolToVisibility}}">
                    <local:InspectorGroup Header="{Binding [axis_title],Source={x:Static lg:LanguageService.Instance}}">
                        <local:InspectorStack Spacing="8">
                            <local:LocalizedStringControl Value="{Binding Label, Mode=TwoWay}"
                                                          TextBoxStyle="{StaticResource InspectorTextBoxStyle}"
                                                          IsSingleLine="True"
                                                          ShowLanguageChip="True"/>
                            <local:InspectorFontEditor
                                FontFamilyName="{Binding Family, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PointSize="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                IsBold="{Binding IsBold, Mode=TwoWay}"
                                IsItalic="{Binding IsItalic, Mode=TwoWay}"
                                FontColor="{Binding Color, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                        </local:InspectorStack>
                    </local:InspectorGroup>

                    <!-- 子标题（默认展开） -->
                    <local:InspectorGroup Header="{Binding [subtitle],Source={x:Static lg:LanguageService.Instance}}">
                        <local:InspectorStack Spacing="8">
                            <local:LocalizedStringControl Value="{Binding SubLabel, Mode=TwoWay}"
                                                          TextBoxStyle="{StaticResource InspectorTextBoxStyle}"
                                                          IsSingleLine="True"
                                                          ShowLanguageChip="True"/>
                            <local:InspectorFontEditor ShowFamily="False"
                                PointSize="{Binding SubLabelSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                IsBold="{Binding SubLabelBold, Mode=TwoWay}"
                                IsItalic="{Binding SubLabelItalic, Mode=TwoWay}"
                                FontColor="{Binding SubLabelColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                        </local:InspectorStack>
                    </local:InspectorGroup>
                </StackPanel>

                <!-- ============ 范围 ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=TabScale, Converter={StaticResource BoolToVisibility}}">
                    <local:InspectorGroup Header="{Binding [insp_scale_and_range],Source={x:Static lg:LanguageService.Instance}}"
                                          Visibility="{Binding ShowAxisStyleOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <local:InspectorStack Spacing="10">
                            <!-- 缩放类型：线性 / 对数 -->
                            <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                    Visibility="{Binding IsScaleTypeSupported, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Header="{Binding [zoom_type],Source={x:Static lg:LanguageService.Instance}}">
                                <Border Style="{StaticResource InspectorSegmentTrackStyle}">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource InspectorSegmentRadioStyle}"
                                                     Content="{Binding [linear],Source={x:Static lg:LanguageService.Instance}}"
                                                     IsChecked="{Binding ScaleType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Linear}"/>
                                        <RadioButton Style="{StaticResource InspectorSegmentRadioStyle}"
                                                     Content="{Binding [logarithmic],Source={x:Static lg:LanguageService.Instance}}"
                                                     IsChecked="{Binding ScaleType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Logarithmic}"/>
                                    </UniformGrid>
                                </Border>
                            </HeaderedContentControl>

                            <!-- 范围：自动 – 自动（留空 = 自动） -->
                            <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                    Header="{Binding [range],Source={x:Static lg:LanguageService.Instance}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <local:AutoNumericUpDown Grid.Column="0"
                                                             Title="{Binding [from],Source={x:Static lg:LanguageService.Instance}}"
                                                             NumericStyle="{StaticResource InspectorNumericUpDownStyle}"
                                                             Value="{Binding Minimum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Minimum="{Binding AllowedInputMinimum}"/>
                                    <TextBlock Grid.Column="1" Text="–" Margin="8,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource InspectorHintBrush}"/>
                                    <local:AutoNumericUpDown Grid.Column="2"
                                                             Title="{Binding [to],Source={x:Static lg:LanguageService.Instance}}"
                                                             NumericStyle="{StaticResource InspectorNumericUpDownStyle}"
                                                             Value="{Binding Maximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Minimum="{Binding AllowedInputMinimum}"/>
                                </Grid>
                            </HeaderedContentControl>

                            <!-- 刻度对齐：自动 / 严格（严格时范围两端即轴边缘，不留边距） -->
                            <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                    Header="{Binding [tick_alignment],Source={x:Static lg:LanguageService.Instance}}">
                                <Border Style="{StaticResource InspectorSegmentTrackStyle}">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource InspectorSegmentRadioStyle}"
                                                     Content="{Binding [auto],Source={x:Static lg:LanguageService.Instance}}"
                                                     IsChecked="{Binding TickAlignment, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Auto}"/>
                                        <RadioButton Style="{StaticResource InspectorSegmentRadioStyle}"
                                                     Content="{Binding [tick_align_strict],Source={x:Static lg:LanguageService.Instance}}"
                                                     IsChecked="{Binding TickAlignment, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Strict}"/>
                                    </UniformGrid>
                                </Border>
                            </HeaderedContentControl>
                        </local:InspectorStack>
                    </local:InspectorGroup>
                </StackPanel>

                <!-- ============ 刻度 ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=TabTicks, Converter={StaticResource BoolToVisibility}}">
                    <local:InspectorGroup Header="{Binding [axis_line],Source={x:Static lg:LanguageService.Instance}}"
                                          Visibility="{Binding ShowAxisStyleOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <local:InspectorStack Spacing="8">
                            <local:InspectorColumns Columns="2" Spacing="8">
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [width],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:NumericUpDown Value="{Binding AxisLineWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         Increment="0.5"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [color],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:TextPropertyColorPicker ShowHexText="False"
                                                                   SelectedColor="{Binding AxisLineColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                                </HeaderedContentControl>
                            </local:InspectorColumns>
                        </local:InspectorStack>
                    </local:InspectorGroup>

                    <!-- 主刻度：长度 · 粗细 · 颜色，下方为步长（仅线性） -->
                    <local:InspectorGroup Header="{Binding [major_tick_style],Source={x:Static lg:LanguageService.Instance}}"
                                          Visibility="{Binding ShowMajorTickStyleOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <local:InspectorStack Spacing="10">
                            <local:InspectorColumns Columns="3" Spacing="8">
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [length],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:NumericUpDown Value="{Binding MajorTickLength, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [width],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:NumericUpDown Value="{Binding MajorTickWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         Increment="0.5"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [color],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:TextPropertyColorPicker ShowHexText="False"
                                                                   SelectedColor="{Binding MajorTickWidthColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                                </HeaderedContentControl>
                            </local:InspectorColumns>

                            <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                    Header="{Binding [interval],Source={x:Static lg:LanguageService.Instance}}"
                                                    Visibility="{Binding IsLinearScale, Converter={StaticResource BoolToVisibilityConverter}}">
                                <local:NumericUpDown Value="{Binding MajorTickInterval, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                     Style="{StaticResource InspectorNumericUpDownStyle}"/>
                            </HeaderedContentControl>
                        </local:InspectorStack>
                    </local:InspectorGroup>

                    <!-- 次刻度：长度 · 粗细 · 颜色，下方为每主刻度分几格（仅线性） -->
                    <local:InspectorGroup Header="{Binding [minor_tick_style],Source={x:Static lg:LanguageService.Instance}}"
                                          Visibility="{Binding ShowMinorTickStyleOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <local:InspectorStack Spacing="10">
                            <local:InspectorColumns Columns="3" Spacing="8">
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [length],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:NumericUpDown Value="{Binding MinorTickLength, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [width],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:NumericUpDown Value="{Binding MinorTickWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         Increment="0.5"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [color],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:TextPropertyColorPicker ShowHexText="False"
                                                                   SelectedColor="{Binding MinorTickColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                                </HeaderedContentControl>
                            </local:InspectorColumns>

                            <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                    Header="{Binding [count],Source={x:Static lg:LanguageService.Instance}}"
                                                    Visibility="{Binding IsLinearScale, Converter={StaticResource BoolToVisibilityConverter}}">
                                <local:NumericUpDown Value="{Binding MinorTicksPerMajorTick, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                     Style="{StaticResource InspectorNumericUpDownStyle}"/>
                            </HeaderedContentControl>
                        </local:InspectorStack>
                    </local:InspectorGroup>

                    <local:InspectorGroup Header="{Binding [tick_labels],Source={x:Static lg:LanguageService.Instance}}">
                        <local:InspectorFontEditor
                            FontFamilyName="{Binding TickLableFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PointSize="{Binding TickLablesize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                            IsBold="{Binding TickLableisBold, Mode=TwoWay}"
                            IsItalic="{Binding TickLableisItalic, Mode=TwoWay}"
                            FontColor="{Binding TickLablecolor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                    </local:InspectorGroup>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
