<UserControl x:Class="GeoChemistryNexus.Controls.ScatterPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
        <cvs:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:ScatterPropertyControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe602;" Title="{Binding [point],Source={x:Static lg:LanguageService.Instance}}">
            <local:InspectorHeader.Summary>
                <MultiBinding StringFormat="{}{0} · ({1:0.##}, {2:0.##})">
                    <Binding Path="Name"/>
                    <Binding Path="StartAndEnd.X"/>
                    <Binding Path="StartAndEnd.Y"/>
                </MultiBinding>
            </local:InspectorHeader.Summary>
        </local:InspectorHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,18" Grid.IsSharedSizeScope="True">

                <!-- 信息：名称 + 只读位置（带锁） -->
                <local:InspectorGroup Header="{Binding [insp_info],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorStack Spacing="10">
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [name],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Name'}">
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource InspectorTextBoxStyle}"/>
                        </HeaderedContentControl>
                        <local:PointDefinitionControl Label="{Binding [location],Source={x:Static lg:LanguageService.Instance}}"
                                                      PointValue="{Binding StartAndEnd}" IsReadOnly="True"/>
                    </local:InspectorStack>
                </local:InspectorGroup>

                <!-- 标记：形状（弹层网格）+ 大小 -->
                <local:InspectorGroup Header="{Binding [insp_marker],Source={x:Static lg:LanguageService.Instance}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <local:MarkerShapePicker Grid.Column="0" SelectedShape="{Binding MarkerShape, Mode=TwoWay}"/>
                        <local:NumericUpDown Grid.Column="2"
                                             Value="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                             Minimum="0"
                                             local:InspectorAssist.Unit="pt"
                                             ToolTip="{Binding [size],Source={x:Static lg:LanguageService.Instance}}"
                                             Style="{StaticResource InspectorNumericUpDownStyle}"/>
                    </Grid>
                </local:InspectorGroup>

                <!-- 颜色：填充（仅实心形状）+ 描边 -->
                <local:InspectorGroup Header="{Binding [color],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorStack Spacing="10">
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [insp_fill],Source={x:Static lg:LanguageService.Instance}}"
                                                Visibility="{Binding HasFill, Converter={StaticResource BoolToVisibilityConverter}}">
                            <local:TextPropertyColorPicker
                                SelectedColor="{Binding Color, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [insp_stroke],Source={x:Static lg:LanguageService.Instance}}">
                            <local:InspectorStrokeEditor ShowLineStyle="False"
                                StrokeColor="{Binding StrokeColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"
                                StrokeWidth="{Binding StrokeWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"/>
                        </HeaderedContentControl>
                    </local:InspectorStack>
                </local:InspectorGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
