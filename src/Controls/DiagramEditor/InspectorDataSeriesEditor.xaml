<UserControl x:Class="GeoChemistryNexus.Controls.InspectorDataSeriesEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="160" d:DesignWidth="280">
    <UserControl.Resources>
        <cvs:OneBasedIndexConverter x:Key="OneBasedIndexConverter"/>
        <cvs:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <!-- 数据系列表格：# / 列名 / 单位 / 删除；底部整行“添加列” -->
    <StackPanel>
        <Border Height="26" Background="{StaticResource InspectorSubtleSurfaceBrush}"
                BorderBrush="{StaticResource InspectorRowDividerBrush}" BorderThickness="0,1">
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" HorizontalAlignment="Center" Style="{StaticResource InspectorTableHeaderLabelStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding [insp_column_name],Source={x:Static lg:LanguageService.Instance}}" Margin="12,0,0,0" Style="{StaticResource InspectorTableHeaderLabelStyle}"/>
                <TextBlock Grid.Column="2" Text="{Binding [epma_json_field_unit],Source={x:Static lg:LanguageService.Instance}}" Margin="12,0,0,0" Style="{StaticResource InspectorTableHeaderLabelStyle}"/>
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Rows, ElementName=Root}" AlternationCount="100000">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:DataSeriesRow}">
                    <Border BorderBrush="{StaticResource InspectorRowDividerBrush}" BorderThickness="0,0,0,1" Padding="12,5,8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       FontFamily="{StaticResource InspectorMonoFont}"
                                       Foreground="{StaticResource InspectorHintBrush}"
                                       Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource OneBasedIndexConverter}}"/>
                            <TextBox Grid.Column="1" Margin="6,0,0,0"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                                     Style="{StaticResource InspectorMonoTextBoxStyle}"/>
                            <TextBox Grid.Column="2" Margin="6,0,0,0"
                                     Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                                     local:ControlAssist.Placeholder="{Binding [epma_json_field_unit],Source={x:Static lg:LanguageService.Instance}}"
                                     Style="{StaticResource InspectorMonoTextBoxStyle}"/>
                            <Button Grid.Column="3" Width="22" Height="22" HorizontalAlignment="Right"
                                    Style="{StaticResource InspectorDangerIconButtonStyle}"
                                    Visibility="{Binding IsReadOnly, ElementName=Root, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                    Click="DeleteButton_Click">
                                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stretch="None"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Click="AddButton_Click" Style="{StaticResource InspectorAddBarButtonStyle}"
                Visibility="{Binding IsReadOnly, ElementName=Root, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="M 6,1 V 11 M 1,6 H 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="None" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding [insp_add_column],Source={x:Static lg:LanguageService.Instance}}"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
