<UserControl x:Class="GeoChemistryNexus.Controls.SpiderAxisPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:SpiderAxisPropertyControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe605;"
                               Title="{Binding [axis_style],Source={x:Static lg:LanguageService.Instance}}"
                               Summary="{Binding Label, Mode=OneWay}"/>

        <!-- 页签：标题 / 刻度标签（与坐标轴“精简”变体同结构） -->
        <Border Grid.Row="1" Style="{StaticResource InspectorTabBarStyle}">
            <local:InspectorColumns Spacing="0">
                <RadioButton x:Name="TabTitle" GroupName="SpiderAxisTabs" IsChecked="True"
                             Style="{StaticResource InspectorTabRadioStyle}"
                             Content="{Binding [axis_tab_title],Source={x:Static lg:LanguageService.Instance}}"/>
                <RadioButton x:Name="TabLabels" GroupName="SpiderAxisTabs"
                             Style="{StaticResource InspectorTabRadioStyle}"
                             Content="{Binding [tick_labels],Source={x:Static lg:LanguageService.Instance}}"/>
            </local:InspectorColumns>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,10,12,18">

                <!-- ============ 标题 ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=TabTitle, Converter={StaticResource BoolToVisibility}}">
                    <local:InspectorGroup Header="{Binding [axis_title],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Axis Title'}">
                        <local:InspectorStack Spacing="8">
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InspectorTextBoxStyle}"/>
                            <local:InspectorFontEditor
                                FontFamilyName="{Binding Family, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PointSize="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                IsBold="{Binding IsBold, Mode=TwoWay}"
                                IsItalic="{Binding IsItalic, Mode=TwoWay}"
                                FontColor="{Binding Color, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                        </local:InspectorStack>
                    </local:InspectorGroup>

                    <!-- 子标题（默认折叠） -->
                    <local:InspectorGroup Header="{Binding [subtitle],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Subtitle'}"
                                          IsExpanded="False">
                        <local:InspectorStack Spacing="8">
                            <TextBox Text="{Binding SubLabel, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InspectorTextBoxStyle}"/>
                            <local:InspectorFontEditor ShowFamily="False"
                                PointSize="{Binding SubLabelSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                IsBold="{Binding SubLabelBold, Mode=TwoWay}"
                                IsItalic="{Binding SubLabelItalic, Mode=TwoWay}"
                                FontColor="{Binding SubLabelColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                        </local:InspectorStack>
                    </local:InspectorGroup>
                </StackPanel>

                <!-- ============ 刻度标签 ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=TabLabels, Converter={StaticResource BoolToVisibility}}">
                    <local:InspectorGroup Header="{Binding [tick_labels],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Tick Labels'}">
                        <local:InspectorFontEditor
                            FontFamilyName="{Binding TickFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PointSize="{Binding TickFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                            IsBold="{Binding TickIsBold, Mode=TwoWay}"
                            IsItalic="{Binding TickIsItalic, Mode=TwoWay}"
                            FontColor="{Binding TickColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                    </local:InspectorGroup>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
