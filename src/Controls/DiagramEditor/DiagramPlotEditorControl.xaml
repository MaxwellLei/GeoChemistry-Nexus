            <!-- 数据与脚本（与 EPMA 同款：上方数据表格，下方脚本） -->
            <Grid x:Name="ScriptPanel" Grid.Row="1" Visibility="Collapsed" Margin="24,16,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="ScriptPageScroll" Grid.Row="0" Margin="0,0,4,0" Background="Transparent"
