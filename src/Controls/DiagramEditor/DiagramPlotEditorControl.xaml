                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="260"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>

