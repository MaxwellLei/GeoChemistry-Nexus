<UserControl x:Class="GeoChemistryNexus.Controls.DiagramPlotEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:vm="clr-namespace:GeoChemistryNexus.ViewModels"
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:views="clr-namespace:GeoChemistryNexus.Views"
             xmlns:helpers="clr-namespace:GeoChemistryNexus.Helpers"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             x:Name="RootEditorControl"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             Background="#F5F7FA">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- 与 EPMA 计算模板编辑器共用的编辑器样式（含 EpmaTemplateEditorStyles） -->
            <ResourceDictionary Source="pack://application:,,,/GeoChemistryNexus;component/Themes/EditorStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="DiagramFormValue" TargetType="TextBox" BasedOn="{StaticResource EditorFormValue}">
            <Setter Property="IsReadOnly" Value="False"/>
        </Style>
        <cvs:EpmaScriptEditorHeightConverter x:Key="ScriptEditorHeight"/>
        <cvs:BorderClipConverter x:Key="RoundedClip"/>
        <cvs:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <Style x:Key="DiagramSourceBox" TargetType="local:EpmaCodeEditor" BasedOn="{StaticResource EpmaSourceBox}">
            <Setter Property="IsReadOnly" Value="False"/>
        </Style>
        <cvs:BoolToVisibilityConverter x:Key="Show"/>
        <ItemsPanelTemplate x:Key="DiagramLocColumnsPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <!-- 多语言表格的单元格容器 / 输入框 / 字段项标签：与 EPMA、地质温压计的多语言窗口共用 Themes/Styles.xaml 中的 LocCellBox、LocCellInput、LocRowLabel -->
        <DataTemplate x:Key="DiagramLocColumnHeader">
            <Grid Width="{Binding Width}">
            <Border Style="{StaticResource LocCellBox}" Height="46" Padding="14,0">
                <DockPanel VerticalAlignment="Center">
                    <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,2" VerticalAlignment="Center" Background="White"
                            BorderBrush="#0F000000" BorderThickness="1" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource EpmaLocStatusDot}"/>
                            <TextBlock Text="{Binding Progress}" Margin="4,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                       FontWeight="Medium" Foreground="#515154"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Header}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Normal" Foreground="#1D1D1F"
                                   LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
                        <Border Margin="6,0,0,0" Height="16" Padding="6,0" VerticalAlignment="Center" Background="{DynamicResource ThemeAccentTintBrush}" CornerRadius="4"
                                Visibility="{Binding IsDefault,Converter={StaticResource Show}}">
                            <TextBlock VerticalAlignment="Center" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource ThemeAccentBrush}"
                                       LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                       Text="{Binding [epma_editor_default_badge],Source={x:Static lg:LanguageService.Instance}}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- 拖动右侧边缘调整该语言列的宽度 -->
            <local:ResizeGripThumb Style="{StaticResource LocResizeGripStyle}" Orientation="Horizontal" MinValue="160"
                                   Value="{Binding Width, Mode=TwoWay}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DiagramLocCell">
            <Border Style="{StaticResource LocCellBox}" Width="{Binding Column.Width}" Padding="6,4">
                <TextBox Style="{StaticResource LocCellInput}"/>
            </Border>
        </DataTemplate>
        <!-- 主题色相关画刷：颜色取自 AppThemeHelper 写入的应用级资源，随主题切换更新 -->
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource ThemeAccentColor}"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource ThemeAccentSoftColor}"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E5E5EA"/>
        <SolidColorBrush x:Key="ModernCardBorderBrush" Color="#E5E5EA"/>
        <SolidColorBrush x:Key="ModernTextPrimaryBrush" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="ModernTextSecondaryBrush" Color="#86868B"/>

        <!-- 语言标签与下拉框样式（TokenBorderStyle 等、DiagramEditorComboBoxStyle）已移至 Themes/Styles.xaml，与 EPMA 模板编辑器共用 -->
        <cvs:GraphMapPathToIconConverter x:Key="GraphMapPathToIconConverter"/>

        <Style x:Key="CategoryPreviewTreeViewItemStyle" BasedOn="{StaticResource ModernStyleTreeViewItemStyle}" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>

        <Style x:Key="TranslationDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>

        <Style x:Key="TranslationDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Top"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ModernPrimarySoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource ModernTextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlotTypeListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E5E5EA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F7F8FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#F3F5FB"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#F3F5FB"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiagramDirectionRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#263549"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" MinHeight="32" Padding="6,4">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F7F8FB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E5E5EA"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏导航项：与 EPMA 模板编辑器的 NavigationItem 一致 -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#3C3C43"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="EditorNav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F3"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationIcon" TargetType="Path">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="1.5,0,11.5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Stroke" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#66768B"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#86868B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PanelControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                                <Setter Property="Foreground" Value="#333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4D4D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryTokenStyle" TargetType="Border" BasedOn="{StaticResource TokenBorderStyle}">
            <Setter Property="Background" Value="#FFF4EB"/>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategorySelectButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModernCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource ModernTextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C7C7CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HelpFormatButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HelpFormatToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F7"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F2FC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar（与 EPMA 模板编辑器一致） -->
        <Border Grid.Column="0" Background="#EBEEF3" BorderBrush="#DFE5ED" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,16">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="20,2,12,24">
                        <Border Width="34" Height="34" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="9" DockPanel.Dock="Left" Margin="0,0,10,0">
                            <Path Data="M 2,14 L 2,2 M 2,14 L 14,14 M 4,11 L 7,7 L 10,9 L 14,4" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding WindowTitle}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#7A8798">
                                <Run Text="v"/><Run Text="{Binding FormatVersionBaseline, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <TextBlock Text="{Binding [epma_editor_workflow], Source={x:Static lg:LanguageService.Instance}}"
                           Foreground="#7A8798" FontSize="11" Margin="22,0,0,6" DockPanel.Dock="Top"/>
                <Border x:Name="TemplateStatusPanel" DockPanel.Dock="Bottom" Margin="18,16,14,0" Padding="0,12,0,0"
                        BorderBrush="#DCE2EB" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [epma_editor_state_title], Source={x:Static lg:LanguageService.Instance}}"
                                   Foreground="#66768B" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TemplateStatusList" ItemsSource="{Binding TemplateStatusItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="•"/>
                                                        <Setter Property="Foreground" Value="#B7791F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="False">
                                                                <Setter Property="Text" Value="✓"/>
                                                                <Setter Property="Foreground" Value="#2D7A49"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="#66768B"
                                                       FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavBasic" Style="{StaticResource NavItemStyle}" IsChecked="True"
                                 Checked="NavSection_Checked" Tag="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource NavigationIcon}" Data="M 1,3 H 4 M 7,3 H 15 M 4,3 A 1.5,1.5 0 1 0 7,3 A 1.5,1.5 0 1 0 4,3 M 1,8 H 9 M 12,8 H 15 M 9,8 A 1.5,1.5 0 1 0 12,8 A 1.5,1.5 0 1 0 9,8 M 1,13 H 3 M 6,13 H 15 M 3,13 A 1.5,1.5 0 1 0 6,13 A 1.5,1.5 0 1 0 3,13"/>
                            <TextBlock Text="{Binding [epma_editor_nav_basic], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTranslation" Style="{StaticResource NavItemStyle}"
                                 Checked="NavSection_Checked" Tag="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource NavigationIcon}" Data="M 1,3 H 9 M 5,1 V 3 M 3,3 C 3,6 5,8 8,9 M 7,3 C 7,6 5,8 2,9 M 8,15 L 11,6 L 14,15 M 9,12 H 13"/>
                            <TextBlock Text="{Binding [diagram_editor_content_translation], Source={x:Static lg:LanguageService.Instance}, TargetNullValue='多语言'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavScript" Style="{StaticResource NavItemStyle}"
                                 Checked="NavSection_Checked" Tag="2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource NavigationIcon}" Data="M 5,3 L 1,8 L 5,13 M 11,3 L 15,8 L 11,13 M 9.5,1.5 L 6.5,14.5"/>
                            <TextBlock Text="{Binding [epma_editor_nav_script], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHelp" Style="{StaticResource NavItemStyle}"
                                 Checked="NavSection_Checked" Tag="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource NavigationIcon}" Data="M 3,2 A 1,1 0 0 1 4,1 H 9 L 13,5 V 14 A 1,1 0 0 1 12,15 H 4 A 1,1 0 0 1 3,14 Z M 9,1 V 5 H 13 M 6,8 H 10 M 6,11 H 9"/>
                            <TextBlock Text="{Binding [epma_editor_documents], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶栏：当前页标题（右侧保存/窗口按钮由窗口叠加） -->
            <Border Grid.Row="0" BorderBrush="#DFE5ED" BorderThickness="0,0,0,1">
                <DockPanel Margin="24,0,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Margin="0,0,20,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                               Text="{Binding ActivePageTitle}"/>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
