                                <!-- 左侧行标签：数据列（列名） / 单位（可选） -->
                                <Border BorderBrush="#D6E1EE" BorderThickness="0,0,1,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Border Height="33" Background="#EDF4FC" BorderBrush="#D6E1EE" BorderThickness="0,0,0,1">
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#475569"
                                                       Text="{Binding [data_series], Source={x:Static lg:LanguageService.Instance}}"/>
                                        </Border>
                                        <Border Height="32" BorderBrush="#E7EDF5" BorderThickness="0,0,0,1">
                                            <TextBlock Margin="8,0,8,0" VerticalAlignment="Center" Foreground="#64748B"
                                                       Text="{Binding [epma_json_field_unit], Source={x:Static lg:LanguageService.Instance}}"/>
                                        </Border>
                                        <!-- 分组（可选）：相邻且同名的列在数据表格表头上合并成一个分组带 -->
                                        <Border Height="32">
                                            <TextBlock Margin="8,0,8,0" VerticalAlignment="Center" Foreground="#64748B"
                                                       Text="{Binding [epma_json_field_group], Source={x:Static lg:LanguageService.Instance}}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Column="1" Style="{StaticResource EditorTableScroll}">
                                    <ItemsControl AlternationCount="2147483647" ItemsSource="{Binding DataSeriesColumns}" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#D6E1EE" BorderThickness="0,0,1,0" MinWidth="96">
                                                    <StackPanel>
                                                        <!-- 列名 -->
                                                        <Border Background="#EDF4FC" BorderBrush="#D6E1EE" BorderThickness="0,0,0,1">
                                                            <DockPanel Height="32">
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource GeoTRemoveColumn}"
                                                                        Command="{Binding DataContext.RemoveDataSeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <TextBox Style="{StaticResource GeoTColumnCell}"
                                                                         Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                                         Tag="{Binding [epma_editor_column_placeholder], Source={x:Static lg:LanguageService.Instance}}"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <!-- 单位（可选）：非空时数据表格的表头会在列名下方显示 -->
                                                        <Border BorderBrush="#E7EDF5" BorderThickness="0,0,0,1" Height="32">
                                                            <TextBox Style="{StaticResource GeoTColumnCell}" Height="31"
                                                                     Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                                                     Tag="{Binding [epma_editor_unit_placeholder], Source={x:Static lg:LanguageService.Instance}}"
                                                                     AutomationProperties.Name="{Binding [epma_json_field_unit], Source={x:Static lg:LanguageService.Instance}}"/>
                                                        </Border>
                                                        <!-- 分组（可选）：默认语言的标题，其它语言在“多语言”页填写 -->
                                                        <Border Height="32">
                                                            <TextBox Style="{StaticResource GeoTColumnCell}" Height="31"
                                                                     Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                                                     Tag="{Binding [epma_editor_unit_placeholder], Source={x:Static lg:LanguageService.Instance}}"
                                                                     AutomationProperties.Name="{Binding [epma_json_field_group], Source={x:Static lg:LanguageService.Instance}}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="ScriptTitleRow" Style="{StaticResource GeoTSectionHeading}" Margin="2,4,2,10"
                                   Text="{Binding [script_definition], Source={x:Static lg:LanguageService.Instance}}"/>
                        <Border x:Name="ScriptEditorPanel" MinHeight="520" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource ScriptEditorHeight}">
                                    <Binding ElementName="ScriptPageScroll" Path="ViewportHeight"/>
                                    <Binding ElementName="ColumnTables" Path="ActualHeight"/>
                                    <Binding ElementName="ScriptTitleRow" Path="ActualHeight"/>
                                </MultiBinding>
                            </Border.Height>
                            <DockPanel LastChildFill="True">
                                <DockPanel.Clip>
                                    <MultiBinding Converter="{StaticResource RoundedClip}">
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="CornerRadius" ElementName="ScriptEditorPanel"/>
                                        <Binding Path="BorderThickness" ElementName="ScriptEditorPanel"/>
                                    </MultiBinding>
                                </DockPanel.Clip>
                                <Border DockPanel.Dock="Top" Background="#F7F9FC" BorderBrush="#E1E7EF" BorderThickness="0,0,0,1" Padding="12,6">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="JS" Background="#F5D76E" Foreground="#574800" FontFamily="Consolas"
                                                   FontWeight="Bold" Padding="5,2" VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Left" Text="diagram.script.js" FontFamily="Consolas"
                                                   Foreground="#475569" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right" Command="{Binding TestScriptCommand}" ToolTip="Ctrl+Enter" Padding="12,5">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding [epma_editor_test], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Background="#F7F9FC" BorderBrush="#E1E7EF" BorderThickness="0,1,0,0" Padding="12,4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="JavaScript · UTF-8" Foreground="#64748B" FontSize="11"/>
                                        <TextBlock Text="{Binding CaretLocation, ElementName=DiagramScriptSource}" Foreground="#64748B" FontFamily="Consolas" FontSize="11"/>
                                    </DockPanel>
                                </Border>
                                <local:EpmaCodeEditor x:Name="DiagramScriptSource" Style="{StaticResource DiagramSourceBox}"
                                                      Text="{Binding ScriptDefinition.ScriptBody, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="{Binding [epma_editor_nav_script], Source={x:Static lg:LanguageService.Instance}}">
                                    <local:EpmaCodeEditor.InputBindings>
                                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding TestScriptCommand}"/>
                                    </local:EpmaCodeEditor.InputBindings>
                                </local:EpmaCodeEditor>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Margin="0,8,8,0" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                        Visibility="{Binding HasScriptStatus, Converter={StaticResource Show}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F4F9F5"/>
                            <Setter Property="MaxHeight" Value="112"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScriptHasError}" Value="True">
                                    <Setter Property="Background" Value="#FFF4F2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox Text="{Binding ScriptStatus, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="12,8"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>

            <!-- 帮助文档（与 EPMA 共用 EpmaHelpDocEditor） -->
            <Grid x:Name="HelpPanel" Grid.Row="1" Visibility="Collapsed" Margin="24,16,16,16">
                <views:EpmaHelpDocEditor/>
            </Grid>

            <!-- 多语言（第二页：控件布局对齐 EPMA 编辑多语言窗体） -->
            <Grid x:Name="TranslationPanel" Grid.Row="1" Visibility="Collapsed" Margin="20,12,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="TranslationTableScroll" Grid.Row="0"
                              Visibility="{Binding HasTranslationContent, Converter={StaticResource Show}}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              helpers:LocalizationTableLayoutBehavior.Columns="{Binding TranslationColumns}"
                              helpers:ScrollWheelBehavior.ShiftHorizontalTarget="{Binding ElementName=TranslationOtherLanguagesScroll}">
                    <Border Background="White" BorderBrush="#12000000" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 冻结列：右侧加粗分界线提示此处为冻结位置 -->
                            <Border Grid.Column="0" HorizontalAlignment="Left" Panel.ZIndex="1"
                                    BorderBrush="#C3C9D4" BorderThickness="0,0,2,0">
                            <StackPanel>
                                <Border Background="#F8F9FB" BorderBrush="#0F000000" BorderThickness="0,0,0,1" CornerRadius="9,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="16,0,8,0" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium" Foreground="#86868B"
                                                   Text="{Binding [epma_loc_field_header], Source={x:Static lg:LanguageService.Instance}}"/>
                                        <ContentControl Grid.Column="1" Content="{Binding TranslationDefaultColumn}"
                                                        ContentTemplate="{StaticResource DiagramLocColumnHeader}"
                                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                        Focusable="False" IsTabStop="False"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding TranslationDisplayRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#0D000000" BorderThickness="0,1,0,0" Height="{Binding RowHeight}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#FCFCFD">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource LocRowLabel}" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <ContentControl Grid.Column="1" Content="{Binding DefaultCell}"
                                                                    ContentTemplate="{StaticResource DiagramLocCell}"
                                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                                    Focusable="False" IsTabStop="False"/>
                                                    <!-- 拖动行底部边缘调整该行高度 -->
                                                    <local:ResizeGripThumb Grid.ColumnSpan="2" Style="{StaticResource LocResizeGripStyle}"
                                                                           Orientation="Vertical" MinValue="42"
                                                                           Value="{Binding RowHeight, Mode=TwoWay}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="TranslationOtherLanguagesScroll" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          helpers:ScrollWheelBehavior.PassVerticalWheelToParent="True">
                                <StackPanel>
                                    <Border Background="#F8F9FB" BorderBrush="#0F000000" BorderThickness="0,0,0,1" CornerRadius="0,9,0,0">
                                        <ItemsControl ItemsSource="{Binding TranslationOtherColumns}"
                                                      ItemsPanel="{StaticResource DiagramLocColumnsPanel}"
                                                      ItemTemplate="{StaticResource DiagramLocColumnHeader}" Focusable="False"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding TranslationDisplayRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#0D000000" BorderThickness="0,1,0,0" Height="{Binding RowHeight}">
                                                    <ItemsControl ItemsSource="{Binding OtherCells}"
                                                                  ItemsPanel="{StaticResource DiagramLocColumnsPanel}"
                                                                  ItemTemplate="{StaticResource DiagramLocCell}" Focusable="False"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <Border Grid.RowSpan="2" Background="#F5F7FA">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTranslationContent}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding [diagram_editor_no_translation], Source={x:Static lg:LanguageService.Instance}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#7A8798"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding TranslationStatusMessage}" Margin="0,10,0,0"
                           Visibility="{Binding HasTranslationContent, Converter={StaticResource Show}}"
                           FontSize="12" Foreground="#86868B" TextTrimming="CharacterEllipsis"/>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
