                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding GraphMapPath, Converter={StaticResource GraphMapPathToIconConverter}}"
                                                                   FontSize="14"
                                                                   Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </HierarchicalDataTemplate>
