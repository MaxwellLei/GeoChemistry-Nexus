<UserControl x:Class="GeoChemistryNexus.Controls.InspectorEndpointsGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="300">
    <!-- “端点”分组：起点（绿点）/ 终点（红点）各一行 X、Y + 拾取，标题栏右侧为交换按钮；箭头、线条共用 -->
    <local:InspectorGroup Header="{Binding [insp_endpoints], Source={x:Static lg:LanguageService.Instance}}">
        <local:InspectorGroup.HeaderRight>
            <Button Style="{StaticResource InspectorIconButtonStyle}"
                    ToolTip="{Binding [swap_endpoints], Source={x:Static lg:LanguageService.Instance}}"
                    Click="SwapEndpointsButton_Click">
                <Path Data="M 5,2.5 V 12.5 M 2.5,10 L 5,12.5 L 7.5,10 M 11,13.5 V 3.5 M 8.5,6 L 11,3.5 L 13.5,6"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="None"/>
            </Button>
        </local:InspectorGroup.HeaderRight>

        <local:InspectorStack Spacing="10" Grid.IsSharedSizeScope="True">
            <local:PointDefinitionControl Label="{Binding [insp_start], Source={x:Static lg:LanguageService.Instance}}"
                                          DotBrush="{StaticResource InspectorStartDotBrush}"
                                          PointValue="{Binding Start, ElementName=Root, Mode=OneWay}"/>
            <local:PointDefinitionControl Label="{Binding [insp_end], Source={x:Static lg:LanguageService.Instance}}"
                                          DotBrush="{StaticResource InspectorEndDotBrush}"
                                          PointValue="{Binding End, ElementName=Root, Mode=OneWay}"/>
        </local:InspectorStack>
    </local:InspectorGroup>
</UserControl>
