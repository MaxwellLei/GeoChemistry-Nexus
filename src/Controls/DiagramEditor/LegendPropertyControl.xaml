<UserControl x:Class="GeoChemistryNexus.Controls.LegendPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LegendBoolToVisibility"/>
        <cvs:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <cvs:EnumToDisplayStringConverter x:Key="EnumToDisplayStringConverter"/>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:LegendPropertyControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe6ae;" Title="{Binding [legend],Source={x:Static lg:LanguageService.Instance}}">
            <local:InspectorHeader.Summary>
                <MultiBinding StringFormat="{}{0} · {1}">
                    <Binding Path="Alignment" Converter="{StaticResource EnumToDisplayStringConverter}"/>
                    <Binding Path="Orientation" Converter="{StaticResource EnumToDisplayStringConverter}"/>
                </MultiBinding>
            </local:InspectorHeader.Summary>
        </local:InspectorHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,18" Grid.IsSharedSizeScope="True">

                <!-- 位置与排列：总开关在标题栏；迷你图表的 6 个落点代表图例位置，选中的落点里直接画出图例 -->
                <local:InspectorGroup Header="{Binding [insp_legend_layout],Source={x:Static lg:LanguageService.Instance}}"
                                      IsCollapsible="False"
                                      Visibility="{Binding IsLayoutEditable, Converter={StaticResource LegendBoolToVisibility}}"
                                      HasSwitch="True" SwitchMode="Dim"
                                      IsSwitchOn="{Binding IsVisible, Mode=TwoWay}">
                    <local:InspectorStack Spacing="10">
                        <!-- 迷你图表 -->
                        <Border Height="132" CornerRadius="10" BorderThickness="1.5" BorderBrush="#CFD6E2"
                                Background="{StaticResource InspectorChartAreaBrush}">
                            <Grid>
                                <UniformGrid Columns="3" Rows="2">
                                    <RadioButton GroupName="LegendAlignment" Style="{StaticResource InspectorLegendSpotRadioStyle}"
                                                 HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                                                 ToolTip="{Binding [Alignment_UpperLeft],Source={x:Static lg:LanguageService.Instance}}"
                                                 IsChecked="{Binding Alignment, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=UpperLeft}"/>
                                    <RadioButton GroupName="LegendAlignment" Style="{StaticResource InspectorLegendSpotRadioStyle}"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
                                                 ToolTip="{Binding [Alignment_UpperCenter],Source={x:Static lg:LanguageService.Instance}}"
                                                 IsChecked="{Binding Alignment, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=UpperCenter}"/>
                                    <RadioButton GroupName="LegendAlignment" Style="{StaticResource InspectorLegendSpotRadioStyle}"
                                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Top"
                                                 ToolTip="{Binding [Alignment_UpperRight],Source={x:Static lg:LanguageService.Instance}}"
                                                 IsChecked="{Binding Alignment, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=UpperRight}"/>
                                    <RadioButton GroupName="LegendAlignment" Style="{StaticResource InspectorLegendSpotRadioStyle}"
                                                 HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"
                                                 ToolTip="{Binding [Alignment_LowerLeft],Source={x:Static lg:LanguageService.Instance}}"
                                                 IsChecked="{Binding Alignment, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LowerLeft}"/>
                                    <RadioButton GroupName="LegendAlignment" Style="{StaticResource InspectorLegendSpotRadioStyle}"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom"
                                                 ToolTip="{Binding [Alignment_LowerCenter],Source={x:Static lg:LanguageService.Instance}}"
                                                 IsChecked="{Binding Alignment, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LowerCenter}"/>
                                    <RadioButton GroupName="LegendAlignment" Style="{StaticResource InspectorLegendSpotRadioStyle}"
                                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom"
                                                 ToolTip="{Binding [Alignment_LowerRight],Source={x:Static lg:LanguageService.Instance}}"
                                                 IsChecked="{Binding Alignment, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LowerRight}"/>
                                </UniformGrid>
                                <TextBlock Text="{Binding [insp_chart_area],Source={x:Static lg:LanguageService.Instance}}"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,3"
                                           FontFamily="{StaticResource InspectorMonoFont}" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="#B6BECB" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- 排列：横向 / 纵向（只用文字） -->
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [orientation],Source={x:Static lg:LanguageService.Instance}}">
                            <Border Style="{StaticResource InspectorSegmentTrackStyle}">
                                <UniformGrid Rows="1">
                                    <RadioButton GroupName="LegendOrientation"
                                                 Style="{StaticResource InspectorSegmentRadioStyle}"
                                                 Content="{Binding [Orientation_Horizontal],Source={x:Static lg:LanguageService.Instance}}"
                                                 IsChecked="{Binding Orientation, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Horizontal}"/>
                                    <RadioButton GroupName="LegendOrientation"
                                                 Style="{StaticResource InspectorSegmentRadioStyle}"
                                                 Content="{Binding [Orientation_Vertical],Source={x:Static lg:LanguageService.Instance}}"
                                                 IsChecked="{Binding Orientation, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Vertical}"/>
                                </UniformGrid>
                            </Border>
                        </HeaderedContentControl>
                    </local:InspectorStack>
                </local:InspectorGroup>

                <!-- 字体：字体名 / 字号·B·I·颜色 -->
                <local:InspectorGroup Header="{Binding [font],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorFontEditor
                        FontFamilyName="{Binding Font, Mode=TwoWay}"
                        PointSize="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                        IsBold="{Binding IsBold, Mode=TwoWay}"
                        IsItalic="{Binding IsItalic, Mode=TwoWay}"
                        FontColor="{Binding FontColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                </local:InspectorGroup>

                <!-- 边框：颜色 + 宽度（宽度为 0 即无边框） -->
                <local:InspectorGroup Header="{Binding [insp_border],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorStrokeEditor
                        ShowLineStyle="False"
                        StrokeColor="{Binding OutlineColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"
                        StrokeWidth="{Binding OutlineWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"/>
                </local:InspectorGroup>

                <!-- 背景：颜色 + 不透明度 -->
                <local:InspectorGroup Header="{Binding [insp_legend_background],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorStack Spacing="10">
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [color],Source={x:Static lg:LanguageService.Instance}}">
                            <local:TextPropertyColorPicker SelectedColor="{Binding BackgroundColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [insp_legend_opacity],Source={x:Static lg:LanguageService.Instance}}">
                            <local:InspectorSliderBox Minimum="0" Maximum="1" Step="0.05" SliderStep="0.05"
                                                      Value="{Binding BackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"/>
                        </HeaderedContentControl>
                    </local:InspectorStack>
                </local:InspectorGroup>

                <!-- 阴影：开关在标题栏；颜色 + X/Y 偏移 -->
                <local:InspectorGroup Header="{Binding [insp_legend_shadow],Source={x:Static lg:LanguageService.Instance}}"
                                      IsCollapsible="False"
                                      HasSwitch="True" SwitchMode="Dim"
                                      IsSwitchOn="{Binding ShadowEnabled, Mode=TwoWay}">
                    <local:InspectorStack Spacing="10">
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [color],Source={x:Static lg:LanguageService.Instance}}">
                            <local:TextPropertyColorPicker SelectedColor="{Binding ShadowColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [offset],Source={x:Static lg:LanguageService.Instance}}">
                            <local:InspectorColumns Columns="2" Spacing="6">
                                <local:NumericUpDown Value="{Binding ShadowOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                     local:ControlAssist.Title="X"
                                                     ToolTip="{Binding [offset_x],Source={x:Static lg:LanguageService.Instance}}"
                                                     Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                <local:NumericUpDown Value="{Binding ShadowOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                     local:ControlAssist.Title="Y"
                                                     ToolTip="{Binding [offset_y],Source={x:Static lg:LanguageService.Instance}}"
                                                     Style="{StaticResource InspectorNumericUpDownStyle}"/>
                            </local:InspectorColumns>
                        </HeaderedContentControl>
                    </local:InspectorStack>
                </local:InspectorGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
