<UserControl x:Class="GeoChemistryNexus.Controls.SpiderSamplePropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:SpiderSamplePropertyControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe602;"
                               Title="{Binding [point],Source={x:Static lg:LanguageService.Instance}}"
                               Summary="{Binding SampleName, Mode=OneWay}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,10,12,18" Grid.IsSharedSizeScope="True">

                <!-- 样品：名称 -->
                <local:InspectorGroup Header="{Binding [insp_sample],Source={x:Static lg:LanguageService.Instance}}">
                    <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                            Header="{Binding [name],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Name'}">
                        <TextBox Text="{Binding SampleName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InspectorTextBoxStyle}"/>
                    </HeaderedContentControl>
                </local:InspectorGroup>

                <!-- 线条：颜色 + 线宽 -->
                <local:InspectorGroup Header="{Binding [line],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorColumns Columns="2" Spacing="8">
                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [color],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Color'}">
                            <local:TextPropertyColorPicker
                                SelectedColor="{Binding Color, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                Header="{Binding [line_width],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Line Width'}">
                            <local:NumericUpDown Value="{Binding LineWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                 Minimum="0.5" Maximum="10" Increment="0.5"
                                                 Style="{StaticResource InspectorNumericUpDownStyle}"/>
                        </HeaderedContentControl>
                    </local:InspectorColumns>
                </local:InspectorGroup>

                <!-- 符号：形状（与图解模板数据点相同的选择器）+ 大小 -->
                <local:InspectorGroup Header="{Binding [insp_symbol],Source={x:Static lg:LanguageService.Instance}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <local:MarkerShapePicker Grid.Column="0" SelectedShape="{Binding MarkerShape, Mode=TwoWay}"/>
                        <local:NumericUpDown Grid.Column="2"
                                             Value="{Binding MarkerSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                             Minimum="0" Maximum="20"
                                             local:InspectorAssist.Unit="pt"
                                             ToolTip="{Binding [marker_size],Source={x:Static lg:LanguageService.Instance}}"
                                             Style="{StaticResource InspectorNumericUpDownStyle}"/>
                    </Grid>
                </local:InspectorGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
