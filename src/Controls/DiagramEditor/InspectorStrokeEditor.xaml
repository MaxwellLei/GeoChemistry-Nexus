<UserControl x:Class="GeoChemistryNexus.Controls.InspectorStrokeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="32" d:DesignWidth="280">
    <UserControl.Resources>
        <cvs:EnumToDisplayStringConverter x:Key="EnumToDisplayStringConverter"/>
        <cvs:EnumTypeToValuesConverter x:Key="EnumTypeToValuesConverter"/>
        <cvs:LineTypeToStrokeDashArrayConverter x:Key="LineTypeToStrokeDashArrayConverter"/>
    </UserControl.Resources>
    <!-- 描边复合控件：[颜色 34] [宽 82] [线型 *]（ShowLineStyle=False 时线型隐藏，宽度占满） -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition x:Name="WidthColumn" Width="82"/>
            <ColumnDefinition x:Name="GapColumn" Width="6"/>
            <ColumnDefinition x:Name="StyleColumn" Width="*"/>
        </Grid.ColumnDefinitions>

        <local:TextPropertyColorPicker Grid.Column="0" ShowHexText="False"
                                       ToolTip="{Binding [insp_stroke_color], Source={x:Static lg:LanguageService.Instance}}"
                                       SelectedColor="{Binding StrokeColor, ElementName=Root, Mode=TwoWay}"/>

        <local:NumericUpDown Grid.Column="2"
                             Value="{Binding StrokeWidth, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Minimum="{Binding MinStrokeWidth, ElementName=Root}"
                             Increment="0.5"
                             local:ControlAssist.Title="{Binding [insp_stroke_w], Source={x:Static lg:LanguageService.Instance}}"
                             ToolTip="{Binding [insp_stroke_width], Source={x:Static lg:LanguageService.Instance}}"
                             Style="{StaticResource InspectorNumericUpDownStyle}"/>

        <ComboBox x:Name="LineStyleCombo" Grid.Column="4"
                  ItemsSource="{Binding Source={x:Type models:LineDefinition+LineType}, Converter={StaticResource EnumTypeToValuesConverter}}"
                  SelectedItem="{Binding LineStyle, ElementName=Root, Mode=TwoWay}"
                  Style="{StaticResource InspectorComboBoxStyle}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Line X1="0" Y1="0" X2="52" Y2="0" Stroke="{StaticResource InspectorTextBrush}" StrokeThickness="2"
                              VerticalAlignment="Center" Margin="0,2,10,0"
                              StrokeDashArray="{Binding Converter={StaticResource LineTypeToStrokeDashArrayConverter}}"/>
                        <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayStringConverter}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
