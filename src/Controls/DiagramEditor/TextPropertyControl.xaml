<UserControl x:Class="GeoChemistryNexus.Controls.TextPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
        <cvs:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:TextPropertyControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe64b;" Title="{Binding [text],Source={x:Static lg:LanguageService.Instance}}">
            <local:InspectorHeader.Summary>
                <MultiBinding StringFormat="{}({0:0.##}, {1:0.##})">
                    <Binding Path="StartAndEnd.X"/>
                    <Binding Path="StartAndEnd.Y"/>
                </MultiBinding>
            </local:InspectorHeader.Summary>
        </local:InspectorHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,18" Grid.IsSharedSizeScope="True">

                <!-- 内容：多语言文本（左下角语言标记 + 右下角拖拽调高）/ 锚点 / 位置 -->
                <local:InspectorGroup Header="{Binding [content],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorStack Spacing="10">
                        <local:LocalizedStringControl Value="{Binding Content, Mode=TwoWay}"
                                                      TextBoxStyle="{StaticResource InspectorTextBoxStyle}"
                                                      ShowLanguageChip="True"
                                                      AllowVerticalResize="True"/>

                        <!-- 锚点：图标 + 文字 -->
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [alignment],Source={x:Static lg:LanguageService.Instance}}">
                            <Border Style="{StaticResource InspectorSegmentTrackStyle}">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource InspectorSegmentRadioStyle}" ToolTip="Left"
                                                 IsChecked="{Binding ContentHorizontalAlignment, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Left}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xe641;" FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding [insp_align_left],Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource InspectorSegmentRadioStyle}" ToolTip="Center"
                                                 IsChecked="{Binding ContentHorizontalAlignment, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Center}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xe627;" FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding [insp_align_center],Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource InspectorSegmentRadioStyle}" ToolTip="Right"
                                                 IsChecked="{Binding ContentHorizontalAlignment, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Right}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xe63c;" FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding [insp_align_right],Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </Border>
                        </HeaderedContentControl>

                        <!-- 位置：X / Y + 拾取 -->
                        <local:PointDefinitionControl Label="{Binding [location],Source={x:Static lg:LanguageService.Instance}}"
                                                      PointValue="{Binding StartAndEnd}"/>
                    </local:InspectorStack>
                </local:InspectorGroup>

                <!-- 字体：字体名 / 字号·B·I·颜色 / 旋转 -->
                <local:InspectorGroup Header="{Binding [font_style],Source={x:Static lg:LanguageService.Instance}}">
                    <local:InspectorStack Spacing="10">
                        <local:InspectorFontEditor
                            FontFamilyName="{Binding Family, Mode=TwoWay}"
                            PointSize="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                            IsBold="{Binding IsBold, Mode=TwoWay}"
                            IsItalic="{Binding IsItalic, Mode=TwoWay}"
                            FontColor="{Binding Color, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>

                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [font_rotation],Source={x:Static lg:LanguageService.Instance}}">
                            <local:InspectorSliderBox Minimum="-180" Maximum="180" Unit="°"
                                                      Value="{Binding Rotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"/>
                        </HeaderedContentControl>
                    </local:InspectorStack>
                </local:InspectorGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
