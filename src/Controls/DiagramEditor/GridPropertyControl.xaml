<UserControl x:Class="GeoChemistryNexus.Controls.GridPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
        <cvs:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:GridPropertyControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe67b;" Title="{Binding [grid],Source={x:Static lg:LanguageService.Instance}}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,18">

                <!-- 主网格线：开关在标题栏，内容为一行描边（颜色 / 宽 / 线型） -->
                <local:InspectorGroup Header="{Binding [major_grid_line],Source={x:Static lg:LanguageService.Instance}}"
                                      IsCollapsible="False"
                                      HasSwitch="True" SwitchMode="Dim"
                                      IsSwitchOn="{Binding MajorGridLineIsVisible, Mode=TwoWay}">
                    <local:InspectorStack Spacing="10">
                        <local:InspectorStrokeEditor
                            StrokeColor="{Binding MajorGridLineColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"
                            StrokeWidth="{Binding MajorGridLineWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                            LineStyle="{Binding MajorGridLinePattern, Mode=TwoWay}"/>
                        <!-- 方向：X（竖线）/ Y（横线） -->
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [grid_direction],Source={x:Static lg:LanguageService.Instance}}"
                                                Visibility="{Binding IsGridDirectionSupported, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding XMajorGridLineIsVisible, Mode=TwoWay}"
                                              ToolTip="{Binding [grid_x_direction_tip],Source={x:Static lg:LanguageService.Instance}}"
                                              Style="{StaticResource InspectorToggleButtonStyle}">
                                    <TextBlock Text="X" FontWeight="SemiBold" FontSize="13"/>
                                </ToggleButton>
                                <ToggleButton Margin="4,0,0,0" IsChecked="{Binding YMajorGridLineIsVisible, Mode=TwoWay}"
                                              ToolTip="{Binding [grid_y_direction_tip],Source={x:Static lg:LanguageService.Instance}}"
                                              Style="{StaticResource InspectorToggleButtonStyle}">
                                    <TextBlock Text="Y" FontWeight="SemiBold" FontSize="13"/>
                                </ToggleButton>
                            </StackPanel>
                        </HeaderedContentControl>
                    </local:InspectorStack>
                </local:InspectorGroup>

                <!-- 次网格线：仅在支持时出现 -->
                <local:InspectorGroup Header="{Binding [minor_grid_Line],Source={x:Static lg:LanguageService.Instance}}"
                                      IsCollapsible="False"
                                      HasSwitch="True" SwitchMode="Dim"
                                      IsSwitchOn="{Binding MinorGridLineIsVisible, Mode=TwoWay}"
                                      Visibility="{Binding IsMinorGridSupported, Converter={StaticResource BoolToVisibilityConverter}}">
                    <local:InspectorStack Spacing="10">
                        <local:InspectorStrokeEditor
                            StrokeColor="{Binding MinorGridLineColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"
                            StrokeWidth="{Binding MinorGridLineWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                            LineStyle="{Binding MinorGridLinePattern, Mode=TwoWay}"/>
                        <!-- 方向：X（竖线）/ Y（横线） -->
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="{Binding [grid_direction],Source={x:Static lg:LanguageService.Instance}}"
                                                Visibility="{Binding IsGridDirectionSupported, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding XMinorGridLineIsVisible, Mode=TwoWay}"
                                              ToolTip="{Binding [grid_x_direction_tip],Source={x:Static lg:LanguageService.Instance}}"
                                              Style="{StaticResource InspectorToggleButtonStyle}">
                                    <TextBlock Text="X" FontWeight="SemiBold" FontSize="13"/>
                                </ToggleButton>
                                <ToggleButton Margin="4,0,0,0" IsChecked="{Binding YMinorGridLineIsVisible, Mode=TwoWay}"
                                              ToolTip="{Binding [grid_y_direction_tip],Source={x:Static lg:LanguageService.Instance}}"
                                              Style="{StaticResource InspectorToggleButtonStyle}">
                                    <TextBlock Text="Y" FontWeight="SemiBold" FontSize="13"/>
                                </ToggleButton>
                            </StackPanel>
                        </HeaderedContentControl>
                    </local:InspectorStack>
                </local:InspectorGroup>

                <!-- 交替填充 / 背景填充：两种颜色并排，下方带条纹预览 -->
                <local:InspectorGroup IsCollapsible="False"
                                      HasSwitch="True" SwitchMode="Dim"
                                      IsSwitchOn="{Binding GridAlternateFillingIsEnable, Mode=TwoWay}">
                    <local:InspectorGroup.Header>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding [enable_alternating_fill],Source={x:Static lg:LanguageService.Instance}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlternatingFillSupported}" Value="False">
                                            <Setter Property="Text" Value="{Binding [background_fill],Source={x:Static lg:LanguageService.Instance}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </local:InspectorGroup.Header>

                    <local:InspectorStack Spacing="10">
                        <local:InspectorColumns Columns="0" Spacing="8">
                            <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}">
                                <HeaderedContentControl.Header>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding [fill_color_1],Source={x:Static lg:LanguageService.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlternatingFillSupported}" Value="False">
                                                        <Setter Property="Text" Value="{Binding [color],Source={x:Static lg:LanguageService.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HeaderedContentControl.Header>
                                <local:TextPropertyColorPicker SelectedColor="{Binding GridFillColor1, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                            </HeaderedContentControl>

                            <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                    Header="{Binding [fill_color_2],Source={x:Static lg:LanguageService.Instance}}"
                                                    Visibility="{Binding IsAlternatingFillSupported, Converter={StaticResource BoolToVisibilityConverter}}">
                                <local:TextPropertyColorPicker SelectedColor="{Binding GridFillColor2, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                            </HeaderedContentControl>
                        </local:InspectorColumns>

                        <!-- 条纹预览 -->
                        <Border Height="14" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource InspectorControlBorderBrush}"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding IsAlternatingFillSupported, Converter={StaticResource BoolToVisibilityConverter}}">
                            <UniformGrid Rows="1" Columns="5">
                                <Border Background="{Binding GridFillColor1}"/>
                                <Border Background="{Binding GridFillColor2}"/>
                                <Border Background="{Binding GridFillColor1}"/>
                                <Border Background="{Binding GridFillColor2}"/>
                                <Border Background="{Binding GridFillColor1}"/>
                            </UniformGrid>
                        </Border>
                    </local:InspectorStack>
                </local:InspectorGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
