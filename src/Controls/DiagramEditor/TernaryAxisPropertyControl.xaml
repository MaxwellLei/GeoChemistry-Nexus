<UserControl x:Class="GeoChemistryNexus.Controls.TernaryAxisPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:models="clr-namespace:GeoChemistryNexus.Models"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
        <cvs:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:TernaryAxisPropertyControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:InspectorHeader Glyph="&#xe67a;"
                               Title="{Binding [axes],Source={x:Static lg:LanguageService.Instance}}"/>

        <!-- 页签：标题 / 刻度。刻度页收纳轴线、刻度和刻度标签 -->
        <Border Grid.Row="1" Style="{StaticResource InspectorTabBarStyle}">
            <local:InspectorColumns Spacing="0">
                <RadioButton x:Name="TabTitle" GroupName="TernaryAxisTabs" IsChecked="True"
                             Style="{StaticResource InspectorTabRadioStyle}"
                             Content="{Binding [axis_tab_title],Source={x:Static lg:LanguageService.Instance}}"/>
                <RadioButton x:Name="TabTicks" GroupName="TernaryAxisTabs"
                             Style="{StaticResource InspectorTabRadioStyle}"
                             Content="{Binding [axis_tab_ticks],Source={x:Static lg:LanguageService.Instance}}"/>
            </local:InspectorColumns>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,18" Grid.IsSharedSizeScope="True">

                <!-- ============ 标题 ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=TabTitle, Converter={StaticResource BoolToVisibility}}">
                    <local:InspectorGroup Header="{Binding [axis_title],Source={x:Static lg:LanguageService.Instance}}">
                        <local:InspectorStack Spacing="8">
                            <local:LocalizedStringControl Value="{Binding Label, Mode=TwoWay}"
                                                          TextBoxStyle="{StaticResource InspectorTextBoxStyle}"
                                                          IsSingleLine="True"
                                                          ShowLanguageChip="True"/>
                            <local:InspectorFontEditor
                                FontFamilyName="{Binding Family, Mode=TwoWay}"
                                PointSize="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                IsBold="{Binding IsBold, Mode=TwoWay}"
                                IsItalic="{Binding IsItalic, Mode=TwoWay}"
                                FontColor="{Binding Color, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>

                            <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                    Header="{Binding [offset],Source={x:Static lg:LanguageService.Instance}}">
                                <local:InspectorColumns Columns="2" Spacing="6">
                                    <local:NumericUpDown Value="{Binding LabelOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         local:ControlAssist.Title="X"
                                                         ToolTip="{Binding [offset_x],Source={x:Static lg:LanguageService.Instance}}"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                    <local:NumericUpDown Value="{Binding LabelOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         local:ControlAssist.Title="Y"
                                                         ToolTip="{Binding [offset_y],Source={x:Static lg:LanguageService.Instance}}"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                </local:InspectorColumns>
                            </HeaderedContentControl>
                        </local:InspectorStack>
                    </local:InspectorGroup>

                    <local:InspectorGroup Header="{Binding [subtitle],Source={x:Static lg:LanguageService.Instance}}">
                        <local:InspectorStack Spacing="8">
                            <local:LocalizedStringControl Value="{Binding SubLabel, Mode=TwoWay}"
                                                          TextBoxStyle="{StaticResource InspectorTextBoxStyle}"
                                                          IsSingleLine="True"
                                                          ShowLanguageChip="True"/>
                            <local:InspectorFontEditor ShowFamily="False"
                                PointSize="{Binding SubLabelSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                IsBold="{Binding SubLabelBold, Mode=TwoWay}"
                                IsItalic="{Binding SubLabelItalic, Mode=TwoWay}"
                                FontColor="{Binding SubLabelColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                            <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                    Header="{Binding [offset],Source={x:Static lg:LanguageService.Instance}}">
                                <local:InspectorColumns Columns="2" Spacing="6">
                                    <local:NumericUpDown Value="{Binding SubLabelOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         local:ControlAssist.Title="X"
                                                         ToolTip="{Binding [offset_x],Source={x:Static lg:LanguageService.Instance}}"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                    <local:NumericUpDown Value="{Binding SubLabelOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         local:ControlAssist.Title="Y"
                                                         ToolTip="{Binding [offset_y],Source={x:Static lg:LanguageService.Instance}}"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                </local:InspectorColumns>
                            </HeaderedContentControl>
                        </local:InspectorStack>
                    </local:InspectorGroup>
                </StackPanel>

                <!-- ============ 刻度 ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=TabTicks, Converter={StaticResource BoolToVisibility}}">
                    <local:InspectorGroup Header="{Binding [axis_line],Source={x:Static lg:LanguageService.Instance}}">
                        <local:InspectorStack Spacing="8">
                            <local:InspectorColumns Columns="2" Spacing="8">
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [width],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:NumericUpDown Value="{Binding AxisLineWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         Increment="0.5"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [color],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:TextPropertyColorPicker ShowHexText="False"
                                                                   SelectedColor="{Binding AxisLineColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                                </HeaderedContentControl>
                            </local:InspectorColumns>
                        </local:InspectorStack>
                    </local:InspectorGroup>

                    <local:InspectorGroup Header="{Binding [axis_tab_ticks],Source={x:Static lg:LanguageService.Instance}}"
                                          IsCollapsible="False"
                                          HasSwitch="True" SwitchMode="Dim"
                                          IsSwitchOn="{Binding IsShowMajorTicks, Mode=TwoWay}">
                        <local:InspectorStack Spacing="10">
                            <local:InspectorColumns Columns="3" Spacing="8">
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [length],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:NumericUpDown Value="{Binding TickLength, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [width],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:NumericUpDown Value="{Binding TickWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                         Increment="0.5"
                                                         Style="{StaticResource InspectorNumericUpDownStyle}"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                        Header="{Binding [color],Source={x:Static lg:LanguageService.Instance}}">
                                    <local:TextPropertyColorPicker ShowHexText="False"
                                                                   SelectedColor="{Binding MajorTickWidthColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                                </HeaderedContentControl>
                            </local:InspectorColumns>

                            <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                    Header="{Binding [tick_step],Source={x:Static lg:LanguageService.Instance}}">
                                <local:NumericUpDown Value="{Binding TickStep, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                     Style="{StaticResource InspectorNumericUpDownStyle}"/>
                            </HeaderedContentControl>

                            <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                    Header="{Binding [tick_value],Source={x:Static lg:LanguageService.Instance}}">
                                <Border Style="{StaticResource InspectorSegmentTrackStyle}">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource InspectorSegmentRadioStyle}"
                                                     Content="{Binding [tick_fraction],Source={x:Static lg:LanguageService.Instance}}"
                                                     IsChecked="{Binding TickValueMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Fraction}"/>
                                        <RadioButton Style="{StaticResource InspectorSegmentRadioStyle}"
                                                     Content="{Binding [tick_percent],Source={x:Static lg:LanguageService.Instance}}"
                                                     IsChecked="{Binding TickValueMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Percent}"/>
                                    </UniformGrid>
                                </Border>
                            </HeaderedContentControl>
                        </local:InspectorStack>
                    </local:InspectorGroup>

                    <local:InspectorGroup Header="{Binding [tick_labels],Source={x:Static lg:LanguageService.Instance}}"
                                          IsCollapsible="False"
                                          HasSwitch="True" SwitchMode="Dim"
                                          IsSwitchOn="{Binding IsShowTickLabels, Mode=TwoWay}">
                        <local:InspectorStack Spacing="8">
                            <local:InspectorFontEditor
                                FontFamilyName="{Binding TickLableFamily, Mode=TwoWay}"
                                PointSize="{Binding TickLablesize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                IsBold="{Binding TickLableisBold, Mode=TwoWay}"
                                IsItalic="{Binding TickLableisItalic, Mode=TwoWay}"
                                FontColor="{Binding TickLablecolor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}"/>
                            <HeaderedContentControl Style="{StaticResource InspectorFieldStyle}"
                                                    Header="{Binding [label_spacing],Source={x:Static lg:LanguageService.Instance}}">
                                <local:NumericUpDown Value="{Binding TickLabelGap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}"
                                                     Style="{StaticResource InspectorNumericUpDownStyle}"/>
                            </HeaderedContentControl>
                        </local:InspectorStack>
                    </local:InspectorGroup>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
