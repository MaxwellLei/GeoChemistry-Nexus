<UserControl x:Class="GeoChemistryNexus.Controls.SpiderAxisPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="300"
             Background="#F5F5F7">
    <UserControl.Resources>
        <cvs:StringColorConverter x:Key="StringColorConverter"/>
        <cvs:NumericTypeConverter x:Key="NumericTypeConverter"/>
        <cvs:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid DataContext="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=local:SpiderAxisPropertyControl}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
                <!-- 坐标轴标题 -->
                <TextBlock Text="{Binding [axis_title],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Axis Title'}" 
                           Style="{StaticResource ModernSettingsGroupTitle}" Margin="4,10,0,6"/>
                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,8">
                    <StackPanel Margin="10">
                        <!-- Content -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [content],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Content'}" 
                                       Style="{StaticResource ModernLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="28" FontSize="13" Padding="6,3" VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- Font Family -->
                        <TextBlock Text="{Binding [font_family],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Font Family'}" 
                                   Style="{StaticResource ModernLabelStyle}"/>
                        <local:FontFamilyControl FontFamilyName="{Binding Family, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <!-- Font Size & Color -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [font_size],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Font Size'}" 
                                           Style="{StaticResource ModernLabelStyle}"/>
                                <hc:NumericUpDown Value="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}" 
                                                  Minimum="8" Maximum="36" Increment="1" 
                                                  Style="{StaticResource ModernNumericUpDownStyle}" Height="28"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [font_color],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Font Color'}" 
                                           Style="{StaticResource ModernLabelStyle}"/>
                                <local:TextPropertyColorPicker SelectedColor="{Binding Color, Mode=TwoWay, Converter={StaticResource StringColorConverter}}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bold & Italic -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" IsChecked="{Binding IsBold, Mode=TwoWay}" Style="{StaticResource FontStyleToggleButtonStyle}"
                                          ToolTip="{Binding [bold],Source={x:Static lg:LanguageService.Instance}}">
                                <TextBlock Text="B" FontWeight="Bold"/>
                            </ToggleButton>

                            <ToggleButton Grid.Column="2" IsChecked="{Binding IsItalic, Mode=TwoWay}" Style="{StaticResource FontStyleToggleButtonStyle}"
                                          ToolTip="{Binding [italic],Source={x:Static lg:LanguageService.Instance}}">
                                <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontFamily="Times New Roman"/>
                            </ToggleButton>
                        </Grid>

                        <!-- Subtitle Configuration (collapsed by default) -->
                        <ToggleButton x:Name="SubtitleSectionToggle"
                                      Style="{StaticResource PropertySectionHeaderToggleStyle}"
                                      Margin="0,0,0,8">
                            <TextBlock Text="{Binding [subtitle],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Subtitle'}"
                                       Style="{StaticResource ModernLabelStyle}"
                                       Margin="0"/>
                        </ToggleButton>

                        <StackPanel Visibility="{Binding IsChecked, ElementName=SubtitleSectionToggle, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBox Text="{Binding SubLabel, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="28" FontSize="13" Padding="6,3" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [subtitle_font_size],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Subtitle Size'}" 
                                               Style="{StaticResource ModernLabelStyle}"/>
                                    <hc:NumericUpDown Value="{Binding SubLabelSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}" 
                                                      Minimum="8" Maximum="36" Increment="1"
                                                      Style="{StaticResource ModernNumericUpDownStyle}" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [subtitle_color],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Subtitle Color'}" 
                                               Style="{StaticResource ModernLabelStyle}"/>
                                    <local:TextPropertyColorPicker SelectedColor="{Binding SubLabelColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="0" IsChecked="{Binding SubLabelBold, Mode=TwoWay}" Style="{StaticResource FontStyleToggleButtonStyle}"
                                              ToolTip="{Binding [subtitle_bold],Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock Text="B" FontWeight="Bold"/>
                                </ToggleButton>

                                <ToggleButton Grid.Column="2" IsChecked="{Binding SubLabelItalic, Mode=TwoWay}" Style="{StaticResource FontStyleToggleButtonStyle}"
                                              ToolTip="{Binding [subtitle_italic],Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontFamily="Times New Roman"/>
                                </ToggleButton>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 刻度标签 -->
                <TextBlock Text="{Binding [tick_labels],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Tick Labels'}" 
                           Style="{StaticResource ModernSettingsGroupTitle}" Margin="4,10,0,6"/>
                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,8">
                    <StackPanel Margin="10">
                        <!-- Font Family -->
                        <TextBlock Text="{Binding [font_family],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Font Family'}" 
                                   Style="{StaticResource ModernLabelStyle}"/>
                        <local:FontFamilyControl FontFamilyName="{Binding TickFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <!-- Font Size & Color -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [font_size],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Font Size'}" 
                                           Style="{StaticResource ModernLabelStyle}"/>
                                <hc:NumericUpDown Value="{Binding TickFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NumericTypeConverter}}" 
                                                  Minimum="6" Maximum="24" Increment="1" 
                                                  Style="{StaticResource ModernNumericUpDownStyle}" Height="28"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [font_color],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Font Color'}" 
                                           Style="{StaticResource ModernLabelStyle}"/>
                                <local:TextPropertyColorPicker SelectedColor="{Binding TickColor, Mode=TwoWay, Converter={StaticResource StringColorConverter}}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bold & Italic -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" IsChecked="{Binding TickIsBold, Mode=TwoWay}" Style="{StaticResource FontStyleToggleButtonStyle}"
                                          ToolTip="{Binding [bold],Source={x:Static lg:LanguageService.Instance}}">
                                <TextBlock Text="B" FontWeight="Bold"/>
                            </ToggleButton>

                            <ToggleButton Grid.Column="2" IsChecked="{Binding TickIsItalic, Mode=TwoWay}" Style="{StaticResource FontStyleToggleButtonStyle}"
                                          ToolTip="{Binding [italic],Source={x:Static lg:LanguageService.Instance}}">
                                <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontFamily="Times New Roman"/>
                            </ToggleButton>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
