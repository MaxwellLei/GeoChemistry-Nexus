<UserControl x:Class="GeoChemistryNexus.Controls.PersonalDiagramIllustration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             SnapsToDevicePixels="False">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="ReeAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource ThemeArtStrongA38Color}" Offset="0"/>
            <GradientStop Color="{DynamicResource ThemeArtStrongA00Color}" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ReeLineBrush" MappingMode="Absolute" StartPoint="68,72" EndPoint="238,125">
            <GradientStop Color="{DynamicResource ThemeArtStrongColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource ThemeArtDarkColor}" Offset="0.55"/>
            <GradientStop Color="{DynamicResource ThemeArtLighterColor}" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="GlowBrush">
            <GradientStop Color="{DynamicResource ThemeArtStrongA14Color}" Offset="0"/>
            <GradientStop Color="{DynamicResource ThemeArtStrongA00Color}" Offset="1"/>
        </RadialGradientBrush>
        <DropShadowEffect x:Key="CardShadow" Color="#0F172A" Opacity="0.07" BlurRadius="12" ShadowDepth="8" Direction="270"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- 整体悬浮 -->
                    <DoubleAnimation Storyboard.TargetName="FloatTranslate" Storyboard.TargetProperty="Y"
                                     From="0" To="-8" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 稀土配分曲线绘制 -->
                    <DoubleAnimation Storyboard.TargetName="ReeCurve" Storyboard.TargetProperty="StrokeDashOffset"
                                     From="90" To="0" Duration="0:0:2.2" FillBehavior="HoldEnd">
                        <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Eu 异常脉冲 -->
                    <DoubleAnimation Storyboard.TargetName="EuPulseScale" Storyboard.TargetProperty="ScaleX"
                                     From="0.8" To="2.2" Duration="0:0:2.4" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="EuPulseScale" Storyboard.TargetProperty="ScaleY"
                                     From="0.8" To="2.2" Duration="0:0:2.4" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="EuPulse" Storyboard.TargetProperty="Opacity"
                                     From="0.6" To="0" Duration="0:0:2.4" RepeatBehavior="Forever"/>

                    <!-- 散点闪烁 -->
                    <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                     From="0.35" To="0.95" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                     From="0.35" To="0.95" Duration="0:0:3.2" BeginTime="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                     From="0.35" To="0.95" Duration="0:0:3.2" BeginTime="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Dot4" Storyboard.TargetProperty="Opacity"
                                     From="0.35" To="0.95" Duration="0:0:3.2" BeginTime="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever"/>

                    <!-- 新建徽章悬浮 -->
                    <DoubleAnimation Storyboard.TargetName="BadgeTranslate" Storyboard.TargetProperty="Y"
                                     From="0" To="-5" Duration="0:0:1.75" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Viewbox Stretch="Uniform">
        <Canvas Width="300" Height="220">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="FloatTranslate"/>
            </Canvas.RenderTransform>

            <!-- 背景光晕 -->
            <Ellipse Canvas.Left="15" Canvas.Top="30" Width="270" Height="170" Fill="{StaticResource GlowBrush}"/>

            <!-- 后景卡片 -->
            <Rectangle Canvas.Left="28" Canvas.Top="38" Width="190" Height="130" RadiusX="10" RadiusY="10"
                       Fill="White" Opacity="0.65" Stroke="#E2E8F0" StrokeThickness="1">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="-4" CenterX="28" CenterY="38"/>
                </Rectangle.RenderTransform>
            </Rectangle>

            <!-- 主卡片 -->
            <Rectangle Canvas.Left="38" Canvas.Top="24" Width="224" Height="158" RadiusX="12" RadiusY="12"
                       Fill="White" Stroke="#E2E8F0" StrokeThickness="1.2" Effect="{StaticResource CardShadow}"/>
            <Line X1="38" Y1="48" X2="262" Y2="48" Stroke="#F1F5F9" StrokeThickness="1.2"/>
            <Ellipse Canvas.Left="50.5" Canvas.Top="32.5" Width="7" Height="7" Fill="#CBD5E1"/>
            <Ellipse Canvas.Left="61.5" Canvas.Top="32.5" Width="7" Height="7" Fill="#E2E8F0"/>
            <Ellipse Canvas.Left="72.5" Canvas.Top="32.5" Width="7" Height="7" Fill="#E2E8F0"/>
            <Rectangle Canvas.Left="198" Canvas.Top="32" Width="48" Height="8" RadiusX="4" RadiusY="4" Fill="#F1F5F9"/>

            <!-- 网格 -->
            <Path Data="M62,74 H244 M62,100 H244 M62,126 H244 M88,62 V152 M122,62 V152 M156,62 V152 M190,62 V152 M224,62 V152"
                  Stroke="#F1F5F9" StrokeThickness="1" StrokeDashArray="3 3"/>

            <!-- 坐标轴 -->
            <Path Data="M62,60 V152 H246" Stroke="#CBD5E1" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

            <!-- 横轴刻度 -->
            <Rectangle Canvas.Left="66" Canvas.Top="159" Width="12" Height="4" RadiusX="2" RadiusY="2" Fill="#CBD5E1"/>
            <Rectangle Canvas.Left="108" Canvas.Top="159" Width="12" Height="4" RadiusX="2" RadiusY="2" Fill="#E2E8F0"/>
            <Rectangle Canvas.Left="150" Canvas.Top="159" Width="12" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource ThemeArtMistBrush}"/>
            <Rectangle Canvas.Left="192" Canvas.Top="159" Width="12" Height="4" RadiusX="2" RadiusY="2" Fill="#E2E8F0"/>
            <Rectangle Canvas.Left="230" Canvas.Top="159" Width="12" Height="4" RadiusX="2" RadiusY="2" Fill="#CBD5E1"/>

            <!-- 散点 -->
            <Ellipse Canvas.Left="79" Canvas.Top="131" Width="6" Height="6" Fill="{DynamicResource ThemeArtMistBrush}" Opacity="0.6"/>
            <Ellipse x:Name="Dot1" Canvas.Left="100.5" Canvas.Top="116.5" Width="7" Height="7" Fill="{DynamicResource ThemeArtLighterBrush}" Opacity="0.35"/>
            <Ellipse Canvas.Left="113.75" Canvas.Top="136.75" Width="5" Height="5" Fill="#CBD5E1" Opacity="0.6"/>
            <Ellipse x:Name="Dot2" Canvas.Left="135" Canvas.Top="109" Width="6" Height="6" Fill="{DynamicResource ThemeArtMistBrush}" Opacity="0.35"/>
            <Ellipse x:Name="Dot3" Canvas.Left="171.5" Canvas.Top="92.5" Width="7" Height="7" Fill="{DynamicResource ThemeArtLighterBrush}" Opacity="0.35"/>
            <Ellipse x:Name="Dot4" Canvas.Left="201" Canvas.Top="85" Width="6" Height="6" Fill="{DynamicResource ThemeArtMistBrush}" Opacity="0.35"/>
            <Ellipse Canvas.Left="215.75" Canvas.Top="102.75" Width="5" Height="5" Fill="#CBD5E1" Opacity="0.6"/>

            <!-- 对比曲线 -->
            <Path Data="M68,92 L95,98 L122,106 L142,110 L156,120 L172,112 L205,122 L238,130"
                  Stroke="#CBD5E1" StrokeThickness="1.5" StrokeDashArray="2.667 2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

            <!-- 曲线下方渐变 -->
            <Path Data="M68,72 L95,80 L122,92 L140,98 L156,128 L172,104 L205,116 L238,125 L238,152 L68,152 Z"
                  Fill="{StaticResource ReeAreaBrush}"/>

            <!-- 主曲线（描绘动画） -->
            <Path x:Name="ReeCurve"
                  Data="M68,72 L95,80 L122,92 L140,98 L156,128 L172,104 L205,116 L238,125"
                  Stroke="{StaticResource ReeLineBrush}" StrokeThickness="2.6"
                  StrokeDashArray="90 90" StrokeDashOffset="90"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

            <!-- 数据节点 -->
            <Ellipse Canvas.Left="64.8" Canvas.Top="68.8" Width="6.4" Height="6.4" Fill="White" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="2"/>
            <Ellipse Canvas.Left="91.8" Canvas.Top="76.8" Width="6.4" Height="6.4" Fill="White" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="2"/>
            <Ellipse Canvas.Left="118.8" Canvas.Top="88.8" Width="6.4" Height="6.4" Fill="White" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="2"/>
            <Ellipse Canvas.Left="136.8" Canvas.Top="94.8" Width="6.4" Height="6.4" Fill="White" Stroke="{DynamicResource ThemeArtDarkBrush}" StrokeThickness="2"/>

            <!-- Eu 异常脉冲节点 -->
            <Ellipse x:Name="EuPulse" Canvas.Left="149" Canvas.Top="121" Width="14" Height="14"
                     Fill="{DynamicResource ThemeArtStrongBrush}" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="EuPulseScale" ScaleX="0.8" ScaleY="0.8"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="151.8" Canvas.Top="123.8" Width="8.4" Height="8.4" Fill="{DynamicResource ThemeArtStrongBrush}" Stroke="White" StrokeThickness="1.8"/>

            <Ellipse Canvas.Left="168.8" Canvas.Top="100.8" Width="6.4" Height="6.4" Fill="White" Stroke="{DynamicResource ThemeArtDarkBrush}" StrokeThickness="2"/>
            <Ellipse Canvas.Left="201.8" Canvas.Top="112.8" Width="6.4" Height="6.4" Fill="White" Stroke="{DynamicResource ThemeArtDarkBrush}" StrokeThickness="2"/>
            <Ellipse Canvas.Left="234.8" Canvas.Top="121.8" Width="6.4" Height="6.4" Fill="White" Stroke="{DynamicResource ThemeArtLighterBrush}" StrokeThickness="2"/>

            <!-- 新建徽章 -->
            <Canvas>
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="BadgeTranslate"/>
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="234" Canvas.Top="150" Width="36" Height="36" Fill="{DynamicResource ThemeArtStrongBrush}" Stroke="White" StrokeThickness="3"/>
                <Path Data="M252,161 V175 M245,168 H259" Stroke="White" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
