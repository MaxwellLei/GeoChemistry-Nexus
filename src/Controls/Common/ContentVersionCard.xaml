<UserControl x:Class="GeoChemistryNexus.Controls.ContentVersionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="720">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GeoChemistryNexus;component/Themes/EditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cvs:BorderClipConverter x:Key="RoundedClip"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource GeoTSectionHeading}" Margin="4,16,0,10"
                   Text="{Binding [geo_field_version], Source={x:Static lg:LanguageService.Instance}, FallbackValue=版本}"/>
        <Border x:Name="VersionCard" Style="{StaticResource GeoTSectionCard}">
            <DockPanel>
                <DockPanel.Clip>
                    <MultiBinding Converter="{StaticResource RoundedClip}">
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="CornerRadius" ElementName="VersionCard"/>
                        <Binding Path="BorderThickness" ElementName="VersionCard"/>
                    </MultiBinding>
                </DockPanel.Clip>
                <Border DockPanel.Dock="Bottom" Background="#F5F7FA" BorderBrush="#E5E5EA" BorderThickness="0,1,0,0" Padding="16,10">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="#4E5D70"
                                   Text="{Binding [diagram_editor_saved_version], Source={x:Static lg:LanguageService.Instance}, FallbackValue=保存后版本：}"/>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#263549"
                                   Text="{Binding SavedVersionText, Mode=OneWay}"/>
                    </DockPanel>
                </Border>
                <Grid MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="16,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource GeoTSectionHeading}" VerticalAlignment="Center"
                                   Text="{Binding [diagram_editor_format_baseline], Source={x:Static lg:LanguageService.Instance}, FallbackValue=格式基线}"/>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#263549"
                                   Text="{Binding FormatVersionBaseline, Mode=OneWay}"/>
                    </DockPanel>
                    <Border Grid.Column="1" BorderBrush="#E5E5EA" BorderThickness="1,0,0,0">
                        <DockPanel Margin="16,8" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource GeoTSectionHeading}" VerticalAlignment="Center"
                                       Text="{Binding [diagram_editor_content_patch], Source={x:Static lg:LanguageService.Instance}, FallbackValue=内容修订}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ContentVersionStepButton}"
                                        Command="{Binding DecreasePatchCommand}"
                                        Content="−"
                                        AutomationProperties.Name="{Binding [diagram_editor_decrease_patch], Source={x:Static lg:LanguageService.Instance}, FallbackValue=减少修订号}"/>
                                <TextBox Style="{StaticResource ContentVersionPatchBox}"
                                         Text="{Binding PatchVersion, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding [geo_tooltip_version_patch], Source={x:Static lg:LanguageService.Instance}, FallbackValue=修订号 z；格式基线 x.y 跟随程序版本}"/>
                                <Button Style="{StaticResource ContentVersionStepButton}"
                                        Command="{Binding IncreasePatchCommand}"
                                        Content="+"
                                        AutomationProperties.Name="{Binding [diagram_editor_increase_patch], Source={x:Static lg:LanguageService.Instance}, FallbackValue=增加修订号}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
