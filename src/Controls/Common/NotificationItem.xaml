<UserControl x:Class="GeoChemistryNexus.Controls.NotificationItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:GeoChemistryNexus.ViewModels"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:helpers="clr-namespace:GeoChemistryNexus.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NotificationViewModel}"
             d:DesignHeight="90" d:DesignWidth="372"
             Margin="16,4,16,6"
             Opacity="0"
             RenderTransformOrigin="1,0"
             PreviewMouseDown="OnPreviewMouseDown">

    <!--
        Toast 卡片：状态反馈（信息 / 成功 / 警告 / 错误）与进度任务。
        交互确认类（确认 / 三按钮 / 单选）由 NotificationSheet 以居中 Sheet 呈现。
    -->
    <UserControl.Resources>
        <!-- 进场：右侧滑入 + 渐显（0.3s） -->
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="100" To="0" Duration="0:0:0.3" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 退场：向右滑出 + 渐隐（0.32s），滑出距离需完全移出右侧边缘 -->
        <Storyboard x:Key="SlideOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="430" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseIn" Amplitude="0.4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 复制按钮图标：已复制后切换为对勾 -->
        <Style x:Key="CopyIconPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource NotificationMessageBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Data" Value="M11 9 H20 A2 2 0 0 1 22 11 V20 A2 2 0 0 1 20 22 H11 A2 2 0 0 1 9 20 V11 A2 2 0 0 1 11 9 Z M5 15 H4 A2 2 0 0 1 2 13 V4 A2 2 0 0 1 4 2 H13 A2 2 0 0 1 15 4 V5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource NotificationSuccessAccentBrush}"/>
                    <Setter Property="StrokeThickness" Value="2.6"/>
                    <Setter Property="Data" Value="M5 13 L9 17 L19 7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            操作区按需实例化：每张卡片只创建自己需要的那一块（复制栏 / 进度条 / 操作按钮），
            不为隐藏部分创建控件，降低弹出瞬间的卡顿。
        -->
        <DataTemplate x:Key="EmptyActionTemplate">
            <Grid/>
        </DataTemplate>

        <!-- 警告 / 错误：诊断码 + 一键复制 -->
        <DataTemplate x:Key="CopyBarTemplate">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CodeLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                           Foreground="{DynamicResource NotificationMutedBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Command="{Binding CopyCommand}"
                        Style="{StaticResource NotificationCopyChipStyle}"
                        ToolTip="{Binding [copy_content], Source={x:Static lg:LanguageService.Instance}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="10" Height="10" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource CopyIconPathStyle}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding [copy_content], Source={x:Static lg:LanguageService.Instance}}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- 进度任务：说明文字 + 百分比 + 进度条 -->
        <DataTemplate x:Key="ProgressBarTemplate">
            <StackPanel Margin="0,9,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProgressDetail}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                               Foreground="{DynamicResource NotificationMutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding TaskProgressText}" Margin="8,0,0,0"
                               FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource NotificationProgressTextBrush}"/>
                </Grid>
                <Border Height="5" Margin="0,6,0,0" CornerRadius="3" Background="{DynamicResource NotificationDividerBrush}">
                    <Border Style="{StaticResource NotificationTaskBarFillStyle}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding TaskProgress}"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 操作按钮行（撤销 / 查看 / 取消） -->
        <DataTemplate x:Key="ActionsRowTemplate">
            <ItemsControl Margin="0,8,0,0" Focusable="False" ItemsSource="{Binding Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Text}"
                                Style="{StaticResource NotificationActionLinkStyle}"
                                Command="{Binding DataContext.InvokeActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- 主体操作区：按卡片形态选择模板 -->
        <Style x:Key="ActionAreaStyle" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="ContentTemplate" Value="{StaticResource EmptyActionTemplate}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowCopyBar}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource CopyBarTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowProgressBar}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource ProgressBarTemplate}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 操作按钮区：仅有操作按钮时实例化 -->
        <Style x:Key="ActionsRowStyle" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="ContentTemplate" Value="{StaticResource EmptyActionTemplate}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowActions}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource ActionsRowTemplate}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.LayoutTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </UserControl.LayoutTransform>

    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClosing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource SlideOut}"/>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SlideIn}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <!-- 悬停时暂停自动关闭倒计时 -->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseEnter">
            <i:CallMethodAction TargetObject="{Binding}" MethodName="PauseAutoClose"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="MouseLeave">
            <i:CallMethodAction TargetObject="{Binding}" MethodName="ResumeAutoClose"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <!-- 两层阴影（衬底投射，位于卡片之下） -->
        <Border Style="{StaticResource NotificationShadowAmbientStyle}"/>
        <Border Style="{StaticResource NotificationShadowContactStyle}"/>

        <!-- 白色卡片 -->
        <Border Style="{StaticResource NotificationCardStyle}">
            <Grid>
                <Grid Margin="12,11,12,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 淡色圆形语义图标 -->
                    <Border Style="{StaticResource NotificationSoftBadgeStyle}" Margin="0,0,10,0">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource NotificationSoftIconPathStyle}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <!-- 标题行：标题 + 时间戳 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontSize="12.5"
                                       Style="{StaticResource NotificationTitleTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Margin="8,0,0,0"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                       Style="{StaticResource NotificationMutedTextStyle}"/>
                        </Grid>

                        <!-- 消息正文：最多 3 行，完整内容可通过“复制”或通知中心查看 -->
                        <TextBlock Text="{Binding Message}" Margin="0,2,0,0" LineHeight="17" MaxHeight="51"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource NotificationMessageTextStyle}"/>

                        <!-- 按形态实例化的操作区 -->
                        <ContentControl Content="{Binding}" Style="{StaticResource ActionAreaStyle}"/>
                        <ContentControl Content="{Binding}" Style="{StaticResource ActionsRowStyle}"/>
                    </StackPanel>

                    <!-- 右上角关闭按钮（进度任务不显示，需通过“取消”结束） -->
                    <Button Grid.Column="2" Margin="8,0,-4,0" VerticalAlignment="Top"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource NotificationCloseButtonStyle}"
                            ToolTip="{Binding [shortcut_action_close_notification_name], Source={x:Static lg:LanguageService.Instance}}"
                            Visibility="{Binding ShowCloseButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- 自动关闭倒计时细进度条 -->
                <Border VerticalAlignment="Bottom" Height="2" Margin="14,0"
                        CornerRadius="1" Background="{StaticResource NotificationTimerTrackBrush}"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasTimer, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border CornerRadius="1" Background="{DynamicResource NotificationTimerBarBrush}"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Progress}"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
