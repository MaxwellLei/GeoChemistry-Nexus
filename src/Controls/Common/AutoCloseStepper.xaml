<UserControl x:Class="GeoChemistryNexus.Controls.AutoCloseStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root"
             Focusable="False"
             d:DesignHeight="30" d:DesignWidth="130">
    <!-- 自动关闭时间步进器：计时环（填充比例 = 当前秒数 / 最大秒数）+ [ − 数值 秒 + ]。
         高度与设置页其它下拉框（30）保持一致；按钮样式见 Themes/Styles.xaml（AutoCloseStepperButtonStyle）；数值由 Seconds（双向）提供。 -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- 计时环 -->
        <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse Width="18" Height="18" Stroke="#E8EAF3" StrokeThickness="2"/>
            <Ellipse x:Name="RingFill" Width="18" Height="18"
                     Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="2"
                     StrokeDashCap="Round"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- 步进器 -->
        <Border Height="30" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4"
                Background="{StaticResource AppRegionBrush}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="DecreaseButton" Grid.Column="0" Content="&#x2212;"
                        Style="{StaticResource AutoCloseStepperButtonStyle}"
                        Click="OnDecreaseClick"/>

                <Border Grid.Column="1" MinWidth="48" Padding="6,0"
                        BorderBrush="{DynamicResource HomeLineBrush}" BorderThickness="1,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ValueText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeAccentBrush}"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="ValueShift"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="UnitTextBlock" Margin="2,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource HomeInkBrush}"/>
                    </StackPanel>
                </Border>

                <Button x:Name="IncreaseButton" Grid.Column="2" Content="+"
                        Style="{StaticResource AutoCloseStepperButtonStyle}"
                        Click="OnIncreaseClick"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
