<UserControl x:Class="GeoChemistryNexus.Controls.AutoNumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             x:Name="Root">
    <!-- AllowEmpty：清空文本即表示“未设定”（NaN），此时显示本地化的 Auto 占位符 -->
    <local:NumericUpDown x:Name="InnerNumeric"
                         AllowEmpty="True"
                         Style="{Binding NumericStyle, ElementName=Root, TargetNullValue={StaticResource ModernNumericUpDownStyle}, FallbackValue={StaticResource ModernNumericUpDownStyle}}"
                         Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                         Minimum="{Binding Minimum, ElementName=Root}"
                         Maximum="{Binding Maximum, ElementName=Root}"
                         Increment="{Binding Increment, ElementName=Root}"
                         DecimalPlaces="{Binding DecimalPlaces, ElementName=Root}"
                         ValueFormat="{Binding ValueFormat, ElementName=Root}"
                         local:ControlAssist.Title="{Binding Title, ElementName=Root}"
                         local:ControlAssist.Placeholder="{Binding [auto], Source={x:Static lg:LanguageService.Instance}}"
                         ValueChanged="InnerNumeric_ValueChanged"/>
</UserControl>
