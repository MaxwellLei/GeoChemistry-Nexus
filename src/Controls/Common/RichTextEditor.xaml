<UserControl x:Class="GeoChemistryNexus.Controls.RichTextEditor"
             x:Name="EditorRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:controls="clr-namespace:GeoChemistryNexus.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GeoChemistryNexus;component/Views/Epma/EpmaTemplateEditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cvs:BoolToVisibilityConverter x:Key="Show"/>

            <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource EditorAction}">
                <Setter Property="Width" Value="29"/>
                <Setter Property="Height" Value="29"/>
                <Setter Property="MinHeight" Value="29"/>
                <Setter Property="Padding" Value="3"/>
                <Setter Property="Margin" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAF0F7"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DDE7F3"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolDivider" TargetType="Border">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="#DFE5ED"/>
                <Setter Property="Margin" Value="7,0"/>
            </Style>

            <Style x:Key="ToolbarOption" TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#263549"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Option" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Option" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#F0F3F7"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarSelect" TargetType="ComboBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#263549"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ToolbarOption}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="SelectSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"/>
                                <!-- Keep the dropdown hit area independent of the application's centered ToggleButton style. -->
                                <ToggleButton Style="{x:Null}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Selection" Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="8,0,24,0" Background="Transparent" BorderThickness="0" Padding="0"
                                         FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <Path Data="M 0,0 L 3,3 L 6,0" Stroke="#758195" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="6" Height="4" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="White" BorderBrush="#DFE5ED" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,4,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="240" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectSurface" Property="Background" Value="#EAF0F7"/></Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectSurface" Property="BorderBrush" Value="#8EBBFF"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border BorderBrush="#DFE5ED" BorderThickness="0,0,0,1"
                Padding="{Binding ToolbarPadding, ElementName=EditorRoot}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F8F9FB"/>
                    <Style.Triggers>
                        <!-- 既不显示格式工具栏、也没有右侧附加内容时，整条工具栏隐藏 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsToolbarVisible, ElementName=EditorRoot}" Value="False"/>
                                <Condition Binding="{Binding ToolbarTrailingContent, ElementName=EditorRoot}" Value="{x:Null}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
            <!-- 右侧附加内容（如宿主的"关闭"按钮），始终显示 -->
            <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                              Content="{Binding ToolbarTrailingContent, ElementName=EditorRoot}"/>
            <WrapPanel VerticalAlignment="Center"
                       Visibility="{Binding IsToolbarVisible, ElementName=EditorRoot, Converter={StaticResource Show}}"
                       IsEnabled="{Binding IsToolbarEnabled, ElementName=EditorRoot}">
                <Button x:Name="UndoButton" Style="{StaticResource FormatButton}" Click="UndoClick"
                        Visibility="{Binding IsHistoryVisible, ElementName=EditorRoot, Converter={StaticResource Show}}"
                        ToolTip="{Binding [undo], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource FormatButton}" Click="RedoClick"
                        Visibility="{Binding IsHistoryVisible, ElementName=EditorRoot, Converter={StaticResource Show}}"
                        ToolTip="{Binding [redo], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Border Style="{StaticResource ToolDivider}"
                        Visibility="{Binding IsHistoryVisible, ElementName=EditorRoot, Converter={StaticResource Show}}"/>
                <ComboBox x:Name="ParagraphStyleBox" Style="{StaticResource ToolbarSelect}" Width="74" Margin="2,0,6,0" SelectedIndex="0"
                          SelectionChanged="ParagraphStyleChanged"
                          ToolTip="{Binding [epma_editor_paragraph_style], Source={x:Static lg:LanguageService.Instance}}">
                    <ComboBoxItem Tag="Body" Content="{Binding [epma_editor_body_text], Source={x:Static lg:LanguageService.Instance}}"/>
                    <ComboBoxItem Tag="H1" Content="{Binding [epma_editor_heading_one], Source={x:Static lg:LanguageService.Instance}}"/>
                    <ComboBoxItem Tag="H2" Content="{Binding [epma_editor_heading_two], Source={x:Static lg:LanguageService.Instance}}"/>
                    <ComboBoxItem Tag="H3" Content="{Binding [epma_editor_heading_three], Source={x:Static lg:LanguageService.Instance}}"/>
                </ComboBox>
                <ComboBox x:Name="FontSizeBox" Style="{StaticResource ToolbarSelect}" Width="60" IsEditable="True" Text="14"
                          SelectionChanged="FontSizeChanged" GotKeyboardFocus="FontSizeGotFocus" LostKeyboardFocus="FontSizeLostFocus" PreviewKeyDown="FontSizeKeyDown"
                          ToolTip="{Binding [geo_help_font_size], Source={x:Static lg:LanguageService.Instance}}">
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="18"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="28"/>
                    <ComboBoxItem Content="36"/>
                </ComboBox>
                <Border Style="{StaticResource ToolDivider}"/>
                <Button x:Name="BoldButton" Style="{StaticResource FormatButton}" Click="BoldClick"
                        ToolTip="{Binding [geo_help_bold], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock FontWeight="Bold" Text="B"/>
                </Button>
                <Button Style="{StaticResource FormatButton}" Click="ItalicClick"
                        ToolTip="{Binding [geo_help_italic], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock FontStyle="Italic" Text="I"/>
                </Button>
                <Button Style="{StaticResource FormatButton}" Click="UnderlineClick"
                        ToolTip="{Binding [geo_help_underline], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock TextDecorations="Underline" Text="U"/>
                </Button>
                <Button Style="{StaticResource FormatButton}" Click="StrikeClick"
                        ToolTip="{Binding [epma_editor_strike], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock TextDecorations="Strikethrough" Text="S"/>
                </Button>
                <controls:ToolbarColorButton x:Name="FontColorButton" Margin="2,0,2,0" VerticalAlignment="Center" IconText="A" IconFontFamily="Segoe UI"
                                             SelectedColor="{Binding SelectedTextColor, ElementName=EditorRoot, Mode=TwoWay}"
                                             ToolTip="{Binding [font_color], Source={x:Static lg:LanguageService.Instance}}">
                    <controls:ToolbarColorButton.Resources>
                        <Style TargetType="Button"><Setter Property="Margin" Value="0"/></Style>
                    </controls:ToolbarColorButton.Resources>
                </controls:ToolbarColorButton>
                <Border Style="{StaticResource ToolDivider}"/>
                <Button Style="{StaticResource FormatButton}" Click="AlignClick" Tag="Left"
                        ToolTip="{Binding [geo_free_sheet_align_left], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock Text="&#xE8E4;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button Style="{StaticResource FormatButton}" Click="AlignClick" Tag="Center"
                        ToolTip="{Binding [geo_free_sheet_align_center], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock Text="&#xE8E3;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button Style="{StaticResource FormatButton}" Click="AlignClick" Tag="Right"
                        ToolTip="{Binding [geo_free_sheet_align_right], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock Text="&#xE8E2;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Border Style="{StaticResource ToolDivider}"/>
                <Button x:Name="BulletsButton" Style="{StaticResource FormatButton}" Click="BulletsClick"
                        ToolTip="{Binding [epma_editor_bullets], Source={x:Static lg:LanguageService.Instance}}">
                    <Grid Width="16" Height="16">
                        <Path Data="M 6,3 H 15 M 6,8 H 15 M 6,13 H 15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1.75,0,0"/>
                        <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6.75,0,0"/>
                        <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,11.75,0,0"/>
                    </Grid>
                </Button>
                <Button x:Name="NumberingButton" Style="{StaticResource FormatButton}" Click="NumberingClick"
                        ToolTip="{Binding [epma_editor_numbering], Source={x:Static lg:LanguageService.Instance}}">
                    <Grid Width="16" Height="16">
                        <Path Data="M 7,3 H 15 M 7,8 H 15 M 7,13 H 15 M 1,1 L 2.5,.5 V 4.5 M .75,4.5 H 4 M .75,7.5 Q .75,6.5 2.25,6.5 Q 4,6.5 4,7.5 Q 4,8 3,8.5 L .75,10.5 H 4 M 1,12 H 3.25 L 2.25,13.5 Q 4,13.5 4,14.5 Q 4,15.5 1,15.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                </Button>
                <Border Style="{StaticResource ToolDivider}"/>
                <Button Style="{StaticResource FormatButton}" Click="SuperscriptClick"
                        ToolTip="{Binding [epma_editor_superscript], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock><Run Text="x"/><Run Text="2" FontSize="9" BaselineAlignment="Superscript"/></TextBlock>
                </Button>
                <Button Style="{StaticResource FormatButton}" Click="SubscriptClick"
                        ToolTip="{Binding [epma_editor_subscript], Source={x:Static lg:LanguageService.Instance}}">
                    <TextBlock><Run Text="x"/><Run Text="2" FontSize="9" BaselineAlignment="Subscript"/></TextBlock>
                </Button>
            </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 编辑区 -->
        <RichTextBox x:Name="HelpEditor" Grid.Row="1" Padding="26,20" BorderThickness="0" Background="White" FontSize="14"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AcceptsTab="False"
                     IsReadOnly="{Binding IsReadOnly, ElementName=EditorRoot}"
                     TextChanged="DocumentTextChanged" SelectionChanged="DocumentSelectionChanged" PreviewKeyDown="DocumentKeyDown">
            <RichTextBox.CommandBindings>
                <CommandBinding Command="EditingCommands.IncreaseIndentation" CanExecute="IndentationCanExecute"/>
                <CommandBinding Command="EditingCommands.DecreaseIndentation" CanExecute="IndentationCanExecute"/>
            </RichTextBox.CommandBindings>
            <FlowDocument ColumnWidth="999999" PagePadding="0"/>
        </RichTextBox>
    </Grid>
</UserControl>
