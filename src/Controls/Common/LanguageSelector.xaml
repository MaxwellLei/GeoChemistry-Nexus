<UserControl x:Class="GeoChemistryNexus.Controls.LanguageSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d"
             x:Name="Root"
             Focusable="False"
             Width="180" Height="30"
             d:DesignHeight="30" d:DesignWidth="180">
    <!-- 界面语言选择器：触发按钮（国旗 + 母语名（地区）+ 箭头）+ 下拉面板（搜索框 + 语言列表 + 快捷键提示）。
         样式统一定义在 Themes/Styles.xaml（LanguageSelector* / Flag.*）；
         数据由 Items（AppLanguageOption 列表）与 SelectedCode（双向）提供，选择变化后执行 SelectionChangedCommand。 -->
    <UserControl.Template>
        <ControlTemplate TargetType="UserControl">
            <ContentPresenter/>
        </ControlTemplate>
    </UserControl.Template>

    <UserControl.Resources>
        <Style x:Key="TriggerButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource LanguageSelectorTriggerStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=Root}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 箭头：展开时旋转 180° -->
        <Style x:Key="ChevronStyle" TargetType="Path">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=Root}" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 触发按钮：展开时不参与命中测试，这样再次点击按钮区域只会让弹层关闭，而不会立刻重新打开 -->
        <ToggleButton x:Name="TriggerButton"
                      Style="{StaticResource TriggerButtonStyle}"
                      IsChecked="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 触发按钮里的国旗缩小到 20×13，下拉列表中保持 24×16 -->
                <Viewbox Grid.Column="0" Width="20" Height="13" VerticalAlignment="Center" Stretch="Uniform">
                    <ContentPresenter Content="{Binding SelectedOption, ElementName=Root}"
                                      ContentTemplate="{DynamicResource LanguageFlagTemplate}"/>
                </Viewbox>

                <TextBlock Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center"
                           Text="{Binding SelectedOption.TriggerText, ElementName=Root}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                <Path Grid.Column="2" VerticalAlignment="Center"
                      Style="{StaticResource ChevronStyle}"
                      Data="M0.5,0.5 L4.5,4.5 L8.5,0.5"
                      Stroke="{DynamicResource HomeSubBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
        </ToggleButton>

        <Popup x:Name="DropPopup"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=TriggerButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="DropPopup_Opened">
            <!-- 外层留白用于容纳阴影；位置由代码中的 AlignPopup 按实际屏幕坐标校正为与触发按钮右对齐 -->
            <Border x:Name="PopupBorder" Margin="24" Width="230"
                    Background="White"
                    BorderBrush="{DynamicResource HomeLineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="0,0,0,4">
                <Border.Effect>
                    <DropShadowEffect Color="#16204A" Opacity="0.16" BlurRadius="24" ShadowDepth="8" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <local:SearchBox x:Name="SearchBox"
                                     Margin="6" Height="28"
                                     Text="{Binding SearchText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Placeholder="{Binding [language_selector_search_placeholder], Source={x:Static lg:LanguageService.Instance}}"
                                     Background="#FAFBFD" BorderBrush="#E1E5EF"
                                     CornerRadius="4" Padding="8,0"
                                     FocusBackground="White"
                                     FocusBorderBrush="{DynamicResource ThemeAccentBrush}"
                                     IconBrush="{DynamicResource HomeMuteBrush}"
                                     PlaceholderBrush="{DynamicResource HomeMuteBrush}"
                                     Foreground="{DynamicResource HomeInkBrush}"
                                     FontSize="12" IconFontSize="12"
                                     ShowClearButton="True"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown"/>

                    <Grid>
                        <ListBox x:Name="LanguageList"
                                 Style="{DynamicResource LanguageSelectorListStyle}"
                                 PreviewMouseLeftButtonUp="LanguageList_PreviewMouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Viewbox Grid.Column="0" Width="20" Height="13" VerticalAlignment="Center" Stretch="Uniform">
                                            <ContentPresenter Content="{Binding}"
                                                              ContentTemplate="{DynamicResource LanguageFlagTemplate}"/>
                                        </Viewbox>

                                        <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NativeName}" FontSize="12.5" FontWeight="Medium"
                                                       Foreground="{DynamicResource HomeInkBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SubText}" FontSize="10.5" Margin="0"
                                                       Foreground="{DynamicResource HomeMuteBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- 当前语言对勾 -->
                                        <Path Grid.Column="2" VerticalAlignment="Center"
                                              Data="M0.8,5.5 L4.6,9.3 L11.8,0.8"
                                              Stretch="Uniform" Width="10" Height="8"
                                              Stroke="{DynamicResource HomeBrandBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 无匹配结果 -->
                        <TextBlock Text="{Binding [language_selector_no_match], Source={x:Static lg:LanguageService.Instance}}"
                                   Padding="12" HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource HomeMuteBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoResults, ElementName=Root}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 底部提示：快捷键 + 语言数量 -->
                    <Border BorderBrush="#F0F2F8" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="10,6,10,2">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource LanguageSelectorKbdBorderStyle}">
                                    <TextBlock Text="&#x2191;" Style="{DynamicResource LanguageSelectorKbdTextStyle}"/>
                                </Border>
                                <Border Style="{DynamicResource LanguageSelectorKbdBorderStyle}" Margin="4,0,0,0">
                                    <TextBlock Text="&#x2193;" Style="{DynamicResource LanguageSelectorKbdTextStyle}"/>
                                </Border>
                                <TextBlock Margin="4,0,0,0" FontSize="10.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource HomeMuteBrush}"
                                           Text="{Binding [language_selector_hint_select], Source={x:Static lg:LanguageService.Instance}}"/>
                                <Border Style="{DynamicResource LanguageSelectorKbdBorderStyle}" Margin="8,0,0,0">
                                    <TextBlock Text="Enter" Style="{DynamicResource LanguageSelectorKbdTextStyle}"/>
                                </Border>
                                <TextBlock Margin="4,0,0,0" FontSize="10.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource HomeMuteBrush}"
                                           Text="{Binding [language_selector_hint_confirm], Source={x:Static lg:LanguageService.Instance}}"/>
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5"
                                       Foreground="{DynamicResource HomeMuteBrush}">
                                <Run Text="{Binding ItemCount, ElementName=Root, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding [language_selector_count_unit], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
