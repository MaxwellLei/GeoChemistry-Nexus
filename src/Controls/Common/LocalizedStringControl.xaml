<UserControl x:Class="GeoChemistryNexus.Controls.LocalizedStringControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeoChemistryNexus.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- 通用「多语言文本输入」控件。
         ShowLanguageChip=False：仅一个文本框（沿用 TextBoxStyle）。
         ShowLanguageChip=True ：整体是一个圆角输入框（FieldHost 提供底色 / 聚焦描边），语言角标作为框内的一部分：
           · 多行（AllowVerticalResize=True）：文本在上，框内底部一行左侧为语言角标、右侧为拖动调高角标（两者同一行，不额外占用文本区域）
           · 单行：语言角标位于框内右侧居中
         位置全部由 Grid 行列布局完成（见代码 UpdateLanguageChipLayout），不再靠给文本框加内边距来“让位”。 -->
    <Border x:Name="FieldHost">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="DisplayTextBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                     VerticalContentAlignment="Center"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"/>

            <!-- 语言角标：显示当前编辑的内容语言（切换在图解工具栏的语言列表中进行） -->
            <Border x:Name="LanguageChip" Visibility="Collapsed"
                    Grid.Row="1" Grid.Column="0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,5"
                    Padding="7,2" CornerRadius="6" IsHitTestVisible="False"
                    Background="{DynamicResource ThemeAccentSoftBrush}">
                <TextBlock Text="{Binding LanguageChipText, RelativeSource={RelativeSource AncestorType=local:LocalizedStringControl}}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeAccentBrush}"/>
            </Border>

            <!-- 右下角拖动角标：仅在 AllowVerticalResize 为 true 时显示，用于调整文本框高度 -->
            <Thumb x:Name="ResizeGrip"
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Visibility="Collapsed"
                   Width="14" Height="14"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,3,3"
                   Cursor="SizeNS"
                   Focusable="False"
                   DragDelta="ResizeGrip_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 3,12 L 12,3 M 7,12 L 12,7 M 11,12 L 12,11"
                                  Stroke="{StaticResource InspectorHintBrush}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
