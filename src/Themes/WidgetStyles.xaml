<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GeoChemistryNexus.Controls"
                    xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
                    xmlns:widgets="clr-namespace:GeoChemistryNexus.Views.Widgets;assembly=GeoChemistryNexus"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- Home tools share the workspace palette and the editors' 44 DIP caption. -->
    <SolidColorBrush x:Key="WidgetCanvasBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="WidgetTextBrush" Color="#263549"/>
    <SolidColorBrush x:Key="WidgetMutedBrush" Color="#7A8798"/>
    <!-- WidgetAccentBrush 由 AppThemeHelper 写入应用级资源（随主题色切换），此处不再本地定义 -->

    <!-- 窗口控制按钮：与主窗体 / 编辑器窗体一致（iconfont 图标字、46x44、#333 前景、悬停 #E5E5E5，关闭 #E81123） -->
    <Style x:Key="WidgetCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E5E5E5"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#CCCCCC"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WidgetCaptionMaximizeButton" TargetType="Button" BasedOn="{StaticResource WidgetCaptionButton}">
        <Setter Property="Content" Value="&#xf2b2;"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Content" Value="&#xf2b4;"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="WidgetCaptionCloseButton" TargetType="Button" BasedOn="{StaticResource WidgetCaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#C50F1F"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="WidgetWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="Background" Value="{StaticResource WidgetCanvasBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource WidgetTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="{DynamicResource AppTextFormattingMode}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 通栏侧栏：仅在小组件声明 SidebarContent 时显示，从顶部贯穿到底部 -->
                        <Border x:Name="WidgetSidebar" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                Background="#EBEEF3" BorderBrush="#DFE5ED" BorderThickness="0,0,1,0"
                                Visibility="Collapsed"
                                LayoutTransform="{Binding Content.LayoutTransform, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter Content="{Binding Path=(widgets:WidgetWindow.SidebarContent), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                        </Border>
                        <Border x:Name="WidgetCaption" Grid.Row="0" Grid.Column="1" Height="44" Background="#F5F7FA"
                                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                LayoutTransform="{Binding Content.LayoutTransform, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="TitleHost" Margin="16,0,12,0" VerticalAlignment="Center" MaxWidth="260">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" Background="{DynamicResource ThemeAccentSoftBrush}" CornerRadius="7" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding WidgetIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource ThemeAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <!-- 小组件自带的标题栏内容：工具栏、搜索、主操作等 -->
                                <!-- Viewbox 只缩小不放大：窗体偏窄或界面缩放较大时整体等比收缩，不会把右侧控件裁掉 -->
                                <Viewbox Grid.Column="1" Margin="8,0,8,0" Stretch="Uniform" StretchDirection="DownOnly"
                                         HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="CaptionHost" VerticalAlignment="Center"
                                                      Content="{Binding Path=(widgets:WidgetWindow.CaptionContent), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                                </Viewbox>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="WidgetMinimize" Style="{StaticResource WidgetCaptionButton}" Content="&#xe67a;"
                                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                            ToolTip="{Binding [minimize], Source={x:Static lg:LanguageService.Instance}}"
                                            AutomationProperties.Name="{Binding [minimize], Source={x:Static lg:LanguageService.Instance}}"/>
                                    <Button x:Name="WidgetMaximize" Style="{StaticResource WidgetCaptionMaximizeButton}"
                                            Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                            ToolTip="{Binding [maximize], Source={x:Static lg:LanguageService.Instance}}"
                                            AutomationProperties.Name="{Binding [maximize], Source={x:Static lg:LanguageService.Instance}}"/>
                                    <Button x:Name="WidgetClose" Style="{StaticResource WidgetCaptionCloseButton}" Content="&#xeaf2;"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                                            ToolTip="{Binding [close], Source={x:Static lg:LanguageService.Instance}}"
                                            AutomationProperties.Name="{Binding [close], Source={x:Static lg:LanguageService.Instance}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <AdornerDecorator Grid.Row="1" Grid.Column="1">
                            <ContentPresenter ContentSource="Content"/>
                        </AdornerDecorator>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="widgets:WidgetWindow.HasSidebar" Value="True">
                            <Setter TargetName="WidgetSidebar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="TitleHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="WidgetMaximize" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="WidgetMinimize" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E5EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="WidgetHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource WidgetTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="WidgetHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource WidgetMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="WidgetAction" TargetType="Button">
        <Setter Property="Background" Value="#EDF1F6"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WidgetPrimaryAction" TargetType="Button" BasedOn="{StaticResource WidgetAction}">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="WidgetNumber" TargetType="ctrl:NumericUpDown" BasedOn="{StaticResource ModernNumericUpDownStyle}">
        <Setter Property="Background" Value="#F5F7FA"/>
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="6"/>
    </Style>
    <Style x:Key="WidgetCombo" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
        <Setter Property="Background" Value="#F5F7FA"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="6"/>
    </Style>
    <Style x:Key="WidgetTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
        <Setter Property="Background" Value="#F5F7FA"/>
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="6"/>
    </Style>
    <Style x:Key="WidgetPassword" TargetType="PasswordBox" BasedOn="{StaticResource AppPasswordBoxStyle}">
        <Setter Property="Background" Value="#F5F7FA"/>
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="6"/>
    </Style>

    <!-- 危险操作（删除等）：浅红底，悬停加深 -->
    <Style x:Key="WidgetDangerAction" TargetType="Button" BasedOn="{StaticResource WidgetAction}">
        <Setter Property="Background" Value="#FFEFED"/>
        <Setter Property="Foreground" Value="#D92D20"/>
    </Style>

    <!-- 区块标题 / 字段标签 -->
    <Style x:Key="WidgetSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource WidgetTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="WidgetFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource WidgetMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 列表：圆角白底，条目悬停 / 选中使用工作区蓝色 -->
    <Style x:Key="WidgetListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Foreground" Value="{StaticResource WidgetTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F3F6FA"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WidgetListBox" TargetType="ListBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E5EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource WidgetListBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 统计徽标：数量摘要（新增 / 更新 / 移除 / 未变） -->
    <Style x:Key="WidgetChip" TargetType="Border">
        <Setter Property="Background" Value="#EDF1F6"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- 语言填写标签（发布器）：灰=还没写，橙=只写了一部分，绿=完整；当前编辑语言带主题色描边。DataContext 为 TranslationChipViewModel -->
    <Style x:Key="WidgetLanguageChip" TargetType="Button">
        <Setter Property="Background" Value="#F3F5F8"/>
        <Setter Property="Foreground" Value="#7A8798"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="full">
                <Setter Property="Background" Value="#E8F8EE"/>
                <Setter Property="Foreground" Value="#17803D"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="partial">
                <Setter Property="Background" Value="#FFF4E5"/>
                <Setter Property="Foreground" Value="#B45309"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 公告上架状态徽标（发布器列表）：Tag 绑定 StatusKey（live / scheduled / expired / empty） -->
    <Style x:Key="WidgetAnnouncementStatusChip" TargetType="Border">
        <Setter Property="Background" Value="#F3F5F8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="live">
                <Setter Property="Background" Value="#E8F8EE"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="scheduled">
                <Setter Property="Background" Value="#E8F1FE"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="expired">
                <Setter Property="Background" Value="#EDF1F6"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="empty">
                <Setter Property="Background" Value="#FFF4E5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 细进度条 -->
    <Style x:Key="WidgetProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Background" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 标题栏内的紧凑控件（44 DIP 标题栏内垂直居中） ===== -->
    <!-- 标题栏按钮：与图解 / EPMA 编辑器的 EditorAction 一致，高度随内容，宽度随文字，不设固定宽 -->
    <Style x:Key="WidgetCaptionAction" TargetType="Button">
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DDE3EB"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WidgetCaptionPrimary" TargetType="Button" BasedOn="{StaticResource WidgetCaptionAction}">
        <Setter Property="Padding" Value="16,4"/>
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>    <!-- 标题栏下拉切换按钮：图标 + 下拉箭头，展开时保持按下态 -->
    <Style x:Key="WidgetCaptionDropdown" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="#DDE3EB" BorderThickness="1" CornerRadius="5" Padding="10,3" MinHeight="{TemplateBinding MinHeight}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="6,1,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCE4EE"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCE4EE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WidgetCaptionNumber" TargetType="ctrl:NumericUpDown" BasedOn="{StaticResource WidgetNumber}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="WidgetCaptionTextBox" TargetType="TextBox" BasedOn="{StaticResource WidgetTextBox}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="WidgetCaptionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource WidgetMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="WidgetCaptionDivider" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Background" Value="#D9E0E8"/>
        <Setter Property="Margin" Value="6,0,12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 标题栏内的单选项（方向切换等）：分段胶囊 -->
    <Style x:Key="WidgetCaptionRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="#E8EDF3" CornerRadius="6" Padding="10,5" Margin="0,0,4,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCE4EE"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource WidgetAction}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource WidgetTextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource WidgetCombo}"/>
</ResourceDictionary>
