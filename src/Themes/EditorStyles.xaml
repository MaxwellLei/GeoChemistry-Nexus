<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GeoChemistryNexus.Controls"
                    xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
                    xmlns:views="clr-namespace:GeoChemistryNexus.Views">

    <ResourceDictionary.MergedDictionaries>
        <!-- 复用 EPMA 新建计算模板窗口的基础样式（EditorAction / EditorLink / EditorCaption / EditorFormRow / EditorFormValue 等） -->
        <ResourceDictionary Source="pack://application:,,,/GeoChemistryNexus;component/Views/Epma/EpmaTemplateEditorStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- EditorAccentBrush / EditorPrimaryBrush / EditorPrimarySoftBrush 由 AppThemeHelper 写入应用级资源，
         此处不再本地定义，否则会遮住主题色。 -->
    <SolidColorBrush x:Key="EditorAccentSoftBrush" Color="{DynamicResource ThemeAccentSoftColor}"/>
    <SolidColorBrush x:Key="EditorSidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="EditorBorderBrushLight" Color="#E5E5EA"/>

    <Style x:Key="EditorFieldComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource AppComboBoxItemStyle}">
        <!-- 使用本地值，避免默认/基样式里 RelativeSource→ItemsControl 在项销毁时绑定失败 -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="EditorFieldComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MaxHeight" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="4"/>
        <!-- 清空 StyleSelector，统一走本样式指定的 ItemContainerStyle -->
        <Setter Property="ItemContainerStyleSelector" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource EditorFieldComboBoxItemStyle}"/>
    </Style>

    <Style x:Key="FieldControlHostStyle" TargetType="Border">
        <Setter Property="Height" Value="32"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 标签胶囊：与 EPMA 支持语言胶囊保持一致 -->
    <Style x:Key="GeoTTokenBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="GeoTCapabilityTokenBorderStyle" TargetType="Border" BasedOn="{StaticResource GeoTTokenBorderStyle}">
        <Setter Property="Background" Value="#EAF7EE"/>
        <Setter Property="BorderBrush" Value="#BFE3CB"/>
    </Style>

    <Style x:Key="GeoTTokenCloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CloseBd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <TextBlock Text="✕" FontSize="9" FontWeight="Bold"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseBd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 以下样式与 EPMA 新建计算模板窗口保持一致 ==================== -->

    <Style x:Key="GeoTNavigationItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="12,2"/>
        <Setter Property="Foreground" Value="#3C3C43"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NavBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="#F0F0F3"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeoTNavigationIcon" TargetType="Path">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Margin" Value="1.5,0,11.5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="StrokeThickness" Value="1.3"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Stroke" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GeoTSectionCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E5EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="GeoTSectionHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#66768B"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ContentVersionStepButton" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E5EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E7E9F0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ContentVersionPatchBox" TargetType="TextBox">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E5EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeoTFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="GeoTFormValue" TargetType="TextBox" BasedOn="{StaticResource EditorFormValue}">
        <Setter Property="IsReadOnly" Value="{Binding IsContentReadOnly}"/>
    </Style>

    <!-- 圆角浅灰输入框（对应 EPMA 的描述输入框），用于整行输入 -->
    <Style x:Key="GeoTFieldBox" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="{Binding IsContentReadOnly}"/>
        <Setter Property="Background" Value="#F5F7FA"/>
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"/>
                            <TextBlock x:Name="Hint" Margin="{TemplateBinding Padding}" Text="{TemplateBinding Tag}" Foreground="#8793A3"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#8EBBFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeoTFormComboBox" TargetType="ComboBox" BasedOn="{StaticResource EditorFieldComboBoxStyle}">
        <Setter Property="Background" Value="#F5F7FA"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="GeoTRemoveButton" TargetType="Button" BasedOn="{StaticResource EditorLink}">
        <Setter Property="Content" Value="×"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style x:Key="GeoTSourceBox" TargetType="ctrl:EpmaCodeEditor" BasedOn="{StaticResource EpmaSourceBox}">
        <Setter Property="IsReadOnly" Value="{Binding IsContentReadOnly}"/>
    </Style>

    <!-- ==================== 基本信息：支持语言（与 EPMA 新建计算模板窗口一致） ==================== -->

    <Style x:Key="GeoTLanguageTokenBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Background" Value="#F5F7FA"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="#758195"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GeoTLanguageRemoveButton" TargetType="Button" BasedOn="{StaticResource EditorLink}">
        <Setter Property="Content" Value="×"/>
        <Setter Property="MinHeight" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="7,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#758195"/>
    </Style>

    <!-- ==================== 数据与脚本：输入/输出列表格（与 EPMA 一致） ==================== -->

    <Style x:Key="GeoTColumnCell" TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="AcceptsReturn" Value="False"/>
        <Setter Property="AcceptsTab" Value="False"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="MinLines" Value="1"/>
        <Setter Property="MaxLines" Value="1"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="IsReadOnly" Value="{Binding DataContext.IsContentReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" CanContentScroll="False"/>
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#8796A8" Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeoTRemoveColumn" TargetType="Button">
        <Setter Property="Content" Value="×"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTip" Value="{Binding [epma_editor_remove_column], Source={x:Static lg:LanguageService.Instance}}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding [epma_editor_remove_column], Source={x:Static lg:LanguageService.Instance}}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.IsContentReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 帮助文档语言胶囊 -->
    <Style x:Key="GeoTLanguageTab" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Foreground" Value="#758195"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Pill" Background="#F5F7FA" CornerRadius="16" Padding="{TemplateBinding Padding}"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Opacity" Value=".8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeoTFormatButton" TargetType="Button" BasedOn="{StaticResource EditorAction}">
        <Setter Property="Width" Value="29"/>
        <Setter Property="Height" Value="29"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#EAF0F7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#DDE7F3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeoTToolDivider" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="#DFE5ED"/>
        <Setter Property="Margin" Value="7,0"/>
    </Style>

    <Style x:Key="GeoTToolbarOption" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Option" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Option" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Option" Property="Background" Value="#F0F3F7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeoTToolbarSelect" TargetType="ComboBox">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource GeoTToolbarOption}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="SelectSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5"/>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Selection" Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="8,0,24,0" Background="Transparent" BorderThickness="0" Padding="0"
                                 FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Path Data="M 0,0 L 3,3 L 6,0" Stroke="#758195" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="6" Height="4" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="#DFE5ED" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="240" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectSurface" Property="Background" Value="#EAF0F7"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="SelectSurface" Property="BorderBrush" Value="#8EBBFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
