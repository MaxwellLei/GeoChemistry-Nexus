            <TextBlock Grid.Column="2"
                       Text="{Binding Name}"
                       ToolTip="{Binding Name}"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Column="3"
                    Width="22"
                    Height="22"
                    Margin="8,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    ToolTip="删除"
                    Command="{Binding DataContext.DeleteSelectedObjectCommand, RelativeSource={RelativeSource AncestorType=TreeView}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Foreground" Value="#8E8E93"/>
                        <Setter Property="Opacity" Value="0.9"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                    <Condition Binding="{Binding ShowInlineDeleteButton}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A8E8E93"/>
                                <Setter Property="BorderBrush" Value="#338E8E93"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont"
                           Text="&#xe6a2;"
                           FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>

            <TextBlock Grid.Column="4"
                       Text="{Binding ChildCount}"
                       FontSize="11.5"
                       FontWeight="Medium"
                       Typography.NumeralAlignment="Tabular"
                       Padding="5,1"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource DiagramLibrarySecondaryBrush}"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.Line}">
                <Setter TargetName="LineIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.Text}">
                <Setter TargetName="TextIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.Polygon}">
                <Setter TargetName="PolygonIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.Arrow}">
                <Setter TargetName="ArrowIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.Function}">
                <Setter TargetName="FunctionIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.Axis}">
                <Setter TargetName="AxisIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.AxisX}">
                <Setter TargetName="AxisXIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.AxisY}">
                <Setter TargetName="AxisYIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.AxisA}">
                <Setter TargetName="AxisAIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.AxisB}">
                <Setter TargetName="AxisBIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.AxisC}">
                <Setter TargetName="AxisCIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static layerModels:LayerTreeIconKind.Point}">
                <Setter TargetName="PointIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <Style x:Key="ModernRibbonButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="360"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#E5E7EB"/>
                            <Setter Property="BorderBrush" Value="#9CA3AF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonSmallButton" TargetType="Button" BasedOn="{StaticResource ModernRibbonButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E5F3FF"/>
                <Setter Property="BorderBrush" Value="#CCE7FF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#CCE7FF"/>
                <Setter Property="BorderBrush" Value="#99D1FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 图解顶部语言切换列表：单个语言选项按钮（与 EPMA 模板编辑器的语言选项列表风格一致） -->
    <Style x:Key="DiagramLanguageOptionButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#263549"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#F0F0F2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 开发者模式：已转换为内置模板的图解卡片边框色 -->
    <SolidColorBrush x:Key="ConvertedBuiltinTemplateBorderBrush" Color="#8B0000"/>

    <!-- 图解模板卡片网格尺寸：标准档位基准 276；运行时由 TemplateCardLayoutHelper 按视口重算 ItemSize -->
    <Size x:Key="TemplateCardCellSize">276,276</Size>

    <!-- 图解卡片列表：滚动条贴齐右侧；Padding 仅作用于 ItemsPresenter，保持最右列卡片与边框间距 -->
    <Style x:Key="TemplateCardListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,0,10,0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter Margin="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="TemplateCardHoverBrush" Color="#007aff"/>

    <Style x:Key="TemplateCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Path x:Name="Arrow"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                          StrokeThickness="1.5"
                          SnapsToDevicePixels="True"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Data="M 0 0 L 4 4 L 0 8">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" CenterX="2" CenterY="4"/>
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arrow"
                                                     Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                     To="90" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arrow"
                                                     Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                     To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 属性面板可折叠分组标题（默认收起） -->
    <Style x:Key="PropertySectionHeaderToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IsChecked" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="Arrow"
                              Grid.Column="0"
                              Stroke="#666"
                              StrokeThickness="1.5"
                              SnapsToDevicePixels="True"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="0,0,8,0"
                              Data="M 0 0 L 4 4 L 0 8">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" CenterX="2" CenterY="4"/>
                            </Path.RenderTransform>
                        </Path>
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Stroke" Value="#333"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" CenterX="2" CenterY="4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Style TreeViewItem -->
    <Style x:Key="ModernStyleTreeViewItemStyle" TargetType="TreeViewItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="8,6" 
                                SnapsToDevicePixels="true">
                            <i:Interaction.Behaviors>
                                <helpers:TreeViewItemExpandBehavior />
                            </i:Interaction.Behaviors>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="Expander"
                                              Grid.Column="0"
                                              Style="{StaticResource ExpandCollapseToggleStyle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>

                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  ContentSource="Header"/>
                            </Grid>
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Margin="20,0,0,0"/>

                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        
                        <!-- Hover State -->
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EAEAEA"/>
                        </Trigger>

                        <!-- Selected State (Active) -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </DataTrigger>
                        
                        <!-- Selected State (Inactive/LostFocus) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/> <!-- Modern Selection Blue - 保持与活动选中相同 -->
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== macOS 风格侧边栏（模板库） ==================== -->
    <SolidColorBrush x:Key="MacSidebarBackgroundBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="MacSidebarBorderBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="MacSidebarHeaderBrush" Color="#8E8E93"/>
    <SolidColorBrush x:Key="MacSidebarTextBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="MacSidebarHoverBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="MacSidebarPressedBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="MacSidebarActiveBrush" Color="#1F007AFF"/>
    <SolidColorBrush x:Key="MacSidebarAccentBrush" Color="#007AFF"/>
    <SolidColorBrush x:Key="MacSidebarBadgeBackgroundBrush" Color="#10000000"/>
    <SolidColorBrush x:Key="MacSidebarBadgeSelectedBackgroundBrush" Color="#40FFFFFF"/>

    <!-- 分组标题 -->
    <Style x:Key="MacSidebarSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MacSidebarHeaderBrush}"/>
        <Setter Property="Margin" Value="20,18,16,6"/>
    </Style>

    <!-- 展开/收起箭头 -->
    <Style x:Key="MacSidebarChevronStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Text" Value="&#xE76C;"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="#A1A1A6"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Tag 绑定为展开状态 -->
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="90" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 侧边栏条目按钮；Tag 绑定为 True 时表示当前激活 -->
    <Style x:Key="MacSidebarItemButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource MacSidebarTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="10,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd"
                                MinHeight="32"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"/>
                        <Border x:Name="Overlay"
                                CornerRadius="8"
                                Background="{StaticResource MacSidebarHoverBrush}"
                                Visibility="Collapsed"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{StaticResource MacSidebarPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Background" Value="{DynamicResource MacSidebarActiveBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 侧边栏可折叠子树容器；Tag 绑定为展开状态 -->
    <Style x:Key="MacSidebarCollapsibleBorderStyle" TargetType="Border">
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="MaxHeight" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="800" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseIn"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 侧边栏模板树节点（选中为 macOS 蓝色填充） -->
    <Style x:Key="MacSidebarTreeViewItemStyle" TargetType="TreeViewItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MacSidebarTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd"
                                MinHeight="32"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="8,0"
                                SnapsToDevicePixels="True">
                            <i:Interaction.Behaviors>
                                <helpers:TreeViewItemExpandBehavior />
                            </i:Interaction.Behaviors>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="Expander"
                                              Grid.Column="0"
                                              Style="{StaticResource ExpandCollapseToggleStyle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center"/>

                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  ContentSource="Header"/>
                            </Grid>
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MacSidebarHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MacSidebarAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 资源库侧边栏（图解模块 / 地质温压计模块共用） ==================== -->
    <SolidColorBrush x:Key="DiagramLibraryBackgroundBrush" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="DiagramLibraryTextBrush" Color="#D9000000"/>
    <SolidColorBrush x:Key="DiagramLibrarySecondaryBrush" Color="#853C3C43"/>
    <SolidColorBrush x:Key="DiagramLibraryIconBrush" Color="#B83C3C43"/>
    <SolidColorBrush x:Key="DiagramLibraryChevronBrush" Color="#5C3C3C43"/>
    <SolidColorBrush x:Key="DiagramLibraryHoverBrush" Color="#0A000000"/>
    <!-- 仅作为“选中态”的标记画刷（触发器以 Background == 本画刷判断，必须保持同一冻结实例）。
         实际填充色由各模板里的触发器改用 ThemeAccentBrush，随主题切换。 -->
    <SolidColorBrush x:Key="DiagramLibraryActiveBrush" Color="#3C4A98"/>

    <!-- 键盘导航焦点框（鼠标点击不会遗留焦点边框） -->
    <Style x:Key="DiagramLibraryKeyboardFocusStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1"
                            CornerRadius="6" Margin="1" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DiagramLibrarySectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DiagramLibrarySecondaryBrush}"/>
        <Setter Property="Margin" Value="10,18,10,5"/>
    </Style>

    <!-- 基础线条图标。选中变白的触发器拆到树节点 / 按钮两个派生样式，
         避免在没有对应父级时产生 FindAncestor 绑定错误。 -->
    <Style x:Key="DiagramLibraryIconStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource DiagramLibraryIconBrush}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="DiagramLibraryTreeItemIconStyle" TargetType="Path" BasedOn="{StaticResource DiagramLibraryIconStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                <Setter Property="Stroke" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DiagramLibraryButtonIconStyle" TargetType="Path" BasedOn="{StaticResource DiagramLibraryIconStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}" Value="{StaticResource DiagramLibraryActiveBrush}">
                <Setter Property="Stroke" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DiagramLibraryChevronStyle" TargetType="TextBlock" BasedOn="{StaticResource MacSidebarChevronStyle}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Foreground" Value="{StaticResource DiagramLibraryChevronBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}" Value="{StaticResource DiagramLibraryActiveBrush}">
                <Setter Property="Foreground" Value="#D9FFFFFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DiagramLibraryExpanderStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Path x:Name="Arrow" Data="M 6.2,4.8 L 9.8,8 L 6.2,11.2"
                              Stroke="{StaticResource DiagramLibraryChevronBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                            <Setter TargetName="Arrow" Property="Stroke" Value="#D9FFFFFF"/>
                        </DataTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 资源库条目按钮；Tag 绑定为 True 时表示当前激活（系统蓝填充） -->
    <Style x:Key="DiagramLibraryItemButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource DiagramLibraryKeyboardFocusStyle}"/>
        <Setter Property="Foreground" Value="{StaticResource DiagramLibraryTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,0,8,0"/>
        <Setter Property="Margin" Value="0,0,0,1.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource DiagramLibraryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="Background" Value="{StaticResource DiagramLibraryActiveBrush}">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Background" Value="{StaticResource DiagramLibraryActiveBrush}"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarSelectedHoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                <Setter Property="Background" Value="{StaticResource DiagramLibraryActiveBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DiagramLibraryActiveBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 模板库大类按钮：高亮完全由 Tag（是否为当前激活的大类）决定，按下时不再临时高亮，避免点击后闪烁 -->
    <Style x:Key="DiagramLibraryCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource DiagramLibraryItemButtonStyle}">
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True"/>
                    <Condition Property="Tag">
                        <Condition.Value><sys:Boolean>False</sys:Boolean></Condition.Value>
                    </Condition>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource DiagramLibraryTextBrush}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FontStyleToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F5F5"/>
                            <Setter Property="BorderBrush" Value="#BDBDBD"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="#EBF4FF"/>
                            <Setter Property="BorderBrush" Value="#A6CFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter Property="BorderBrush" Value="#80BDFF"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
