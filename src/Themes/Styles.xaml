                            <Path Style="{StaticResource PlateIcoDotPath}" Data="M5.6 16a2.4 2.4 0 1 0 4.8 0a2.4 2.4 0 1 0 -4.8 0z"/>
                            <Path Style="{StaticResource PlateIcoDotPath}" Data="M10.1 11a2.4 2.4 0 1 0 4.8 0a2.4 2.4 0 1 0 -4.8 0z"/>
                            <Path Style="{StaticResource PlateIcoDotPath}" Data="M14.6 14.5a2.4 2.4 0 1 0 4.8 0a2.4 2.4 0 1 0 -4.8 0z"/>
                            <Path Style="{StaticResource PlateIcoDotPath}" Data="M15.1 7.5a2.4 2.4 0 1 0 4.8 0a2.4 2.4 0 1 0 -4.8 0z"/>
