                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 顶栏参数胶囊（CIPW / Niggli 的 Fe³⁺/ΣFe 比例） =====================
         结构：[ 浅灰标签 | 数值输入 ]，与同一顶栏里的圆角按钮等高。
         用法：<Border Style="{StaticResource TitleBarParamChipStyle}">
                   <StackPanel Orientation="Horizontal">
                       <Border Style="{StaticResource TitleBarParamChipLabelStyle}"><TextBlock Style="{StaticResource TitleBarParamChipLabelTextStyle}"/></Border>
                       <TextBox Style="{StaticResource TitleBarParamChipTextBoxStyle}"/>
                   </StackPanel>
               </Border> -->
    <Style x:Key="TitleBarParamChipStyle" TargetType="Border">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D5DBE5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#94A3B8"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TitleBarParamChipLabelStyle" TargetType="Border">
        <Setter Property="Background" Value="#F1F5F9"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="CornerRadius" Value="5,0,0,5"/>
        <Setter Property="Padding" Value="9,0"/>
    </Style>

    <Style x:Key="TitleBarParamChipLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#475569"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TitleBarParamChipTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentDarkBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="0,5,5,0"/>
    </Style>

    <!-- 语言/分类标签（图解编辑器与 EPMA 模板编辑器共用） -->
    <Style x:Key="TokenBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#EBF3FF"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="TokenLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,1,0,1"/>
    </Style>

    <Style x:Key="TokenCloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CloseBd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <TextBlock Text="✕" FontSize="9" FontWeight="Bold"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseBd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 覆盖 AppComboBoxStyle 中带 ItemsControl 祖先绑定的 ComboBoxItem，避免下拉关闭后绑定报错 -->
    <Style x:Key="DiagramEditorComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#F2F2F7"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DiagramEditorComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource DiagramEditorComboBoxItemStyle}"/>
    </Style>

    <!-- EPMA 模板编辑器：说明文档语言切换标签 -->
    <Style x:Key="EpmaHelpLanguageItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TokenBd" Background="#EBF3FF" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,8,8" Padding="12,6" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource ThemeAccentBrush}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TokenBd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TokenBd" Property="Background" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                            <Setter TargetName="TokenBd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="TokenBd" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EPMA 模板编辑器：说明文档格式按钮 -->
    <Style x:Key="EpmaHelpFormatButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F2F2F7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== EPMA 模板多语言窗口（macOS 风格） ========== -->
    <!-- 标题栏右上角的窗口控制按钮 -->
    <Style x:Key="EpmaLocCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#6E6E73"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0D000000"/>
                <Setter Property="Foreground" Value="#1D1D1F"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="EpmaLocCaptionCloseButton" TargetType="Button" BasedOn="{StaticResource EpmaLocCaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF3B30"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 表格单元格输入框：平时无边框，悬停变灰，聚焦时蓝色描边与外发光；占位文字取自 Tag -->
    <Style x:Key="EpmaLocInputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="#1D1D1F"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <!-- 不能再给 PART_ContentHost 加 Margin：TextBox 会把 Padding 自行应用到内容区，再加 Margin 等于内边距算了两次（文字被挤成一小条、光标比占位文字靠后） -->
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                <Border x:Name="Hint" Padding="{TemplateBinding Padding}" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock Text="{TemplateBinding Tag}" Margin="2,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                               Foreground="#C7C7CC" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- 聚焦描边：与 ReoGrid 表格选中单元格一致（2px 主题色实线边框 + 淡主题色底），盖在表面之上 -->
                        <Border x:Name="Ring" BorderThickness="2" CornerRadius="3" BorderBrush="{DynamicResource ThemeAccentBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F5F6F8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeAccentTintBrush}"/>
                            <Setter TargetName="Surface" Property="CornerRadius" Value="3"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 多语言表格公共样式（EPMA / 地质温压计 / 图解的“多语言”表共用）：单元格容器、输入框、左侧字段项标签 -->
    <Style x:Key="LocCellBox" TargetType="Border">
        <Setter Property="BorderBrush" Value="#0D000000"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>

    <!-- 单行格：自动换行 + 垂直居中（不接受回车）；长文本格（IsMultiline）顶端对齐并接受回车 -->
    <Style x:Key="LocCellInput" TargetType="TextBox" BasedOn="{StaticResource EpmaLocInputBox}">
        <Setter Property="Text" Value="{Binding Text,UpdateSourceTrigger=PropertyChanged}"/>
        <Setter Property="Tag" Value="{Binding Placeholder}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="5,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="5,6"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 左侧字段项名称：名称为深色，标签 / 分组为浅灰，描述（长文本）行顶端对齐 -->
    <Style x:Key="LocRowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#515154"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="16,10,8,10"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsTag}" Value="True">
                <Setter Property="Foreground" Value="#6E6E73"/>
                <Setter Property="Margin" Value="16,8,8,8"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                <Setter Property="Foreground" Value="#6E6E73"/>
                <Setter Property="Margin" Value="16,8,8,8"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDescription}" Value="True">
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Margin" Value="16,14,8,14"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 次级按钮（导入 / 导出 / 取消） -->
    <Style x:Key="EpmaLocButton" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#1D1D1F"/>
        <Setter Property="BorderBrush" Value="#1C000000"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8F8FA" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#26000000"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#F0F0F3"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 主按钮（确认） -->
    <Style x:Key="EpmaLocPrimaryButton" TargetType="Button" BasedOn="{StaticResource EpmaLocButton}">
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentDarkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeAccentGradientBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                <Setter Property="Background" Value="{DynamicResource SidebarSelectedHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 列头状态圆点：红 = 未填写，橙 = 部分填写，绿 = 已填完；DataContext 为 EpmaLocalizationColumn -->
    <Style x:Key="EpmaLocStatusDot" TargetType="ContentControl">
        <Setter Property="Width" Value="11.5"/>
        <Setter Property="Height" Value="11.5"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Ellipse x:Name="Ring" Fill="#26FF3B30"/>
                        <Ellipse x:Name="Dot" Width="6.5" Height="6.5" Fill="#FF3B30"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Partial">
                            <Setter TargetName="Ring" Property="Fill" Value="#29FF9500"/>
                            <Setter TargetName="Dot" Property="Fill" Value="#FF9500"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Complete">
                            <Setter TargetName="Ring" Property="Fill" Value="#2934C759"/>
                            <Setter TargetName="Dot" Property="Fill" Value="#34C759"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 页面顶栏（融入主窗口顶部） =====================
         主窗口不再有独立标题栏，每个页面在自己顶部放一条 44px 的 PageTitleBar：
         最左侧显示模块名称（Tag），中间/右侧放页面原有的工具栏内容；
         右侧固定预留 190px 给主窗口悬浮的通知中心/最小化/最大化/关闭按钮；
         空白处可拖动窗口、双击最大化。
         用法：<ContentControl Style="{StaticResource PageTitleBarStyle}" Tag="模块名称">…工具栏内容…</ContentControl> -->
    <Style x:Key="PageTitleBarStyle" TargetType="ContentControl">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Background" Value="#F2F2F7"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                            helpers:WindowDragHelper.IsDragHandle="True">
                        <Grid x:Name="Layout" Margin="18,0,190,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ModuleTitle" Text="{TemplateBinding Tag}" VerticalAlignment="Center" Margin="0,0,18,0"
                                       FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextWrapping="NoWrap"
                                       IsHitTestVisible="False"/>
                            <ContentPresenter Grid.Column="1"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 工作界面省略 Tag 时，同时收起模块名称及其间距。 -->
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="ModuleTitle" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="">
                            <Setter TargetName="ModuleTitle" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- 侧边栏完全收起时，主窗口左上角会悬浮一个展开按钮，模块名称让开 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source={x:Static layerModels:ShellLayoutState.Instance}, Path=IsSideBarVisible, Mode=OneWay}" Value="False"/>
                                <Condition Binding="{Binding Source={x:Static layerModels:ShellLayoutState.Instance}, Path=UseIconOnlySidebarCollapse, Mode=OneWay}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Layout" Property="Margin" Value="56,0,190,0"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 页面顶栏（自定义布局变体）：外观与 PageTitleBarStyle 一致，但不自动绘制模块名称、不加左边距，
         内容铺满整个顶栏（右侧仍为窗口按钮让出 190），适用于标题/菜单需要与下方列分隔线对齐的页面。 -->
    <Style x:Key="PageTitleBarCustomLayoutStyle" TargetType="ContentControl" BasedOn="{StaticResource PageTitleBarStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                            helpers:WindowDragHelper.IsDragHandle="True" Padding="0,0,190,0">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 页面顶栏菜单（文件 / 更新 等） =====================
         顶层项：胶囊式悬停高亮，展开时使用主题蓝淡色底；子菜单：白色圆角卡片 + 柔和阴影。
         用法：<Menu Style="{StaticResource TitleBarMenuStyle}"> 内的 MenuItem 自动应用样式 -->
    <Style x:Key="TitleBarSubMenuItemStyle" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Margin="6,1" Padding="10,5" CornerRadius="4"
                            Background="Transparent" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="TitleBarMenuGesture"/>
                            </Grid.ColumnDefinitions>
                            <!-- 左侧预留一个图标的宽度，便于后续补充图标 -->
                            <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"
                                              Margin="26,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                                       FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬浮样式与主程序左侧边栏选中样式一致 -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentGradientBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarMenuItemStyle" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TitleBarSubMenuItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Padding="12,6" CornerRadius="6" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Margin="10,4,10,14" Padding="0,4" MinWidth="240" Background="White"
                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" Opacity="0.14" BlurRadius="14" ShadowDepth="3" Direction="270"/>
                                </Border.Effect>
                                <Grid IsSharedSizeScope="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MacSidebarPressedBrush}"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MacSidebarPressedBrush}"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarMenuStyle" TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TitleBarMenuItemStyle}"/>
    </Style>

    <!-- ===================== 右键菜单（ContextMenu / MenuItem / Separator） =====================
         自绘一套：白色圆角卡片 + 柔和阴影，配色全部取自主题动态资源（随主题色切换）。
         · 悬停：浅主题色底 + 图标染主题色
         · 图标列：始终占位（18 宽 + 10 间距），没有图标的菜单项文字也与有图标的对齐
         · 危险操作（删除等）：给 MenuItem 设置 Tag="Danger"，悬停时使用红色调
         · 支持 IsCheckable 勾选、InputGestureText 快捷键文字、子菜单（Role=SubmenuHeader）
         · 以隐式样式应用于全应用的 ContextMenu / MenuItem；页面顶栏菜单（TitleBarMenuStyle）使用显式样式不受影响 -->
    <Style x:Key="AppMenuPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HomeLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#0F172A" Opacity="0.16" BlurRadius="18" ShadowDepth="4" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="12,4" Background="{DynamicResource HomeLineBrush}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <!-- 最小宽度包含左右各 12 的阴影边距（可见面板最小宽 168），个别菜单可在实例上覆盖 -->
        <Setter Property="MinWidth" Value="192"/>
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Margin 为阴影预留空间（Popup 已开启透明） -->
                    <Border Margin="12,10,12,14" Style="{StaticResource AppMenuPanelStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="-4" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!-- 兜底：即使分隔线上写了局部样式缺少 BasedOn，也可在菜单内取到统一外观 -->
            <Style TargetType="Separator" BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}"/>
        </Style.Resources>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Margin="6,1" MinHeight="26" Padding="8,0,10,0" CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AppMenuIconColumn"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AppMenuGestureColumn"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AppMenuArrowColumn"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 / 勾选标记（始终占位，即使没有图标也保留左侧间距） -->
                                <Border x:Name="IconHost" Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0"
                                        TextElement.FontSize="12"
                                        TextElement.Foreground="{DynamicResource HomeSubBrush}">
                                    <Grid>
                                        <ContentPresenter x:Name="Icon" ContentSource="Icon"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          SnapsToDevicePixels="True"/>
                                        <Path x:Name="CheckMark" Visibility="Collapsed" Width="12" Height="10" Stretch="Uniform"
                                              Data="M 1,5 L 4.5,8.5 L 11,1.5" StrokeThickness="1.8"
                                              Stroke="{DynamicResource ThemeAccentBrush}"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                                <!-- 快捷键文字（为空时不占位） -->
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0"
                                           FontSize="11" Foreground="{DynamicResource HomeMuteBrush}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InputGestureText, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 子菜单箭头 -->
                                <Path x:Name="Arrow" Grid.Column="3" Visibility="Collapsed" Margin="14,0,0,0"
                                      Width="5" Height="9" Stretch="Uniform" Data="M 0,0 L 4,4 L 0,8"
                                      Stroke="{DynamicResource HomeMuteBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 子菜单：与一级菜单同一外观，向右展开并略微压住父级边缘 -->
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-14" VerticalOffset="-17"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Margin="12" MinWidth="168" Style="{StaticResource AppMenuPanelStyle}">
                                <Grid IsSharedSizeScope="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-12"/>
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-10"/>
                        </Trigger>

                        <!-- 悬停 / 键盘选中 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                        </MultiTrigger>

                        <!-- 危险操作：Tag="Danger" -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Danger"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#FDECEC"/>
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="#D13438"/>
                            <Setter Property="Foreground" Value="#C62828"/>
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 页面顶栏文字按钮（返回 / 帮助 / 导出 等） =====================
         透明底 + 圆角悬停高亮，与 TitleBarMenuStyle 搭配放在 PageTitleBarStyle 内使用。
         用法：<Button Style="{StaticResource ToolbarButtonStyle}">…</Button> -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            ToolTip="{TemplateBinding ToolTip}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E5E5E5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#D1D1D1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 数据表格顶部工具栏（插入行 / 删除行 / 更多 / 投图） ==================== -->
    <!-- 基础模板：圆角底板 + 内容，所有状态色由各派生样式的 Style.Triggers 控制，便于派生样式覆盖 -->
    <Style x:Key="DataToolbarButtonBaseStyle" TargetType="ButtonBase">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="#2B3350"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 带文字的描边按钮（插入行 / 删除行） -->
    <Style x:Key="DataToolbarTextButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource DataToolbarButtonBaseStyle}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DFE3EE"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FAFBFE"/>
                <Setter Property="BorderBrush" Value="#C7CDE2"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#F0F2F8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 危险操作按钮：悬停时变红（删除行） -->
    <Style x:Key="DataToolbarDangerButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource DataToolbarTextButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#C2364B"/>
                <Setter Property="Background" Value="#FDECEF"/>
                <Setter Property="BorderBrush" Value="#EFC3CB"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#F9D9DE"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 展开下拉面板的切换按钮：展开时高亮，并让点击穿透以便面板（StaysOpen=False）正常收起，避免“关了又开” -->
    <Style x:Key="DataToolbarMenuToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DataToolbarTextButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- “更多”（三个点）图标按钮：无边框 -->
    <Style x:Key="DataToolbarMoreToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DataToolbarMenuToggleButtonStyle}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#C8C8C8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0F2F8"/>
                <Setter Property="BorderBrush" Value="#C8C8C8"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="#C8C8C8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 主按钮（投图） -->
    <Style x:Key="DataToolbarPrimaryButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource DataToolbarButtonBaseStyle}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 下拉菜单项按钮 -->
    <Style x:Key="DataToolbarMenuItemButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource DataToolbarButtonBaseStyle}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F3F5FB"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#E8ECF6"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 下拉面板外框 -->
    <Style x:Key="DataToolbarPopupPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E6E9F2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Margin" Value="4,2,10,12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#16204A"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 数据表行头状态点图例（颜色与 ReoGridTableAppearance.RowHeaderBody 保持一致） ==================== -->
    <Style x:Key="DataRowStatusLegendDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
    </Style>
    <Style x:Key="DataRowStatusOkDotStyle" TargetType="Ellipse" BasedOn="{StaticResource DataRowStatusLegendDotStyle}">
        <Setter Property="Fill" Value="#2EA043"/>
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>
    <Style x:Key="DataRowStatusErrorDotStyle" TargetType="Ellipse" BasedOn="{StaticResource DataRowStatusLegendDotStyle}">
        <Setter Property="Fill" Value="#C2364B"/>
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>
    <Style x:Key="DataRowStatusStaleDotStyle" TargetType="Ellipse" BasedOn="{StaticResource DataRowStatusLegendDotStyle}">
        <Setter Property="Stroke" Value="#E08A00"/>
    </Style>
    <Style x:Key="DataRowStatusIdleDotStyle" TargetType="Ellipse" BasedOn="{StaticResource DataRowStatusLegendDotStyle}">
        <Setter Property="Stroke" Value="#C3C8DC"/>
    </Style>
    <Style x:Key="DataRowStatusLegendTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#6B7392"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>

    <!-- ==================== ReoGrid 表格统一外观（EPMA 计算表格样式） ==================== -->
    <!-- 细滚动条：EPMA 工作台与所有 ReoGridTableHost 共用 -->
    <Style x:Key="GridThinScrollThumbStyle" TargetType="Thumb">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="18"/>
            </DataTrigger>
        </Style.Triggers>
        <Setter Property="Background" Value="#B8C2CE"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Background="{TemplateBinding Background}" CornerRadius="3" Margin="1"
                                Width="2" HorizontalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                            <Setter TargetName="Grip" Property="Width" Value="Auto"/>
                            <Setter TargetName="Grip" Property="Height" Value="2"/>
                            <Setter TargetName="Grip" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="Grip" Property="VerticalAlignment" Value="Center"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Vertical"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Grip" Property="Width" Value="6"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Grip" Property="Height" Value="6"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Vertical"/>
                                <Condition Binding="{Binding IsDragging, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Grip" Property="Width" Value="6"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"/>
                                <Condition Binding="{Binding IsDragging, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Grip" Property="Height" Value="6"/>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#8B99A9"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#64748B"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridThinScrollPageStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="GridThinScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreasePage" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource GridThinScrollPageStyle}"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource GridThinScrollThumbStyle}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreasePage" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource GridThinScrollPageStyle}"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="DecreasePage" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                            <Setter TargetName="IncreasePage" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorksheetBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#475569"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EDF4FC"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EDF4FC"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工作表栏上的开关按钮（检查器等）：与 WorksheetBarButtonStyle 同款，选中时高亮。 -->
    <Style x:Key="WorksheetBarToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#475569"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EDF4FC"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 右侧检查器摘要行里的导出 / 复制小按钮（与温压计检查器一致）；图标字体为 iconfont。 -->
    <FontFamily x:Key="InspectorIconFont">pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont</FontFamily>
    <Style x:Key="InspectorActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#888"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                            <Setter Property="Foreground" Value="#333"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D4D4D4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 完整的数据工作表：顶栏 + 原生列头 + 数据区 + 细滚动条 + 右侧检查器（可选）+ 底部状态栏。 -->
    <Style x:Key="ReoGridTableHostStyle" TargetType="{x:Type ctrl:ReoGridTableHost}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="InspectorTitle" Value="{Binding [sheet_inspector], Source={x:Static lg:LanguageService.Instance}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:ReoGridTableHost}">
                    <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border x:Name="PART_WorksheetBar" Height="40" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,0">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding ToolbarActions}" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="PART_InspectorToggle" DockPanel.Dock="Right" Style="{StaticResource WorksheetBarToggleStyle}" Margin="10,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsInspectorOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ToolTip="{Binding [sheet_inspector_tooltip], Source={x:Static lg:LanguageService.Instance}}"
                                              AutomationProperties.Name="{Binding [sheet_inspector], Source={x:Static lg:LanguageService.Instance}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                              Data="M1,2 H13 V12 H1 Z M9,2 V12 M3.5,7 H7 M5.5,5.2 L3.5,7 L5.5,8.8"/>
                                        <TextBlock Text="{Binding [sheet_inspector], Source={x:Static lg:LanguageService.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel x:Name="PART_Legend" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Rectangle Fill="White" Stroke="{DynamicResource ThemeAccentSoftBorderBrush}" Width="12" Height="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding [epma_input_editable], Source={x:Static lg:LanguageService.Instance}}" FontSize="11" Foreground="#64748B" Margin="0,0,14,0"/>
                                    <Rectangle Fill="{DynamicResource ThemeSheetOutputBrush}" Stroke="{DynamicResource ThemeAccentSoftBorderBrush}" Width="12" Height="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding [epma_output_readonly], Source={x:Static lg:LanguageService.Instance}}" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                                <StackPanel x:Name="PART_WorksheetTitle" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding [epma_worksheet], Source={x:Static lg:LanguageService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="PART_ResetLayout" DockPanel.Dock="Left" Style="{StaticResource WorksheetBarButtonStyle}" Margin="0,0,10,0" VerticalAlignment="Center"
                                        ToolTip="{Binding [epma_reset_worksheet_layout], Source={x:Static lg:LanguageService.Instance}}"
                                        AutomationProperties.Name="{Binding [epma_reset_worksheet_layout], Source={x:Static lg:LanguageService.Instance}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [refresh], Source={x:Static lg:LanguageService.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PART_Undo" DockPanel.Dock="Left" Style="{StaticResource WorksheetBarButtonStyle}" Margin="0,0,2,0" Padding="7,5" VerticalAlignment="Center"
                                        IsEnabled="{Binding CanUndo, RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTip="{Binding [sheet_undo], Source={x:Static lg:LanguageService.Instance}}"
                                        AutomationProperties.Name="{Binding [sheet_undo], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <Button x:Name="PART_Redo" DockPanel.Dock="Left" Style="{StaticResource WorksheetBarButtonStyle}" Margin="0,0,10,0" Padding="7,5" VerticalAlignment="Center"
                                        IsEnabled="{Binding CanRedo, RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTip="{Binding [sheet_redo], Source={x:Static lg:LanguageService.Instance}}"
                                        AutomationProperties.Name="{Binding [sheet_redo], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                    <Border Height="26" VerticalAlignment="Center" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3" Padding="8,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="PART_CellEditor" Style="{x:Null}" FontSize="13" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0"
                                                     Text="{Binding SelectedCellContent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsSelectedCellReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                                     ToolTip="{Binding SelectedCellContent, RelativeSource={RelativeSource TemplatedParent}}"
                                                     AutomationProperties.Name="{Binding [epma_cell_content], Source={x:Static lg:LanguageService.Instance}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedCellAddress, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#888888" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <!-- 左侧：表格 + 状态栏。检查器展开时整体向左被挤压。 -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <!-- 滚动条的布局根只包含表格，顶栏、状态栏与右侧检查器不参与可视区计算。 -->
                                <Grid x:Name="PART_Root" Grid.Row="0" ClipToBounds="True">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentPresenter/>
                                    <ScrollBar x:Name="PART_VerticalScroll" Grid.Column="1" Orientation="Vertical"
                                               Style="{StaticResource GridThinScrollBarStyle}" Visibility="Collapsed"/>
                                    <ScrollBar x:Name="PART_HorizontalScroll" Grid.Row="1" Orientation="Horizontal"
                                               Style="{StaticResource GridThinScrollBarStyle}" Visibility="Collapsed"/>
                                </Grid>
                                <!-- 状态栏：选区统计（计数 / 求和 / 平均 / 最小 / 最大）。 -->
                                <Border x:Name="PART_StatusBar" Grid.Row="1" Height="28" Padding="14,0" Background="{DynamicResource ThemeSheetRowHeaderBrush}" BorderBrush="{DynamicResource HomeLineBrush}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="{TemplateBinding SelectionSummary}" FontSize="11.5" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <!-- 右侧检查器：内容由各模块通过 Inspector 属性提供。
                                 外框宽度由代码做展开 / 收起动画（0 ⇄ InspectorWidth），内部内容保持固定宽度，动画过程中不会跟着重排。 -->
                            <Border x:Name="PART_Inspector" Grid.Column="1" Width="0" Visibility="Collapsed" ClipToBounds="True"
                                    Background="{DynamicResource ThemeSheetRowHeaderBrush}" BorderBrush="{DynamicResource HomeLineBrush}" BorderThickness="1,0,0,0">
                                <Grid Width="{TemplateBinding InspectorWidth}" HorizontalAlignment="Left">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="40" Padding="14,0,8,0" Background="White" BorderBrush="{DynamicResource HomeLineBrush}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <Button x:Name="PART_InspectorClose" DockPanel.Dock="Right" Style="{StaticResource WorksheetBarButtonStyle}" Padding="6,4" VerticalAlignment="Center"
                                                    ToolTip="{Binding [sheet_inspector_close], Source={x:Static lg:LanguageService.Instance}}"
                                                    AutomationProperties.Name="{Binding [sheet_inspector_close], Source={x:Static lg:LanguageService.Instance}}">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                            </Button>
                                            <TextBlock Text="{TemplateBinding InspectorTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <ContentPresenter Content="{TemplateBinding Inspector}"/>
                                </DockPanel>
                                <!-- 左边缘拖动条：手动调整检查器宽度（上限为软件窗口宽度的 2/3，由代码限制）。 -->
                                <Thumb x:Name="PART_InspectorResizer" HorizontalAlignment="Left" Width="6" Cursor="SizeWE" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowWorksheetBar" Value="False">
                            <Setter TargetName="PART_WorksheetBar" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_StatusBar" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ShowStatusBar" Value="False"><Setter TargetName="PART_StatusBar" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="HasInspector" Value="False"><Setter TargetName="PART_InspectorToggle" Property="Visibility" Value="Collapsed"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         通知系统（通知中心）：Toast 卡片 / Sheet 对话框 / 历史面板 / 铃铛
         延续主页 v2 的靛蓝品牌色 + 大圆角白卡 + 等宽元信息
         使用位置：Controls/Common/NotificationItem.xaml、NotificationSheet.xaml、
                  NotificationHistoryPanel.xaml、Views/MainWindow.xaml（标题栏铃铛）
         ============================================================ -->
    <SolidColorBrush x:Key="NotificationTitleBrush" Color="#16204A"/>
    <SolidColorBrush x:Key="NotificationMessageBrush" Color="#6B7392"/>
    <SolidColorBrush x:Key="NotificationMutedBrush" Color="#9AA1BB"/>
    <SolidColorBrush x:Key="NotificationDividerBrush" Color="#E9ECF4"/>
    <SolidColorBrush x:Key="NotificationChipBackgroundBrush" Color="#F1F3FA"/>
    <SolidColorBrush x:Key="NotificationChipHoverBrush" Color="#E4E8F6"/>
    <SolidColorBrush x:Key="NotificationCardBorderBrush" Color="#E9ECF4"/>
    <SolidColorBrush x:Key="NotificationAccentBrush" Color="#3C4A98"/>
    <SolidColorBrush x:Key="NotificationSuccessAccentBrush" Color="#34C759"/>
    <SolidColorBrush x:Key="NotificationTimerBarBrush" Color="#C7CDE8"/>
    <SolidColorBrush x:Key="NotificationTimerTrackBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="NotificationCardBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="NotificationUnreadDotBrush" Color="#007AFF"/>
    <!-- 铃铛未读角标。默认紫色，运行时由 AppThemeHelper 改成当前主题色。 -->
    <SolidColorBrush x:Key="NotificationBadgeBrush" Color="#3C4A98"/>

    <!-- 6 类通知 + 进度的语义实色（Sheet 大图标底色 / 进度条填充） -->
    <SolidColorBrush x:Key="NotificationInfoGradientBrush" Color="#248BFF"/>
    <SolidColorBrush x:Key="NotificationSuccessGradientBrush" Color="#34C759"/>
    <SolidColorBrush x:Key="NotificationWarningGradientBrush" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="NotificationErrorGradientBrush" Color="#FF453A"/>
    <SolidColorBrush x:Key="NotificationConfirmGradientBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="NotificationDialogGradientBrush" Color="#5E5CE6"/>
    <SolidColorBrush x:Key="NotificationProgressGradientBrush" Color="#3C4A98"/>

    <!-- 语义淡色底（Toast / 历史列表的圆形图标底，约 12% 透明度） -->
    <SolidColorBrush x:Key="NotificationInfoSoftBrush" Color="#1F248BFF"/>
    <SolidColorBrush x:Key="NotificationSuccessSoftBrush" Color="#2434C759"/>
    <SolidColorBrush x:Key="NotificationWarningSoftBrush" Color="#29FF9F0A"/>
    <SolidColorBrush x:Key="NotificationErrorSoftBrush" Color="#1FFF453A"/>
    <SolidColorBrush x:Key="NotificationConfirmSoftBrush" Color="#1F0A84FF"/>
    <SolidColorBrush x:Key="NotificationDialogSoftBrush" Color="#1F5E5CE6"/>
    <SolidColorBrush x:Key="NotificationProgressSoftBrush" Color="#EEF1FB"/>

    <!-- 语义文字 / 线条色（在白底上比实色深一档，保证可读） -->
    <SolidColorBrush x:Key="NotificationInfoTextBrush" Color="#0A6FE0"/>
    <SolidColorBrush x:Key="NotificationSuccessTextBrush" Color="#1E9E45"/>
    <SolidColorBrush x:Key="NotificationWarningTextBrush" Color="#B86E00"/>
    <SolidColorBrush x:Key="NotificationErrorTextBrush" Color="#D92D22"/>
    <SolidColorBrush x:Key="NotificationConfirmTextBrush" Color="#0A6FE0"/>
    <SolidColorBrush x:Key="NotificationDialogTextBrush" Color="#4D4BD0"/>
    <SolidColorBrush x:Key="NotificationProgressTextBrush" Color="#3C4A98"/>

    <!-- 按钮配色：主按钮使用品牌靛蓝，次级为浅灰蓝 -->
    <SolidColorBrush x:Key="NotificationPrimaryButtonBrush" Color="#3C4A98"/>
    <SolidColorBrush x:Key="NotificationPrimaryButtonHoverBrush" Color="#34418A"/>
    <SolidColorBrush x:Key="NotificationPrimaryButtonPressedBrush" Color="#2B3675"/>
    <SolidColorBrush x:Key="NotificationSecondaryButtonBrush" Color="#F1F3FA"/>
    <SolidColorBrush x:Key="NotificationSecondaryButtonHoverBrush" Color="#E4E8F6"/>
    <SolidColorBrush x:Key="NotificationDestructiveButtonBrush" Color="#1AFF453A"/>
    <SolidColorBrush x:Key="NotificationDestructiveButtonHoverBrush" Color="#2EFF453A"/>
    <SolidColorBrush x:Key="NotificationDestructiveForegroundBrush" Color="#D92D22"/>

    <!-- Toast 卡片 -->
    <Style x:Key="NotificationCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{StaticResource NotificationCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- 卡片阴影：两层叠加（远处柔和环境光 + 贴边接触阴影），对应 HTML 中的多层 box-shadow。
         阴影由卡片下方的不透明衬底投射，避免半透明卡片把阴影“透”出来发灰。 -->
    <Style x:Key="NotificationShadowAmbientStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#16204A" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.12" RenderingBias="Quality"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotificationShadowContactStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#16204A" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.06" RenderingBias="Quality"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sheet 对话框卡片：更大的圆角与更重的阴影，视觉重心在窗口中央 -->
    <Style x:Key="NotificationSheetCardStyle" TargetType="Border" BasedOn="{StaticResource NotificationCardStyle}">
        <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <Style x:Key="NotificationSheetShadowAmbientStyle" TargetType="Border" BasedOn="{StaticResource NotificationShadowAmbientStyle}">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#16204A" BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.18" RenderingBias="Quality"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotificationSheetShadowContactStyle" TargetType="Border" BasedOn="{StaticResource NotificationShadowContactStyle}">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#16204A" BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="0.07" RenderingBias="Quality"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左侧渐变圆角语义徽标 -->
    <Style x:Key="NotificationIconBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{StaticResource NotificationInfoGradientBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter Property="Background" Value="{StaticResource NotificationSuccessGradientBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                <Setter Property="Background" Value="{StaticResource NotificationWarningGradientBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter Property="Background" Value="{StaticResource NotificationErrorGradientBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Confirm">
                <Setter Property="Background" Value="{DynamicResource NotificationConfirmGradientBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="ThreeButton">
                <Setter Property="Background" Value="{StaticResource NotificationDialogGradientBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Choice">
                <Setter Property="Background" Value="{StaticResource NotificationDialogGradientBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Progress">
                <Setter Property="Background" Value="{DynamicResource NotificationProgressGradientBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 徽标内的线性图标（坐标系 24x24，置于 Viewbox 内缩放） -->
    <Style x:Key="NotificationIconPathStyle" TargetType="Path">
        <Setter Property="Stroke" Value="White"/>
        <Setter Property="StrokeThickness" Value="2.2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <!-- Info -->
        <Setter Property="Data" Value="M13 16 H12 V12 H11 M12 8 H12.01 M21 12 A9 9 0 1 1 3 12 A9 9 0 0 1 21 12 Z"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter Property="StrokeThickness" Value="2.6"/>
                <Setter Property="Data" Value="M5 13 L9 17 L19 7"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                <Setter Property="Data" Value="M12 9 V11.5 M12 15 H12.01 M10.29 3.86 L1.82 18 A2 2 0 0 0 3.53 21 H20.47 A2 2 0 0 0 22.18 18 L13.71 3.86 A2 2 0 0 0 10.29 3.86 Z"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter Property="Data" Value="M10 14 L14 10 M10 10 L14 14 M21 12 A9 9 0 1 1 3 12 A9 9 0 0 1 21 12 Z"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Confirm">
                <Setter Property="Data" Value="M8.228 9 C8.777 7.835 10.258 7 12 7 C14.21 7 16 8.343 16 10 C16 11.4 14.722 12.575 12.994 12.907 C12.452 13.011 12 13.447 12 14 M12 17 H12.01 M21 12 A9 9 0 1 1 3 12 A9 9 0 0 1 21 12 Z"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="ThreeButton">
                <Setter Property="StrokeThickness" Value="2.1"/>
                <Setter Property="Data" Value="M8 7 H5 A2 2 0 0 0 3 9 V18 A2 2 0 0 0 5 20 H19 A2 2 0 0 0 21 18 V9 A2 2 0 0 0 19 7 H16 M15 11 L12 14 M12 14 L9 11 M12 14 V4"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Choice">
                <Setter Property="StrokeThickness" Value="2.1"/>
                <Setter Property="Data" Value="M8 7 H5 A2 2 0 0 0 3 9 V18 A2 2 0 0 0 5 20 H19 A2 2 0 0 0 21 18 V9 A2 2 0 0 0 19 7 H16 M15 11 L12 14 M12 14 L9 11 M12 14 V4"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Progress">
                <Setter Property="Data" Value="M21 12 A9 9 0 1 1 18 5.3 M21 4 V9 H16"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 淡色圆形图标底（Toast 28px / 历史列表 26px）：语义色 12% 底 + 深一档的线条色 -->
    <Style x:Key="NotificationSoftBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="{StaticResource NotificationInfoSoftBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter Property="Background" Value="{StaticResource NotificationSuccessSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                <Setter Property="Background" Value="{StaticResource NotificationWarningSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter Property="Background" Value="{StaticResource NotificationErrorSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Confirm">
                <Setter Property="Background" Value="{DynamicResource NotificationConfirmSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="ThreeButton">
                <Setter Property="Background" Value="{StaticResource NotificationDialogSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Choice">
                <Setter Property="Background" Value="{StaticResource NotificationDialogSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Progress">
                <Setter Property="Background" Value="{DynamicResource NotificationProgressSoftBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NotificationSoftIconPathStyle" TargetType="Path" BasedOn="{StaticResource NotificationIconPathStyle}">
        <Setter Property="Stroke" Value="{StaticResource NotificationInfoTextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter Property="Stroke" Value="{StaticResource NotificationSuccessTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                <Setter Property="Stroke" Value="{StaticResource NotificationWarningTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter Property="Stroke" Value="{StaticResource NotificationErrorTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Confirm">
                <Setter Property="Stroke" Value="{DynamicResource NotificationConfirmTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="ThreeButton">
                <Setter Property="Stroke" Value="{StaticResource NotificationDialogTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Choice">
                <Setter Property="Stroke" Value="{StaticResource NotificationDialogTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Progress">
                <Setter Property="Stroke" Value="{DynamicResource NotificationProgressTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 进度条填充色：与淡色徽标的线条色一致，随 Kind 变化（进度完成转为成功后自动变绿） -->
    <Style x:Key="NotificationTaskBarFillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
        <Setter Property="Background" Value="{DynamicResource NotificationProgressGradientBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter Property="Background" Value="{StaticResource NotificationSuccessGradientBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter Property="Background" Value="{StaticResource NotificationErrorGradientBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 文本 -->
    <Style x:Key="NotificationTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource NotificationTitleBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NotificationMessageTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource NotificationMessageBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="NotificationMutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource NotificationMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 按钮基类：圆角 8，按下缩放 0.98 -->
    <Style x:Key="NotificationButtonBaseStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource NotificationMessageBrush}"/>
        <Setter Property="Background" Value="{DynamicResource NotificationSecondaryButtonBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮（品牌靛蓝） -->
    <Style x:Key="NotificationPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NotificationButtonBaseStyle}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource NotificationPrimaryButtonBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NotificationPrimaryButtonHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NotificationPrimaryButtonPressedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 次级中性按钮（取消 / 次要操作） -->
    <Style x:Key="NotificationSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NotificationButtonBaseStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NotificationSecondaryButtonHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 破坏性动作按钮（不保存 / 强制退出） -->
    <Style x:Key="NotificationDestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource NotificationButtonBaseStyle}">
        <Setter Property="Foreground" Value="{StaticResource NotificationDestructiveForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource NotificationDestructiveButtonBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource NotificationDestructiveButtonHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 复制小按钮（警告 / 错误卡片） -->
    <Style x:Key="NotificationCopyChipStyle" TargetType="Button" BasedOn="{StaticResource NotificationButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NotificationChipBackgroundBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NotificationChipHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 卡片底部的文字操作按钮（撤销 / 查看 / 取消）：无底色，主要操作用品牌色加粗 -->
    <Style x:Key="NotificationActionLinkStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource NotificationMessageBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="label" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="label" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource HomeBrandBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Sheet 单选列表：圆点 + 文本的整行选项，选中行淡靛蓝底 -->
    <Style x:Key="NotificationChoiceItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource NotificationMessageBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Padding="10,7" CornerRadius="8" Background="Transparent" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse x:Name="ring" Stroke="#B8BED6" StrokeThickness="1.5"/>
                                <Ellipse x:Name="dot" Margin="3.5" Fill="{DynamicResource HomeBrandBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#F4F6FC"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HomeSoftBrush}"/>
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource HomeBrandBrush}"/>
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource NotificationTitleBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NotificationChoiceListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NotificationChoiceItemStyle}"/>
    </Style>

    <!-- 勿扰开关（28×16 胶囊滑块） -->
    <Style x:Key="NotificationSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Width="28" Height="16" CornerRadius="8" Background="#D5DAEE" SnapsToDevicePixels="True">
                        <Ellipse x:Name="thumb" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.2"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource HomeBrandBrush}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 历史面板头部的文字链接（清除全部） -->
    <Style x:Key="NotificationHeaderLinkStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource HomeBrandBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="label" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏铃铛按钮：与相邻的帮助 / 窗口按钮同尺寸（46×44），带未读角标；面板展开时高亮 -->
    <Style x:Key="NotificationBellButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20"
                              UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6 8 A6 6 0 0 1 18 8 C18 15 21 17 21 17 H3 C3 17 6 15 6 8 M10.3 21 A2 2 0 0 0 13.7 21"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <!-- 未读角标。白圈画在底色外侧，不占用内容区，避免描边把数字挤偏。
                                 Segoe UI 数字的墨迹中心比行框中心低约 0.6px，Margin 上移 1 后视觉上才落在圆心。 -->
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-8,0"
                                  MinWidth="16" Height="16" UseLayoutRounding="True"
                                  Visibility="{Binding HasUnread, Source={x:Static lg:NotificationManager.Instance}, Converter={StaticResource NotificationBoolToVisibilityConverter}}">
                                <Border Background="White" CornerRadius="9" Margin="-1" IsHitTestVisible="False"/>
                                <Border Background="{DynamicResource NotificationBadgeBrush}" CornerRadius="8" Padding="4,0"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <TextBlock Text="{Binding UnreadText, Source={x:Static lg:NotificationManager.Instance}}"
                                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,-1,0,0"
                                               TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}"
                                               TextOptions.TextRenderingMode="Grayscale"
                                               TextOptions.TextHintingMode="Fixed"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#E5E5E5"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsHistoryOpen, Source={x:Static lg:NotificationManager.Instance}}" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource HomeSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource HomeBrandBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 右上角常驻关闭按钮（圆形底、悬停加深，按下轻微缩小） -->
    <Style x:Key="NotificationCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg"
                            CornerRadius="9"
                            Background="Transparent"
                            RenderTransformOrigin="0.5,0.5">
                        <Path x:Name="icon"
                              Data="M0 0 L6 6 M6 0 L0 6"
                              Stroke="#9AA1BB"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#F1F3FA"/>
                            <Setter TargetName="icon" Property="Stroke" Value="#16204A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 主题色标签胶囊（EPMA 模板标签 / 地质温压计标签与能力），颜色随主题色切换 ===== -->
    <Style x:Key="ThemeTagChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ThemeTagChipTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentDeepBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== 内容包标识（PackageId）弱化文字：浅灰、小字号，不抢标题视觉 ===== -->
    <Style x:Key="ContentPackageIdTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#A0A6B0"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ===== EPMA 官方模板服务器状态胶囊（未下载 / 可更新 / 需升级软件） ===== -->
    <Style x:Key="EpmaStatusChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFF4E5"/>
        <Setter Property="BorderBrush" Value="#F5D9A8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="EpmaStatusChipTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#B26A00"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== EPMA 更新进度遮罩 ===== -->
    <Style x:Key="EpmaUpdateOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="#80000000"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Panel.ZIndex" Value="1000"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsUpdateOverlayVisible}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- =====================================================================
         设置 · 界面语言选择器（Controls/Common/LanguageSelector）
         国旗为矢量图（30×20 视口，与原型 SVG 一致），不依赖 emoji / 位图；
         颜色取自主页配色画刷（HomeInk / HomeSub / HomeMute / HomeBrand / HomeSoft），随主题色切换。
         ===================================================================== -->
    <conv:FlagKeyToImageSourceConverter x:Key="FlagKeyToImageSourceConverter"/>

    <!-- 国旗：Flag.{FlagKey} -->
    <DrawingImage x:Key="Flag.CN">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,30,20" RadiusX="3.75" RadiusY="3.75"/>
