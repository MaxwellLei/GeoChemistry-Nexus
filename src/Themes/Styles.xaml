    <!-- 国旗 / 角标：24×16，数据上下文为 AppLanguageOption -->
    <DataTemplate x:Key="LanguageFlagTemplate">
        <Grid Width="24" Height="16" SnapsToDevicePixels="True">
            <Image Source="{Binding FlagKey, Converter={StaticResource FlagKeyToImageSourceConverter}}"
                   Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFlag}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <Border CornerRadius="3" Background="{DynamicResource HomeSoftBrush}"
                    BorderBrush="{DynamicResource ThemeAccentSoftBorderBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFlag}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding BadgeText}" FontSize="10.5" FontWeight="Bold"
                           Foreground="{DynamicResource HomeBrandBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- 触发按钮：白底圆角边框；悬停加深边框；展开时边框取主题色并带 3px 外发光 -->
    <Style x:Key="LanguageSelectorTriggerStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D9DEEA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Glow" Margin="-3" CornerRadius="7" BorderThickness="3"
                                BorderBrush="{DynamicResource ThemeAccentTintStrongBrush}"
                                IsHitTestVisible="False" Visibility="Collapsed"/>
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#BFC6DC"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#BFC6DC"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉列表：透明底、无边框，内边距与原型一致（左右 6px） -->
    <Style x:Key="LanguageSelectorListStyle" TargetType="ListBox" BasedOn="{StaticResource AppListBoxStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="MaxHeight" Value="250"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="ItemContainerStyle" Value="{DynamicResource LanguageSelectorItemStyle}"/>
    </Style>

    <!-- 列表项：悬停 / 键盘选中为浅灰蓝底；当前语言为主题浅色底 -->
    <Style x:Key="LanguageSelectorItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F3F5FB"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F3F5FB"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HomeSoftBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 底部快捷键提示的键帽 -->
    <Style x:Key="LanguageSelectorKbdBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#E1E5EF"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="LanguageSelectorKbdTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeSubBrush}"/>
    </Style>

    <!-- ====================================================================
         统一“添加语言”选择器（Controls/Common/LanguagePicker）
         图解 / 地质温压计 / EPMA 模板编辑器共用
         ==================================================================== -->

    <!-- 触发按钮：主题色文字链接 + 前置图标（图标字符通过 Tag 指定，Segoe MDL2 Assets） -->
    <Style x:Key="LanguagePickerTriggerStyle" TargetType="Button" BasedOn="{StaticResource ThemeLinkButtonStyle}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Tag" Value="&#xE710;"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 弹层标题行右侧的“全选”：主题色文字链接。 -->
    <Style x:Key="LanguagePickerSelectAllButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemeLinkButtonStyle}">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 弹层外壳：白底圆角 + 投影（外层 Margin 为阴影预留空间，需与 LanguagePicker.cs 中的 PopupShadowMargin 一致） -->
    <Style x:Key="LanguagePickerPopupSurfaceStyle" TargetType="Border">
        <Setter Property="Margin" Value="24"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HomeLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0,0,0,6"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#16204A" Opacity="0.16" BlurRadius="24" ShadowDepth="8" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 候选语言行：悬停浅灰蓝底；已添加的语言用灰色文字 -->
    <Style x:Key="LanguagePickerItemStyle" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#F3F5FB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource HomeSubBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 地质温压计：筛选控件（图标按钮 + 搜索 + 双栏勾选气泡） ===== -->
    <SolidColorBrush x:Key="GeoTFilterInkBrush" Color="#16204A"/>
    <SolidColorBrush x:Key="GeoTFilterSubBrush" Color="#6B7392"/>
    <SolidColorBrush x:Key="GeoTFilterMuteBrush" Color="#9AA1B8"/>
    <SolidColorBrush x:Key="GeoTFilterLineBrush" Color="#EEF0F6"/>
    <SolidColorBrush x:Key="GeoTFilterRowHoverBrush" Color="#F5F6FB"/>
    <SolidColorBrush x:Key="GeoTFilterBoxBorderBrush" Color="#C7CCDC"/>

    <!-- 实心主题色图标按钮 -->
    <Style x:Key="GeoTFilterButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{DynamicResource ThemeAccentBrush}" CornerRadius="8"/>
                        <Border x:Name="Overlay" Background="Black" CornerRadius="8" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主题色文字链接按钮（全选 / 清除） -->
    <Style x:Key="GeoTFilterLinkButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Hover" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="6" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource GeoTFilterMuteBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="Hover" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 整行勾选项：Tag 用于显示右侧的次要说明文字 -->
    <Style x:Key="GeoTFilterCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource GeoTFilterInkBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="6,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4"
                                    Background="White" BorderThickness="1.5"
                                    BorderBrush="{StaticResource GeoTFilterBoxBorderBrush}">
                                <Path x:Name="Check" Visibility="Collapsed" Data="M 1,4.2 L 3.8,7 L 9,1"
                                      Stretch="Uniform" Width="8" Height="6.5"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="False"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding Tag}" FontSize="10.5"
                                       Foreground="{StaticResource GeoTFilterMuteBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GeoTFilterRowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 轻量对话框（无边框、圆角、投影）：用于“添加 / 编辑链接”等小型表单 ===== -->
    <!-- 阴影衬底：只投射阴影，不包裹真实内容，避免 Effect 栅格化内部控件导致文字发虚 -->
    <Style x:Key="DialogShadowStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#16204A" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.22" RenderingBias="Quality"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DialogCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="#E3E8EF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="DialogFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="Margin" Value="2,0,0,6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DialogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="9"/>
    </Style>
    <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="11,0,2,0"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="9"/>
    </Style>

    <!-- 对话框按钮：次要（取消）/ 主要（确认） -->
    <Style x:Key="DialogButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DDE3EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.64"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 对话框右上角关闭按钮：圆形悬停底，悬停转红 -->
    <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="15">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#FEE9E7"/>
                            <Setter Property="Foreground" Value="#E5483B"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#FCD5D1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         属性面板（Inspector）：圆角卡片 + 卡片内标题，字段统一为浅灰填充圆角输入框。
         用于 Controls/DiagramEditor 下的各个属性面板；视觉规格对应 Design/PropertyPanels/index.html。
         ==================================================================== -->
    <SolidColorBrush x:Key="InspectorFieldBrush" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="InspectorFieldHoverBrush" Color="#EAEEF4"/>
    <SolidColorBrush x:Key="InspectorCardBorderBrush" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="InspectorLabelBrush" Color="#66768B"/>
    <SolidColorBrush x:Key="InspectorHintBrush" Color="#8793A3"/>
    <SolidColorBrush x:Key="InspectorTextBrush" Color="#1D2433"/>
    <SolidColorBrush x:Key="InspectorStrongTextBrush" Color="#263549"/>
    <SolidColorBrush x:Key="InspectorDividerBrush" Color="#E3E5E8"/>
    <SolidColorBrush x:Key="InspectorRowDividerBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="InspectorSubtleSurfaceBrush" Color="#F8F9FB"/>
    <SolidColorBrush x:Key="InspectorControlBorderBrush" Color="#DDE3EC"/>
    <SolidColorBrush x:Key="InspectorStartDotBrush" Color="#22A06B"/>
    <SolidColorBrush x:Key="InspectorEndDotBrush" Color="#E5484D"/>
    <FontFamily x:Key="InspectorMonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- 开关（34×20） -->
    <Style x:Key="InspectorSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10" Background="#C9D0DA"/>
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分组头部整行的点击区域（折叠 / 展开） -->
    <Style x:Key="InspectorHeaderHitStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" CornerRadius="12"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分组卡片：标题在卡片内部的头部 -->
    <Style x:Key="InspectorGroupStyle" TargetType="ctrl:InspectorGroup">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource InspectorCardBorderBrush}"/>
        <Setter Property="Padding" Value="12,2,12,12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:InspectorGroup">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="HeaderRow" MinHeight="36">
                                <ToggleButton x:Name="HeaderHit" Style="{StaticResource InspectorHeaderHitStyle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <Grid Margin="14,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" ContentSource="Header" IsHitTestVisible="False"
                                                      VerticalAlignment="Center" RecognizesAccessKey="False"
                                                      TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{StaticResource InspectorLabelBrush}"/>
                                    <Border x:Name="CountBadge" Grid.Column="1" Margin="6,0,0,0" Padding="6,1" CornerRadius="8"
                                            Background="#EEF1F6" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Count}" FontSize="10.5"
                                                   Foreground="{StaticResource InspectorHintBrush}"/>
                                    </Border>
                                    <ContentPresenter Grid.Column="3" ContentSource="HeaderRight" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="HeaderSwitch" Grid.Column="4" Visibility="Collapsed" Margin="2,0,0,0"
                                                  Style="{StaticResource InspectorSwitchStyle}"
                                                  IsChecked="{Binding IsSwitchOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                    <Path x:Name="Chevron" Grid.Column="5" Margin="8,0,0,0" IsHitTestVisible="False"
                                          Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource InspectorHintBrush}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" CenterX="4" CenterY="2"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Grid>

                            <ContentPresenter x:Name="Body" Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Count" Value="">
                            <Setter TargetName="CountBadge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasSwitch" Value="True">
                            <Setter TargetName="HeaderSwitch" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsCollapsible" Value="False">
                            <Setter TargetName="HeaderHit" Property="IsHitTestVisible" Value="False"/>
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" CenterX="4" CenterY="2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasSwitch" Value="True"/>
                                <Condition Property="IsSwitchOn" Value="False"/>
                                <Condition Property="SwitchMode" Value="Dim"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Body" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Body" Property="IsEnabled" Value="False"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasSwitch" Value="True"/>
                                <Condition Property="IsSwitchOn" Value="False"/>
                                <Condition Property="SwitchMode" Value="Hide"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ctrl:InspectorGroup" BasedOn="{StaticResource InspectorGroupStyle}"/>

    <!-- 面板顶部标题栏：强调色小图标 + 标题 + 行内灰色摘要 + 右侧附加内容 -->
    <Style x:Key="InspectorHeaderStyle" TargetType="ctrl:InspectorHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:InspectorHeader">
                    <Border Background="White" BorderBrush="{StaticResource InspectorDividerBrush}"
                            BorderThickness="0,0,0,1" MinHeight="38" Padding="12,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource ThemeAccentBrush}">
                                <TextBlock Text="{TemplateBinding Glyph}"
                                           FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont"
                                           FontSize="13" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" Margin="9,0,0,0"
                                       FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InspectorTextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="SummaryText" Grid.Column="2" Text="{TemplateBinding Summary}" Margin="10,0,0,0"
                                       FontSize="12" Foreground="{StaticResource InspectorHintBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="3" ContentSource="HeaderRight" Margin="8,0,0,0" VerticalAlignment="Center"
                                              Visibility="{TemplateBinding HeaderRightVisibility}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Summary" Value="">
                            <Setter TargetName="SummaryText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ctrl:InspectorHeader" BasedOn="{StaticResource InspectorHeaderStyle}"/>

    <!-- 左标签 + 右控件的一行（需要父级设置 Grid.IsSharedSizeScope 以对齐标签列） -->
    <Style x:Key="InspectorRowStyle" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="52" SharedSizeGroup="InspectorLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Header" Margin="0,0,8,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="False"
                                          TextElement.FontSize="12"
                                          TextElement.Foreground="{StaticResource InspectorLabelBrush}"/>
                        <ContentPresenter Grid.Column="1" ContentSource="Content" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 上标签 + 下控件（用于两列并排的字段） -->
    <Style x:Key="InspectorFieldStyle" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <ContentPresenter ContentSource="Header" Margin="0,0,0,4" RecognizesAccessKey="False"
                                          TextElement.FontSize="11"
                                          TextElement.Foreground="{StaticResource InspectorHintBrush}"/>
                        <ContentPresenter ContentSource="Content"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分组内的小标题（如“副标题”“起点”） -->
    <Style x:Key="InspectorMiniLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource InspectorHintBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="InspectorDividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="#EEF0F4"/>
    </Style>

    <!-- 文本框 -->
    <Style x:Key="InspectorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
        <Setter Property="Foreground" Value="{StaticResource InspectorTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource InspectorFieldBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="7"/>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="Padding" Value="10,7"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 等宽字体文本框（函数表达式、顶点坐标等） -->
    <Style x:Key="InspectorMonoTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InspectorTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InspectorMonoFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- 下拉项：圆角、悬停浅灰、选中为强调色浅底 -->
    <Style x:Key="InspectorComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource InspectorTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InspectorFieldBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉框：浅灰填充、无边框；展开 / 聚焦时变白并出现强调色描边；弹层为圆角卡片 -->
    <Style x:Key="InspectorComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource InspectorTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource InspectorFieldBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="10,0,2,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="7"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource InspectorComboBoxItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Path=(ctrl:ControlAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Selection" Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed"
                                     Margin="{TemplateBinding Padding}" Padding="0" BorderThickness="0" Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}"
                                     SelectionBrush="{DynamicResource ThemeAccentBrush}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" FocusVisualStyle="{x:Null}"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock x:Name="Placeholder" Visibility="Collapsed" IsHitTestVisible="False"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{Binding Path=(ctrl:ControlAssist.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource AppTextHintBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis"/>
                            <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2"
                                          Style="{StaticResource AppComboBoxToggleStyle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" HorizontalOffset="-8"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Margin="8,2,8,14" Padding="6" CornerRadius="12" Background="White"
                                    BorderBrush="{StaticResource InspectorCardBorderBrush}" BorderThickness="1"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{Binding ActualWidth, ElementName=Root}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="DropDownToggle" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="DropDownToggle" Property="Grid.ColumnSpan" Value="1"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="False"/>
                                <Condition Property="SelectedIndex" Value="-1"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True"/>
                                <Condition Property="Text" Value=""/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InspectorFieldHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppDangerBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 数值框：前缀标题（ControlAssist.Title，可在其上左右拖动调整）+ 右对齐数值 + 单位（InspectorAssist.Unit）；
         悬停 / 聚焦时增减按钮单独占右侧一列，数字向左让开，单位先隐去；只读或关闭按钮时该列不占宽度 -->
    <Style x:Key="InspectorNumericUpDownStyle" TargetType="ctrl:NumericUpDown">
        <Setter Property="Foreground" Value="{StaticResource InspectorTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource InspectorFieldBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="7"/>
        <Setter Property="ctrl:InspectorAssist.DragAdjust" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:NumericUpDown">
                    <Border x:Name="Bd" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(ctrl:ControlAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TitleText" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch"
                                           Padding="0,7" Background="Transparent" Cursor="SizeWE"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource InspectorHintBrush}"
                                           Text="{Binding Path=(ctrl:ControlAssist.Title), RelativeSource={RelativeSource TemplatedParent}}"
                                           Width="{Binding Path=(ctrl:ControlAssist.TitleWidth), RelativeSource={RelativeSource TemplatedParent}}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="PART_TextBox" Style="{x:Null}" Margin="0" Padding="0"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}"
                                             SelectionBrush="{DynamicResource ThemeAccentBrush}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" FocusVisualStyle="{x:Null}"
                                             InputMethod.IsInputMethodEnabled="False"
                                             VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                    <TextBlock x:Name="Placeholder" Visibility="Collapsed" IsHitTestVisible="False"
                                               Text="{Binding Path=(ctrl:ControlAssist.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{StaticResource AppTextHintBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <TextBlock x:Name="UnitText" Grid.Column="2" Margin="5,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" FontSize="11.5"
                                           Foreground="{StaticResource InspectorHintBrush}"
                                           Text="{Binding Path=(ctrl:InspectorAssist.Unit), RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <!-- 贴在输入框右边缘；默认折叠不占宽度，悬停 / 聚焦时展开，数字向左让开 -->
                            <Border x:Name="SpinHost" Grid.Column="1" Width="14"
                                    Visibility="Collapsed">
                                <Border.Clip>
                                    <MultiBinding Converter="{StaticResource RightRoundedClipConverter}">
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="(ctrl:ControlAssist.CornerRadius)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.Clip>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <RepeatButton x:Name="PART_UpButton" Style="{StaticResource InspectorNumericSpinButtonStyle}">
                                        <Path Data="M 0,1.8 L 1.8,0 L 3.6,1.8" Stretch="None" StrokeThickness="1.15"
                                              Margin="0,4,2,0"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"/>
                                    </RepeatButton>
                                    <RepeatButton x:Name="PART_DownButton" Grid.Row="1" Style="{StaticResource InspectorNumericSpinButtonStyle}">
                                        <Path Data="M 0,0 L 1.8,1.8 L 3.6,0" Stretch="None" StrokeThickness="1.15"
                                              Margin="0,0,2,4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"/>
                                    </RepeatButton>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PART_TextBox" Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InspectorFieldHoverBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsReadOnly" Value="False"/>
                                <Condition Property="ShowUpDownButton" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SpinHost" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="UnitText" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                <Condition Property="IsReadOnly" Value="False"/>
                                <Condition Property="ShowUpDownButton" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SpinHost" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="UnitText" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                        <Trigger Property="ShowUpDownButton" Value="False">
                            <Setter TargetName="SpinHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InspectorDividerBrush}"/>
                            <Setter TargetName="SpinHost" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="UnitText" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource InspectorLabelBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppDangerBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滑块：细轨道 + 强调色已填充段 + 白色圆形滑块 -->
    <Style x:Key="InspectorSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Knob" Fill="White" Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InspectorSliderTrackButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InspectorSliderStyle" TargetType="Slider">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                        <Border Height="4" CornerRadius="2" Background="#DDE3EC" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource InspectorSliderTrackButtonStyle}"
                                              Background="{DynamicResource ThemeAccentBrush}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource InspectorSliderThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource InspectorSliderTrackButtonStyle}"
                                              Background="Transparent"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标按钮（拾取、交换、删除等）：24×24 -->
    <Style x:Key="InspectorIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource InspectorLabelBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险图标按钮（删除）：悬停变红 -->
    <Style x:Key="InspectorDangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource InspectorIconButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FDECEA"/>
                            <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FBD5D1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小号次要按钮（头部操作、列表底部“添加”等）：白底描边 -->
    <Style x:Key="InspectorSmallButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource InspectorStrongTextBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource InspectorControlBorderBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F7F9FC"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按钮（浅灰填充） -->
    <Style x:Key="InspectorGhostButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource InspectorLabelBrush}"/>
        <Setter Property="Background" Value="{StaticResource InspectorFieldBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 整宽次要按钮（36 高、圆角 9、白底描边） -->
    <Style x:Key="InspectorSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource InspectorSmallButtonStyle}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F7F9FC"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮（导出、验证）：强调色实心，36 高、圆角 9 -->
    <Style x:Key="InspectorPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 粗体 / 斜体等切换按钮：选中为强调色实心白字 -->
    <Style x:Key="InspectorToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource InspectorLabelBrush}"/>
        <Setter Property="Background" Value="{StaticResource InspectorFieldBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InspectorFieldHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段选择器：外框 + 单选项 -->
    <Style x:Key="InspectorSegmentTrackStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InspectorFieldBrush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <Style x:Key="InspectorSegmentRadioStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Foreground" Value="{StaticResource InspectorLabelBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E3E8F0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InspectorControlBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 迷你分段选择器（分组头部右侧用） -->
    <Style x:Key="InspectorMiniSegmentTrackStyle" TargetType="Border" BasedOn="{StaticResource InspectorSegmentTrackStyle}">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="InspectorMiniSegmentRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource InspectorSegmentRadioStyle}">
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="9,0"/>
    </Style>

    <!-- 分段选择器（ListBox 版本，用于绑定项集合，如导出格式） -->
    <Style x:Key="InspectorSegmentedItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource InspectorLabelBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E3E8F0"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InspectorControlBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InspectorSegmentedListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource InspectorFieldBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource InspectorSegmentedItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下划线标签页（坐标轴面板顶部）：整栏白底，底部分隔线，选中项强调色加粗 + 2px 下划线 -->
    <Style x:Key="InspectorTabBarStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource InspectorDividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="6,0"/>
    </Style>

    <Style x:Key="InspectorTabRadioStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource InspectorLabelBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="Underline" Height="2" CornerRadius="2,2,0,0" Margin="12,0"
                                VerticalAlignment="Bottom" Visibility="Collapsed"
                                Background="{DynamicResource ThemeAccentBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource InspectorTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 卡片式单选列表项（导出格式 / 第三方程序）：白底描边卡片，悬停强调色描边，选中强调色浅底 -->
    <Style x:Key="InspectorCardItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource InspectorCardBorderBrush}"
                            BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InspectorCardGridItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource InspectorCardItemStyle}">
        <Setter Property="Margin" Value="4"/>
    </Style>

    <!-- 竖排卡片列表 -->
    <Style x:Key="InspectorCardListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource InspectorCardItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 两列网格卡片列表（外层请设置 Margin="-4" 抵消卡片间距） -->
    <Style x:Key="InspectorCardGridListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource InspectorCardListBoxStyle}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource InspectorCardGridItemStyle}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图例位置：迷你图中的 6 个落点，选中项为带两条短线的图例块 -->
    <Style x:Key="InspectorSpotRadioStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#C9D1DE"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="Chip" Visibility="Collapsed" CornerRadius="5" Padding="6,0"
                                Background="White" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1.5">
                            <StackPanel VerticalAlignment="Center">
                                <Rectangle Height="2.5" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource ThemeAccentBrush}" Margin="0,0,0,3"/>
                                <Rectangle Height="2.5" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource ThemeAccentSoftBorderBrush}" Width="14" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Chip" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 表格单元格数值框（顶点表）：无底色，左对齐等宽字体，悬停 / 聚焦时才显示填充 -->
    <Style x:Key="InspectorCellNumericUpDownStyle" TargetType="ctrl:NumericUpDown" BasedOn="{StaticResource InspectorNumericUpDownStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="{StaticResource InspectorMonoFont}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="ShowUpDownButton" Value="False"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="0"/>
        <Setter Property="ctrl:InspectorAssist.DragAdjust" Value="False"/>
    </Style>

    <!-- 图例位置落点：未选中为浅灰圆点，悬停出现虚线框，选中时在该落点画出缩小的图例（横 / 纵排列、隐藏时变为虚线灰色，取自 DataContext 的 Orientation / IsVisible） -->
    <Style x:Key="InspectorLegendSpotRadioStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="HoverBox" Margin="-7" RadiusX="8" RadiusY="8" StrokeThickness="1.5"
                                   StrokeDashArray="3 2" Stroke="Transparent" Fill="Transparent"/>
                        <Ellipse x:Name="Ghost" Width="10" Height="10" Fill="#D5DBE5"
                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Grid x:Name="LegendBox" Visibility="Collapsed" IsHitTestVisible="False"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Rectangle x:Name="Frame" RadiusX="6" RadiusY="6" Fill="White" StrokeThickness="1.5"
                                       Stroke="{DynamicResource ThemeAccentBrush}">
                                <Rectangle.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.14" Color="#1E2850"/>
                                </Rectangle.Effect>
                            </Rectangle>
                            <StackPanel x:Name="Items" Orientation="Vertical" Margin="5,2.5">
                                <StackPanel Orientation="Horizontal" Margin="2.5">
                                    <Rectangle x:Name="Sq1" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="#3C4A98" Margin="0,0,4,0"/>
                                    <Rectangle Width="18" Height="4" RadiusX="2" RadiusY="2" Fill="#C5CCD8"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2.5">
                                    <Rectangle x:Name="Sq2" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="#E4572E" Margin="0,0,4,0"/>
                                    <Rectangle Width="18" Height="4" RadiusX="2" RadiusY="2" Fill="#C5CCD8"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2.5">
                                    <Rectangle x:Name="Sq3" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="#2E8B57" Margin="0,0,4,0"/>
                                    <Rectangle Width="18" Height="4" RadiusX="2" RadiusY="2" Fill="#C5CCD8"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBox" Property="Stroke" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                            <Setter TargetName="HoverBox" Property="Fill" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter TargetName="Ghost" Property="Fill" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="HoverBox" Property="Stroke" Value="Transparent"/>
                            <Setter TargetName="HoverBox" Property="Fill" Value="Transparent"/>
                            <Setter TargetName="Ghost" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="LegendBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Orientation}" Value="Horizontal">
                            <Setter TargetName="Items" Property="Orientation" Value="Horizontal"/>
                            <Setter TargetName="Items" Property="Margin" Value="2.5,5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                            <Setter TargetName="LegendBox" Property="Opacity" Value="0.55"/>
                            <Setter TargetName="Frame" Property="Stroke" Value="#B8C0CE"/>
                            <Setter TargetName="Frame" Property="StrokeDashArray" Value="3 2"/>
                            <Setter TargetName="Frame" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="Sq1" Property="Fill" Value="#B8C0CE"/>
                            <Setter TargetName="Sq2" Property="Fill" Value="#B8C0CE"/>
                            <Setter TargetName="Sq3" Property="Fill" Value="#B8C0CE"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图例位置小图的背景：细网格线（模拟绘图区） -->
    <DrawingBrush x:Key="InspectorChartAreaBrush" TileMode="Tile" Viewport="0,0,0.16666,0.25" ViewportUnits="RelativeToBoundingBox" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FCFDFE">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#EEF1F6">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,1,0.03"/>
                            <RectangleGeometry Rect="0,0,0.02,1"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 表格列标题文字（顶点表、数据系列表共用） -->
    <Style x:Key="InspectorTableHeaderLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource InspectorHintBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 表格底部整行“添加”条：主题色文字，悬停浅色底 -->
    <Style x:Key="InspectorAddBarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#FBFCFE" BorderBrush="{StaticResource InspectorRowDividerBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,11,11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 脚本状态块：就绪（灰）/ 通过（绿）/ 错误（红）三种底色，由 Tag 切换 -->
    <Style x:Key="InspectorStatusBoxStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Background" Value="#F7F8FA"/>
        <Setter Property="BorderBrush" Value="{StaticResource InspectorCardBorderBrush}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Ok">
                <Setter Property="Background" Value="#F4F9F5"/>
                <Setter Property="BorderBrush" Value="#D5E8DB"/>
            </Trigger>
            <Trigger Property="Tag" Value="Error">
                <Setter Property="Background" Value="#FFF4F2"/>
                <Setter Property="BorderBrush" Value="#F4CFC9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 页面顶栏「下载 / 更新全部（N）」批量按钮：图解 / 地质温压计 / EPMA 共用。
         主题色实心的紧凑小按钮；内容由使用处提供（图标 TextBlock + 文字 TextBlock）。 -->
    <Style x:Key="BatchActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Harker 多联图设置页 ==================== -->

    <!-- 变量 Chip：选中=强调色浅底；未选中=灰色删除线；被 X 占用(IsEnabled=False)=半透明 -->
    <Style x:Key="HarkerChipToggleStyle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="2,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ChipBorder" CornerRadius="4" Padding="8,4"
                            Background="#F0F4FF" BorderThickness="1" BorderBrush="#D6E4F9">
                        <TextBlock x:Name="ChipText" Text="{TemplateBinding Content}"
                                   FontSize="12" Foreground="{DynamicResource ThemeAccentBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="ChipBorder" Property="Background" Value="#F5F5F5"/>
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#E8E8E8"/>
                            <Setter TargetName="ChipText" Property="Foreground" Value="#AAA"/>
                            <Setter TargetName="ChipText" Property="TextDecorations" Value="Strikethrough"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ChipBorder" Property="Background" Value="#DCE8FB"/>
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#B0CBF0"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ChipBorder" Property="Background" Value="#EAEAEA"/>
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#D0D0D0"/>
                            <Setter TargetName="ChipText" Property="Foreground" Value="#666"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 方形小图标按钮（步进 / 上移 / 下移），Content 为 Segoe MDL2 字形或文字 -->
    <Style x:Key="HarkerSquareButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" Background="White" BorderBrush="#D9D9D9" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 预设 / 分段按钮（行×列预设、图例位置等小型选择按钮） -->
    <Style x:Key="HarkerPresetButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D9D9D9"/>
        <Setter Property="Foreground" Value="#444"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" Padding="10,4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="12"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 预览格子（点击选两格互换） -->
    <Style x:Key="HarkerPreviewCellButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#F0F4FF"/>
        <Setter Property="BorderBrush" Value="#D6E4F9"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCE8FB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
