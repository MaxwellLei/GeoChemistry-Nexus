    <Style x:Key="LineIconStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Viewbox Margin="{TemplateBinding Padding}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding Tag}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="{TemplateBinding Content}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round"
                                  StrokeLineJoin="Round" StrokeDashArray="0.3 1.9"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Style Sidebar RadioButton -->
    <Style x:Key="ModernSidebarRadioButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                             <Setter TargetName="Border" Property="Background" Value="#E5E5EA"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SidebarSelectedHoverBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Style Card -->
    <Style x:Key="ModernCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E5E5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Modern Style Group Title -->
    <Style x:Key="ModernGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#8E8E93"/>
        <Setter Property="Margin" Value="4,0,0,8"/>
    </Style>

    <!-- Modern Style Label -->
    <Style x:Key="ModernLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Marker shape icon grid (scatter property panel) -->
    <Style x:Key="MarkerShapePickerListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style x:Key="MarkerShapePickerItemStyle" TargetType="ListBoxItem">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource InspectorFieldBrush}"/>
                            
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented Control Item Style (ListBoxItem) -->
    <Style x:Key="SegmentedItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Border" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="#E0E0E0"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border.BorderThickness>
                            <MultiBinding Converter="{StaticResource ListBoxItemBorderThicknessConverter}">
                                <Binding RelativeSource="{RelativeSource TemplatedParent}"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                            </MultiBinding>
                        </Border.BorderThickness>
                        <Border.CornerRadius>
                            <MultiBinding Converter="{StaticResource ListBoxItemCornerRadiusConverter}">
                                <Binding RelativeSource="{RelativeSource TemplatedParent}"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                            </MultiBinding>
                        </Border.CornerRadius>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,8"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Border" Property="Margin" Value="-1"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#E5E5E5"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented Control Style (ListBox) -->
    <Style x:Key="SegmentedControlStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 选中底色由滑块绘制。文字不挂 Effect，避免高 DPI 下选中项被栅格化发糊 -->
    <Style x:Key="TemplateCardSizeSegmentedItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="6,0"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True"
                                          UseLayoutRounding="True"
                                          TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}"
                                          TextOptions.TextRenderingMode="ClearType"
                                          RenderOptions.ClearTypeHint="Enabled"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E4E4E4"/>
                            <Setter Property="Foreground" Value="#333333"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#333333"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#333333"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 空状态主按钮（蓝底白字，带投影） -->
    <Style x:Key="EmptyStatePrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="{DynamicResource AppTextFormattingMode}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 空状态次按钮（白底灰边） -->
    <Style x:Key="EmptyStateSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#444"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="18,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="{DynamicResource AppTextFormattingMode}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="White" BorderBrush="#E1E4E8" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Button Style -->
    <Style x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#0051A8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="#A0A0A0"/>
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox Style (Minimal) -->
    <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
        <Setter Property="Background" Value="#F2F2F7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Modern Icon Button Style (Small) -->
    <Style x:Key="ModernIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#F2F2F7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#E5E5EA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#D1D1D6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Modern Numeric UpDown Style -->
    <Style x:Key="ModernNumericUpDownStyle" TargetType="ctrl:NumericUpDown" BasedOn="{StaticResource AppNumericUpDownStyle}">
        <Setter Property="Background" Value="#F2F2F7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- ModernSettingsGroupTitle -->
    <Style x:Key="ModernSettingsGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource ModernGroupTitleStyle}">
         <Setter Property="Margin" Value="16,20,0,8"/>
    </Style>

    <!-- ModernSettingsCard -->
    <Style x:Key="ModernSettingsCard" TargetType="Border" BasedOn="{StaticResource ModernCardStyle}">
         <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- ModernSettingsItemHintStyle：设置项标题下方的灰色说明 -->
    <Style x:Key="ModernSettingsItemHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#86868B"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- ===== 设置 · 默认第三方编辑程序：带徽标与检测状态的下拉（设计稿 E1） =====
         尺寸按本软件设置页调整：触发器 32 高 / 12.5 字号，列表项 34 高，弹窗比触发器宽 1/4。
         颜色取自主题画刷，随主题色切换；徽标为通用字母标识（非官方 Logo）。 -->

    <conv:ScaleOffsetConverter x:Key="ThirdPartyEditorScaleOffsetConverter"/>
    <conv:PopupRightAlignedRectConverter x:Key="ThirdPartyEditorPopupRectConverter"/>

    <!-- 程序徽标：字母徽标；“自定义”项显示文件夹图形 -->
    <DataTemplate x:Key="ThirdPartyEditorBadgeTemplate">
        <Border x:Name="Badge" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center"
                Background="{Binding BadgeBackground}" SnapsToDevicePixels="True">
            <Grid>
                <TextBlock x:Name="Mono" Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}"
                           FontSize="9.5" FontWeight="ExtraBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path x:Name="Folder" Visibility="Collapsed" Width="12" Height="10"
                      Data="M0.8,1 L4.2,1 L5.6,2.6 L11.2,2.6 L11.2,9 L0.8,9 Z"
                      Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCustom}" Value="True">
                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                <Setter TargetName="Mono" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Folder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 触发器（收起状态）内容：徽标 + 名称 -->
    <DataTemplate x:Key="ThirdPartyEditorTriggerTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ThirdPartyEditorBadgeTemplate}"/>
            <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                       Text="{Binding TriggerText}" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </DataTemplate>

    <!-- 状态圆点 / 文字：已就绪为绿色，其余为灰色 -->
    <Style x:Key="ThirdPartyEditorStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource HomeMuteBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsStatusOk}" Value="True">
                <Setter Property="Fill" Value="#1F9D6B"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThirdPartyEditorStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeMuteBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsStatusOk}" Value="True">
                <Setter Property="Foreground" Value="#1F9D6B"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 下拉项：徽标 + 名称 + 状态 + 选中对勾 -->
    <Style x:Key="ThirdPartyEditorComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" MinHeight="34" CornerRadius="7" Padding="9,0,9,0"
                            Background="Transparent" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ThirdPartyEditorBadgeTemplate}"/>
                            <TextBlock x:Name="NameText" Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center"
                                       FontSize="12.5" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource ThirdPartyEditorStatusDotStyle}"/>
                                <TextBlock Style="{StaticResource ThirdPartyEditorStatusTextStyle}" Text="{Binding StatusText}"/>
                            </StackPanel>
                            <Path x:Name="Check" Grid.Column="3" Visibility="Hidden" Width="14" Height="12"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Data="M1.5,6.5 L5,10 L12.5,2" Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppRegionHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 触发器上的整块点击区域（箭头由模板自绘，打开时旋转） -->
    <Style x:Key="ThirdPartyEditorComboBoxToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThirdPartyEditorComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="ItemTemplate" Value="{StaticResource ThirdPartyEditorTriggerTemplate}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThirdPartyEditorComboBoxItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <!-- 聚焦 / 展开时的外圈光晕 -->
                        <Border x:Name="Glow" Margin="-3" CornerRadius="10" BorderThickness="3"
                                BorderBrush="{DynamicResource ThemeAccentTintBrush}" Visibility="Collapsed"
                                IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Margin="10,0,0,0" IsHitTestVisible="False"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Path x:Name="Chevron" Grid.Column="1" Data="M0,0 L4,4 L8,0" Width="9" Height="5" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                  RenderTransformOrigin="0.5,0.5"
                                  Stroke="{StaticResource AppTextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                            <ToggleButton Grid.ColumnSpan="2" Style="{StaticResource ThirdPartyEditorComboBoxToggleStyle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <!-- 弹窗宽度 = 触发器 × 1.3，可见内容右缘与触发器右缘严格对齐、向左加宽。
                             用 PopupAlignHelper 的自定义定位回调（设备像素），不受 UI 缩放 / DPI 影响；
                             RightInset = 内容外层右侧阴影留白 12 -->
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade"
                               helpers:PopupAlignHelper.RightInset="12"
                               helpers:PopupAlignHelper.AlignRightEdge="True"
                               PlacementTarget="{Binding ElementName=Root}">
                            <Popup.IsOpen>
                                <Binding Path="IsDropDownOpen" Mode="TwoWay" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </Popup.IsOpen>
                            <!-- 外层留出阴影空间；内层宽度至少为触发器的 1.3 倍 -->
                            <Border Margin="12,4,12,16" Padding="5" CornerRadius="10" Background="White"
                                    BorderBrush="{DynamicResource HomeLineBrush}" BorderThickness="1"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{Binding ActualWidth, ElementName=Root, Converter={StaticResource ThirdPartyEditorScaleOffsetConverter}, ConverterParameter=1.3}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#16204A" Opacity="0.13" BlurRadius="18" ShadowDepth="5" Direction="270"/>
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 自定义程序路径区：浅底圆角容器 + 等宽字体路径输入框 -->
    <Style x:Key="ThirdPartyEditorPathPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#F7F8FC"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HomeLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style x:Key="ThirdPartyEditorPathTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
        <Setter Property="ctrl:ControlAssist.CornerRadius" Value="6"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <!-- 路径提示：默认灰色；校验失败时的红色在页面里用 DataTrigger 覆盖 -->
    <Style x:Key="ThirdPartyEditorPathHintStyle" TargetType="TextBlock" BasedOn="{StaticResource ModernSettingsItemHintStyle}">
        <Setter Property="Margin" Value="2,6,0,0"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeMuteBrush}"/>
    </Style>

    <!-- ===== 设置 · 快捷键页：键帽。颜色取自主题画刷，随主题色切换 ===== -->

    <!-- 键帽外框 -->
    <Style x:Key="ShortcutKbdBorderStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D6DAE6"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 键帽文字 -->
    <Style x:Key="ShortcutKbdTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- ===== 设置 · 关于页：元素卡片风格。颜色全部取自主题画刷（AppThemeHelper），随主题色即时切换 ===== -->

    <!-- 头部卡片底纹：细网格 -->
    <DrawingBrush x:Key="AboutHeroGridBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"
                  Viewbox="0,0,24,24" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,0.5 L24,0.5 M0.5,0 L0.5,24">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource HomeLineBrush}" Thickness="1"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 关于页白色卡片 -->
    <Style x:Key="AboutCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HomeLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- 头部“元素格”：轻微倾斜，悬停时回正并放大 -->
    <Style x:Key="AboutElementGroupStyle" TargetType="Grid">
        <Setter Property="Width" Value="190"/>
        <Setter Property="Height" Value="190"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="-2"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 元素格下方的投影层（与白色外圈叠放，只露出阴影，避免文字被模糊） -->
    <Style x:Key="AboutElementShadowStyle" TargetType="Border">
        <Setter Property="Margin" Value="8"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ThemeAccentColor}" BlurRadius="34" ShadowDepth="14" Direction="270" Opacity="0.5"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 元素格白色外圈 -->
    <Style x:Key="AboutElementRingStyle" TargetType="Border">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HomeLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>

    <!-- 社区卡片按钮 -->
    <Style x:Key="AboutBondButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="White" BorderBrush="{DynamicResource HomeLineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{DynamicResource ThemeAccentColor}" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 社区卡片左侧的小“元素格” -->
    <Style x:Key="AboutBondTileStyle" TargetType="Border">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="5,4"/>
    </Style>
    <Style x:Key="AboutBondTileIndexStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="AboutBondTileSymbolStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style x:Key="AboutBondLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeSubBrush}"/>
    </Style>
    <Style x:Key="AboutBondValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 设置列表行：左侧标签 -->
    <Style x:Key="AboutRowKeyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,4,12,0"/>
    </Style>

    <!-- 标签：强调色（技术栈） -->
    <DataTemplate x:Key="AboutAccentChipTemplate">
        <Border Background="{DynamicResource ThemeAccentSoftBrush}" CornerRadius="6" Padding="10,2" Margin="0,3,6,3">
            <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}"/>
        </Border>
    </DataTemplate>

    <!-- 标签：中性（开源组件） -->
    <DataTemplate x:Key="AboutChipTemplate">
        <Border Background="{DynamicResource ThemeChipBrush}" CornerRadius="6" Padding="10,2" Margin="0,3,6,3">
            <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource HomeInkBrush}"/>
        </Border>
    </DataTemplate>

    <!-- 品牌矢量图标（与主页欢迎横幅右侧同款）：三块晶面均取自主题画刷，随主题色切换。用法：<ContentControl Template="{StaticResource BrandGlyphTemplate}"/> -->
    <ControlTemplate x:Key="BrandGlyphTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="170" Height="136">
                <Polygon Points="58,8 125,8 116,63 41,114 7,102 8,68"
                         Fill="{DynamicResource ThemeGlyphBrush}" Stroke="{DynamicResource ThemeGlyphBrush}"
                         StrokeLineJoin="Round" StrokeThickness="5"/>
                <Polygon Points="140,7 163,75 148,90 129,64"
                         Fill="{DynamicResource ThemeAccentDeepBrush}" Stroke="{DynamicResource ThemeAccentDeepBrush}"
                         StrokeLineJoin="Round" StrokeThickness="5"/>
                <Polygon Points="119,75 136,97 94,129 57,118"
                         Fill="{DynamicResource ThemeAccentLighterBrush}" Stroke="{DynamicResource ThemeAccentLighterBrush}"
                         StrokeLineJoin="Round" StrokeThickness="5"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- 特别感谢：圆点 + 姓名 -->
    <DataTemplate x:Key="AboutThanksItemTemplate">
        <StackPanel Orientation="Horizontal" Margin="0,0,28,10">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding}" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource HomeInkBrush}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ThemeSwatchListBoxStyle / ThemeSwatchItemStyle：设置页“主题颜色”的圆形色块选择器 -->
    <Style x:Key="ThemeSwatchListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeSwatchItemStyle" TargetType="ListBoxItem">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTip" Value="{Binding DisplayName}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Ring" Stroke="{Binding SwatchBrush}" StrokeThickness="2" Opacity="0"/>
                        <Ellipse x:Name="Dot" Margin="5" Fill="{Binding SwatchBrush}"/>
                        <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ThemeLinkButtonStyle：全软件统一的“主题色文字链接按钮”（检查更新 / 新建 / 添加语言 / 编辑多语言 等）。
        前景使用 ThemeLinkBrush（比主色更浅，适合放在侧边栏等浅色背景上），悬停时出现浅色底。
        内容由使用方提供（文字或图标 + 文字）；带图标的场景请直接使用 Controls/Common/IconLinkButton。
        要整体调整链接配色，只需修改 AppThemeHelper 中的 ThemeLinkBrush / ThemeLinkHoverBackgroundBrush。
    -->
    <Style x:Key="ThemeLinkButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ThemeLinkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeLinkHoverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AutoCloseStepperButtonStyle：自动关闭时间步进器左右两侧的 − / + 按钮 -->
    <Style x:Key="AutoCloseStepperButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeSubBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F3F4F9"/>
                            <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#D0D4E2"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="Surface" Property="Background" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButtonSwitch -->
    <Style x:Key="ToggleButtonSwitch" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="#E9E9EA"/>
        <Setter Property="BorderBrush" Value="#E9E9EA"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                        <Ellipse x:Name="Ellipse" Fill="White" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.3" Direction="270" Color="Black"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Setter TargetName="Ellipse" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Ellipse" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxBaseStyle -->
    <Style x:Key="ComboBoxBaseStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E5E5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
        <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid Name="MainGrid" SnapsToDevicePixels="true">
                        <Popup Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" Placement="Bottom" Margin="1" IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                            <Border x:Name="DropDownBorder" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}">
                                <ScrollViewer Name="DropDownScrollViewer">
                                    <Grid RenderOptions.ClearTypeHint="Enabled">
                                        <Canvas Height="0" Width="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Rectangle Name="OpaqueRect" Height="{Binding ElementName=DropDownBorder, Path=ActualHeight}" Width="{Binding ElementName=DropDownBorder, Path=ActualWidth}" Fill="{Binding ElementName=DropDownBorder, Path=Background}" />
                                        </Canvas>
                                        <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                        <ToggleButton Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Grid.ColumnSpan="2" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                             <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="20" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Arrow" Grid.Column="1" Fill="#999" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                             </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,23,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ButtonIcon -->
    <Style x:Key="ButtonIcon" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F0F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeLinkTileBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="#1A000000"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <!-- Avoid per-tile DropShadowEffect: it forces expensive bitmap effects on every group switch -->
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FAFAFA"/>
                <Setter Property="BorderBrush" Value="#33000000"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeLinkTitleHostStyle" TargetType="Grid">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>

    <Style x:Key="HomeLinkTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#1C1C1E"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="14"/>
        <Setter Property="MaxHeight" Value="28"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="MaxWidth" Value="64"/>
    </Style>

    <Style x:Key="HomeLinkDescriptionToolTipStyle" TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#3C3C43"/>
        <Setter Property="BorderBrush" Value="#E5E5EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeWidgetPanelTileStyle" TargetType="Border">
        <Setter Property="Background" Value="#FAFAFC"/>
        <Setter Property="BorderBrush" Value="#E5E5EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0F4FF"/>
                <Setter Property="BorderBrush" Value="#B8D4FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeToolbarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#AEAEB2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="8"
                            ClipToBounds="False"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="0" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#08000000"/>
                            <Setter Property="Foreground" Value="#8E8E93"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#12000000"/>
                            <Setter Property="Foreground" Value="#636366"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主页滚过一半后，顶栏右侧淡入的「回到顶部」。出现与消失由 HomeScrollEdge 做透明度动画。 -->
    <Style x:Key="HomeBackToTopButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#C8CDD6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HomeSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HomeSoftBrush}"/>
                            <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主页分段控件：与设置页 TemplateCardSizeSegmented 同一视觉。
         外层容器内放官方分组 ListBox + “个人”按钮，视觉上是一个整体 -->
    <Style x:Key="HomeSegmentedWrapStyle" TargetType="Border">
        <Setter Property="Background" Value="#EEEEEE"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="HomeGroupTabListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段控件选项：选中底色由滑块绘制，文字本身不挂 Effect，避免高 DPI 下发糊 -->
    <Style x:Key="HomeGroupTabItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource TemplateCardSizeSegmentedItemStyle}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="6,0"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True"
                                          UseLayoutRounding="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E4E4E4"/>
                            <Setter Property="Foreground" Value="#333333"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#333333"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#333333"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段控件内的“个人”按钮：与 TemplateCardSizeSegmentedItemStyle 同视觉（跟随 IsSelectedGroupPersonal） -->
    <Style x:Key="HomePersonalTabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="6,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          SnapsToDevicePixels="True"
                                          UseLayoutRounding="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E4E4E4"/>
                            <Setter Property="Foreground" Value="#333333"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelectedGroupPersonal}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#333333"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 主页 · 半透明卡片视觉 ===== -->

    <!-- 半透明白卡（约 90% 不透明度，替代毛玻璃） -->
    <Style x:Key="HomeGlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#E6FFFFFF"/>
        <Setter Property="BorderBrush" Value="#B3FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- 公告大卡右上高光叠层（保持圆角，无需裁剪） -->
    <RadialGradientBrush x:Key="HomeHeroHighlightBrush" Center="0.88,0.05" GradientOrigin="0.88,0.05" RadiusX="0.75" RadiusY="1.4">
        <GradientStop Color="#38FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>

    <!-- 自定义图片上的底部压暗，保证白字可读 -->
    <LinearGradientBrush x:Key="HomeHeroImageScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.28"/>
        <GradientStop Color="#59000000" Offset="0.68"/>
        <GradientStop Color="#A6000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- 公告轮播导航按钮：平时只显示白色图标，悬停时深灰圆形底 -->
    <Style x:Key="HomeHeroNavButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#666666"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#555555"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 公告动作：透明文字按钮，无底无边框 -->
    <Style x:Key="HomeHeroActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"/>
                            <TextBlock Text=">" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 公告眉题标签（胶囊） -->
    <Style x:Key="HomeHeroTagStyle" TargetType="Border">
        <Setter Property="Background" Value="#2EFFFFFF"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 公告分页点 -->
    <Style x:Key="HomeHeroDotStyle" TargetType="Border">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Background" Value="#73FFFFFF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Background" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 主页 v2：编辑式版面（问候 + 轮播公告 + 小组件 + 导航站侧栏） ===== -->
    <SolidColorBrush x:Key="HomeInkBrush" Color="#16204A"/>
    <SolidColorBrush x:Key="HomeSubBrush" Color="#6B7392"/>
    <SolidColorBrush x:Key="HomeMuteBrush" Color="#9AA1BB"/>
    <SolidColorBrush x:Key="HomeLineBrush" Color="#E9ECF4"/>
    <SolidColorBrush x:Key="HomeBrandBrush" Color="#3C4A98"/>
    <SolidColorBrush x:Key="HomeSoftBrush" Color="#EEF1FB"/>

    <!-- 白色内容卡 -->
    <Style x:Key="HomeSurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HomeLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- 分区小标题（“公告 · ANNOUNCEMENTS”） -->
    <Style x:Key="HomeSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeMuteBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 轮播页文字：浅色底用深色字；使用自定义图片背景时改回白字 -->
    <Style x:Key="HomeSlideTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="MaxHeight" Value="68"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeSlideBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeSubBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="MaxHeight" Value="154"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                <Setter Property="Foreground" Value="#E6FFFFFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeSlideMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeSubBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                <Setter Property="Foreground" Value="#B3FFFFFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeSlideTagBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#B3FFFFFF"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                <Setter Property="Background" Value="#2EFFFFFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeSlideTagTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeBrandBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeSlideActionButtonStyle" TargetType="Button" BasedOn="{StaticResource HomeHeroActionButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource HomeBrandBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 轮播圆形导航按钮 -->
    <Style x:Key="HomeCarouselRoundButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeBrandBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="White" BorderBrush="#D5DAEE" BorderThickness="1" CornerRadius="17">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HomeSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 轮播底部缩略条的条目：无选中底色，由内容模板自己表现当前项 -->
    <Style x:Key="HomeAnnouncementStripItemStyle" TargetType="ListBoxItem">
        <Setter Property="Width" Value="190"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource HomeLineBrush}"
                            BorderThickness="0,0,1,0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FAFBFE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 缩略条当前项的进度条：6 秒填满，与自动轮播间隔一致 -->
    <Style x:Key="HomeAnnouncementProgressBarStyle" TargetType="Border">
        <Setter Property="Height" Value="3"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="{DynamicResource HomeBrandBrush}"/>
        <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <!-- 使用处需在元素上本地设置 RenderTransform（ScaleTransform），Style 内的变换对象是冻结的，无法做动画 -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="HomeProgressStoryboard">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             From="0" To="1" Duration="0:0:6"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="HomeProgressStoryboard"/>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeAnnouncementStripTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource HomeInkBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource HomeBrandBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 小组件行 -->
    <Style x:Key="HomeWidgetRowStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{DynamicResource HomeLineBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 图标底块（小组件 / 链接共用） -->
    <Style x:Key="HomeIconBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HomeSoftBrush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 导航站卡片 -->
    <Style x:Key="HomeLinkCardStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="10"/>
        <!-- 宽度与间距由 EvenWrapPanel 决定：按可用宽度算列数，并让每列等宽铺满 -->
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HomeSoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 主页“添加小组件”气泡面板 ===== -->
    <!-- 气泡卡片下方的阴影衬底（Popup 需 AllowsTransparency，阴影由不透明衬底投射） -->
    <Style x:Key="HomePopupShadowStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#16204A" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.17" RenderingBias="Quality"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小组件条目整行按钮：悬停浅底，点击即切换“添加 / 移除” -->
    <Style x:Key="HomeWidgetPickerRowStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HomeSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E3E8F8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 条目右侧圆形状态：未添加=空心 +，悬停=实心 +；已添加=实心 ✓，悬停=红色 −（再点移除） -->
    <Style x:Key="HomeWidgetPickerIndicatorStyle" TargetType="Border">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="BorderBrush" Value="#CDD3E8"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource HomeBrandBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource HomeBrandBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                <Setter Property="Background" Value="{DynamicResource HomeBrandBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource HomeBrandBrush}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsAdded}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#FDECEC"/>
                <Setter Property="BorderBrush" Value="#F1B5B5"/>
            </MultiDataTrigger>
