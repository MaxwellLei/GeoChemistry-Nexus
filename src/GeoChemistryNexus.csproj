<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Data\Icon\GeoChemistryNexus_Icon.ico</ApplicationIcon>
	<!--软件版本号-->
    <AssemblyVersion>0.9.0</AssemblyVersion>
    <!--程序文件版本号：与软件版本保持一致（不再承载图解格式版本） -->
    <FileVersion>$(AssemblyVersion)</FileVersion>
	<!--图解格式版本号 x.y.z -->
    <DiagramFormatVersion>1.3.0</DiagramFormatVersion>
    <!--地质温压计格式版本号 x.y.z -->
    <GeothermometerFormatVersion>1.3.0</GeothermometerFormatVersion>
    <!--EPMA 模块版本号 x.y.z，从 1.0 起；前两位是模块版本 -->
    <EpmaFormatVersion>1.0.0</EpmaFormatVersion>
    <Copyright>Copyright ©️ 2024</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Release 发布时禁用调试符号输出与发布 (不生成且不复制 .pdb 文件)，启用 ReadyToRun 优化冷启动性能 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>


  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DiagramFormatVersion</_Parameter1>
      <_Parameter2>$(DiagramFormatVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GeothermometerFormatVersion</_Parameter1>
      <_Parameter2>$(GeothermometerFormatVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EpmaFormatVersion</_Parameter1>
      <_Parameter2>$(EpmaFormatVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Data\Documents\template.rtf" />
    <None Remove="Data\Icon\iconfont.ttf" />
    <None Remove="Data\Icon\GeoChemistryNexus_Icon.ico" />
    <None Remove="Data\Plugins\GeoTMineralCategories.json" />
    <None Remove="Data\Config\App.config" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\Documents\template.rtf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Data\Icon\iconfont.ttf" />
    <Resource Include="Data\Icon\GeoChemistryNexus_Icon.ico" />
    <Resource Include="Data\Image\Startup\rock-thin-section.png" />
    <Content Include="Data\Plugins\GeoTMineralCategories.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Home\HomeLinksCatalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Home\Announcements.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Home\elements_geochem.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Home\chronostratigraphy.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="Data\Config\App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>GeoChemistryNexus.dll.config</TargetPath>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tencent.QCloud.Cos.Sdk" Version="5.4.49" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Jint" Version="4.2.0" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="unvell.ReoGridWPF.dll" Version="3.3.0" />
    <PackageReference Include="ScottPlot.WPF" Version="5.0.56" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Data\Language\Language.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Language.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Data\Language\Language.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Language.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Others\**\*" />
    <Page Remove="Others\**\*" />
    <EmbeddedResource Remove="Others\**\*" />
    <None Remove="Others\**\*" />
  </ItemGroup> 

</Project>
