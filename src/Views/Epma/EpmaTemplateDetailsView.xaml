<UserControl x:Class="GeoChemistryNexus.Views.EpmaTemplateDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Background="White"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        <DataTemplate x:Key="Tag">
            <Border Style="{StaticResource ThemeTagChipBorderStyle}" Margin="0,0,6,6" Padding="8,3">
                <TextBlock Text="{Binding Mode=OneWay}" Style="{StaticResource ThemeTagChipTextStyle}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,16,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewIcon" Background="#F3F3F5" CornerRadius="8" Width="44" Height="44">
                    <Border.Style><Style TargetType="Border"><Setter Property="Grid.RowSpan" Value="2"/></Style></Border.Style>
                    <Viewbox Margin="4" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Icon}"
                               Foreground="{DynamicResource ThemeAccentBrush}"
                               FontWeight="SemiBold" FontSize="18"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/></Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewName" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1D1D1F" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorPreview,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="FontSize" Value="14"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border x:Name="PreviewIdentifier" Grid.Column="1" CornerRadius="4">
                    <Border.Style><Style TargetType="Border">
                        <Setter Property="Grid.Row" Value="1"/><Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="12,6,8,0"/><Setter Property="Padding" Value="8,2"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsEditorPreview,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="12,3,0,0"/>
                        </DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                    <TextBlock Text="{Binding Id}" ToolTip="{Binding Id}" FontSize="11" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsEditorPreview,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Foreground" Value="#7A8798"/><Setter Property="FontFamily" Value="Consolas"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
            <TextBlock x:Name="PreviewTagsLabel" Text="{Binding [epma_library_tags],Source={x:Static lg:LanguageService.Instance}}">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}"><Style.Triggers><DataTrigger Binding="{Binding HasTags}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ItemsControl x:Name="PreviewTags" ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource Tag}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Height="1" Background="#E8E8E8" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [epma_library_detail],Source={x:Static lg:LanguageService.Instance}}"/>
            <TextBlock Text="{Binding DetailDescription}" Foreground="#666" TextWrapping="Wrap" FontSize="12" LineHeight="19"/>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding [epma_library_version_info],Source={x:Static lg:LanguageService.Instance}}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding [epma_library_current_version],Source={x:Static lg:LanguageService.Instance}}" Foreground="#888" Margin="0,3"/>
                <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="#333" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="{Binding [epma_library_update_date],Source={x:Static lg:LanguageService.Instance}}" Foreground="#888" Margin="0,3"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdateDate}" Foreground="#333" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="{Binding [epma_library_author],Source={x:Static lg:LanguageService.Instance}}" Foreground="#888" Margin="0,3"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Author}" Foreground="#333" Margin="0,3" TextWrapping="Wrap"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
