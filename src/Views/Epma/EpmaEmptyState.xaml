<UserControl x:Class="GeoChemistryNexus.Views.EpmaEmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:uc="clr-namespace:GeoChemistryNexus.Controls"
             HorizontalAlignment="Center" VerticalAlignment="Center">
    <UserControl.Resources>
        <cvs:BoolToVisibilityConverter x:Key="Show"/>
        <SineEase x:Key="Ease" EasingMode="EaseInOut"/>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="FloatT" Storyboard.TargetProperty="Y" From="0" To="-5" Duration="0:0:2.3" AutoReverse="True" EasingFunction="{StaticResource Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="ShadowS" Storyboard.TargetProperty="ScaleX" From="1" To="0.87" Duration="0:0:2.3" AutoReverse="True" EasingFunction="{StaticResource Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" From="0.58" To="0.35" Duration="0:0:2.3" AutoReverse="True" EasingFunction="{StaticResource Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="ScanT" Storyboard.TargetProperty="X" From="0" To="-5" Duration="0:0:2.6" AutoReverse="True" EasingFunction="{StaticResource Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="ScanT" Storyboard.TargetProperty="Y" From="0" To="-4" Duration="0:0:2.6" AutoReverse="True" EasingFunction="{StaticResource Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="ScanR" Storyboard.TargetProperty="Angle" From="0" To="-4" Duration="0:0:2.6" AutoReverse="True" EasingFunction="{StaticResource Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Beam" Storyboard.TargetProperty="StrokeDashOffset" From="8" To="0" Duration="0:0:2.2"/>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Beam" Storyboard.TargetProperty="Opacity" Duration="0:0:2.2">
                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.55"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="1"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0.55"/>
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetName="Wave1S" Storyboard.TargetProperty="ScaleX" From="0.4" To="1.9" Duration="0:0:2.4"/>
                    <DoubleAnimation Storyboard.TargetName="Wave1S" Storyboard.TargetProperty="ScaleY" From="0.4" To="1.9" Duration="0:0:2.4"/>
                    <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="Opacity" From="0.85" To="0" Duration="0:0:2.4"/>
                    <DoubleAnimation Storyboard.TargetName="Wave2S" Storyboard.TargetProperty="ScaleX" From="0.4" To="1.9" Duration="0:0:2.4" BeginTime="0:0:1.2"/>
                    <DoubleAnimation Storyboard.TargetName="Wave2S" Storyboard.TargetProperty="ScaleY" From="0.4" To="1.9" Duration="0:0:2.4" BeginTime="0:0:1.2"/>
                    <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="Opacity" From="0.85" To="0" Duration="0:0:2.4" BeginTime="0:0:1.2"/>
                    <DoubleAnimation Storyboard.TargetName="Spark1" Storyboard.TargetProperty="Opacity" From="0.25" To="0.95" Duration="0:0:1.6" AutoReverse="True" EasingFunction="{StaticResource Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Spark2" Storyboard.TargetProperty="Opacity" From="0.25" To="0.95" Duration="0:0:1.9" AutoReverse="True" EasingFunction="{StaticResource Ease}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <StackPanel MaxWidth="340" Margin="24,40">
        <Viewbox Width="176" Height="176" Stretch="Uniform" Margin="0,0,0,12">
            <Canvas Width="200" Height="185">
                <!-- 背景光晕与阴影 -->
                <Ellipse Canvas.Left="28" Canvas.Top="23" Width="144" Height="144">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource ThemeArtStrongA1FColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource ThemeArtStrongA08Color}" Offset="0.7"/>
                            <GradientStop Color="{DynamicResource ThemeArtStrongA00Color}" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="Shadow" Canvas.Left="48" Canvas.Top="157.2" Width="104" Height="13.6" Fill="#CBD5E1" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="ShadowS"/></Ellipse.RenderTransform>
                </Ellipse>
                <!-- 轨道环 -->
                <Ellipse Canvas.Left="35" Canvas.Top="78" Width="130" Height="48" Stroke="#CBD5E1" StrokeThickness="1.2" StrokeDashArray="3.3 3.3" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform Angle="-15"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="38" Canvas.Top="82" Width="116" Height="40" Stroke="#E2E8F0" StrokeThickness="1.1" Opacity="0.75" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform Angle="18"/></Ellipse.RenderTransform>
                </Ellipse>

                <!-- 悬浮主体 -->
                <Canvas>
                    <Canvas.RenderTransform><TranslateTransform x:Name="FloatT"/></Canvas.RenderTransform>

                    <!-- 计算表卡片 -->
                    <Rectangle Canvas.Left="88" Canvas.Top="44" Width="60" Height="82" RadiusX="6" RadiusY="6" Fill="White" Stroke="#94A3B8" StrokeThickness="1.6"/>
                    <Path Data="M88 50 C88 46.7 90.7 44 94 44 L142 44 C145.3 44 148 46.7 148 50 L148 58 L88 58 Z" Fill="{DynamicResource ThemeArtSoftBrush}"/>
                    <Line X1="88" Y1="58" X2="148" Y2="58" Stroke="{DynamicResource ThemeArtMistBrush}" StrokeThickness="1.3"/>
                    <Ellipse Canvas.Left="94" Canvas.Top="49" Width="4" Height="4" Fill="{DynamicResource ThemeArtStrongBrush}"/>
                    <Line X1="102" Y1="51" X2="118" Y2="51" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="126" Y1="51" X2="140" Y2="51" Stroke="{DynamicResource ThemeArtLighterBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="95" Y1="68" X2="112" Y2="68" Stroke="#64748B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="120" Y1="68" X2="140" Y2="68" Stroke="{DynamicResource ThemeArtMistBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="95" Y1="78" X2="110" Y2="78" Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="120" Y1="78" X2="136" Y2="78" Stroke="#CBD5E1" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="95" Y1="88" X2="114" Y2="88" Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="120" Y1="88" X2="140" Y2="88" Stroke="{DynamicResource ThemeArtMistBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="94" Y1="97" X2="142" Y2="97" Stroke="#E2E8F0" StrokeThickness="1.2" StrokeDashArray="1.6 1.6"/>
                    <Path Data="M101 104 L95 104 L98.5 108 L95 112 L101 112" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <Line X1="107" Y1="108" X2="128" Y2="108" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                    <!-- 电子枪 -->
                    <Rectangle Canvas.Left="70" Canvas.Top="22" Width="24" Height="10" RadiusX="3" RadiusY="3" Fill="#E2E8F0" Stroke="#64748B" StrokeThickness="1.6"/>
                    <Polygon Points="73,32 91,32 86,46 78,46" Fill="#7C8CA3" Stroke="#64748B" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                    <Ellipse Canvas.Left="78" Canvas.Top="44.5" Width="8" Height="3" Fill="{DynamicResource ThemeArtLighterBrush}"/>
                    <Line X1="82" Y1="47" X2="82" Y2="86" Stroke="{DynamicResource ThemeArtStrongA38Brush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line x:Name="Beam" X1="82" Y1="47" X2="82" Y2="86" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="2" StrokeDashArray="2 2" StrokeStartLineCap="Flat"/>

                    <!-- 靶台 -->
                    <Path Data="M42 134 L126 134 L118 145 L50 145 Z" Fill="#E2E8F0" Stroke="#94A3B8" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                    <Line X1="56" Y1="139.5" X2="112" Y2="139.5" Stroke="#CBD5E1" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                    <!-- 矿物晶体 -->
                    <Polygon Points="66,72 82,62 98,72 98,86 82,94 66,86" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="{DynamicResource ThemeArtSoftBorderBrush}"/>
                    <Polygon Points="54,88 66,72 66,86 82,94 82,134 54,122" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="{DynamicResource ThemeArtSoftBrush}"/>
                    <Polygon Points="82,94 98,86 98,72 110,88 110,122 82,134" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="{DynamicResource ThemeArtSoftBrush}"/>
                    <Polyline Points="54,88 66,86" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.3" Opacity="0.6"/>
                    <Polyline Points="98,86 110,88" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.3" Opacity="0.6"/>
                    <Line X1="63" Y1="100" X2="63" Y2="118" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8"/>

                    <!-- X 射线波纹 -->
                    <Ellipse x:Name="Wave1" Canvas.Left="73" Canvas.Top="71" Width="18" Height="18" Stroke="{DynamicResource ThemeArtLighterBrush}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="Wave1S" ScaleX="0.4" ScaleY="0.4"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Wave2" Canvas.Left="73" Canvas.Top="71" Width="18" Height="18" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.3" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="Wave2S" ScaleX="0.4" ScaleY="0.4"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="78.8" Canvas.Top="76.8" Width="6.4" Height="6.4" Fill="{DynamicResource ThemeArtStrongBrush}"/>
                    <Ellipse Canvas.Left="80.5" Canvas.Top="78.5" Width="3" Height="3" Fill="White"/>
                </Canvas>

                <!-- 放大镜 -->
                <Canvas>
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="ScanR" CenterX="136" CenterY="126"/>
                            <TranslateTransform x:Name="ScanT"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="114" Canvas.Top="102" Width="40" Height="40" Fill="#DBFFFFFF" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="2.4"/>
                    <Ellipse Canvas.Left="119" Canvas.Top="107" Width="30" Height="30" Stroke="{DynamicResource ThemeArtSoftBorderBrush}" StrokeThickness="1.2" StrokeDashArray="4 3"/>
                    <Line X1="134" Y1="104" X2="134" Y2="108" Stroke="{DynamicResource ThemeArtMistBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="134" Y1="136" X2="134" Y2="140" Stroke="{DynamicResource ThemeArtMistBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="116" Y1="122" X2="120" Y2="122" Stroke="{DynamicResource ThemeArtMistBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="148" Y1="122" X2="152" Y2="122" Stroke="{DynamicResource ThemeArtMistBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path Data="M123 113 A14 14 0 0 1 138 108" Stroke="{DynamicResource ThemeArtLighterBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path Data="M130.5 117.5 C130.5 114.5 137.5 114.5 137.5 118.5 C137.5 121 134 121.5 134 124" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Canvas.Left="132.7" Canvas.Top="127.2" Width="2.6" Height="2.6" Fill="{DynamicResource ThemeArtStrongBrush}"/>
                    <Line X1="148.5" Y1="136.5" X2="162" Y2="150" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="148.5" Y1="136.5" X2="152" Y2="140" Stroke="#64748B" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>

                <!-- 星点 -->
                <Path x:Name="Spark1" Data="M42 54 L43.8 60.2 L50 62 L43.8 63.8 L42 70 L40.2 63.8 L34 62 L40.2 60.2 Z" Fill="{DynamicResource ThemeArtLighterBrush}" Opacity="0.25"/>
                <Path x:Name="Spark2" Data="M158 42 L159.2 46.8 L164 48 L159.2 49.2 L158 54 L156.8 49.2 L152 48 L156.8 46.8 Z" Fill="#94A3B8" Opacity="0.25"/>
                <Ellipse Canvas.Left="35.8" Canvas.Top="107.8" Width="4.4" Height="4.4" Fill="#CBD5E1"/>
                <Ellipse Canvas.Left="161.5" Canvas.Top="91.5" Width="5" Height="5" Fill="{DynamicResource ThemeArtMistBrush}"/>
            </Canvas>
        </Viewbox>
        <TextBlock Text="{Binding LibraryEmptyMessage}" FontSize="14" Foreground="#8C959F" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <uc:TemplateFeedbackHint Visibility="{Binding ShowLibraryEmptyContact,Converter={StaticResource Show}}"
                                 FontSize="12.5" Foreground="#9BA3AB" HorizontalAlignment="Center"/>
        <!-- 个人计算为空时：新建 / 导入 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                    Visibility="{Binding ShowLibraryEmptyActions,Converter={StaticResource Show}}">
            <Button Style="{StaticResource EmptyStatePrimaryButtonStyle}"
                    Command="{Binding CreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding [empty_state_new],Source={x:Static lg:LanguageService.Instance}, FallbackValue=新建}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource EmptyStateSecondaryButtonStyle}"
                    Command="{Binding ImportTemplateCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding [empty_state_import],Source={x:Static lg:LanguageService.Instance}, FallbackValue=导入}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
