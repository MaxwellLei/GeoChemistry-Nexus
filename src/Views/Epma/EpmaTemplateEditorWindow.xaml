<Window x:Class="GeoChemistryNexus.Views.EpmaTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
        xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
        xmlns:views="clr-namespace:GeoChemistryNexus.Views"
        xmlns:controls="clr-namespace:GeoChemistryNexus.Controls"
        xmlns:models="clr-namespace:GeoChemistryNexus.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding EditorTitle}" Width="1180" Height="700" MinWidth="960" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="#F5F7FA" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" Closing="OnClosing">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="EpmaTemplateEditorStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        <cvs:BoolToVisibilityConverter x:Key="Show"/>
        <cvs:EpmaBasicPageVisibilityConverter x:Key="BasicPageVisibility"/>
        <CollectionViewSource x:Key="LanguagePartsView" Source="{Binding LanguageParts}"/>
        <cvs:EpmaColumnWidthConverter x:Key="ColumnWidth"/>
        <cvs:EpmaColumnDividerConverter x:Key="ColumnDivider"/>
        <cvs:EpmaColumnTableWidthConverter x:Key="ColumnTableWidth"/>
        <cvs:EpmaScriptEditorHeightConverter x:Key="ScriptEditorHeight"/>
        <cvs:BorderClipConverter x:Key="RoundedClip"/>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}"/>
            <Setter Property="BorderBrush" Value="#D8DFE8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="EditorSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66768B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style x:Key="BasicSectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E5EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DFE8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <Grid><ItemsPresenter Height="0" IsHitTestVisible="False" ClipToBounds="True"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="12,2"/>
            <Setter Property="Foreground" Value="#3C3C43"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="NavBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#F0F0F3"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Normal"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationIcon" TargetType="Path">
            <Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="1.5,0,11.5,0"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="StrokeThickness" Value="1.3"/><Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Stroke" Value="White"/></DataTrigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SourceBox" TargetType="controls:EpmaCodeEditor" BasedOn="{StaticResource EpmaSourceBox}"/>
        <Style x:Key="ColumnCell" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <EventSetter Event="PreviewKeyDown" Handler="ColumnCellPreviewKeyDown"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="AcceptsTab" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="MinLines" Value="1"/><Setter Property="MaxLines" Value="1"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsReadOnly" Value="{Binding DataContext.IsReadOnly,RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Grid Background="{TemplateBinding Background}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                  VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" CanContentScroll="False"/>
                    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#8796A8" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RemoveColumn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="×"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/><Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
            <Setter Property="ToolTip" Value="{Binding [epma_editor_remove_column],Source={x:Static lg:LanguageService.Instance}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding [epma_editor_remove_column],Source={x:Static lg:LanguageService.Instance}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin,RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsReadOnly,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AddColumn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="16"/><Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Content" Value="+"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#71869F"/><Setter Property="Background" Value="#EDF4FC"/>
            <Setter Property="ToolTip" Value="{Binding [epma_editor_add_column],Source={x:Static lg:LanguageService.Instance}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding [epma_editor_add_column],Source={x:Static lg:LanguageService.Instance}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="AddBorder" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AddBorder" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="AddBorder" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AddExample" TargetType="Button" BasedOn="{StaticResource AddColumn}">
            <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="16"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding [epma_editor_add_example],Source={x:Static lg:LanguageService.Instance}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding [epma_editor_add_example],Source={x:Static lg:LanguageService.Instance}}"/>
        </Style>
        <Style x:Key="RemoveExample" TargetType="Button" BasedOn="{StaticResource RemoveColumn}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="ToolTip" Value="{Binding [epma_editor_remove_example],Source={x:Static lg:LanguageService.Instance}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding [epma_editor_remove_example],Source={x:Static lg:LanguageService.Instance}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ExampleRows.Count,RelativeSource={RelativeSource AncestorType=Window}}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="EditorSurface" Focusable="True" Background="{Binding Background,RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#EBEEF3" BorderBrush="#DFE5ED" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,16">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="20,2,12,24">
                        <Border Width="34" Height="34" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="9" DockPanel.Dock="Left" Margin="0,0,10,0"><TextBlock Text="Σ" Foreground="White" FontSize="24" FontFamily="Georgia" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding EditorTitle}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ModuleVersionLabel}" Foreground="#7A8798" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding [epma_editor_workflow],Source={x:Static lg:LanguageService.Instance}}" Foreground="#7A8798" FontSize="11" Margin="22,0,0,6"/>
                </StackPanel>
                <Border x:Name="TemplateStatusPanel" DockPanel.Dock="Bottom" Margin="18,16,14,0" Padding="0,12,0,0" BorderBrush="#DCE2EB" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [epma_editor_state_title],Source={x:Static lg:LanguageService.Instance}}" Foreground="#66768B" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TemplateStatusList" ItemsSource="{Binding TemplateStatusItems}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="2,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="•"/><Setter Property="Foreground" Value="#B7791F"/><Style.Triggers><DataTrigger Binding="{Binding NeedsAttention}" Value="False"><Setter Property="Text" Value="✓"/><Setter Property="Foreground" Value="#2D7A49"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="#66768B" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <ListBox x:Name="EditorNavigation" SelectedIndex="{Binding Step}" ItemContainerStyle="{StaticResource NavigationItem}" Background="Transparent" BorderThickness="0" IsEnabled="{Binding CanNavigate}" VerticalAlignment="Top">
                    <ListBoxItem HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path x:Name="BasicNavigationIcon" Style="{StaticResource NavigationIcon}" Data="M 1,3 H 4 M 7,3 H 15 M 4,3 A 1.5,1.5 0 1 0 7,3 A 1.5,1.5 0 1 0 4,3 M 1,8 H 9 M 12,8 H 15 M 9,8 A 1.5,1.5 0 1 0 12,8 A 1.5,1.5 0 1 0 9,8 M 1,13 H 3 M 6,13 H 15 M 3,13 A 1.5,1.5 0 1 0 6,13 A 1.5,1.5 0 1 0 3,13"/><TextBlock x:Name="BasicNavigationLabel" Text="{Binding [epma_editor_nav_basic],Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path x:Name="ScriptNavigationIcon" Style="{StaticResource NavigationIcon}" Data="M 5,3 L 1,8 L 5,13 M 11,3 L 15,8 L 11,13 M 9.5,1.5 L 6.5,14.5"/><TextBlock x:Name="ScriptNavigationLabel" Text="{Binding [epma_editor_nav_script],Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path x:Name="HelpNavigationIcon" Style="{StaticResource NavigationIcon}" Data="M 3,2 A 1,1 0 0 1 4,1 H 9 L 13,5 V 14 A 1,1 0 0 1 12,15 H 4 A 1,1 0 0 1 3,14 Z M 9,1 V 5 H 13 M 6,8 H 10 M 6,11 H 9"/><TextBlock x:Name="HelpNavigationLabel" Text="{Binding [epma_editor_documents],Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="#DFE5ED" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="PreviewToggleButton" Style="{StaticResource EditorAction}" Command="{Binding TogglePreviewCommand}" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Button.Visibility><Binding Path="Step" Converter="{StaticResource BasicPageVisibility}"/></Button.Visibility>
                            <StackPanel Orientation="Horizontal">
                                <Grid x:Name="PreviewToggleIcon" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Path Data="M 2,1.5 H 12 Q 13,1.5 13,2.5 V 11.5 Q 13,12.5 12,12.5 H 2 Q 1,12.5 1,11.5 V 2.5 Q 1,1.5 2,1.5 Z M 9.5,1.5 V 12.5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" StrokeLineJoin="Round"/>
                                    <Path x:Name="PreviewToggleArrow" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                        <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 4.25,4.5 L 6.75,7 L 4.25,9.5"/><Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewExpanded}" Value="False"><Setter Property="Data" Value="M 6.5,4.5 L 4,7 L 6.5,9.5"/></DataTrigger>
                                        </Style.Triggers></Style></Path.Style>
                                    </Path>
                                </Grid>
                                <TextBlock Text="{Binding PreviewActionLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CanShowSave,Converter={StaticResource Show}}" VerticalAlignment="Center"><Button x:Name="SaveTemplateButton" Click="SaveClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource EditorAction}" Content="{Binding [epma_editor_save_action],Source={x:Static lg:LanguageService.Instance}}" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" BorderBrush="{DynamicResource ThemeAccentBrush}" Padding="16,5"/></StackPanel>
                        <Border Width="1" Height="18" Background="#DFE5ED" Margin="12,0,8,0"/>
                        <Button x:Name="CaptionMinimizeButton" Style="{StaticResource EditorCaption}" Content="&#xe67a;" Click="MinimizeClick" AutomationProperties.Name="{Binding [epma_editor_minimize],Source={x:Static lg:LanguageService.Instance}}" ToolTip="{Binding [epma_editor_minimize],Source={x:Static lg:LanguageService.Instance}}"/>
                        <Button x:Name="CaptionMaximizeButton" Style="{StaticResource EditorCaptionMaximize}" Click="MaximizeClick" AutomationProperties.Name="{Binding [epma_editor_maximize],Source={x:Static lg:LanguageService.Instance}}" ToolTip="{Binding [epma_editor_maximize],Source={x:Static lg:LanguageService.Instance}}"/>
                        <Button x:Name="CaptionCloseButton" Style="{StaticResource EditorCaptionClose}" Content="&#xeaf2;" Click="CancelClick" AutomationProperties.Name="{Binding [close],Source={x:Static lg:LanguageService.Instance}}" ToolTip="{Binding [close],Source={x:Static lg:LanguageService.Instance}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ActivePageTitle}" Margin="24,0,12,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="#FFF8E1" CornerRadius="6" Padding="12,8" Margin="24,12,24,0" Visibility="{Binding IsReadOnly,Converter={StaticResource Show}}"><TextBlock Text="{Binding [epma_editor_readonly_hint],Source={x:Static lg:LanguageService.Instance}}" Foreground="#795548" TextWrapping="Wrap"/></Border>
            <Grid x:Name="EditorContentArea" Grid.Row="2" Margin="24,16,16,16">
                <TabControl x:Name="Steps" SelectedIndex="{Binding Step}" IsEnabled="{Binding CanNavigate}">
            <TabItem Header="{Binding [epma_editor_nav_basic],Source={x:Static lg:LanguageService.Instance}}">
                <Grid x:Name="BasicPageLayout" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="BasicPageScroll" Grid.Column="0" Padding="0,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel x:Name="BasicInformationForm" HorizontalAlignment="Stretch" Margin="0,0,12,8">
                            <DockPanel Margin="4,0,4,10" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding [epma_editor_supported_languages],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource EditorSectionTitle}" FontSize="12" Foreground="#66768B" Margin="0" VerticalAlignment="Center"/>
                                <controls:LanguagePicker x:Name="AddLanguageButton" DockPanel.Dock="Right" Candidates="{Binding LanguageCandidates}" ToggleCommand="{Binding ToggleLanguageCommand}" SelectAllCommand="{Binding SelectAllLanguagesCommand}" IsEnabled="{Binding CanEdit}" Visibility="{Binding CanShowSave,Converter={StaticResource Show}}"/>
                            </DockPanel>
                            <Border Style="{StaticResource BasicSectionCard}" Padding="14,14,6,6">
                                <ItemsControl x:Name="LanguageTokens" ItemsSource="{Binding LanguageParts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border CornerRadius="16" BorderThickness="1" Padding="10,5" Margin="0,0,8,8" Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F5F7FA"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="TextElement.Foreground" Value="#758195"/><Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBorderBrush}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeAccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <Border.ContextMenu><ContextMenu><MenuItem Header="{Binding [epma_editor_set_default_language],Source={x:Static lg:LanguageService.Instance}}" Command="{Binding PlacementTarget.Tag.SetDefaultLanguageCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/></ContextMenu></Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource EditorLanguageContent}" FontSize="12" VerticalAlignment="Center" VerticalContentAlignment="Center"/><Button MinHeight="16" Height="16" Width="16" VerticalAlignment="Center" Content="×" Click="RemoveLanguage_Click" Tag="{Binding}" Padding="0" Margin="7,0,0,0" BorderThickness="0" Background="Transparent" Foreground="#758195" Style="{StaticResource EditorLink}" Visibility="{Binding DataContext.CanShowSave,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Show}}" ToolTip="{Binding [epma_editor_remove_language],Source={x:Static lg:LanguageService.Instance}}"/></StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Border>
                            <DockPanel Margin="4,16,4,10" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding [epma_editor_template_identity],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource EditorSectionTitle}" FontSize="12" Foreground="#66768B" Margin="0" VerticalAlignment="Center"/>
                                <Button x:Name="LocalizationButton" DockPanel.Dock="Right" Click="LocalizationClick" Style="{StaticResource EditorLink}" Content="{Binding [epma_editor_edit_localization],Source={x:Static lg:LanguageService.Instance}}" ToolTip="{Binding [epma_editor_localization_tooltip],Source={x:Static lg:LanguageService.Instance}}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                      Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M 1,3 H 9 M 5,1 V 3 M 3,3 C 3,6 5,8 8,9 M 7,3 C 7,6 5,8 2,9 M 8,15 L 11,6 L 14,15 M 9,12 H 13"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </DockPanel>
                            <Border Style="{StaticResource BasicSectionCard}"><StackPanel>
                                <Border Style="{StaticResource EditorFormRow}"><DockPanel><TextBlock DockPanel.Dock="Left" Text="{Binding [epma_editor_icon],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource EditorFormLabel}"/><TextBox x:Name="TemplateIconEditor" Style="{StaticResource EditorIconValue}" Text="{Binding TemplateIcon,UpdateSourceTrigger=LostFocus}" Tag="{Binding [epma_editor_icon_hint],Source={x:Static lg:LanguageService.Instance}}" TextChanged="IconTextChanged"/></DockPanel></Border>
                                <Border Style="{StaticResource EditorFormRow}"><DockPanel><TextBlock DockPanel.Dock="Left" Text="{Binding [epma_editor_name],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource EditorFormLabel}"/><TextBox x:Name="TemplateNameEditor" Style="{StaticResource EditorFormValue}" Text="{Binding TemplateName,UpdateSourceTrigger=PropertyChanged}"/></DockPanel></Border>
                                <Border Style="{StaticResource EditorFormRow}" BorderThickness="0"><DockPanel><TextBlock DockPanel.Dock="Left" Text="{Binding [epma_library_author],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource EditorFormLabel}"/><TextBox x:Name="AuthorEditor" Style="{StaticResource EditorFormValue}" Text="{Binding Author,UpdateSourceTrigger=PropertyChanged}"/></DockPanel></Border>
                            </StackPanel></Border>
                            <TextBlock Text="{Binding [epma_editor_classification],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource EditorSectionTitle}" FontSize="12" Foreground="#66768B" Margin="4,16,0,10"/>
                            <Border Style="{StaticResource BasicSectionCard}"><StackPanel>
