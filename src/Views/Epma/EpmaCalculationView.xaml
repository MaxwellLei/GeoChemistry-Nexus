<UserControl x:Class="GeoChemistryNexus.Views.EpmaCalculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rg="clr-namespace:unvell.ReoGrid;assembly=unvell.ReoGrid"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:ctrl="clr-namespace:GeoChemistryNexus.Controls"
             FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#334155"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}"
             Background="White" SizeChanged="WorkbenchSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EpmaWorkbenchStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cvs:BoolToVisibilityConverter x:Key="Show"/>
            <!-- Match CIPW's compact header buttons, with EPMA's grey outline. -->
            <Style x:Key="HeaderToolbarButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#555"/>
                <Setter Property="BorderBrush" Value="#B8BDC5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="FontFamily" Value="{x:Static SystemFonts.MessageFontFamily}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E5E5E5"/>
                                    <Setter Property="Foreground" Value="#000"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#D1D1D1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#BBB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HeaderPrimaryButton" TargetType="Button" BasedOn="{StaticResource HeaderToolbarButton}">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#004578"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Background" Value="#CCCCCC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
        </Grid.RowDefinitions>
        <!-- 计算顶栏：返回 + 模板名称 + 工具栏；窄窗口时操作按钮折到第二行。 -->
        <ContentControl Grid.Row="0" Style="{StaticResource PageTitleBarStyle}">
            <Grid x:Name="ToolbarGrid" Margin="0,6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding BackCommand}" Style="{StaticResource HeaderToolbarButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding [return_to_template_library], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="PackageTitle" Grid.Column="1" Text="{Binding PackageName}"
                           FontFamily="{x:Static SystemFonts.MessageFontFamily}" FontSize="16" FontWeight="SemiBold"
                           Foreground="#1E293B" LineHeight="24" LineStackingStrategy="BlockLineHeight"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                <StackPanel x:Name="ToolbarActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleHelpCommand}" Style="{StaticResource HeaderToolbarButton}"
                            ToolTip="{Binding [epma_help_tooltip], Source={x:Static lg:LanguageService.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [epma_help], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExampleCommand}" Style="{StaticResource HeaderToolbarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [epma_example_data], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportCommand}" Style="{StaticResource HeaderToolbarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xe673;" FontFamily="pack://application:,,,/Data/Icon/#iconfont" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [epma_export], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearCommand}" Style="{StaticResource HeaderToolbarButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [epma_clear], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="#E0E0E0" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Command="{Binding CancelCommand}"
                            Style="{StaticResource HeaderToolbarButton}"
                            Visibility="{Binding IsBusy, Converter={StaticResource Show}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [epma_cancel], Source={x:Static lg:LanguageService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CalculateCommand}" Style="{StaticResource HeaderPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding [epma_calculate], Source={x:Static lg:LanguageService.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ContentControl>

        <ctrl:ReoGridTableHost x:Name="WorksheetSurface" Grid.Row="1" Style="{StaticResource ReoGridTableHostStyle}"
                               UseBuiltInCellEditor="False"
                               ResetLayoutCommand="{Binding ResetWorksheetLayoutCommand}"
                               SelectedCellContent="{Binding SelectedCellContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               SelectedCellAddress="{Binding SelectedCellAddress}"
                               IsSelectedCellReadOnly="{Binding IsSelectedCellReadOnly}"
                               IsInspectorOpen="{Binding IsInspectorOpen, Mode=TwoWay}"
                               InspectorTitle="{Binding [epma_details], Source={x:Static lg:LanguageService.Instance}}">
            <!-- 右侧检查器：当前选中数据行的诊断详情，与 CIPW / Niggli 共用同一个侧边栏 -->
            <ctrl:ReoGridTableHost.Inspector>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 摘要：选中样品 + 结果是否已过期 + 导出 / 复制 -->
                    <Border Grid.Row="0" Padding="14,10" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasInspectorData, Converter={StaticResource Show}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 导出 / 复制检查器详情（与温压计检查器一致） -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,-3,0,0">
                                <Button Style="{StaticResource InspectorActionButtonStyle}" Margin="0,0,2,0"
                                        Command="{Binding ExportInspectorDetailsCommand}"
                                        ToolTip="{Binding [geo_tooltip_export_calc_details], Source={x:Static lg:LanguageService.Instance}, FallbackValue=导出计算详情为 CSV}">
                                    <TextBlock Text="&#xe673;" FontFamily="{StaticResource InspectorIconFont}" FontSize="13"/>
                                </Button>
                                <Button Style="{StaticResource InspectorActionButtonStyle}"
                                        Command="{Binding CopyInspectorDetailsCommand}"
                                        ToolTip="{Binding [geo_tooltip_copy_calc_details], Source={x:Static lg:LanguageService.Instance}, FallbackValue=复制计算详情到剪贴板}">
                                    <TextBlock Text="&#xe63e;" FontFamily="{StaticResource InspectorIconFont}" FontSize="13"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedRowInfo}" FontSize="13" FontWeight="SemiBold" Foreground="#333"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedRowInfo}"/>
                                <TextBlock Text="{Binding [epma_stale], Source={x:Static lg:LanguageService.Instance}}" FontSize="11" Foreground="#B45309"
                                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding IsSelectedRowStale, Converter={StaticResource Show}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 分组 + 条目列表（与地质温压计共用）：先是解释行状态点的诊断，再是模板自己返回的条目 -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                            <StackPanel>
                                <!-- 没有可显示的行详情时的提示 -->
                                <TextBlock Text="{Binding InspectorHint}" FontSize="12" Foreground="#999" Margin="14,12" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInspectorData}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ctrl:CalculationStepList ItemsSource="{Binding InspectorItems}"
                                                          ToggleCommand="{Binding ToggleCalculationGroupCommand}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 模板的 calculateDetailed 正在运行：顶部细进度条，诊断仍可阅读 -->
                        <ProgressBar Style="{StaticResource FlatProgressBarStyle}" VerticalAlignment="Top" Height="3" IsIndeterminate="True"
                                     Visibility="{Binding IsInspectorLoading, Converter={StaticResource Show}}"/>
                    </Grid>
                </Grid>
            </ctrl:ReoGridTableHost.Inspector>
            <rg:ReoGridControl x:Name="ScriptGrid"/>
        </ctrl:ReoGridTableHost>

        <!-- 帮助文档：点击工具栏“帮助”后覆盖工具栏下方的工作区，再次点击返回 -->
        <Border x:Name="HelpSurface" Grid.Row="1" Background="White" Panel.ZIndex="10"
                Visibility="{Binding IsHelpVisible, Converter={StaticResource Show}}">
            <Grid>
                <RichTextBox x:Name="HelpDocViewer" IsReadOnly="True" IsDocumentEnabled="True" Padding="20,16" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type FlowDocument}">
                            <Setter Property="ColumnWidth" Value="999999"/>
                            <Setter Property="PagePadding" Value="10"/>
                        </Style>
                    </RichTextBox.Resources>
                    <FlowDocument/>
                </RichTextBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHelpDocument}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding [epma_help_no_doc], Source={x:Static lg:LanguageService.Instance}}" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
