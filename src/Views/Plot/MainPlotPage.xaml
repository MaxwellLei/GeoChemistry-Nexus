<Page x:Class="GeoChemistryNexus.Views.MainPlotPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:rg="clr-namespace:unvell.ReoGrid;assembly=unvell.ReoGrid"
      xmlns:local="clr-namespace:GeoChemistryNexus.Views"
      xmlns:tools="clr-namespace:GeoChemistryNexus.Helpers"
      xmlns:uc="clr-namespace:GeoChemistryNexus.Controls"
      xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
      xmlns:layerModels="clr-namespace:GeoChemistryNexus.ViewModels"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
      xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:s="clr-namespace:System;assembly=mscorlib"
      xmlns:models="clr-namespace:GeoChemistryNexus.Models"
      xmlns:spiderModels="clr-namespace:GeoChemistryNexus.Models.SpiderDiagram"
      xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      x:Name="MainPlotPageRoot"
      Title="MainPlotPage"
      Focusable="True"
      UseLayoutRounding="True"
      TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}">

    <Page.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding HandlePageDeleteKeyCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding CenterPlotCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding CenterPlotCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveBaseMapCommand}"/>
        <!-- 模式切换快捷键 -->
        <KeyBinding Key="D1" Modifiers="Alt" Command="{Binding SwitchToDiagramModeCommand}"/>
        <KeyBinding Key="D2" Modifiers="Alt" Command="{Binding SwitchToDataModeCommand}"/>
        <KeyBinding Key="D3" Modifiers="Alt" Command="{Binding SwitchToEditModeCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding CyclePlotModeCommand}"/>
        <!-- 数据模式：投图 -->
        <KeyBinding Key="Enter" Modifiers="Control+Shift" Command="{Binding UpdateDataCommand}"/>
        <!-- 添加绘图对象快捷键 -->
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding AddLineCommand}"/>
        <KeyBinding Key="NumPad1" Modifiers="Control" Command="{Binding AddLineCommand}"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding AddTextCommand}"/>
        <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding AddTextCommand}"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding AddPolygonCommand}"/>
        <KeyBinding Key="NumPad3" Modifiers="Control" Command="{Binding AddPolygonCommand}"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding AddArrowCommand}"/>
        <KeyBinding Key="NumPad4" Modifiers="Control" Command="{Binding AddArrowCommand}"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding AddFunctionCommand}"/>
        <KeyBinding Key="NumPad5" Modifiers="Control" Command="{Binding AddFunctionCommand}"/>
    </Page.InputBindings>

    <Page.Resources>
        <!-- 加载iconfont字体 -->
        <FontFamily x:Key="IconFont">pack://application:,,,/Data/Icon/#iconfont</FontFamily>
        
        <cvs:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <cvs:BoolToVisibilityReConverter x:Key="BoolToVisibilityReConverter"/>
        <cvs:GraphMapPathToIconConverter x:Key="GraphMapPathToIconConverter"/>
        <cvs:IndexToBooleanConverter x:Key="IndexToBooleanConverter"/>
        <cvs:StringToBitmapImageConverter x:Key="StringToBitmapImageConverter"/>
        <cvs:StringToCharListConverter x:Key="StringToCharListConverter"/>

        <Style x:Key="SkeletonBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="#E8ECF2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="TemplateTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DiagramLibraryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1.5,0,0"/>
            <EventSetter Event="RequestBringIntoView" Handler="TreeViewItem_RequestBringIntoView"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row" Height="28" CornerRadius="6" Padding="6,0,8,0"
                                    Background="{TemplateBinding Background}">
                                <i:Interaction.Behaviors><tools:TreeViewItemExpandBehavior/></i:Interaction.Behaviors>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Style="{StaticResource DiagramLibraryExpanderStyle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource DiagramLibraryHoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition SourceName="Row" Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarSelectedHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate x:Key="MacSidebarTemplateNodeTemplate" ItemsSource="{Binding Children}">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Viewbox Margin="0,0,7,0">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Width" Value="17"/>
                            <Setter Property="Height" Value="17"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=TreeView}}" Value="Official"/>
                                        <Condition Binding="{Binding GraphMapPath}" Value=""/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Width" Value="14"/>
                                    <Setter Property="Height" Value="14"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Canvas Width="24" Height="24">
                        <Path>
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource DiagramLibraryTreeItemIconStyle}">
                                    <Setter Property="Data" Value="M14,2 L20,8 L20,22 L4,22 L4,2 Z M14,2 L14,8 L20,8 M8,13 L16,13 M8,17 L14,17"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GraphMapPath}" Value="">
                                            <Setter Property="Data" Value="M22,19 A2,2 0 0 1 20,21 L4,21 A2,2 0 0 1 2,19 L2,5 A2,2 0 0 1 4,3 L9,3 L11,6 L20,6 A2,2 0 0 1 22,8 Z"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GraphMapPath}" Value="{x:Null}">
                                            <Setter Property="Data" Value="M22,19 A2,2 0 0 1 20,21 L4,21 A2,2 0 0 1 2,19 L2,5 A2,2 0 0 1 4,3 L9,3 L11,6 L20,6 A2,2 0 0 1 22,8 Z"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding TemplateCount}" FontSize="11.5" FontWeight="Medium"
                           Typography.NumeralAlignment="Tabular" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource DiagramLibrarySecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Children.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"><Setter Property="Foreground" Value="#D9FFFFFF"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="MacSidebarReeSpiderButtonStyle" TargetType="Button" BasedOn="{StaticResource DiagramLibraryItemButtonStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSpiderDiagramMode}" Value="True"/>
                        <Condition Binding="{Binding SpiderDiagramViewModel.DiagramType}" Value="REE"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource DiagramLibraryActiveBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MacSidebarTraceSpiderButtonStyle" TargetType="Button" BasedOn="{StaticResource DiagramLibraryItemButtonStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSpiderDiagramMode}" Value="True"/>
                        <Condition Binding="{Binding SpiderDiagramViewModel.DiagramType}" Value="TraceElement"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource DiagramLibraryActiveBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="LayerRowHoverBrush" Color="#0B000000"/>
        <SolidColorBrush x:Key="LayerRowTextBrush" Color="#1D1D1F"/>

        <Style x:Key="LayerTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LayerRowTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="Bd"
                                    MinHeight="34"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="8,0"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <i:Interaction.Behaviors>
                                    <tools:TreeViewItemExpandBehavior />
                                </i:Interaction.Behaviors>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ExpandCollapseToggleStyle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"/>

                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                      ContentSource="Header"/>
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Margin="20,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LayerRowHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LayerRowSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LayerRowSelectedBorderBrush}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LayerRowSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LayerRowSelectedBorderBrush}"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- New Modern-Style Styles -->
        <!-- ToolbarButtonStyle 已迁移到 Themes/Styles.xaml（与温压计等模块的页面顶栏共用） -->

        <Style x:Key="ToolbarIconButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="#000"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonIconStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="#000"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#D1D1D1"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonIconRectStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonIconStyle}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="#000"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#D1D1D1"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000" Opacity="0.1" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlidingSegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 页面顶栏（模板浏览模式）：文件/更新菜单 + 模板路径 + 批量操作与模板搜索 ==================== -->
        <ContentControl Grid.Row="0" Style="{StaticResource PageTitleBarStyle}" Background="#F2F2F7"
                        Tag="{Binding [Plot],Source={x:Static lg:LanguageService.Instance}}"
                        Visibility="{Binding IsPlotMode, Converter={StaticResource BoolToVisibilityReConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Style="{StaticResource TitleBarMenuStyle}">
                    <MenuItem Header="{Binding [File],Source={x:Static lg:LanguageService.Instance}}">
                        <!--新建模板-->
                        <MenuItem Header="{Binding [create_new_diagram_template],Source={x:Static lg:LanguageService.Instance}}" 
                                  InputGestureText=".diag.zip"
                                  Command="{Binding NewTemplateCommand}"/>
                        <!--打开模板-->
                        <MenuItem Header="{Binding [open_diagram_template],Source={x:Static lg:LanguageService.Instance}}" 
                                  InputGestureText=".diag.zip"
                                  Command="{Binding OpenTemplateCommand}"/>
                        <!--导入自定义模板-->
                        <MenuItem Header="{Binding [import_custom_diagram_template],Source={x:Static lg:LanguageService.Instance}}" 
                                  InputGestureText=".diag.zip"
                                  Command="{Binding ImportCustomTemplateCommand}"/>
                    </MenuItem>
                </Menu>

                            <StackPanel x:Name="TemplateBarRightPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsToolPanelMode, Converter={StaticResource BoolToVisibilityReConverter}}">
                                <!-- 下载 / 更新全部按钮（未下载的和有新版本的合并为一个入口；需要升级软件的不计入） -->
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource BatchActionButtonStyle}"
                                        Command="{Binding BatchDownloadOrUpdateAllCommand}"
                                        ToolTip="{Binding [batch_download_update_all_tooltip], Source={x:Static lg:LanguageService.Instance}, FallbackValue='下载未安装的模板并更新有新版本的官方模板'}"
                                        Visibility="{Binding IsBatchActionButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding BatchActionText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 搜索框 -->
                                <uc:SearchBox Width="180" Height="26" FontSize="12"
                                              Placeholder="{Binding [search_templates], Source={x:Static lg:LanguageService.Instance}, FallbackValue='搜索模板...'}"
                                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                
                            </StackPanel>
            </Grid>
        </ContentControl>

        <!-- 模板路径（面包屑）：浮于顶栏之上，左边缘对齐下方"左侧分类树 / 右侧内容"分割线的右侧；右侧让出批量操作与搜索区域 -->
        <Grid Grid.Row="0" Margin="0,0,190,0" VerticalAlignment="Center" Height="44"
              tools:WindowDragHelper.IsDragHandle="True"
              Visibility="{Binding IsPlotMode, Converter={StaticResource BoolToVisibilityReConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ActualWidth, ElementName=TemplateTreePanel}"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding ActualWidth, ElementName=TemplateBarRightPanel}"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          x:Name="BreadcrumbScrollViewer" SizeChanged="BreadcrumbScrollViewer_SizeChanged"
                          Focusable="False"
                          Margin="16,0,16,0" VerticalAlignment="Center"
                          Visibility="{Binding IsToolPanelMode, Converter={StaticResource BoolToVisibilityReConverter}}">
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock>
                                    <Hyperlink Command="{Binding DataContext.NavigateToBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"
                                               TextDecorations="None"
                                               Foreground="#666">
                                        <Run Text="{Binding Name}" FontSize="12"/>
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Text=" / " Margin="4,0" FontSize="12" 
                                          Foreground="#999" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 页面顶栏（图解绘图模式）：返回 / 模式切换 / 工具栏 ==================== -->
        <ContentControl Grid.Row="0" Style="{StaticResource PageTitleBarStyle}" Background="#F2F2F7"
                        Visibility="{Binding IsPlotMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Back & Mode Switch -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding BackToTemplateModeCommand}" Style="{StaticResource ToolbarButtonStyle}" FontSize="12" Padding="10,4" Margin="0,0,4,0" 
                                ToolTip="{Binding [return_to_template_library], Source={x:Static lg:LanguageService.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe61f;" FontSize="14" Margin="0,1,6,0"/>
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding [return_to_template_library],Source={x:Static lg:LanguageService.Instance}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHarkerPlotMode}" Value="True">
                                                    <Setter Property="Text" Value="返回设置"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="*" Foreground="Red" Margin="2,-8,0,0" FontWeight="Bold" FontSize="18"
                                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="24" Fill="#D0D0D0" Margin="12,0"/>

                        <Border Background="#DCDCE2" CornerRadius="6" Padding="3">
                            <Grid>
                                <Border x:Name="SwitchSlider" HorizontalAlignment="Left" VerticalAlignment="Stretch" 
                                        Background="White" CornerRadius="5" Width="0" Margin="0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000" Opacity="0.1" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                                    </Border.Effect>
                                </Border>
                                <StackPanel x:Name="SwitchContainer" Orientation="Horizontal" IsVisibleChanged="OnSwitchContainerIsVisibleChanged">
                                    <RadioButton Content="{Binding [diagram], Source={x:Static lg:LanguageService.Instance}}" 
                                                 IsChecked="{Binding RibbonTabIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}"
                                                 Style="{StaticResource SlidingSegmentedRadioButtonStyle}"
                                                 ToolTip="{Binding [plot_toolbar_diagram_mode_tooltip], Source={x:Static lg:LanguageService.Instance}}"
                                                 Checked="OnSwitchRadioButtonChecked" Loaded="OnSwitchRadioButtonLoaded"/>
                                    <RadioButton Content="{Binding [Data], Source={x:Static lg:LanguageService.Instance}}" 
                                                 IsChecked="{Binding RibbonTabIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1}"
                                                 Style="{StaticResource SlidingSegmentedRadioButtonStyle}"
                                                 ToolTip="{Binding [plot_toolbar_data_mode_tooltip], Source={x:Static lg:LanguageService.Instance}}"
                                                 Checked="OnSwitchRadioButtonChecked"/>
                                    <RadioButton Visibility="{Binding IsEditModeAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Content="{Binding [Edit], Source={x:Static lg:LanguageService.Instance}}" 
                                                 IsChecked="{Binding RibbonTabIndex, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=2}"
                                                 Style="{StaticResource SlidingSegmentedRadioButtonStyle}"
                                                 ToolTip="{Binding [plot_toolbar_edit_mode_tooltip], Source={x:Static lg:LanguageService.Instance}}"
                                                 Checked="OnSwitchRadioButtonChecked"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right: Tools -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Common Tools -->
                        <Button Command="{Binding CenterPlotCommand}" Style="{StaticResource ToolbarButtonIconStyle}" 
                                ToolTip="{Binding [reset_view], Source={x:Static lg:LanguageService.Instance}}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IcoPath}" Data="M4 9V6.5A2.5 2.5 0 0 1 6.5 4H9M15 4h2.5A2.5 2.5 0 0 1 20 6.5V9M20 15v2.5a2.5 2.5 0 0 1-2.5 2.5H15M9 20H6.5A2.5 2.5 0 0 1 4 17.5V15"/>
                                    <Path Style="{StaticResource IcoTintPath}" Data="M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>



                        <Button Command="{Binding CancelSelectedCommand}" Style="{StaticResource ToolbarButtonIconStyle}" 
                                ToolTip="{Binding [deselect], Source={x:Static lg:LanguageService.Instance}}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IcoPath}" Data="M3.5 12a8.5 8.5 0 1 0 17 0a8.5 8.5 0 1 0 -17 0z"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M6 6l12 12"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Harker 多联图联动开关（仅 Harker 绘图态可见） -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsHarkerPlotMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ToggleButton IsChecked="{Binding HarkerLinkX}" Style="{StaticResource ToolbarIconButtonStyle}"
                                          ToolTip="{Binding [harker_link_x_tooltip], Source={x:Static lg:LanguageService.Instance}, FallbackValue='X 轴联动：缩放/平移时所有面板的 X 范围同步（切换会重置视图）.'}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IcoPath}" Data="M4 5v14"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M20 5v14"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M6.5 12h11"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M9 9l-3 3 3 3"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M15 9l3 3-3 3"/>
                                    </Canvas>
                                </Viewbox>
                            </ToggleButton>
                            <ToggleButton IsChecked="{Binding HarkerLinkHover}" Style="{StaticResource ToolbarIconButtonStyle}"
                                          ToolTip="{Binding [harker_link_hover_tooltip], Source={x:Static lg:LanguageService.Instance}, FallbackValue='悬停联动：鼠标悬停某个面板的样点时，其余面板同步高亮同一样点.'}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IcoPath}" Data="M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0z"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M12 3v4"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M12 17v4"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M3 12h4"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M17 12h4"/>
                                    </Canvas>
                                </Viewbox>
                            </ToggleButton>
                        </StackPanel>

                        <Rectangle Width="1" Height="24" Fill="#D0D0D0" Margin="8,0"/>

                        <!-- Edit Mode Tools -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RibbonTabIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Command="{Binding SaveBaseMapCommand}" Style="{StaticResource ToolbarButtonIconStyle}" ToolTip="{Binding [plot_toolbar_save_tooltip], Source={x:Static lg:LanguageService.Instance}}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IcoAccentPath}" Data="M5 3h11l5 5v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>
                                        <Path Style="{StaticResource IcoAccentPath}" Data="M7.5 3v5h7V3"/>
                                        <Path Style="{StaticResource IcoAccentPath}" Data="M7 21v-6.5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1V21"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle Width="1" Height="24" Fill="#D0D0D0" Margin="8,0"/>

                            <ToggleButton IsChecked="{Binding IsAddingLine}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{Binding [add_line], Source={x:Static lg:LanguageService.Instance}}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IcoPath}" Data="M6.4 17.6L17.6 6.4"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M3 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0z"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M17 5a2 2 0 1 0 4 0a2 2 0 1 0 -4 0z"/>
                                    </Canvas>
                                </Viewbox>
                            </ToggleButton>
                            <ToggleButton IsChecked="{Binding IsAddingText}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{Binding [add_text], Source={x:Static lg:LanguageService.Instance}}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IcoPath}" Data="M5 7V4.5h14V7"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M12 4.5V20"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M9 20h6"/>
                                    </Canvas>
                                </Viewbox>
                            </ToggleButton>
                            <ToggleButton IsChecked="{Binding IsAddingPolygon}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{Binding [add_polygon], Source={x:Static lg:LanguageService.Instance}}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IcoPath}" Data="M4 9l6.5-5 9.5 4.5-2 10.5H7z"/>
                                    </Canvas>
                                </Viewbox>
                            </ToggleButton>
                            <ToggleButton IsChecked="{Binding IsAddingArrow}" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{Binding [add_arrow], Source={x:Static lg:LanguageService.Instance}}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IcoPath}" Data="M4.5 19.5L15.6 8.4"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M20.5 3.5l-2.35 7.45-5.1-5.1z"/>
                                    </Canvas>
                                </Viewbox>
                            </ToggleButton>
                            <Button Command="{Binding AddFunctionCommand}" Style="{StaticResource ToolbarButtonIconStyle}" Visibility="{Binding IsAddFunctionButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding [add_function], Source={x:Static lg:LanguageService.Instance}}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IcoPath}" Data="M7 20V9a4 4 0 0 1 4-4h.5M4.5 11.5H10"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M11.5 12.5l6 7M17.5 12.5l-6 7"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M18 3.5v6M15 6.5h6"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <Rectangle Width="1" Height="24" Fill="#D0D0D0" Margin="8,0"/>

                            <Button Command="{Binding UndoCommand}" Style="{StaticResource ToolbarButtonIconStyle}" ToolTip="{Binding [plot_toolbar_undo_tooltip], Source={x:Static lg:LanguageService.Instance}}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IcoPath}" Data="M4.5 9.5H15a5 5 0 0 1 0 10h-5"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M8.5 5l-4 4.5 4 4.5"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Command="{Binding RedoCommand}" Style="{StaticResource ToolbarButtonIconStyle}" ToolTip="{Binding [plot_toolbar_redo_tooltip], Source={x:Static lg:LanguageService.Instance}}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24" RenderTransform="-1,0,0,1,24,0">
                                        <Path Style="{StaticResource IcoPath}" Data="M4.5 9.5H15a5 5 0 0 1 0 10h-5"/>
                                        <Path Style="{StaticResource IcoPath}" Data="M8.5 5l-4 4.5 4 4.5"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <Rectangle Width="1" Height="24" Fill="#D0D0D0" Margin="8,0"/>

                            <Button Command="{Binding DeleteSelectedObjectCommand}" Style="{StaticResource ToolbarButtonIconStyle}" ToolTip="{Binding [delete_object], Source={x:Static lg:LanguageService.Instance}}">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IcoDangerPath}" Data="M6 8h12l-.9 11.2a2 2 0 0 1-2 1.8H8.9a2 2 0 0 1-2-1.8z"/>
                                        <Path Style="{StaticResource IcoDangerPath}" Data="M4 8h16M9.5 8V5.5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1V8"/>
                                        <Path Style="{StaticResource IcoDangerPath}" Data="M10 11.5v5.5M14 11.5v5.5"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <Rectangle Width="1" Height="24" Fill="#D0D0D0" Margin="8,0"/>
                        </StackPanel>

                        <!-- Settings & Export -->
                        <Button Command="{Binding PlotSettingCommand}" Style="{StaticResource ToolbarButtonIconStyle}" ToolTip="{Binding [diagram_title_properties], Source={x:Static lg:LanguageService.Instance}}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IcoPath}" Data="M5.5 4h13a2.5 2.5 0 0 1 2.5 2.5v11a2.5 2.5 0 0 1 -2.5 2.5h-13a2.5 2.5 0 0 1 -2.5 -2.5v-11a2.5 2.5 0 0 1 2.5 -2.5z"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M7 8h10"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M7 16.5l3.5-3.5 2.5 2 4-4"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Command="{Binding LegendSettingCommand}" Style="{StaticResource ToolbarButtonIconStyle}" ToolTip="{Binding [diagram_legend_properties], Source={x:Static lg:LanguageService.Instance}}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IcoPath}" Data="M4.3 4.5h1.9a0.8 0.8 0 0 1 0.8 0.8v1.9a0.8 0.8 0 0 1 -0.8 0.8h-1.9a0.8 0.8 0 0 1 -0.8 -0.8v-1.9a0.8 0.8 0 0 1 0.8 -0.8z"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M4.3 10.25h1.9a0.8 0.8 0 0 1 0.8 0.8v1.9a0.8 0.8 0 0 1 -0.8 0.8h-1.9a0.8 0.8 0 0 1 -0.8 -0.8v-1.9a0.8 0.8 0 0 1 0.8 -0.8z"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M4.3 16h1.9a0.8 0.8 0 0 1 0.8 0.8v1.9a0.8 0.8 0 0 1 -0.8 0.8h-1.9a0.8 0.8 0 0 1 -0.8 -0.8v-1.9a0.8 0.8 0 0 1 0.8 -0.8z"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M10 6.25h10.5M10 12h10.5M10 17.75h10.5"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Command="{Binding GridSettingCommand}" IsEnabled="{Binding IsGridSettingEnabled}" Style="{StaticResource ToolbarButtonIconStyle}" ToolTip="{Binding [diagram_grid_properties], Source={x:Static lg:LanguageService.Instance}}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IcoPath}" Data="M5.5 3.5h13a2 2 0 0 1 2 2v13a2 2 0 0 1 -2 2h-13a2 2 0 0 1 -2 -2v-13a2 2 0 0 1 2 -2z"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M9.2 3.5v17M14.8 3.5v17M3.5 9.2h17M3.5 14.8h17"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Command="{Binding ScriptSettingCommand}" Style="{StaticResource ToolbarButtonIconStyle}" ToolTip="{Binding [diagram_script_properties], Source={x:Static lg:LanguageService.Instance}}"
                                Visibility="{Binding IsScriptSettingButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IcoPath}" Data="M8.5 7L3.5 12l5 5M15.5 7l5 5-5 5"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M13.5 4.5l-3 15"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="DiagramLanguageButton" Command="{Binding SwitchTemplateLanguageCommand}" Style="{StaticResource ToolbarButtonIconStyle}" ToolTip="{Binding [switch_diagram_language], Source={x:Static lg:LanguageService.Instance}}"
                                Visibility="{Binding IsDiagramLanguageButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IcoPath}" Data="M3 6h9M7.5 4v2M5 6c.6 3.4 3 6 6 7.5M10 6c-.6 3.4-3 6-6.5 8"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M13 20l4-10 4 10M14.6 16h4.8"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Popup IsOpen="{Binding IsDiagramLanguagePopupOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=DiagramLanguageButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#FDFDFE" BorderBrush="#DFE5ED" BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="220" Margin="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding [switch_diagram_language], Source={x:Static lg:LanguageService.Instance}}" Foreground="#7A8798" FontSize="11" Margin="10,7"/>
                                    <ItemsControl ItemsSource="{Binding DiagramLanguageOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DiagramLanguageOptionButtonStyle}"
                                                        Command="{Binding DataContext.SelectDiagramLanguageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="✓" FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"/>
                                                        <TextBlock Grid.Column="2" FontSize="11" Margin="10,0,0,0" Opacity="0.7">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Code}"/>
                                                                    <Setter Property="FontFamily" Value="Consolas"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                            <Setter Property="Text" Value="{Binding [Default], Source={x:Static lg:LanguageService.Instance}}"/>
                                                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Rectangle Width="1" Height="24" Fill="#D0D0D0" Margin="8,0"/>

                        <!-- Copy Image to Clipboard -->
                        <Button Command="{Binding CopyToClipboardCommand}" Style="{StaticResource ToolbarButtonIconStyle}" 
                                ToolTip="{Binding [copy_plot_to_clipboard], Source={x:Static lg:LanguageService.Instance}}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IcoPath}" Data="M9 4.5H7.5a2 2 0 0 0-2 2V19a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V6.5a2 2 0 0 0-2-2H15"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M10 3h4a1 1 0 0 1 1 1v1.5a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-1.5a1 1 0 0 1 1 -1z"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M8.5 17.5l3-3.5 2 2.2 1.5-1.7 2 3"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M9.5 11h.01"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Export / External Tools -->
                        <Button Command="{Binding ShowExportPanelCommand}" Style="{StaticResource ToolbarButtonIconStyle}" ToolTip="{Binding [export_and_tools], Source={x:Static lg:LanguageService.Instance}, TargetNullValue='瀵煎嚭/宸ュ叿'}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IcoPath}" Data="M12 5H6.5a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5.5"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M7.5 17l3-4 2.5 3 1.5-2 3.5 3"/>
                                    <Path Style="{StaticResource IcoPath}" Data="M15 3h6v6M21 3l-8 8"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Rectangle Width="1" Height="24" Fill="#D0D0D0" Margin="8,0"/>



                    </StackPanel>
                </Grid>
        </ContentControl>

        <!-- 模板浏览模式 -->
        <Grid x:Name="TemplateGrid" Grid.Row="1" Visibility="{Binding IsPlotMode, Converter={StaticResource BoolToVisibilityReConverter}}" Opacity="1" RenderTransformOrigin="0.5,0.5">
            <i:Interaction.Behaviors>
                <tools:FileDropBehavior DropCommand="{Binding ImportCustomTemplateFromPathCommand}"
                                        AllowedExtensions="{x:Static tools:TemplatePackageFileExtensions.DiagramDropAllowed}"
                                        OverlayFormats="{x:Static tools:TemplatePackageFileExtensions.DiagramPrimary}"
                                        KickerText="{Binding [file_drop_diagram_kicker], Source={x:Static lg:LanguageService.Instance}}"
                                        HintText="{Binding [file_drop_release_to_import], Source={x:Static lg:LanguageService.Instance}}"
                                        SubHintText="{Binding [file_drop_diagram_sub], Source={x:Static lg:LanguageService.Instance}}"
                                        InvalidHintText="{Binding [file_drop_invalid_format], Source={x:Static lg:LanguageService.Instance}}"
                                        InvalidSubHintText="{Binding [file_drop_use_formats_below], Source={x:Static lg:LanguageService.Instance}}"
                                        RecognizedCountFormat="{Binding [file_drop_recognized_count], Source={x:Static lg:LanguageService.Instance}}"/>
            </i:Interaction.Behaviors>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧模板分类树 -->
            <DockPanel x:Name="TemplateTreePanel" Grid.Column="0" TextElement.FontFamily="Segoe UI, Microsoft YaHei UI" Background="{StaticResource DiagramLibraryBackgroundBrush}">
                <!-- macOS 风格侧边栏 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,12,10,14">
                        <!-- 分组一：资源库 -->
                        <Grid Margin="10,0,10,5">
                            <TextBlock Text="{Binding [library_section],Source={x:Static lg:LanguageService.Instance}, FallbackValue='资源库'}"
                                       Style="{StaticResource DiagramLibrarySectionHeaderStyle}"
                                       Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <uc:IconLinkButton Text="{Binding [check_for_template_updates],Source={x:Static lg:LanguageService.Instance}, FallbackValue='检查更新'}"
                                               Command="{Binding CheckForTemplateUpdatesCommand}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 官方图解 -->
                        <Button Style="{StaticResource DiagramLibraryCategoryButtonStyle}"
                                Tag="{Binding IsOfficialRootActive}"
                                Command="{Binding ToggleCategoryExpansionCommand}"
                                CommandParameter="Official">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource DiagramLibraryChevronStyle}"
                                           Tag="{Binding IsOfficialExpanded}"/>
                                <Viewbox Grid.Column="1" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24"><Path Style="{StaticResource DiagramLibraryButtonIconStyle}" Data="M5,4 L19,4 A2,2 0 0 1 21,6 L21,18 A2,2 0 0 1 19,20 L5,20 A2,2 0 0 1 3,18 L3,6 A2,2 0 0 1 5,4 Z M3,9 L21,9 M9,14 L15,14"/></Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding [official_templates],Source={x:Static lg:LanguageService.Instance}}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <!-- 官方图解子树 -->
                        <Border x:Name="OfficialTreeBorder"
                                Style="{StaticResource MacSidebarCollapsibleBorderStyle}"
                                Tag="{Binding IsOfficialExpanded}">
                            <TreeView ItemsSource="{Binding OfficialTemplatesNode.Children}"
                                      Tag="Official"
                                      Background="Transparent"
                                      HorizontalContentAlignment="Stretch" Padding="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ItemContainerStyle="{StaticResource TemplateTreeViewItemStyle}"
                                      ItemTemplate="{StaticResource MacSidebarTemplateNodeTemplate}"
                                      BorderThickness="0"
                                      Margin="14,0,0,0"
                                      PreviewMouseWheel="TreeView_PreviewMouseWheel">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectedItemChanged">
                                        <i:InvokeCommandAction Command="{Binding SelectTreeViewItemCommand}"
                                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TreeView>
                        </Border>

                        <!-- 分组二：我的空间 -->
                        <Grid Margin="10,18,10,5">
                            <TextBlock Text="{Binding [workspace_section],Source={x:Static lg:LanguageService.Instance}, FallbackValue='我的空间'}"
                                       Style="{StaticResource DiagramLibrarySectionHeaderStyle}"
                                       Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <uc:IconLinkButton Icon="&#xE710;"
                                               Text="{Binding [create_new_diagram_template],Source={x:Static lg:LanguageService.Instance}, FallbackValue='新建图解'}"
                                               Command="{Binding NewTemplateCommand}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 个人图解 -->
                        <Button Style="{StaticResource DiagramLibraryCategoryButtonStyle}"
                                Tag="{Binding IsPersonalRootActive}"
                                Command="{Binding ToggleCategoryExpansionCommand}"
                                CommandParameter="Personal">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource DiagramLibraryChevronStyle}"
                                           Tag="{Binding IsPersonalExpanded}"/>
                                <Viewbox Grid.Column="1" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24"><Path Style="{StaticResource DiagramLibraryButtonIconStyle}" Data="M19,21 L19,19 A4,4 0 0 0 15,15 L9,15 A4,4 0 0 0 5,19 L5,21 M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7"/></Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding [personal_templates],Source={x:Static lg:LanguageService.Instance}}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <!-- 个人图解子树 -->
                        <Border x:Name="PersonalTreeBorder"
                                Style="{StaticResource MacSidebarCollapsibleBorderStyle}"
                                Tag="{Binding IsPersonalExpanded}">
                            <TreeView ItemsSource="{Binding PersonalTemplatesNode.Children}"
                                      Background="Transparent"
                                      HorizontalContentAlignment="Stretch" Padding="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ItemContainerStyle="{StaticResource TemplateTreeViewItemStyle}"
                                      ItemTemplate="{StaticResource MacSidebarTemplateNodeTemplate}"
                                      BorderThickness="0"
                                      Margin="14,0,0,0"
                                      PreviewMouseWheel="TreeView_PreviewMouseWheel">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectedItemChanged">
                                        <i:InvokeCommandAction Command="{Binding SelectTreeViewItemCommand}"
                                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TreeView>
                        </Border>

                        <!-- 收藏 -->
                        <Button Style="{StaticResource DiagramLibraryItemButtonStyle}"
                                Tag="{Binding IsFavoriteExpanded}"
                                Command="{Binding ToggleCategoryExpansionCommand}"
                                CommandParameter="Favorite">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="1" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24"><Path Style="{StaticResource DiagramLibraryButtonIconStyle}" Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z"/></Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding [favorite_templates],Source={x:Static lg:LanguageService.Instance}}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <!-- 最近使用 -->
                        <Button Style="{StaticResource DiagramLibraryItemButtonStyle}"
                                Tag="{Binding IsRecentsExpanded}"
                                Command="{Binding ToggleCategoryExpansionCommand}"
                                CommandParameter="Recents">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="1" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24"><Path Style="{StaticResource DiagramLibraryButtonIconStyle}" Data="M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 M12,7 L12,12 L15.5,14"/></Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding [recents_templates],Source={x:Static lg:LanguageService.Instance}, FallbackValue='最近使用'}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <!-- 分组三：工具图解 -->
                        <TextBlock Text="{Binding [tool_diagrams_section],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Tool Diagrams'}"
                                   Style="{StaticResource DiagramLibrarySectionHeaderStyle}"/>

                        <!-- 稀土元素蛛网图 -->
                        <Button Style="{StaticResource MacSidebarReeSpiderButtonStyle}"
                                Command="{Binding OpenSpiderDiagramCommand}"
                                CommandParameter="REE">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="1" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24"><Path Style="{StaticResource DiagramLibraryButtonIconStyle}" Data="M3,3 L3,21 L21,21 M7,14 L11,9 L15,12 L20,6 M7,18 L11,15 L15,17 L20,13"/></Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding [ree_spider_diagram],Source={x:Static lg:LanguageService.Instance}, FallbackValue='稀土元素蛛网图'}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <!-- 微量元素蛛网图 -->
                        <Button Style="{StaticResource MacSidebarTraceSpiderButtonStyle}"
                                Command="{Binding OpenSpiderDiagramCommand}"
                                CommandParameter="TraceElement">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="1" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24"><Path Style="{StaticResource DiagramLibraryButtonIconStyle}" Data="M3,3 L3,21 L21,21 M7,16 L10,10 L14,14 L20,6 M11.2,10 A1.2,1.2 0 1 1 8.8,10 A1.2,1.2 0 1 1 11.2,10 M15.2,14 A1.2,1.2 0 1 1 12.8,14 A1.2,1.2 0 1 1 15.2,14 M21.2,6 A1.2,1.2 0 1 1 18.8,6 A1.2,1.2 0 1 1 21.2,6"/></Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding [trace_element_spider_diagram],Source={x:Static lg:LanguageService.Instance}, FallbackValue='微量元素蛛网图'}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <!-- Harker 多联图 -->
                        <Button Style="{StaticResource DiagramLibraryItemButtonStyle}"
                                Tag="{Binding IsHarkerDiagramMode}"
                                Command="{Binding OpenHarkerDiagramCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="1" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24"><Path Style="{StaticResource DiagramLibraryButtonIconStyle}" Data="M3,3 L11,3 L11,11 L3,11 Z M13,3 L21,3 L21,11 L13,11 Z M3,13 L11,13 L11,21 L3,21 Z M13,13 L21,13 L21,21 L13,21 Z"/></Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding [harker_diagram],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Harker 多联图'}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <!-- 二维散点图 -->
                        <Button Style="{StaticResource DiagramLibraryItemButtonStyle}"
                                Tag="{Binding IsScatter2DDiagramMode}"
                                Command="{Binding OpenScatterDiagramCommand}"
                                CommandParameter="2D">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="1" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24"><Path Style="{StaticResource DiagramLibraryButtonIconStyle}" Data="M3,3 L3,21 L21,21 M9.8,14.5 A1.3,1.3 0 1 1 7.2,14.5 A1.3,1.3 0 1 1 9.8,14.5 M13.3,10 A1.3,1.3 0 1 1 10.7,10 A1.3,1.3 0 1 1 13.3,10 M17.3,13 A1.3,1.3 0 1 1 14.7,13 A1.3,1.3 0 1 1 17.3,13 M19.8,7.5 A1.3,1.3 0 1 1 17.2,7.5 A1.3,1.3 0 1 1 19.8,7.5"/></Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding [scatter_2d_diagram],Source={x:Static lg:LanguageService.Instance}, FallbackValue='二维散点图'}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>

                        <!-- 三元散点图 -->
                        <Button Style="{StaticResource DiagramLibraryItemButtonStyle}"
                                Tag="{Binding IsTernaryScatterDiagramMode}"
                                Command="{Binding OpenScatterDiagramCommand}"
                                CommandParameter="Ternary">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="1" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24"><Path Style="{StaticResource DiagramLibraryButtonIconStyle}" Data="M12,3 L21,20 L3,20 Z M12.9,12 A0.9,0.9 0 1 1 11.1,12 A0.9,0.9 0 1 1 12.9,12 M9.9,16 A0.9,0.9 0 1 1 8.1,16 A0.9,0.9 0 1 1 9.9,16 M15.9,16.5 A0.9,0.9 0 1 1 14.1,16.5 A0.9,0.9 0 1 1 15.9,16.5"/></Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding [scatter_ternary_diagram],Source={x:Static lg:LanguageService.Instance}, FallbackValue='三元散点图'}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <!-- 两侧填充与相邻面板一致的底色，避免 4px 间隙露出页面白色背景 -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="{StaticResource MacSidebarBackgroundBrush}"/>
                            <Rectangle Grid.Column="1" Fill="#F5F5F5"/>
                            <Rectangle Grid.ColumnSpan="2" Width="1" HorizontalAlignment="Center" Fill="#E0E0E0"/>
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 右侧模板卡片展示区域 -->
            <Grid Grid.Column="2" Background="#F5F5F5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 模板卡片网格 (虚拟化) -->
                <Grid Grid.Row="1"
                      Visibility="{Binding IsToolPanelMode, Converter={StaticResource BoolToVisibilityReConverter}}">
                    <!-- Margin 右侧为 0 使滚动条贴齐边框；右侧间距由 TemplateCardListBoxStyle 的 Padding 保留 -->
                    <ListBox ItemsSource="{Binding TemplateCardsView}" Margin="10,10,0,10"
                             Style="{StaticResource TemplateCardListBoxStyle}"
                             x:Name="TemplateCardsControl"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- VWP 2.x：Horizontal=横向排列换行+纵向滚动；Vertical=纵向排列换列+横向滚动（勿用） -->
                            <!-- ItemSize 由 MainPlotPage.xaml.cs 按布局模式/视口宽度运行时计算 -->
                            <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                                       StretchItems="True"
                                                       SpacingMode="Uniform"
                                                       ItemSize="{StaticResource TemplateCardCellSize}"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 固定命中区域，避免抬升后边缘反复触发移入/移出。 -->
                            <Grid x:Name="TemplateCardHitArea" Margin="8" Background="Transparent">
                            <Grid x:Name="TemplateCardSurface">
                                <Grid.RenderTransform>
                                    <TranslateTransform/>
                                </Grid.RenderTransform>
                                <!-- 阴影独立于内容绘制，保持名称和作者文字清晰。 -->
                                <Border x:Name="TemplateCardShadow" Background="White" CornerRadius="8" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.14"/>
                                    </Border.Effect>
                                </Border>
                            <Border x:Name="TemplateCardRoot" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" Margin="0"
                                    Tag="{Binding DataContext, ElementName=TemplateCardsControl}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TemplateCardStyle}">
                                        <Style.Triggers>
                                            <!-- 开发者模式：已转换为内置模板但尚未推送的卡片使用深红色边框 -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsNewTemplate}" Value="True"/>
                                                    <Condition Binding="{Binding Tag.IsDeveloperMode, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderBrush" Value="{StaticResource ConvertedBuiltinTemplateBorderBrush}"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsNewTemplate}" Value="True"/>
                                                    <Condition Binding="{Binding Tag.IsDeveloperMode, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Value="True">
                                                        <Condition.Binding>
                                                            <MultiBinding Converter="{StaticResource BoolOrMultiConverter}">
                                                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}"/>
                                                                <Binding Path="ContextMenu.IsOpen" RelativeSource="{RelativeSource Self}"/>
                                                            </MultiBinding>
                                                        </Condition.Binding>
                                                    </Condition>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderBrush" Value="{StaticResource ConvertedBuiltinTemplateBorderBrush}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <!--收藏/取消收藏-->
                                        <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="{Binding [favorite],Source={x:Static lg:LanguageService.Instance}}"/>
                                                    <Style.Triggers>
                                                        <!-- 如果已经收藏，显示"取消收藏" -->
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Header" Value="{Binding [unfavorite],Source={x:Static lg:LanguageService.Instance}}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator/>
                                        <!--编辑图解模板-->
                                        <MenuItem Header="{Binding [Edit],Source={x:Static lg:LanguageService.Instance}}" 
                                                  Command="{Binding PlacementTarget.Tag.EditTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <!-- 个人图解显示编辑选项 -->
                                                        <DataTrigger Binding="{Binding IsCustomTemplate}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <!-- 开发者模式下非个人图解才显示编辑选项 -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCustomTemplate}" Value="False"/>
                                                                <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <!-- 未下载的官方图解没有本地内容，隐藏该项 -->
                                                        <DataTrigger Binding="{Binding IsNotDownloaded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!--只读查看官方图解模板 (非开发者模式 + 已下载的官方图解)-->
                                        <MenuItem Header="{Binding [ctx_view],Source={x:Static lg:LanguageService.Instance}}"
                                                  Command="{Binding PlacementTarget.Tag.ViewTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCustomTemplate}" Value="False"/>
                                                                <Condition Binding="{Binding IsNotDownloaded}" Value="False"/>
                                                                <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!--导出图解模板 (未下载的官方图解隐藏)-->
                                        <MenuItem Header="{Binding [geo_btn_export],Source={x:Static lg:LanguageService.Instance}}" 
                                                  Command="{Binding PlacementTarget.Tag.ExportTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <!-- 非开发者模式下隐藏导出 -->
                                                        <DataTrigger Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsNotDownloaded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!--强制更新 (开发者模式 + 官方图解)-->
                                        <MenuItem Header="{Binding [force_update_template],Source={x:Static lg:LanguageService.Instance}, TargetNullValue='强制更新'}"
                                                  Command="{Binding PlacementTarget.Tag.ForceUpdateTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCustomTemplate}" Value="False"/>
                                                                <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <!-- 未下载的官方图解没有本地内容，隐藏该项 -->
                                                        <DataTrigger Binding="{Binding IsNotDownloaded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!--转换为内置模板 (开发者模式)-->
                                        <MenuItem Header="{Binding [convert_to_builtin_template],Source={x:Static lg:LanguageService.Instance}, TargetNullValue='转换为内置模板'}"
                                                  Command="{Binding PlacementTarget.Tag.ConvertToBuiltInCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCustomTemplate}" Value="True"/>
                                                                <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!--降级为个人图解 (开发者模式 + 官方图解)-->
                                        <MenuItem Header="{Binding [demote_to_custom_template],Source={x:Static lg:LanguageService.Instance}, TargetNullValue='降级为个人图解'}"
                                                  Command="{Binding PlacementTarget.Tag.DemoteToCustomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCustomTemplate}" Value="False"/>
                                                                <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <!-- 未下载的官方图解没有本地内容，隐藏该项 -->
                                                        <DataTrigger Binding="{Binding IsNotDownloaded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="{Binding [Delete],Source={x:Static lg:LanguageService.Instance}}" 
                                                  Tag="Danger"
                                                  Command="{Binding PlacementTarget.Tag.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustomTemplate}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding CardClickCommand}"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="Loaded">
                                        <i:InvokeCommandAction Command="{Binding CheckReadinessCommand}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <!-- 固定文字区高度，长名称不再挤压缩略图。 -->
                                        <RowDefinition Height="64"/>
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnails -->
                                    <Border x:Name="ThumbnailFrame" Grid.Row="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Margin" Value="8,8,8,0"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                <Setter Property="CornerRadius" Value="8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag.TemplateCardAppearance, ElementName=TemplateCardRoot}" Value="{x:Static models:TemplateCardAppearance.Frameless}">
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=TemplateCardRoot}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <Grid x:Name="ThumbnailContent" tools:HomeRoundedClip.Radius="7">
                                        <Border x:Name="ThumbnailBorder" CornerRadius="7" Background="White">
                                            <Image Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="{Binding ThumbnailImage}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag.TemplateCardAppearance, ElementName=TemplateCardRoot}" Value="{x:Static models:TemplateCardAppearance.Frameless}">
                                                                <Setter Property="Margin" Value="6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ThumbnailImage}" Value="{x:Null}">
                                                                <Setter Property="Source" Value="{Binding ThumbnailPath, Converter={StaticResource StringToBitmapImageConverter}, ConverterParameter=320}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>

                                        <!-- 收藏图标按钮 -->
                                        <Button VerticalAlignment="Top" HorizontalAlignment="Right" 
                                                Width="28" Height="28" Margin="4"
                                                Command="{Binding ToggleFavoriteCommand}"
                                                Background="Transparent" BorderThickness="0" 
                                                Cursor="Hand"
                                                Opacity="0"
                                                Panel.ZIndex="999">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="FavoriteBorder" 
                                                                        Background="{TemplateBinding Background}" 
                                                                        CornerRadius="14"
                                                                        Width="28" Height="28">
                                                                    <TextBlock x:Name="FavoriteIcon" 
                                                                               Text="&#xe649;" 
                                                                               FontFamily="{StaticResource IconFont}" 
                                                                               FontSize="16" 
                                                                               Foreground="#999" 
                                                                               HorizontalAlignment="Center" 
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <!-- 鼠标悬停效果 -->
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="FavoriteBorder" Property="Background" Value="#F0F0F0"/>
                                                                    </Trigger>
                                                                    <!-- 已收藏状态 - 高亮显示 -->
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter TargetName="FavoriteIcon" Property="Foreground" Value="#FFD700"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <!-- 卡片悬停或右键菜单打开时显示收藏按钮 -->
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource BoolOrMultiConverter}">
                                                                    <Binding Path="IsMouseOver" ElementName="TemplateCardHitArea"/>
                                                                    <Binding Path="ContextMenu.IsOpen" ElementName="TemplateCardRoot"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                                                         To="1.0" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                                                         To="0" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0"
                                                Width="{Binding ActualWidth, ElementName=ThumbnailBorder}"
                                                Command="{Binding UpdateCommand}"
                                                Padding="0,8" Background="{DynamicResource ThemeAccentBrush}" Foreground="White"
                                                BorderThickness="0" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6,6,0,0">
                                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                     <Trigger Property="IsMouseOver" Value="True">
                                                                         <Setter Property="Opacity" Value="0.9"/>
                                                                     </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" IsHitTestVisible="False">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE118;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding [update_available_click_to_download], Source={x:Static lg:LanguageService.Instance}, TargetNullValue='有新版本可用，点击更新'}" 
                                                               FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Button>

                                        <!-- 本地已有旧版、服务器新版需要升级软件：仍可点击打开旧版，顶部只显示提示条 -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Padding="0,8" Background="#C77700"
                                                CornerRadius="6,6,0,0" IsHitTestVisible="False"
                                                Width="{Binding ActualWidth, ElementName=ThumbnailBorder}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="UpdateRequiresAppUpgrade">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <Border CornerRadius="6,6,0,0" Background="#80000000">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="NotDownloaded">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="RequiresAppUpgrade">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="NotDownloaded">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Error">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="RequiresAppUpgrade">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock FontSize="30" Foreground="White" 
                                       HorizontalAlignment="Center" Margin="0,0,0,5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="⬇"/>
                                                                <Style.Triggers>
                                                                    <!-- 需升级软件：不能下载，用锁图标代替下载箭头 -->
                                                                    <DataTrigger Binding="{Binding State}" Value="RequiresAppUpgrade">
                                                                        <Setter Property="Text" Value="🔒"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding StateText}" Foreground="White" 
                                       FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel VerticalAlignment="Center" Margin="20,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock Text="{Binding [downloading_ellipsis],Source={x:Static lg:LanguageService.Instance}}" Foreground="White" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="10" BorderThickness="0"/>
                                                    <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:0}%}" 
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    </Border>

                                    <!--模板名称和分类-->
                                    <Border x:Name="TemplateCardCaption" Grid.Row="1" Margin="6,4,6,4"
                                            Padding="6,4" CornerRadius="6" Background="Transparent">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="16"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="TemplateCardNameBackground" Background="Transparent" CornerRadius="4" Padding="4,0">
                                            <TextBlock x:Name="TemplateCardName" Text="{Binding Name}" ToolTip="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="12" LineHeight="16"
                                                       LineStackingStrategy="BlockLineHeight" MaxHeight="32"
                                                       Foreground="#333" TextAlignment="Center" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <TextBlock x:Name="TemplateCardAuthor" Grid.Row="1" Text="{Binding Category}" ToolTip="{Binding Category}"
                                                       FontSize="10.5" Foreground="#666" VerticalAlignment="Center"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>

                                    <!-- 右 Alt 按住时的操作遮罩 -->
                                    <Border x:Name="TemplateCardCtrlOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#66000000" CornerRadius="7"
                                            tools:HomeRoundedClip.Radius="7"
                                            Panel.ZIndex="1000">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCtrlOverlayVisible}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                                                     From="0" To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                                                     To="0" Duration="0:0:0.15"/>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 左侧：删除区域 -->
                                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" 
                                                    Command="{Binding QuickDeleteCommand}" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="DeleteArea" Background="#B0E53935" 
                                                                            CornerRadius="6,0,0,6">
                                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                            <TextBlock Text="&#xE107;" FontFamily="Segoe MDL2 Assets" 
                                                                                       FontSize="32" Foreground="White" 
                                                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                                            <TextBlock Text="删除" FontSize="14" FontWeight="Bold" 
                                                                                       Foreground="White" HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="DeleteArea" Property="Background" Value="#E0E53935"/>
                                                                        </Trigger>
                                                                        <!-- 非自定义模板隐藏快捷删除按钮（仅支持右键删除） -->
                                                                        <DataTrigger Binding="{Binding IsCustomTemplate}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- 右侧：收藏区域（仅自定义模板显示） -->
                                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                                    Command="{Binding QuickFavoriteCommand}" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="FavoriteArea" Background="#B0FFA726" 
                                                                            CornerRadius="0,6,6,0">
                                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                            <TextBlock x:Name="FavoriteIcon" 
                                                                                       Text="&#xe649;" 
                                                                                       FontFamily="{StaticResource IconFont}" 
                                                                                       FontSize="32" Foreground="White" 
                                                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                                            <TextBlock x:Name="FavoriteText" 
                                                                                       Text="收藏" FontSize="14" FontWeight="Bold" 
                                                                                       Foreground="White" HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="FavoriteArea" Property="Background" Value="#E0FFA726"/>
                                                                        </Trigger>
                                                                        <!-- 已收藏状态 -->
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter TargetName="FavoriteText" Property="Text" Value="取消收藏"/>
                                                                            <Setter TargetName="FavoriteArea" Property="Background" Value="#B0FFD54F"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <!-- 非自定义模板隐藏右侧收藏按钮，由全宽收藏按钮代替 -->
                                                            <DataTrigger Binding="{Binding IsCustomTemplate}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- 非自定义模板时，收藏区域占满整个宽度 -->
                                            <Button Grid.Column="0" Grid.ColumnSpan="2" 
                                                    Background="Transparent" BorderThickness="0" 
                                                    Command="{Binding QuickFavoriteCommand}" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="FullFavoriteArea" Background="#B0FFA726" 
                                                                            CornerRadius="6">
                                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                            <TextBlock x:Name="FullFavoriteIcon" 
                                                                                       Text="&#xe649;" 
                                                                                       FontFamily="{StaticResource IconFont}" 
                                                                                       FontSize="32" Foreground="White" 
                                                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                                            <TextBlock x:Name="FullFavoriteText" 
                                                                                       Text="收藏" FontSize="14" FontWeight="Bold" 
                                                                                       Foreground="White" HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="FullFavoriteArea" Property="Background" Value="#E0FFA726"/>
                                                                        </Trigger>
                                                                        <!-- 已收藏状态 -->
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter TargetName="FullFavoriteText" Property="Text" Value="取消收藏"/>
                                                                            <Setter TargetName="FullFavoriteArea" Property="Background" Value="#B0FFD54F"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <!-- 只有非自定义模板才显示全屏收藏按钮 -->
                                                            <DataTrigger Binding="{Binding IsCustomTemplate}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <!-- 高亮独立绘制，不改变边框厚度和卡片尺寸。 -->
                                    <Border x:Name="TemplateCardHoverOutline" Grid.RowSpan="2" Margin="-1"
                                            BorderBrush="{Binding BorderBrush, ElementName=TemplateCardRoot}"
                                            BorderThickness="2" CornerRadius="8" Visibility="Collapsed"
                                            IsHitTestVisible="False" Panel.ZIndex="2000"/>
                                </Grid>
                            </Border>
                            </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tag.TemplateCardAppearance, ElementName=TemplateCardRoot}" Value="{x:Static models:TemplateCardAppearance.Frameless}">
                                    <Setter TargetName="TemplateCardRoot" Property="Background" Value="Transparent"/>
                                    <Setter TargetName="TemplateCardRoot" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="TemplateCardShadow" Property="Height" Value="{Binding ActualHeight, ElementName=ThumbnailFrame}"/>
                                    <Setter TargetName="TemplateCardShadow" Property="VerticalAlignment" Value="Top"/>
                                    <Setter TargetName="ThumbnailContent" Property="tools:HomeRoundedClip.Radius" Value="7"/>
                                    <Setter TargetName="TemplateCardCaption" Property="Margin" Value="0,6,0,0"/>
                                    <Setter TargetName="TemplateCardCtrlOverlay" Property="Grid.RowSpan" Value="1"/>
                                    <Setter TargetName="TemplateCardCtrlOverlay" Property="Margin" Value="1"/>
                                    <Setter TargetName="TemplateCardCtrlOverlay" Property="tools:HomeRoundedClip.Radius" Value="7"/>
                                    <Setter TargetName="TemplateCardHoverOutline" Property="Grid.RowSpan" Value="1"/>
                                    <Setter TargetName="TemplateCardHoverOutline" Property="Margin" Value="0"/>
                                </DataTrigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource BoolOrMultiConverter}">
                                            <Binding Path="IsMouseOver" ElementName="TemplateCardHitArea"/>
                                            <Binding Path="ContextMenu.IsOpen" ElementName="TemplateCardRoot"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="TemplateCardHoverOutline" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="TemplateCardRoot" Property="BorderBrush" Value="{DynamicResource TemplateCardHoverBrush}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="TemplateCardSurface"
                                                                 Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                 To="-4" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TemplateCardShadow"
                                                                 Storyboard.TargetProperty="Effect.(DropShadowEffect.ShadowDepth)"
                                                                 To="6" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="TemplateCardShadow"
                                                                 Storyboard.TargetProperty="Effect.(DropShadowEffect.BlurRadius)"
                                                                 To="16" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="TemplateCardShadow"
                                                                 Storyboard.TargetProperty="Effect.(DropShadowEffect.Opacity)"
                                                                 To="0.22" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="TemplateCardSurface"
                                                                 Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                 To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TemplateCardShadow"
                                                                 Storyboard.TargetProperty="Effect.(DropShadowEffect.ShadowDepth)"
                                                                 To="2" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="TemplateCardShadow"
                                                                 Storyboard.TargetProperty="Effect.(DropShadowEffect.BlurRadius)"
                                                                 To="10" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="TemplateCardShadow"
                                                                 Storyboard.TargetProperty="Effect.(DropShadowEffect.Opacity)"
                                                                 To="0.14" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsNewTemplate}" Value="True"/>
                                        <Condition Binding="{Binding Tag.IsDeveloperMode, ElementName=TemplateCardRoot}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="TemplateCardHoverOutline" Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 模板列表为空时的居中提示 -->
                    <TextBlock Text="{Binding TemplateCardsEmptyHint}"
                               FontSize="14"
                               Foreground="#AAAAAA"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="360"
                               Margin="24"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsTemplateCardsEmpty}" Value="True"/>
                                            <Condition Binding="{Binding IsSearchNoResults}" Value="False"/>
                                            <Condition Binding="{Binding IsPersonalExpanded}" Value="False"/>
                                            <Condition Binding="{Binding IsFavoriteExpanded}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 收藏为空：动态插画 + 提示文本 -->
                    <uc:EmptyStateView IconKind="DiagramSearch"
                                       IconSize="260"
                                       Title="{Binding TemplateCardsEmptyHint}"
                                       TitleFontSize="14"
                                       MaxWidth="360"
                                       Margin="24"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                        <uc:EmptyStateView.Style>
                            <Style TargetType="uc:EmptyStateView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsTemplateCardsEmpty}" Value="True"/>
                                            <Condition Binding="{Binding IsSearchNoResults}" Value="False"/>
                                            <Condition Binding="{Binding IsFavoriteExpanded}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </uc:EmptyStateView.Style>
                    </uc:EmptyStateView>

                    <!-- 个人图解为空：动态插画 + 提示文本 -->
                    <uc:EmptyStateView IconKind="PersonalDiagram"
                                       IconSize="260"
                                       Title="{Binding TemplateCardsEmptyHint}"
                                       TitleFontSize="14"
                                       MaxWidth="360"
                                       Margin="24"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                        <uc:EmptyStateView.Description>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Button Style="{StaticResource EmptyStatePrimaryButtonStyle}"
                                        Command="{Binding NewTemplateCommand}" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding [empty_state_new],Source={x:Static lg:LanguageService.Instance}, FallbackValue=新建}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource EmptyStateSecondaryButtonStyle}"
                                        Command="{Binding ImportCustomTemplateCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding [empty_state_import],Source={x:Static lg:LanguageService.Instance}, FallbackValue=导入}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </uc:EmptyStateView.Description>
                        <uc:EmptyStateView.Style>
                            <Style TargetType="uc:EmptyStateView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsTemplateCardsEmpty}" Value="True"/>
                                            <Condition Binding="{Binding IsSearchNoResults}" Value="False"/>
                                            <Condition Binding="{Binding IsPersonalExpanded}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </uc:EmptyStateView.Style>
                    </uc:EmptyStateView>

                    <!-- 搜索无结果：提示反馈渠道 -->
                    <StackPanel MaxWidth="420"
                                Margin="24"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsSearchNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <uc:EmptyStateView IconKind="DiagramSearch"
                                           IconSize="240"
                                           Title="{Binding TemplateCardsEmptyHint}"
                                           TitleFontSize="14">
                            <uc:EmptyStateView.Description>
                                <uc:TemplateFeedbackHint FontSize="13"
                                                         Foreground="#AAAAAA"
                                                         Margin="0,12,0,0"/>
                            </uc:EmptyStateView.Description>
                        </uc:EmptyStateView>
                    </StackPanel>
                </Grid>

                <!-- 蛛网图工具面板 -->
                <Grid Grid.Row="1" Margin="20"
                      Visibility="{Binding IsSpiderDiagramMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <StackPanel Margin="0,0,0,16">
                            <!-- 标准化方案选择 -->
                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding [normalization_standard],Source={x:Static lg:LanguageService.Instance}, FallbackValue='标准化方案'}" 
                                               FontSize="14" FontWeight="SemiBold" Foreground="#333"
                                               VerticalAlignment="Center"/>
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding SpiderDiagramViewModel.IsNormalizationEnabled, Mode=TwoWay}"
                                              Content="{Binding [enable_normalization],Source={x:Static lg:LanguageService.Instance}, FallbackValue='启用标准化'}"
                                              FontSize="12" Foreground="#555"/>
                                </Grid>
                                <ComboBox x:Name="NormalizationComboBox"
                                          ItemsSource="{Binding SpiderDiagramViewModel.AvailableStandardsView}"
                                          SelectedItem="{Binding SpiderDiagramViewModel.SelectedStandard}"
                                          IsEnabled="{Binding SpiderDiagramViewModel.IsNormalizationEnabled}"
                                          DisplayMemberPath="Name"
                                          MaxDropDownHeight="420"
                                          Height="32" FontSize="13">
                                    <ComboBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F0F0F0" Padding="8,4" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Foreground="#666666"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ComboBox.GroupStyle>
                                </ComboBox>
                                <Border Margin="0,8,0,0"
                                        Padding="10,8"
                                        Background="#FAFAFA"
                                        BorderBrush="#E8E8E8"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        IsEnabled="{Binding SpiderDiagramViewModel.IsNormalizationEnabled}"
                                        Visibility="{Binding SpiderDiagramViewModel.HasSelectedStandardDisplayValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpiderDiagramViewModel.IsNormalizationEnabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SpiderDiagramViewModel.SelectedStandardDisplayTitle}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#555"/>
                                        <ItemsControl Margin="0,6,0,0"
                                                      ItemsSource="{Binding SpiderDiagramViewModel.SelectedStandardDisplayValues}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,6"
                                                            Padding="8,4"
                                                            Background="White"
                                                            BorderBrush="#E4E4E4"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Key}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#333"/>
                                                            <TextBlock Text=" = "
                                                                       FontSize="12"
                                                                       Foreground="#777"/>
                                                            <TextBlock Text="{Binding Value, StringFormat={}{0:G6}}"
                                                                       FontSize="12"
                                                                       Foreground="#666"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 元素选择与排序 -->
                            <StackPanel>
                                <!-- 标题行：标题 + 操作链接 -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding [element_order],Source={x:Static lg:LanguageService.Instance}, FallbackValue='元素顺序'}" 
                                               FontSize="14" FontWeight="SemiBold" Foreground="#333" 
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ThemeLinkButtonStyle}" Command="{Binding SpiderDiagramViewModel.SelectAllElementsCommand}"
                                                Content="{Binding [select_all],Source={x:Static lg:LanguageService.Instance}, FallbackValue='全选'}"
                                                Padding="6,2" Margin="0,0,2,0"/>
                                        <TextBlock Text="|" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <Button Style="{StaticResource ThemeLinkButtonStyle}" Command="{Binding SpiderDiagramViewModel.DeselectAllElementsCommand}"
                                                Content="{Binding [deselect_all],Source={x:Static lg:LanguageService.Instance}, FallbackValue='取消全选'}"
                                                Padding="6,2" Margin="0,0,2,0"/>
                                        <TextBlock Text="|" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <Button Style="{StaticResource ThemeLinkButtonStyle}" Command="{Binding SpiderDiagramViewModel.ResetElementOrderCommand}"
                                                Content="{Binding [reset_default],Source={x:Static lg:LanguageService.Instance}, FallbackValue='重置'}"
                                                Padding="6,2"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding [spider_element_order_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue='勾选需要参与绘图的元素；下方列表表示当前绘图顺序，可通过右侧按钮调整横轴排列。'}"
                                           Margin="0,0,0,8"
                                           FontSize="12"
                                           Foreground="#777"
                                           TextWrapping="Wrap"/>

                                <!-- 元素 Chip 网格（点击切换选中） -->
                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <ItemsControl ItemsSource="{Binding SpiderDiagramViewModel.AllElements}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Cursor="Hand" Margin="2,3">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="ChipBorder"
                                                                    CornerRadius="4" Padding="8,4"
                                                                    Background="#F0F4FF" BorderThickness="1" BorderBrush="#D6E4F9">
                                                                <TextBlock x:Name="ChipText" Text="{Binding Name}"
                                                                           FontSize="12" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <!-- 未选中状态 -->
                                                                <Trigger Property="IsChecked" Value="False">
                                                                    <Setter TargetName="ChipBorder" Property="Background" Value="#F5F5F5"/>
                                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#E8E8E8"/>
                                                                    <Setter TargetName="ChipText" Property="Foreground" Value="#AAA"/>
                                                                    <Setter TargetName="ChipText" Property="TextDecorations" Value="Strikethrough"/>
                                                                </Trigger>
                                                                <!-- 悬浮状态（选中时） -->
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsChecked" Value="True"/>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="ChipBorder" Property="Background" Value="#DCE8FB"/>
                                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#B0CBF0"/>
                                                                </MultiTrigger>
                                                                <!-- 悬浮状态（未选中时） -->
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsChecked" Value="False"/>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="ChipBorder" Property="Background" Value="#EAEAEA"/>
                                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#D0D0D0"/>
                                                                    <Setter TargetName="ChipText" Property="Foreground" Value="#666"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- 排序调整区域 -->
                                <TextBlock Text="{Binding [spider_current_plot_order],Source={x:Static lg:LanguageService.Instance}, FallbackValue='当前绘图顺序'}"
                                           Margin="0,8,0,6"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#555"/>
                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                        CornerRadius="6" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 已选元素排序列表（水平滚动） -->
                                        <ListBox Grid.Column="0"
                                                 ItemsSource="{Binding SpiderDiagramViewModel.AllElements}"
                                                 SelectedItem="{Binding SpiderDiagramViewModel.SelectedElementItem, Mode=TwoWay}"
                                                 BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 Height="30">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" Background="Transparent"
                                                                        CornerRadius="3" Padding="5,3" Margin="1,0">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#E0EDFF"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <!-- 隐藏未选中的元素 -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#555"
                                                               VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- 上移/下移箭头 -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Button Command="{Binding SpiderDiagramViewModel.MoveElementUpCommand}"
                                                    CommandParameter="{Binding SpiderDiagramViewModel.SelectedElementItem}"
                                                    ToolTip="{Binding [move_up],Source={x:Static lg:LanguageService.Instance}, FallbackValue='上移'}"
                                                    Cursor="Hand" Margin="0,0,2,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Width="24" Height="24" CornerRadius="4"
                                                                Background="Transparent">
                                                            <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="11" Foreground="#666"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.3"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Command="{Binding SpiderDiagramViewModel.MoveElementDownCommand}"
                                                    CommandParameter="{Binding SpiderDiagramViewModel.SelectedElementItem}"
                                                    ToolTip="{Binding [move_down],Source={x:Static lg:LanguageService.Instance}, FallbackValue='下移'}"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Width="24" Height="24" CornerRadius="4"
                                                                Background="Transparent">
                                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="11" Foreground="#666"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.3"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部：进入绘图按钮 -->
                    <Button Grid.Row="1" Margin="0,16,0,0"
                            Height="40" MinWidth="180"
                            HorizontalAlignment="Center"
                            Command="{Binding EnterSpiderPlotModeCommand}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{DynamicResource ThemeAccentBrush}" CornerRadius="6" Padding="24,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding [enter_plot_mode],Source={x:Static lg:LanguageService.Instance}, FallbackValue='进入图解'}" 
                                                               FontSize="14" Foreground="White" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                
                <!-- Harker 多联图设置页 -->
                <Grid Grid.Row="1" Margin="20"
                      Visibility="{Binding IsHarkerDiagramMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.Resources>
                        <DataTemplate x:Key="HarkerChipTemplate">
                            <ToggleButton Style="{StaticResource HarkerChipToggleStyle}"
                                          Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEnabled}"/>
                        </DataTemplate>
                        <Style x:Key="HarkerSectionTitleStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#333"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="HarkerHintTextStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="#777"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：设置项 -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        <ScrollViewer Grid.Column="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <StackPanel Margin="0,0,8,16">

                                <!-- X 变量 -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding [harker_x_axis],Source={x:Static lg:LanguageService.Instance}, FallbackValue='X 轴变量'}" Style="{StaticResource HarkerSectionTitleStyle}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding HarkerDiagramViewModel.XOptions}"
                                              SelectedItem="{Binding HarkerDiagramViewModel.SelectedXVariable, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Height="32" FontSize="13"/>
                                </StackPanel>

                                <!-- Y 变量 -->
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{Binding [harker_y_axis],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Y 轴变量'}" Style="{StaticResource HarkerSectionTitleStyle}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ThemeLinkButtonStyle}" Command="{Binding HarkerDiagramViewModel.SelectAllVariablesCommand}"
                                                    Content="{Binding [select_all],Source={x:Static lg:LanguageService.Instance}, FallbackValue='全选'}"
                                                    Padding="6,2" Margin="0,0,2,0"/>
                                            <TextBlock Text="|" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            <Button Style="{StaticResource ThemeLinkButtonStyle}" Command="{Binding HarkerDiagramViewModel.DeselectAllVariablesCommand}"
                                                    Content="{Binding [deselect_all],Source={x:Static lg:LanguageService.Instance}, FallbackValue='取消全选'}"
                                                    Padding="6,2" Margin="0,0,2,0"/>
                                            <TextBlock Text="|" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            <Button Style="{StaticResource ThemeLinkButtonStyle}" Command="{Binding HarkerDiagramViewModel.ResetCommand}"
                                                    Content="{Binding [reset_default],Source={x:Static lg:LanguageService.Instance}, FallbackValue='重置'}"
                                                    Padding="6,2"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [harker_major],Source={x:Static lg:LanguageService.Instance}, FallbackValue='主量元素'}" FontSize="12" FontWeight="SemiBold" Foreground="#555" Margin="2,0,0,2"/>
                                                <ItemsControl ItemsSource="{Binding HarkerDiagramViewModel.MajorItems}"
                                                              ItemTemplate="{StaticResource HarkerChipTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>

                                            <Rectangle Grid.Column="1" Width="1" Fill="#E8E8E8" Margin="10,2"/>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding [harker_derived],Source={x:Static lg:LanguageService.Instance}, FallbackValue='派生指标'}" FontSize="12" FontWeight="SemiBold" Foreground="#555" Margin="2,0,0,2"/>
                                                <ItemsControl ItemsSource="{Binding HarkerDiagramViewModel.DerivedItems}"
                                                              ItemTemplate="{StaticResource HarkerChipTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>

                                            <Rectangle Grid.Column="3" Width="1" Fill="#E8E8E8" Margin="10,2"/>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{Binding [harker_trace],Source={x:Static lg:LanguageService.Instance}, FallbackValue='微量元素'}" FontSize="12" FontWeight="SemiBold" Foreground="#555" Margin="2,0,0,2"/>
                                                <ItemsControl ItemsSource="{Binding HarkerDiagramViewModel.TraceItems}"
                                                              ItemTemplate="{StaticResource HarkerChipTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- 布局 -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding [harker_panel_layout],Source={x:Static lg:LanguageService.Instance}, FallbackValue='面板布局'}" Style="{StaticResource HarkerSectionTitleStyle}" Margin="0,0,0,8"/>
                                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding HarkerDiagramViewModel.LayoutPresets}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Text}"
                                                                Command="{Binding DataContext.HarkerDiagramViewModel.ApplyLayoutPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource HarkerPresetButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="#E0EDFF"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding [harker_rows],Source={x:Static lg:LanguageService.Instance}, FallbackValue='行'}" FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource HarkerSquareButtonStyle}" Content="&#xE738;"
                                                        Command="{Binding HarkerDiagramViewModel.DecreaseRowsCommand}"/>
                                                <TextBlock Text="{Binding HarkerDiagramViewModel.Rows}" Width="28" TextAlignment="Center"
                                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HarkerSquareButtonStyle}" Content="&#xE710;"
                                                        Command="{Binding HarkerDiagramViewModel.IncreaseRowsCommand}"/>

                                                <TextBlock Text="{Binding [harker_columns],Source={x:Static lg:LanguageService.Instance}, FallbackValue='列'}" FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="24,0,6,0"/>
                                                <Button Style="{StaticResource HarkerSquareButtonStyle}" Content="&#xE738;"
                                                        Command="{Binding HarkerDiagramViewModel.DecreaseColumnsCommand}"/>
                                                <TextBlock Text="{Binding HarkerDiagramViewModel.Columns}" Width="28" TextAlignment="Center"
                                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HarkerSquareButtonStyle}" Content="&#xE710;"
                                                        Command="{Binding HarkerDiagramViewModel.IncreaseColumnsCommand}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding HarkerDiagramViewModel.LayoutMessage}" FontSize="12" Margin="0,8,0,0"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HarkerDiagramViewModel.LayoutMessageIsWarning}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 图例位置 -->
                                <StackPanel>
                                    <TextBlock Text="{Binding [harker_legend_position],Source={x:Static lg:LanguageService.Instance}, FallbackValue='图例位置'}" Style="{StaticResource HarkerSectionTitleStyle}" Margin="0,0,0,8"/>
                                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8,8">
                                        <StackPanel>
                                            <ListBox ItemsSource="{Binding HarkerDiagramViewModel.LegendOptions}"
                                                     SelectedIndex="{Binding HarkerDiagramViewModel.LegendModeIndex, Mode=TwoWay}"
                                                     BorderThickness="0" Background="Transparent"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Bd" Background="#F7F7F7" BorderBrush="#E4E4E4" BorderThickness="1"
                                                                            CornerRadius="4" Padding="10,5" Margin="2">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#EFEFEF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#E0EDFF"/>
                                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Opacity" Value="0.4"/>
                                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#333" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <!-- 没有提示文字时不占位：空 TextBlock 也会撑出一行高度 -->
                                            <TextBlock Text="{Binding HarkerDiagramViewModel.LegendNote}" Margin="2,6,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HarkerHintTextStyle}">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                    <!-- 底部：进入绘图按钮 -->
                    <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <Button Height="40" MinWidth="180"
                                HorizontalAlignment="Center"
                                Command="{Binding EnterHarkerPlotModeCommand}"
                                IsEnabled="{Binding HarkerDiagramViewModel.CanEnter}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="6" Padding="24,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding [enter_plot_mode],Source={x:Static lg:LanguageService.Instance}, FallbackValue='进入图解'}"
                                                                   FontSize="14" Foreground="White" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                        </Grid>

                        <!-- 右侧：布局预览 -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="8" Padding="14" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{Binding [harker_layout_preview],Source={x:Static lg:LanguageService.Instance}, FallbackValue='布局预览'}" Style="{StaticResource HarkerSectionTitleStyle}"/>
                                <TextBlock Text="{Binding [harker_swap_panels],Source={x:Static lg:LanguageService.Instance}, FallbackValue='点击两个面板可互换位置'}" Style="{StaticResource HarkerHintTextStyle}" Margin="0,2,0,10"/>

                                <!-- 图例（上方） -->
                                <Border Height="22" CornerRadius="4" Background="#FFF7E6" BorderBrush="#F5D9A8" BorderThickness="1"
                                        Margin="2,0,2,4"
                                        Visibility="{Binding HarkerDiagramViewModel.IsLegendAbove, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding [legend],Source={x:Static lg:LanguageService.Instance}, FallbackValue='图例'}" FontSize="11" Foreground="#A56A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 图例（左侧） -->
                                    <Border Grid.Column="0" Width="52" CornerRadius="4" Background="#FFF7E6" BorderBrush="#F5D9A8" BorderThickness="1"
                                            Margin="2,2,4,2"
                                            Visibility="{Binding HarkerDiagramViewModel.IsLegendLeft, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding [legend],Source={x:Static lg:LanguageService.Instance}, FallbackValue='图例'}" FontSize="11" Foreground="#A56A00" TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                                    </Border>

                                    <ItemsControl Grid.Column="1" Height="240"
                                                  ItemsSource="{Binding HarkerDiagramViewModel.PreviewCells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="{Binding HarkerDiagramViewModel.Rows}"
                                                             Columns="{Binding HarkerDiagramViewModel.Columns}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.HarkerDiagramViewModel.PickPreviewCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource HarkerPreviewCellButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                    <Setter Property="Background" Value="#FAFAFA"/>
                                                                    <Setter Property="BorderBrush" Value="#E2E2E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLegendCell}" Value="True">
                                                                    <Setter Property="Background" Value="#FFF7E6"/>
                                                                    <Setter Property="BorderBrush" Value="#F5D9A8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                                    <Setter Property="Background" Value="#DCE8FB"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#333" HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLegendCell}" Value="True">
                                                                                <Setter Property="Foreground" Value="#A56A00"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Number}" FontSize="10" Foreground="#999" HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <!-- 图例嵌入该面板 -->
                                                        <Border CornerRadius="3" Background="#FFF7E6" BorderBrush="#F5D9A8" BorderThickness="1"
                                                                Padding="3,0" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Visibility="{Binding IsLegendEmbedded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding [legend],Source={x:Static lg:LanguageService.Instance}, FallbackValue='图例'}" FontSize="9" Foreground="#A56A00"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 图例（右侧） -->
                                    <Border Grid.Column="2" Width="52" CornerRadius="4" Background="#FFF7E6" BorderBrush="#F5D9A8" BorderThickness="1"
                                            Margin="4,2,2,2"
                                            Visibility="{Binding HarkerDiagramViewModel.IsLegendRight, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding [legend],Source={x:Static lg:LanguageService.Instance}, FallbackValue='图例'}" FontSize="11" Foreground="#A56A00" TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                                    </Border>
                                </Grid>

                                <!-- 图例（下方） -->
                                <Border Height="22" CornerRadius="4" Background="#FFF7E6" BorderBrush="#F5D9A8" BorderThickness="1"
                                        Margin="2,4,2,0"
                                        Visibility="{Binding HarkerDiagramViewModel.IsLegendBelow, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding [legend],Source={x:Static lg:LanguageService.Instance}, FallbackValue='图例'}" FontSize="11" Foreground="#A56A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                <!-- 批量下载遮罩层 -->
                <Border Background="#80000000" 
                        Visibility="{Binding IsBatchDownloadOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Grid.RowSpan="2">
                    <Border Background="White" CornerRadius="12" 
                            Width="450" Height="280" 
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="40,30">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 标题 -->
                            <TextBlock Grid.Row="0" Text="{Binding BatchOverlayTitle, FallbackValue='批量下载中'}" 
                                       FontSize="20" FontWeight="SemiBold" 
                                       Foreground="#333" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,25"/>
                            
                            <!-- 加载动画 -->
                            <Grid Grid.Row="1" Width="60" Height="60" Margin="0,0,0,20" HorizontalAlignment="Center">
                                <Ellipse Width="60" Height="60" 
                                         Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="4" 
                                         Opacity="0.2"/>
                                <Ellipse Width="60" Height="60" 
                                         Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="4" 
                                         StrokeDashArray="8,4">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="LoadingRotation" CenterX="30" CenterY="30" Angle="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                                                   Storyboard.TargetProperty="Angle"
                                                                   From="0" To="360" Duration="0:0:1.5"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>
                            
                            <!-- 进度文本 -->
                            <TextBlock Grid.Row="2" Text="{Binding BatchDownloadProgressText}" 
                                       FontSize="14" Foreground="#666" 
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       MaxWidth="370"
                                       Margin="0,0,0,20"/>
                            
                            <!-- 取消按钮 -->
                            <Button Grid.Row="3" 
                                    Content="{Binding [Cancel], Source={x:Static lg:LanguageService.Instance}, FallbackValue='取消'}" 
                                    Command="{Binding CancelBatchDownloadCommand}"
                                    Width="120" Height="38"
                                    Background="#F0F0F0" 
                                    BorderBrush="#D0D0D0" 
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    HorizontalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E0E0E0"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#D0D0D0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Grid>

        <!-- Plot Mode (Modern Style Redesign) -->
        <Grid x:Name="PlotGrid" Grid.Row="1" Visibility="{Binding IsPlotMode, Converter={StaticResource BoolToVisibilityConverter}}" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <!-- 原工具栏行：工具栏已移到页面顶栏，这里留空 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Main Content -->
            <Grid Grid.Row="1" x:Name="MainLayoutGrid" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InnerLeftCol" Width="19*" MinWidth="200"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition x:Name="PlotColumn" Width="56*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition x:Name="OuterRightCol" Width="25*" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Layers / Data
                     收起后左侧留下 40px 通高窄轨。图层内容按原宽度左移，窄轨单独停在这一列。 -->
                <local:LayerSlideHost x:Name="LeftPanelHost" Grid.Column="0" ClipToBounds="False">
                        <Border x:Name="LeftPanelSlide" Background="#F5F5F7" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" ClipToBounds="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LeftPanelTranslate"/>
                            </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Layer Panel Header -->
                        <Grid Grid.Row="0" Margin="16,6,8,6">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RibbonTabIndex}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RibbonTabIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding [layer], Source={x:Static lg:LanguageService.Instance}, FallbackValue='图层'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#666666"
                                       VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2"
                                       Height="1"
                                       Fill="#E3E5E8"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="3"
                                    Command="{Binding ToggleLayerPanelCommand}"
                                    Cursor="Hand"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonIconStyle}">
                                        <Setter Property="ToolTip" Value="{Binding [collapse_layer_panel], Source={x:Static lg:LanguageService.Instance}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLayerPanelExpanded}" Value="False">
                                                <Setter Property="ToolTip" Value="{Binding [expand_layer_panel], Source={x:Static lg:LanguageService.Instance}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="16" Height="16">
                                        <Path Stroke="{DynamicResource ThemeAccentBrush}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M 10.2 3.2 L 5.4 8 L 10.2 12.8"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>

                        <!-- Data Toolbar -->
                        <Border Grid.Row="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RibbonTabIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <!-- 数据表格工具栏（单行紧凑）：单元格地址/内容 | 联动 | 插入行 | 删除行 | 更多 | 投图 -->
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Height="26"
                                        Background="White"
                                        BorderBrush="#D9D9D9"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,0"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding SelectedCellContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsSelectedCellEditable}"
                                                 ToolTip="{Binding SelectedCellAddress}"
                                                 FontSize="12"
                                                 VerticalContentAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 MinHeight="0"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SelectedCellAddress}"
                                                   FontSize="11"
                                                   Foreground="#888888"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                </Grid>

                                <!-- 联动开关 -->
                                <ToggleButton Grid.Column="1"
                                              Width="26" Height="26" Margin="6,0,0,0"
                                              IsChecked="{Binding IsDataSelectionLinkEnabled, Mode=TwoWay}"
                                              Style="{StaticResource ToolbarIconButtonStyle}"
                                              Foreground="Black"
                                              ToolTip="{Binding [enable_data_to_drawing_object_linkage], Source={x:Static lg:LanguageService.Instance}, FallbackValue='启用数据到绘图对象联动'}">
                                    <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe62c;" FontSize="14" Foreground="Black"/>
                                </ToggleButton>

                                <!-- 插入行 / 删除行 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <ToggleButton x:Name="InsertRowMenuButton"
                                                  Style="{StaticResource DataToolbarMenuToggleButtonStyle}"
                                                  IsChecked="{Binding IsInsertRowMenuOpen, Mode=TwoWay}"
                                                  ToolTip="{Binding [data_toolbar_insert_row_tooltip], Source={x:Static lg:LanguageService.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe615;" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding [data_toolbar_insert_row], Source={x:Static lg:LanguageService.Instance}}" Margin="4,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsInsertRowMenuOpen, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=InsertRowMenuButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Style="{StaticResource DataToolbarPopupPanelStyle}" Width="320">
                                            <StackPanel>
                                                <!-- 在上方插入 -->
                                                <Grid Margin="4,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe615;" FontSize="13" Foreground="#6B7392" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding [data_toolbar_insert_above], Source={x:Static lg:LanguageService.Instance}}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <uc:NumericUpDown Grid.Column="1" Width="76" Margin="8,0"
                                                                      Minimum="1" Maximum="500" Increment="1" DecimalPlaces="0"
                                                                      Value="{Binding InsertRowsAboveCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding [data_toolbar_row_unit], Source={x:Static lg:LanguageService.Instance}}" Margin="0,0,8,0" Foreground="#6B7392" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Height="26" Padding="10,0"
                                                            Style="{StaticResource DataToolbarPrimaryButtonStyle}"
                                                            Command="{Binding AddRowUpCommand}"
                                                            Content="{Binding [data_toolbar_insert_confirm], Source={x:Static lg:LanguageService.Instance}}"/>
                                                </Grid>

                                                <!-- 在下方插入 -->
                                                <Grid Margin="4,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe613;" FontSize="13" Foreground="#6B7392" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding [data_toolbar_insert_below], Source={x:Static lg:LanguageService.Instance}}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <uc:NumericUpDown Grid.Column="1" Width="76" Margin="8,0"
                                                                      Minimum="1" Maximum="500" Increment="1" DecimalPlaces="0"
                                                                      Value="{Binding InsertRowsBelowCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding [data_toolbar_row_unit], Source={x:Static lg:LanguageService.Instance}}" Margin="0,0,8,0" Foreground="#6B7392" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="3" Height="26" Padding="10,0"
                                                            Style="{StaticResource DataToolbarPrimaryButtonStyle}"
                                                            Command="{Binding AddRowDownCommand}"
                                                            Content="{Binding [data_toolbar_insert_confirm], Source={x:Static lg:LanguageService.Instance}}"/>
                                                </Grid>

                                                <!-- 基准行提示 -->
                                                <Border BorderBrush="#F0F2F8" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="8,5,8,2">
                                                    <TextBlock Text="{Binding InsertRowHintText}" FontSize="11" Foreground="#9AA1BB"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <Button Margin="4,0,0,0"
                                            Style="{StaticResource DataToolbarDangerButtonStyle}"
                                            Command="{Binding DeleteRowCommand}"
                                            ToolTip="{Binding [data_toolbar_delete_row_tooltip], Source={x:Static lg:LanguageService.Instance}, FallbackValue='删除当前选中行'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe89f;" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DeleteRowButtonText}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- 更多（三个点） / 投图 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <ToggleButton x:Name="DataMoreMenuButton"
                                                  Style="{StaticResource DataToolbarMoreToggleButtonStyle}"
                                                  IsChecked="{Binding IsDataMoreMenuOpen, Mode=TwoWay}"
                                                  ToolTip="{Binding [data_toolbar_more_tooltip], Source={x:Static lg:LanguageService.Instance}}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="14"/>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsDataMoreMenuOpen, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=DataMoreMenuButton}"
                                           Placement="Bottom"
                                           HorizontalOffset="-148"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Style="{StaticResource DataToolbarPopupPanelStyle}" MinWidth="170">
                                            <StackPanel>
                                                <Button Style="{StaticResource DataToolbarMenuItemButtonStyle}"
                                                        Command="{Binding ExportWorksheetCommand}"
                                                        CommandParameter="{Binding ElementName=DataGrid}"
                                                        ToolTip="{Binding [data_toolbar_export_data_tooltip], Source={x:Static lg:LanguageService.Instance}, FallbackValue='导出当前数据表格内容'}">
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="Click">
                                                            <i:ChangePropertyAction TargetObject="{Binding}" PropertyName="IsDataMoreMenuOpen" Value="False"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe656;" FontSize="13" Foreground="#6B7392" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding [data_toolbar_export_data], Source={x:Static lg:LanguageService.Instance}}" Margin="10,0,16,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="CSV" FontFamily="Consolas" FontSize="10" Foreground="#9AA1BB" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                                <Rectangle Height="1" Fill="#F0F2F8" Margin="0,4"/>
                                                <Button Style="{StaticResource DataToolbarMenuItemButtonStyle}"
                                                        Foreground="#C2364B"
                                                        Command="{Binding ClearAllDataCommand}"
                                                        ToolTip="{Binding [data_toolbar_clear_all_data_tooltip], Source={x:Static lg:LanguageService.Instance}, FallbackValue='清空数据表格中的所有数据'}">
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="Click">
                                                            <i:ChangePropertyAction TargetObject="{Binding}" PropertyName="IsDataMoreMenuOpen" Value="False"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe734;" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding [data_toolbar_clear_data], Source={x:Static lg:LanguageService.Instance}}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <Button Margin="4,0,0,0"
                                            Style="{StaticResource DataToolbarPrimaryButtonStyle}"
                                            Command="{Binding UpdateDataCommand}"
                                            ToolTip="{Binding [data_toolbar_update_chart_tooltip], Source={x:Static lg:LanguageService.Instance}, FallbackValue='将当前数据投绘到图表 (Ctrl+Shift+Enter)'}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource IcoPath}" Data="M4 3.5V20h16.5"/>
                                                    <Path Style="{StaticResource IcoPath}" Data="M6.8 15.5a1.7 1.7 0 1 0 3.4 0a1.7 1.7 0 1 0 -3.4 0z"/>
                                                    <Path Style="{StaticResource IcoPath}" Data="M10.3 11.5a1.7 1.7 0 1 0 3.4 0a1.7 1.7 0 1 0 -3.4 0z"/>
                                                    <Path Style="{StaticResource IcoPath}" Data="M13.8 13.5a1.7 1.7 0 1 0 3.4 0a1.7 1.7 0 1 0 -3.4 0z"/>
                                                    <Path Style="{StaticResource IcoPath}" Data="M16.3 7.5a1.7 1.7 0 1 0 3.4 0a1.7 1.7 0 1 0 -3.4 0z"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding [data_toolbar_plot], Source={x:Static lg:LanguageService.Instance}}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Layer Tree -->
                        <TreeView Grid.Row="1"
                                  ItemsSource="{Binding LayerTree}"
                                  ItemTemplate="{StaticResource LayerTreeItemTemplate}"
                                  x:Name="LayerTreeView"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.CanContentScroll="False"
                                  BorderThickness="0">
                            <TreeView.Style>
                                <Style TargetType="TreeView">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RibbonTabIndex}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RibbonTabIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.Style>
                            <TreeView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource LayerTreeViewItemStyle}" TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}"/>
                                    <EventSetter Event="UIElement.PreviewMouseLeftButtonDown" Handler="OnTreeViewItemPreviewMouseLeftButtonDown"/>
                                    <EventSetter Event="RequestBringIntoView" Handler="TreeViewItem_RequestBringIntoView"/>
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>

                        <!-- Data Grid -->
                        <uc:ReoGridTableHost Grid.Row="1" AutoStyleCells="True" ShowWorksheetBar="False">
                            <uc:ReoGridTableHost.Style>
                                <Style TargetType="uc:ReoGridTableHost" BasedOn="{StaticResource ReoGridTableHostStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RibbonTabIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </uc:ReoGridTableHost.Style>
                            <rg:ReoGridControl x:Name="DataGrid" SheetTabVisible="False" SizeChanged="DataGrid_SizeChanged"/>
                        </uc:ReoGridTableHost>

                        <!-- 数据表格底部状态栏：行头状态点图例 + 计算详情展开/收起（仅数据状态显示） -->
                        <Border Grid.Row="2" Background="#FAFBFE" BorderBrush="#E8EAF2" BorderThickness="0,1,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RibbonTabIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 状态栏：状态点图例 | 计算结果摘要 | 展开/收起按钮 -->
                                <Grid Grid.Row="0" Margin="10,0,6,0" MinHeight="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 状态点图例 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource DataRowStatusOkDotStyle}"/>
                                        <TextBlock Style="{StaticResource DataRowStatusLegendTextStyle}"
                                                   Text="{Binding [data_row_status_ok], Source={x:Static lg:LanguageService.Instance}, FallbackValue='已投图'}"/>
                                        <Ellipse Style="{StaticResource DataRowStatusErrorDotStyle}"/>
                                        <TextBlock Style="{StaticResource DataRowStatusLegendTextStyle}"
                                                   Text="{Binding [data_row_status_error], Source={x:Static lg:LanguageService.Instance}, FallbackValue='无法投图'}"/>
                                        <Ellipse Style="{StaticResource DataRowStatusStaleDotStyle}"/>
                                        <TextBlock Style="{StaticResource DataRowStatusLegendTextStyle}"
                                                   Text="{Binding [data_row_status_stale], Source={x:Static lg:LanguageService.Instance}, FallbackValue='投图后已修改'}"/>
                                        <Ellipse Style="{StaticResource DataRowStatusIdleDotStyle}"/>
                                        <TextBlock Style="{StaticResource DataRowStatusLegendTextStyle}"
                                                   Text="{Binding [data_row_status_pending], Source={x:Static lg:LanguageService.Instance}, FallbackValue='未投图'}"/>
                                    </StackPanel>

                                    <!-- 展开/收起计算详情按钮（仅计算验证可见时显示） -->
                                    <Button Grid.Column="2" Command="{Binding ToggleCalculationDetailCommand}"
                                            Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsCalculationVerificationVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="{Binding [toggle_details_expand_collapse],Source={x:Static lg:LanguageService.Instance}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont"
                                                               Foreground="#666" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xe624;"/><!-- 展开图标 -->
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCalculationDetailExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="&#xe8fc;"/><!-- 收起图标 -->
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F0F0F0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- 展开状态：显示详细计算过程 -->
                                <Border Grid.Row="1" Padding="10,0,10,10" Background="#FAFAFA">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCalculationVerificationVisible}" Value="True"/>
                                                        <Condition Binding="{Binding IsCalculationDetailExpanded}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ScrollViewer MaxHeight="{Binding DataGridMaxVerificationHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- 计算结果摘要：作为计算详情的第一行 -->
                                            <TextBlock Text="{Binding CalculationResultSummary}" FontSize="12" Foreground="#333"
                                                       Margin="0,2,0,4" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding CalculationLogs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#555"
                                                                   FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                        </Border>
                        <Button x:Name="LayerRail"
                                Style="{x:Null}"
                                Width="40"
                                Height="{Binding ActualHeight, ElementName=LeftPanelHost}"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Panel.ZIndex="2"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Focusable="False"
                                Cursor="Hand"
                                Command="{Binding ToggleLayerPanelCommand}"
                                ToolTip="{Binding [expand_layer_panel], Source={x:Static lg:LanguageService.Instance}}">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="LayerRailTranslate"/>
                            </Button.RenderTransform>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="RailBorder"
                                            Background="#F5F5F7"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="0,0,1,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            ToolTip="{TemplateBinding ToolTip}">
                                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <Viewbox Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                                                <Viewbox.RenderTransform>
                                                    <RotateTransform Angle="180"/>
                                                </Viewbox.RenderTransform>
                                                <Canvas Width="16" Height="16">
                                                    <Path Stroke="{DynamicResource ThemeAccentBrush}"
                                                          StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M 10.2 3.2 L 5.4 8 L 10.2 12.8"/>
                                                </Canvas>
                                            </Viewbox>
                                            <ItemsControl Margin="0,10,0,0"
                                                          HorizontalAlignment="Center"
                                                          ItemsSource="{Binding [layer], Source={x:Static lg:LanguageService.Instance}, Converter={StaticResource StringToCharListConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#666666"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RailBorder" Property="Background" Value="#E8E8ED"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                </local:LayerSlideHost>

                <!-- Center Panel: Plot
                     左右各向分隔条列外扩 4px（负边距），使状态栏 / 帮助面板顶栏直接贴齐左右面板；
                     相应地，内部控件边距各加 4px 以保持原有视觉位置。 -->
                <Grid Grid.Column="2" Margin="-4,0,-4,0" Background="#FFFFFF" x:Name="PlotContainer" ClipToBounds="True"
                      UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PlotContainerTranslate"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScottPlot:WpfPlot Grid.Row="0" Name="WpfPlot1" Margin="14,10"/>

                    <Button Grid.Row="0" Style="{StaticResource ToolbarButtonIconStyle}" Click="OnPopOutPlotClick" 
                            ToolTip="{Binding [popup_diagram_window],Source={x:Static lg:LanguageService.Instance}}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,10,10,10" Panel.ZIndex="1">
                        <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe642;" FontSize="14"/>
                    </Button>

                    <Button Grid.Row="0" Command="{Binding ShowTemplateInfoCommand}" 
                            ToolTip="{Binding [use_help], Source={x:Static lg:LanguageService.Instance}}" 
                            Style="{StaticResource ToolbarButtonIconStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,10,14,10" Panel.ZIndex="1">
                        <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe621;" FontSize="16"/>
                    </Button>

                    <!-- Quest Reminder Overlay -->
                    <Grid Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,45,6,0"
                          Visibility="{Binding IsDataStateReminderVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                          Panel.ZIndex="99">
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#40000000" Opacity="0.2"/>
                        </Grid.Effect>

                        <!-- Arrow pointing up -->
                        <Path Data="M 3,10 L 8,0 L 16,10 Z" Fill="#FFF4CE" Stroke="#F5C346" StrokeThickness="1.5"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,14,0"/>

                        <!-- Box -->
                        <Border Background="#FFF4CE" BorderBrush="#F5C346" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,9,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Icon -->
                                <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe698;" FontSize="20" Foreground="#D48806" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [diagram_guide], Source={x:Static lg:LanguageService.Instance}, TargetNullValue='图解向导'}" FontWeight="Bold" Foreground="#333" FontSize="13"/>
                                    <TextBlock Text="{Binding [click_help_for_guide], Source={x:Static lg:LanguageService.Instance}, TargetNullValue='点击按钮查看帮助文档'}" Foreground="#555" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Mask to hide the border line between arrow and box -->
                        <Rectangle Fill="#FFF4CE" Height="3" Width="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,16,0"/>
                    </Grid>

                    <!-- Help Content Overlay  -->
                    <Border Grid.Row="0" Background="White" Margin="0"
                             Visibility="{Binding IsShowTemplateInfo, Converter={StaticResource BoolToVisibilityConverter}}" 
                             Panel.ZIndex="100">
                        <!-- 通用富文本编辑器（与帮助文档编辑器共用 RichTextEditor）：格式工具栏与“退出帮助文档”按钮在同一行；
                             文档内容由 ViewModel 直接读写其内部 RichTextBox -->
                        <uc:RichTextEditor x:Name="HelpDocEditor"
                                           IsReadOnly="{Binding IsHelpDocReadOnly}"
                                           IsToolbarVisible="{Binding HasConfirmedEditMode}"
                                           ToolbarPadding="10,4"
                                           IsHistoryVisible="False">
                            <uc:RichTextEditor.Style>
                                <Style TargetType="uc:RichTextEditor">
                                    <Setter Property="IsToolbarEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHelpDocReadOnly}" Value="True">
                                            <Setter Property="IsToolbarEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </uc:RichTextEditor.Style>
                            <uc:RichTextEditor.ToolbarTrailingContent>
                                <!-- 退出帮助文档 -->
                                <Button Command="{Binding ShowTemplateInfoCommand}" ToolTip="Close"
                                        Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <TextBlock Text="&#xe61f;" FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Foreground="#666" FontSize="14"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E5E5E5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </uc:RichTextEditor.ToolbarTrailingContent>
                        </uc:RichTextEditor>
                    </Border>
                    <!-- Info Bar：提示相对整条状态栏居中；左右等宽，右侧留出坐标位置 -->
                    <Border Grid.Row="1" Height="28" Background="#F5F6F8" Padding="14,0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                        <Grid IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PlotInfoBarSide"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PlotInfoBarSide"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：当前图解语言 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Visibility="{Binding IsDiagramLanguageStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock FontFamily="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont" Text="&#xe6b4;"
                                           FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding DiagramLanguageStatus}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 中：添加对象模式。相对整条状态栏居中，不进入右侧坐标区 -->
                            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#475569" ClipToBounds="True"
                                       TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding AddObjectModeStatus}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AddObjectModeStatus}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AddObjectModeStatus}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <InlineUIContainer BaselineAlignment="Center">
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}" IsHitTestVisible="False"/>
                                </InlineUIContainer>
                                <Run Text="{Binding AddObjectModeStatus, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- 右：鼠标坐标（无坐标时整块隐藏，位置仍按文字宽度留出） -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoordinateStatus}" Value="">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CoordinateStatus}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding CoordinateStatus}" Foreground="#475569" FontSize="12"
                                           FontFamily="Consolas, Microsoft YaHei UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 分隔条放在绘图区之后，使其位于绘图区上方，仍可拖动 -->
                <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent">
                    <GridSplitter.RenderTransform>
                        <TranslateTransform x:Name="LeftSplitterTranslate"/>
                    </GridSplitter.RenderTransform>
                </GridSplitter>

                <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent">
                    <GridSplitter.RenderTransform>
                        <TranslateTransform x:Name="RightSplitterTranslate"/>
                    </GridSplitter.RenderTransform>
                </GridSplitter>

                <!-- Right Panel: Inspector -->
                <Border x:Name="RightPanelBorder" Grid.Column="4" Background="#F5F5F7" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="RightPanelTranslate"/>
                    </Border.RenderTransform>
                    <Grid>
                        <!-- Property Grid：各属性面板自带标题头，不再需要顶部“属性”横条 -->
                        <Grid Margin="0">
                            <Grid.Resources>
                                <ControlTemplate x:Key="EmptyStateTemplate">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Viewbox Width="40" Height="48" HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <Canvas Width="22" Height="26">
                                                <Path Fill="#C5CCD8"
                                                      Data="M 2.5 1.5 L 2.5 19 L 8.2 14.2 L 11.4 21.8 L 14.2 20.6 L 11 13 L 18.5 12.6 Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{Binding [select_an_object],Source={x:Static lg:LanguageService.Instance}}"
                                                   FontSize="14" Foreground="#8793A3" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </Grid.Resources>

                            <ContentControl Content="{Binding PropertyGridModel}">
                                <ContentControl.Resources>
                                    <cvs:StringColorConverter x:Key="StringColorConverter"/>
                                    <DataTemplate DataType="{x:Type models:EmptyPropertyModel}">
                                        <Control Template="{StaticResource EmptyStateTemplate}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type layerModels:ExportPanelViewModel}">
                                        <uc:ExportPropertyControl/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:TextDefinition}">
                                        <uc:TextPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:LineDefinition}">
                                        <uc:LinePropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:ArrowDefinition}">
                                        <uc:ArrowPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:PolygonDefinition}">
                                        <uc:PolygonPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:CartesianAxisDefinition}">
                                        <uc:AxisPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <!-- 蛛网图坐标轴：复用笛卡尔轴属性面板（标题/子标题，刻度页只留刻度标签） -->
                                    <DataTemplate DataType="{x:Type models:SpiderAxisDefinition}">
                                        <uc:AxisPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <!-- 顶端 / 右侧图框边：仅显示轴线属性 -->
                                    <DataTemplate DataType="{x:Type models:FrameAxisDefinition}">
                                        <uc:FrameAxisPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:TernaryAxisDefinition}">
                                        <uc:TernaryAxisPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:GridDefinition}">
                                        <uc:GridPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:LegendDefinition}">
                                        <uc:LegendPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:TitleDefinition}">
                                        <uc:TitlePropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:FunctionDefinition}">
                                        <uc:FunctionPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type models:ScatterDefinition}">
                                        <uc:ScatterPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <!-- 蛛网图样品线属性 -->
                                    <DataTemplate DataType="{x:Type spiderModels:SpiderSamplePropertyModel}">
                                        <uc:SpiderSamplePropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                    <!-- 蛛网图坐标轴属性 -->
                                    <DataTemplate DataType="{x:Type spiderModels:SpiderAxisPropertyModel}">
                                        <uc:SpiderAxisPropertyControl SelectedObject="{Binding}"/>
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>
                        </Grid>

                        <uc:ScriptDefinitionControl
                                         ScriptDefinition="{Binding CurrentScript}"
                                         Visibility="{Binding ScriptsPropertyGrid, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 页面骨架加载遮罩 -->
        <Border Grid.RowSpan="2" Panel.ZIndex="2000"
                Background="#F7F8FA"
                Visibility="{Binding IsLoadingOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="24">
                <Grid
                      Visibility="{Binding IsEnteringPlotTransition, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SkeletonBlockStyle}" Height="28" Width="220" Margin="0"/>
                            <Border Grid.Column="2" Style="{StaticResource SkeletonBlockStyle}" Height="28" Width="200" HorizontalAlignment="Right" Margin="0"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="19*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="56*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="25*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" Padding="18">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="18" Width="120"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="36" Margin="0,4,0,12"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="36"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="36"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="36"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="36"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="220" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="14" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F3F6FA" CornerRadius="12"/>
                                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="240"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="180"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="14" Padding="18">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="20" Width="140"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="28" Margin="0,12,0,12"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="120"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="120"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="120"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid
                      Visibility="{Binding IsReturningTemplateLibraryTransition, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" Padding="18">
                        <StackPanel>
                            <Border Style="{StaticResource SkeletonBlockStyle}" Height="24" Width="180"/>
                            <Border Style="{StaticResource SkeletonBlockStyle}" Height="34" Margin="0,20,0,8"/>
                            <Border Style="{StaticResource SkeletonBlockStyle}" Height="220"/>
                            <Border Style="{StaticResource SkeletonBlockStyle}" Height="34" Margin="0,16,0,8"/>
                            <Border Style="{StaticResource SkeletonBlockStyle}" Height="160"/>
                            <Border Style="{StaticResource SkeletonBlockStyle}" Height="34" Margin="0,16,0,8"/>
                            <Border Style="{StaticResource SkeletonBlockStyle}" Height="120"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SkeletonBlockStyle}" Height="20" Width="180" Margin="0"/>
                                <Border Grid.Column="2" Style="{StaticResource SkeletonBlockStyle}" Height="32" Width="160" HorizontalAlignment="Right" Margin="0"/>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="1" Rows="2" Columns="3" Margin="0,16,0,0">
                            <Border Background="#FFFFFF" CornerRadius="14" Padding="16" Margin="0,0,16,16">
                                <StackPanel>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="130" Margin="0"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="18" Width="80" Margin="0,16,0,12"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="180"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="140"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" CornerRadius="14" Padding="16" Margin="0,0,16,16">
                                <StackPanel>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="130" Margin="0"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="18" Width="96" Margin="0,16,0,12"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="170"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="120"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="130" Margin="0"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="18" Width="72" Margin="0,16,0,12"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="160"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="110"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" CornerRadius="14" Padding="16" Margin="0,0,16,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="130" Margin="0"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="18" Width="88" Margin="0,16,0,12"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="175"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="128"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" CornerRadius="14" Padding="16" Margin="0,0,16,0">
                                <StackPanel>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="130" Margin="0"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="18" Width="78" Margin="0,16,0,12"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="168"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="138"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFFFF" CornerRadius="14" Padding="16" Margin="0">
                                <StackPanel>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="130" Margin="0"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="18" Width="104" Margin="0,16,0,12"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="172"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="126"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Grid>

                <Grid
                      Visibility="{Binding IsDataPlotLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SkeletonBlockStyle}" Height="28" Width="180" Margin="0"/>
                            <Border Grid.Column="2" Style="{StaticResource SkeletonBlockStyle}" Height="28" Width="140" HorizontalAlignment="Right" Margin="0"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="19*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="56*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="25*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" Padding="18">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="18" Width="110"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="36" Margin="0,8,0,12"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="36"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="36"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="36"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="180" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="14" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F3F6FA" CornerRadius="12"/>
                                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="260"/>
                                    <Border Style="{StaticResource SkeletonBlockStyle}" Height="16" Width="200"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="14" Padding="18">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="20" Width="120"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="28" Margin="0,12,0,12"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="90"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="90"/>
                                <Border Style="{StaticResource SkeletonBlockStyle}" Height="90"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border Panel.ZIndex="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#D9FFFFFF"
                        CornerRadius="18"
                        Padding="30,22">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" Background="#EAF2FF" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7C3;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Margin="0,16,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"
                                   HorizontalAlignment="Center"
                                   Text="{Binding [entering_plot_interface_status], Source={x:Static lg:LanguageService.Instance}, FallbackValue='正在进入绘图界面'}"
                                   Visibility="{Binding IsEnteringPlotTransition, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Margin="0,16,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"
                                   HorizontalAlignment="Center"
                                   Text="{Binding [returning_template_library_status], Source={x:Static lg:LanguageService.Instance}, FallbackValue='正在返回模板库'}"
                                   Visibility="{Binding IsReturningTemplateLibraryTransition, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Margin="0,16,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#243447"
                                   HorizontalAlignment="Center"
                                   Text="{Binding [projecting_data], Source={x:Static lg:LanguageService.Instance}, FallbackValue='正在投绘数据'}"
                                   Visibility="{Binding IsDataPlotLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="#6C7A89"
                                   Text="{Binding [preparing_interface_content_status], Source={x:Static lg:LanguageService.Instance}, FallbackValue='已切换页面，正在准备界面内容...'}"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding IsTransitionLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="#6C7A89"
                                   Text="{Binding [parsing_table_and_refreshing_layer_please_wait], Source={x:Static lg:LanguageService.Instance}, FallbackValue='正在解析表格并刷新图层，请稍候...'}"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding IsDataPlotLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
