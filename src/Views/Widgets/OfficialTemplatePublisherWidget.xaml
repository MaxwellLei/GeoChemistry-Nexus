<UserControl x:Class="GeoChemistryNexus.Views.Widgets.OfficialTemplatePublisherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:controls="clr-namespace:GeoChemistryNexus.Controls"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="PublisherNavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1C1C1E"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F1FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="#E5E5EA" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,12,0,12">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding [official_template_publisher], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                           FontSize="16" FontWeight="Bold" Margin="16,4,12,12" TextWrapping="Wrap"/>
                <StackPanel>
                    <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection"
                                 Content="{Binding [official_publisher_section_targets], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsTargetsSection, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection"
                                 Content="{Binding [official_publisher_diagram_section], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsDiagramsSection, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection"
                                 Content="{Binding [official_publisher_geothermometer_section], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsGeothermometersSection, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection"
                                 Content="{Binding [official_publisher_home_links_section], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsHomeLinksSection, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection"
                                 Content="{Binding [official_publisher_section_announcement], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsAnnouncementSection, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection"
                                 Content="{Binding [official_publisher_plot_categories_section], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsPlotCategoriesSection, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection"
                                 Content="{Binding [official_publisher_geot_categories_section], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsGeoTCategoriesSection, Mode=TwoWay}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <hc:ScrollViewer Grid.Row="0" Grid.Column="1"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20">
                <Grid Visibility="{Binding IsTargetsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="3" TextWrapping="Wrap" Foreground="#636366" Margin="0,0,0,12"
                               Text="{Binding [official_publisher_targets_hint], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>

                    <DockPanel Grid.Row="1" Grid.Column="0" LastChildFill="True">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="{Binding [official_publisher_add_target], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                    Command="{Binding AddPublishTargetCommand}" Margin="0,0,6,0"/>
                            <Button Content="{Binding [Delete], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                    Command="{Binding RemovePublishTargetCommand}" Margin="0,0,6,0"/>
                            <Button Content="{Binding [official_publisher_move_up], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                    Command="{Binding MovePublishTargetUpCommand}" Margin="0,0,6,0" MinWidth="36"/>
                            <Button Content="{Binding [official_publisher_move_down], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                    Command="{Binding MovePublishTargetDownCommand}" MinWidth="36" Margin="0,4,0,0"/>
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding PublishTargets}"
                                 SelectedItem="{Binding SelectedPublishTarget}"
                                 DisplayMemberPath="ListLabel"
                                 BorderBrush="#EEEEEE" BorderThickness="1" MinHeight="280"/>
                    </DockPanel>

                    <Border Grid.Row="1" Grid.Column="2" Padding="12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding HasSelectedPublishTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{Binding [official_publisher_target_name], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Text="{Binding SelectedPublishTarget.Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding [official_publisher_enabled], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" VerticalAlignment="Center" IsChecked="{Binding SelectedPublishTarget.Enabled}"/>

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding [official_publisher_public_base_url], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,4" Text="{Binding SelectedPublishTarget.PublicBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="8,0,0,8" FontSize="12" Foreground="#636366" TextWrapping="Wrap"
                                       Text="{Binding [official_publisher_public_base_url_hint], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>

                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="SecretId"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="8,0,0,8" Text="{Binding SelectedPublishTarget.SecretId, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="SecretKey"/>
                            <PasswordBox x:Name="SecretKeyBox" Grid.Row="5" Grid.Column="1" Margin="8,0,0,8" PasswordChanged="SecretKeyBox_OnPasswordChanged"/>

                            <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Region"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Margin="8,0,0,8" Text="{Binding SelectedPublishTarget.Region, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Bucket"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Margin="8,0,0,8" Text="{Binding SelectedPublishTarget.Bucket, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="{Binding [official_publisher_staging_dir], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <DockPanel Grid.Row="8" Grid.Column="1" Margin="8,0,0,12">
                                <Button DockPanel.Dock="Right" Content="..." Command="{Binding BrowseStagingDirectoryCommand}" MinWidth="36" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding StagingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="{Binding [cos_save_settings], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                        Command="{Binding SaveCosSettingsCommand}" Margin="0,0,8,0" MinWidth="120"/>
                                <Button Content="{Binding [cos_test_connection], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                        Command="{Binding TestCosConnectionCommand}" IsEnabled="{Binding IsNotBusy}" MinWidth="120"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Visibility="{Binding IsDiagramsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox Content="{Binding [official_publisher_include_this], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                              IsChecked="{Binding PublishDiagrams}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Margin="0,0,16,0">
                            <Run Text="{Binding [official_publisher_new], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/><Run Text="{Binding DiagramNewCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,16,0">
                            <Run Text="{Binding [official_publisher_updated], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/><Run Text="{Binding DiagramUpdatedCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,16,0">
                            <Run Text="{Binding [official_publisher_removed], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/><Run Text="{Binding DiagramRemovedCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="{Binding [official_publisher_unchanged], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/><Run Text="{Binding DiagramUnchangedCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding DiagramPreviewLines}" BorderBrush="#EEEEEE" BorderThickness="1" MinHeight="320"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsGeothermometersSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox Content="{Binding [official_publisher_include_this], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                              IsChecked="{Binding PublishGeothermometers}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Margin="0,0,16,0">
                            <Run Text="{Binding [official_publisher_new], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/><Run Text="{Binding GeoNewCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,16,0">
                            <Run Text="{Binding [official_publisher_updated], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/><Run Text="{Binding GeoUpdatedCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,16,0">
                            <Run Text="{Binding [official_publisher_removed], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/><Run Text="{Binding GeoRemovedCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="{Binding [official_publisher_unchanged], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/><Run Text="{Binding GeoUnchangedCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding GeothermometerPreviewLines}" BorderBrush="#EEEEEE" BorderThickness="1" MinHeight="320"/>
                </StackPanel>

                <Grid Visibility="{Binding IsHomeLinksSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="{Binding [official_publisher_include_this], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                  IsChecked="{Binding PublishHomeLinks}"/>
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF9500"
                                   Visibility="{Binding HomeLinksHasRemoteChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="{Binding [official_publisher_home_links_pending], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding [home_links_edit_language], Source={x:Static lg:LanguageService.Instance}, FallbackValue=Editing language:}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding HomeLinksLanguageOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedHomeLinksLanguage}"
                                  Width="180" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Button Content="{Binding [official_publisher_home_add_group], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding AddHomeLinkGroupCommand}" Margin="0,0,8,0" MinWidth="88"/>
                        <Button Content="{Binding [official_publisher_home_edit_group], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding EditHomeLinkGroupCommand}" Margin="0,0,8,0" MinWidth="88"/>
                        <Button Content="{Binding [Delete], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding RemoveHomeLinkGroupCommand}" Margin="0,0,8,0" MinWidth="72"/>
                        <Button Content="{Binding [add_link], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding AddHomeLinkCommand}" Margin="0,0,8,0" MinWidth="88"/>
                        <Button Content="{Binding [Edit], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding EditHomeLinkCommand}" Margin="0,0,8,0" MinWidth="72"/>
                        <Button Content="{Binding [Delete], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding RemoveHomeLinkCommand}" Margin="0,0,8,0" MinWidth="72"/>
                        <Button Content="{Binding [official_publisher_home_save_draft], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding SaveHomeLinksDraftCommand}" Margin="0,0,8,0" MinWidth="100"/>
                        <Button Content="{Binding [refresh], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding ReloadHomeLinksEditorCommand}" MinWidth="72"/>
                    </StackPanel>
                    <Grid Grid.Row="2" MinHeight="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding HomeLinkGroups}"
                                 SelectedItem="{Binding SelectedHomeLinkGroup}"
                                 DisplayMemberPath="DisplayTitle"
                                 BorderBrush="#EEEEEE" BorderThickness="1"/>
                        <ListBox Grid.Column="2"
                                 ItemsSource="{Binding SelectedHomeLinkGroup.Links}"
                                 SelectedItem="{Binding SelectedHomeLink}"
                                 BorderBrush="#EEEEEE" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DisplayDescription}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Url}" FontSize="11" Foreground="#666666" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Icon}" FontSize="10" Foreground="#999999" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsAnnouncementSection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      PreviewMouseWheel="AnnouncementSection_PreviewMouseWheel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <CheckBox Content="{Binding [official_publisher_include_this], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                  IsChecked="{Binding PublishAnnouncement}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#636366" TextWrapping="Wrap"
                                   Text="{Binding [official_publisher_announcement_publish_hint], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Padding="12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding [official_publisher_announcement_load], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                        Command="{Binding LoadAnnouncementFromServerCommand}" MinWidth="108"/>
                                <TextBlock Text="{Binding [official_publisher_legacy_announcement], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Foreground="#FF9500" Margin="0,0,12,0"
                                           Visibility="{Binding AnnouncementHasRemoteChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Text="{Binding [official_publisher_announcement_pending], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                                <TextBlock Foreground="#34C759"
                                           Visibility="{Binding AnnouncementHasRemoteChanges, Converter={StaticResource BooleanToVisibilityReConverter}}"
                                           Text="{Binding [official_publisher_announcement_up_to_date], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                                           Text="{Binding [official_publisher_minimum_version_label], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                                <TextBox Grid.Column="1" Text="{Binding MinimumSupportedVersionText, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#636366" FontSize="12"
                                           Text="{Binding [official_publisher_minimum_version_hint], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                                           Text="{Binding [official_publisher_latest_version_label], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                                <TextBox Grid.Column="1" Text="{Binding LatestAppVersionText, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock VerticalAlignment="Center" Foreground="#636366" FontSize="12"
                                               Text="{Binding [official_publisher_latest_version_hint], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF9500" FontSize="12"
                                               Visibility="{Binding LatestAppVersionHasRemoteChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Text="{Binding [official_publisher_latest_version_pending], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                            <TextBox Text="{Binding AnnouncementText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,3" MaxLines="1"
                                     VerticalContentAlignment="Center"
                                     VerticalScrollBarVisibility="Disabled"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" MinHeight="360">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding [official_publisher_announcements_catalog], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding [home_links_edit_language], Source={x:Static lg:LanguageService.Instance}, FallbackValue=Editing language:}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding HomeLinksLanguageOptions}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                      SelectedValue="{Binding SelectedAnnouncementsLanguage}"
                                      Width="180" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <Button Content="{Binding [official_publisher_announcement_add], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                    Command="{Binding AddAnnouncementEntryCommand}" Margin="0,0,8,0" MinWidth="88"/>
                            <Button Content="{Binding [Delete], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                    Command="{Binding RemoveAnnouncementEntryCommand}" Margin="0,0,8,0" MinWidth="72"/>
                            <Button Content="{Binding [official_publisher_announcement_import], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                    Command="{Binding ImportAnnouncementsCatalogCommand}" Margin="0,0,8,0" MinWidth="72"
                                    ToolTip="{Binding [official_publisher_announcement_import_tooltip], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <Button Content="{Binding [refresh], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                    Command="{Binding LoadAnnouncementsEditorFromServerCommand}" MinWidth="72"
                                    ToolTip="{Binding [official_publisher_announcement_reload_tooltip], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding AnnouncementEntries}"
                                     SelectedItem="{Binding SelectedAnnouncementEntry}"
                                     BorderBrush="#EEEEEE" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding BackgroundSummary}" FontSize="11" Foreground="#888888"/>
                                                <TextBlock Text="{Binding Id, StringFormat=' · {0}'}" FontSize="11" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="4,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding [official_publisher_ann_id], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,8" Text="{Binding SelectedAnnouncementEntry.Id, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding [official_publisher_ann_theme], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,8"
                                              ItemsSource="{Binding AnnouncementThemeOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedAnnouncementEntry.Theme}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding [official_publisher_ann_date], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,8" Text="{Binding SelectedAnnouncementEntry.Date, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding [official_publisher_ann_priority], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" Text="{Binding SelectedAnnouncementEntry.Priority, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="2" Text="{Binding [official_publisher_ann_start], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,12,8" Text="{Binding SelectedAnnouncementEntry.StartDate, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding [official_publisher_ann_end], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,8" Text="{Binding SelectedAnnouncementEntry.EndDate, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="3" Text="{Binding [official_publisher_ann_tag], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    <controls:LocalizedStringControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" MinHeight="30"
                                                                     Value="{Binding SelectedAnnouncementEntry.Tag, Mode=TwoWay}"
                                                                     ContentLanguageContext="{Binding AnnouncementsLanguageContext}"/>
                                    <TextBlock Grid.Row="4" Text="{Binding [official_publisher_ann_title], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    <controls:LocalizedStringControl Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" MinHeight="30"
                                                                     Value="{Binding SelectedAnnouncementEntry.Title, Mode=TwoWay}"
                                                                     ContentLanguageContext="{Binding AnnouncementsLanguageContext}"/>
                                    <TextBlock Grid.Row="5" Text="{Binding [official_publisher_ann_body], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    <controls:LocalizedStringControl Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" MinHeight="64"
                                                                     Value="{Binding SelectedAnnouncementEntry.Body, Mode=TwoWay}"
                                                                     ContentLanguageContext="{Binding AnnouncementsLanguageContext}"/>
                                    <TextBlock Grid.Row="6" Text="{Binding [official_publisher_ann_action], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    <controls:LocalizedStringControl Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" MinHeight="30"
                                                                     Value="{Binding SelectedAnnouncementEntry.ActionLabel, Mode=TwoWay}"
                                                                     ContentLanguageContext="{Binding AnnouncementsLanguageContext}"/>
                                    <TextBlock Grid.Row="7" Text="{Binding [official_publisher_ann_action_url], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"
                                             Text="{Binding SelectedAnnouncementEntry.ActionUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="8" Text="{Binding [official_publisher_ann_background], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,0,12,8"
                                              ItemsSource="{Binding AnnouncementBackgroundModeOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedAnnouncementEntry.BackgroundMode}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#888888" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,8"
                                               Text="{Binding [official_publisher_ann_background_hint], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                                    <TextBlock Grid.Row="9" Text="{Binding [official_publisher_ann_color], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedAnnouncementEntry.IsDefaultBackground, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <controls:TextPropertyColorPicker Grid.Row="9" Grid.Column="1" Margin="0,0,12,8"
                                                                      HexColor="{Binding SelectedAnnouncementEntry.BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                                                      Visibility="{Binding SelectedAnnouncementEntry.IsDefaultBackground, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="2" Text="{Binding [official_publisher_ann_polygon], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedAnnouncementEntry.IsDefaultBackground, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ComboBox Grid.Row="9" Grid.Column="3" Margin="0,0,0,8"
                                              ItemsSource="{Binding SelectedAnnouncementEntry.PolygonStyleOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedAnnouncementEntry.PolygonStyle}"
                                              IsEnabled="{Binding SelectedAnnouncementEntry.ShowPolygons}"
                                              Visibility="{Binding SelectedAnnouncementEntry.IsDefaultBackground, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <CheckBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"
                                              Content="{Binding [official_publisher_ann_show_polygons], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                              IsChecked="{Binding SelectedAnnouncementEntry.ShowPolygons}"
                                              Visibility="{Binding SelectedAnnouncementEntry.IsDefaultBackground, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Grid.Row="11" Text="{Binding [official_publisher_ann_image_url], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedAnnouncementEntry.IsImageBackground, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBox Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"
                                             Text="{Binding SelectedAnnouncementEntry.BackgroundImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding SelectedAnnouncementEntry.IsImageBackground, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsPlotCategoriesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Foreground="#636366" Margin="0,0,0,8"
                               Text="{Binding [official_publisher_plot_categories_note], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding [home_links_edit_language], Source={x:Static lg:LanguageService.Instance}, FallbackValue=Editing language:}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding HomeLinksLanguageOptions}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedPlotCategoriesLanguage}"
                                  Width="180" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [official_publisher_plot_categories_level], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding PlotCategoryLevelKeys}"
                                  SelectedItem="{Binding SelectedPlotCategoryLevel}"
                                  Width="100" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Button Content="{Binding [official_publisher_category_add], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding AddPlotCategoryEntryCommand}" Margin="0,0,8,0" MinWidth="88"/>
                        <Button Content="{Binding [official_publisher_category_edit], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding EditPlotCategoryEntryCommand}" Margin="0,0,8,0" MinWidth="88"/>
                        <Button Content="{Binding [Delete], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding RemovePlotCategoryEntryCommand}" Margin="0,0,8,0" MinWidth="72"/>
                        <Button Content="{Binding [official_publisher_home_save_draft], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding SavePlotCategoriesDraftCommand}" Margin="0,0,8,0" MinWidth="100"/>
                        <Button Content="{Binding [refresh], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding ReloadPlotCategoriesEditorCommand}" MinWidth="72"/>
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding PlotCategoryEntries}"
                             SelectedItem="{Binding SelectedPlotCategoryEntry}"
                             BorderBrush="#EEEEEE" BorderThickness="1" MinHeight="320">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayTitle}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Visibility="{Binding IsGeoTCategoriesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Foreground="#636366" Margin="0,0,0,8"
                               Text="{Binding [official_publisher_geot_categories_note], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding [home_links_edit_language], Source={x:Static lg:LanguageService.Instance}, FallbackValue=Editing language:}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding HomeLinksLanguageOptions}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedGeoTMineralCategoriesLanguage}"
                                  Width="180" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Button Content="{Binding [official_publisher_category_add], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding AddGeoTMineralEntryCommand}" Margin="0,0,8,0" MinWidth="88"/>
                        <Button Content="{Binding [official_publisher_category_edit], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding EditGeoTMineralEntryCommand}" Margin="0,0,8,0" MinWidth="88"/>
                        <Button Content="{Binding [Delete], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding RemoveGeoTMineralEntryCommand}" Margin="0,0,8,0" MinWidth="72"/>
                        <Button Content="{Binding [official_publisher_home_save_draft], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding SaveGeoTMineralCategoriesDraftCommand}" Margin="0,0,8,0" MinWidth="100"/>
                        <Button Content="{Binding [refresh], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding ReloadGeoTMineralCategoriesEditorCommand}" MinWidth="72"/>
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding GeoTMineralEntries}"
                             SelectedItem="{Binding SelectedGeoTMineralEntry}"
                             BorderBrush="#EEEEEE" BorderThickness="1" MinHeight="320">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayTitle}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </hc:ScrollViewer>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#E5E5EA" BorderThickness="0,1,0,0" Background="White" Padding="20,12,20,16">
            <StackPanel>
                <hc:ScrollViewer Background="#F5F5F5" Padding="10" Margin="0,0,0,10"
                                 VerticalScrollBarVisibility="Auto" MaxHeight="96">
                    <TextBlock Text="{Binding LogText}" TextWrapping="Wrap"/>
                </hc:ScrollViewer>
                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsPublishing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding PublishProgressText}" FontSize="12" Foreground="#666666" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PublishProgress, StringFormat={}{0:0}%}"
                                   FontSize="12" Foreground="#666666" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Value="{Binding PublishProgress}" Maximum="100" Height="6" BorderThickness="0"/>
                </StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#636366">
                        <Run Text="{Binding [official_publisher_enabled_servers_label], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding EnabledTargetCount, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding [official_publisher_refresh], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding RefreshPreviewCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding IsNotBusy}" MinWidth="100"/>
                        <Button Content="{Binding [official_publisher_export_local], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding ExportLocalCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding IsNotBusy}" MinWidth="120"/>
                        <Button Content="{Binding [official_publisher_publish_targets], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                Command="{Binding PublishToCosCommand}"
                                Style="{StaticResource ButtonPrimary}" IsEnabled="{Binding IsNotBusy}" MinWidth="180"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
