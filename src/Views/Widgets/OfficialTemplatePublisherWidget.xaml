<UserControl x:Class="GeoChemistryNexus.Views.Widgets.OfficialTemplatePublisherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
             xmlns:helpers="clr-namespace:GeoChemistryNexus.Helpers"
             xmlns:widgets="clr-namespace:GeoChemistryNexus.Views.Widgets"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100" Background="#F5F7FA"
             PreviewMouseWheel="Publisher_PreviewMouseWheel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoChemistryNexus;component/Themes/WidgetStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PublisherNavButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#1C2433"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Margin" Value="10,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F6F7FB"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PublisherNavCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#8B93A7"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="22,14,12,4"/>
            </Style>

            <Style x:Key="PublisherToolButton" TargetType="Button" BasedOn="{StaticResource WidgetAction}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="PublisherDangerToolButton" TargetType="Button" BasedOn="{StaticResource WidgetDangerAction}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="PublisherPrimaryButton" TargetType="Button" BasedOn="{StaticResource PublisherToolButton}">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style x:Key="PublisherFilterButton" TargetType="Button" BasedOn="{StaticResource PublisherToolButton}"/>
            <Style x:Key="PublisherCaptionButton" TargetType="Button" BasedOn="{StaticResource WidgetCaptionAction}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="PublisherCaptionPrimary" TargetType="Button" BasedOn="{StaticResource PublisherCaptionButton}">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="PublisherStateChip" TargetType="Border">
                <Setter Property="Background" Value="#F3F5F8"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="新增">
                        <Setter Property="Background" Value="#E8F8EE"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="纳入">
                        <Setter Property="Background" Value="#E8F8EE"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="更新">
                        <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="移除">
                        <Setter Property="Background" Value="#FFEFED"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="有改动">
                        <Setter Property="Background" Value="#FFF4E5"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="CategoryLanguageTemplate">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </DataTemplate>

            <cvs:AnnouncementLightThemeToBrushConverter x:Key="AnnouncementLightThemeConverter"/>

            <DataTemplate x:Key="PublisherAnnouncementPreviewTemplate">
                <Grid Background="{Binding Converter={StaticResource AnnouncementLightThemeConverter}}">
                    <Border IsHitTestVisible="False"
                            Visibility="{Binding HasBackgroundImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding BackgroundImage}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border IsHitTestVisible="False"
                            Background="{StaticResource HomeHeroImageScrimBrush}"
                            Visibility="{Binding HasBackgroundImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="34,20,12,14" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource HomeSlideTagBorderStyle}"
                                        Visibility="{Binding HasTag, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Tag}" Style="{StaticResource HomeSlideTagTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding DateText}" Style="{StaticResource HomeSlideMetaStyle}"
                                           Margin="8,0,0,0"
                                           Visibility="{Binding HasDate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource HomeSlideTitleStyle}"/>
                            <TextBlock Text="{Binding Body}" Style="{StaticResource HomeSlideBodyStyle}"
                                       Visibility="{Binding HasBody, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Margin="0,10,0,0"
                                    Style="{StaticResource HomeSlideActionButtonStyle}"
                                    Content="{Binding ActionLabel}"
                                    Command="{Binding DataContext.OpenAnnouncementPreviewActionCommand, RelativeSource={RelativeSource AncestorType=widgets:OfficialTemplatePublisherWidget}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                        <Viewbox Grid.Column="1" MaxWidth="170" Stretch="Uniform" Margin="0,0,24,0"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                 Visibility="{Binding HasBackgroundImage, Converter={StaticResource BooleanToVisibilityReConverter}}">
                            <Canvas Width="170" Height="136">
                                <Canvas.Effect>
                                    <DropShadowEffect Color="{DynamicResource ThemeAccentColor}" Opacity="0.28" BlurRadius="26" ShadowDepth="10" Direction="270"/>
                                </Canvas.Effect>
                                <Polygon Points="58,8 125,8 116,63 41,114 7,102 8,68"
                                         Fill="{DynamicResource ThemeGlyphBrush}" Stroke="{DynamicResource ThemeGlyphBrush}"
                                         StrokeLineJoin="Round" StrokeThickness="5"/>
                                <Polygon Points="140,7 163,75 148,90 129,64"
                                         Fill="{DynamicResource ThemeAccentDeepBrush}" Stroke="{DynamicResource ThemeAccentDeepBrush}"
                                         StrokeLineJoin="Round" StrokeThickness="5"/>
                                <Polygon Points="119,75 136,97 94,129 57,118"
                                         Fill="{DynamicResource ThemeAccentLighterBrush}" Stroke="{DynamicResource ThemeAccentLighterBrush}"
                                         StrokeLineJoin="Round" StrokeThickness="5"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="PublishDiffTemplate">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PublisherStateChip}" Tag="{Binding ActionLabel}" HorizontalAlignment="Left" Margin="0">
                        <TextBlock FontSize="12" Text="{Binding ActionLabel}"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="widgets:WidgetWindow.CaptionContent">
                <Setter.Value>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource PublisherCaptionButton}" Content="刷新预览"
                                Command="{Binding RefreshPreviewCommand}" IsEnabled="{Binding IsNotBusy}"/>
                        <Button Style="{StaticResource PublisherCaptionButton}" Content="暂存到本地"
                                Command="{Binding ExportLocalCommand}" IsEnabled="{Binding CanStageOrPublish}"/>
                        <Button Style="{StaticResource PublisherCaptionPrimary}" Content="{Binding PublishButtonText}"
                                Command="{Binding PublishToCosCommand}" IsEnabled="{Binding CanPublish}"/>
                    </StackPanel>
                </Setter.Value>
            </Setter>
            <Setter Property="widgets:WidgetWindow.SidebarContent">
                <Setter.Value>
                    <DockPanel Width="220" Margin="0,18,0,16">
                        <DockPanel DockPanel.Dock="Top" Margin="18,2,12,12">
                            <Border Width="34" Height="34" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="10" DockPanel.Dock="Left" Margin="0,0,10,0">
                                <TextBlock Text="{Binding WidgetIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="官方发布器" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PublisherNavCaption}" Margin="22,4,12,4" Text="发布"/>
                                <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection" Content="发布单"
                                             IsChecked="{Binding IsReleaseSection, Mode=TwoWay}"/>
                                <TextBlock Style="{StaticResource PublisherNavCaption}" Text="主页内容"/>
                                <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection" Content="公告与版本"
                                             IsChecked="{Binding IsAnnouncementSection, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection" Content="导航链接"
                                             IsChecked="{Binding IsHomeLinksSection, Mode=TwoWay}"/>
                                <TextBlock Style="{StaticResource PublisherNavCaption}" Text="官方模板"/>
                                <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection" Content="图解与分类"
                                             IsChecked="{Binding IsDiagramsSection, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection" Content="温压计与矿物分类"
                                             IsChecked="{Binding IsGeothermometersSection, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection" Content="EPMA 计算模板"
                                             IsChecked="{Binding IsEpmaSection, Mode=TwoWay}"/>
                                <TextBlock Style="{StaticResource PublisherNavCaption}" Text="服务器"/>
                                <RadioButton Style="{StaticResource PublisherNavButton}" GroupName="PublisherSection" Content="发布目标"
                                             IsChecked="{Binding IsTargetsSection, Mode=TwoWay}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="24,16,24,8" FontSize="16" FontWeight="SemiBold" Text="{Binding SectionTitle}"/>

        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,16">

                <!-- 发布单顶部：一句话说明这次要发什么，并给出常用的批量勾选 -->
                <Border Style="{StaticResource WidgetCard}" Padding="16,12" Margin="0,0,0,12"
                        Visibility="{Binding IsReleaseSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PublisherToolButton}" Content="勾选有改动的"
                                    ToolTip="只勾选和服务器不一致的内容"
                                    Command="{Binding SelectChangedPacksCommand}"/>
                            <Button Style="{StaticResource PublisherToolButton}" Margin="0" Content="全部取消"
                                    Command="{Binding ClearPackSelectionCommand}"/>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                   Text="{Binding ReleaseSummaryText}"/>
                    </DockPanel>
                </Border>

                <!-- 没有可用服务器时直接提示，不要等点了发布才发现 -->
                <Border Background="#FFF4E5" CornerRadius="10" Padding="16,10" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsReleaseSection}" Value="True"/>
                                        <Condition Binding="{Binding HasNoEnabledTarget}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PublisherToolButton}" Margin="12,0,0,0" Content="去配置"
                                Command="{Binding OpenPublisherSectionCommand}" CommandParameter="targets"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#B45309" TextWrapping="Wrap"
                                   Text="没有启用的服务器，暂时无法发布。到“发布目标”里添加或启用一台。"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource WidgetCard}" Padding="0" Margin="0"
                        Visibility="{Binding IsReleaseSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border BorderBrush="#E4E7F0" BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding PublishAnnouncement}"/>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="公告与版本" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding AnnouncementReleaseStatus}" FontSize="12" Foreground="#5C677A" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource PublisherStateChip}" Tag="{Binding AnnouncementReleaseChip}">
                                    <TextBlock FontSize="12" Text="{Binding AnnouncementReleaseChip}"/>
                                </Border>
                                <Button Grid.Column="3" Style="{StaticResource PublisherToolButton}" Margin="0" Content="打开"                                        Command="{Binding OpenPublisherSectionCommand}" CommandParameter="announcement"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="#E4E7F0" BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding PublishHomeLinks}"/>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="导航链接" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding HomeLinksReleaseStatus}" FontSize="12" Foreground="#5C677A" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource PublisherStateChip}" Tag="{Binding HomeLinksReleaseChip}">
                                    <TextBlock FontSize="12" Text="{Binding HomeLinksReleaseChip}"/>
                                </Border>
                                <Button Grid.Column="3" Style="{StaticResource PublisherToolButton}" Margin="0" Content="打开"                                        Command="{Binding OpenPublisherSectionCommand}" CommandParameter="homeLinks"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="#E4E7F0" BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding PublishDiagrams}"/>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="图解与分类" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DiagramReleaseStatus}" FontSize="12" Foreground="#5C677A" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource PublisherStateChip}" Tag="{Binding DiagramReleaseChip}">
                                    <TextBlock FontSize="12" Text="{Binding DiagramReleaseChip}"/>
                                </Border>
                                <Button Grid.Column="3" Style="{StaticResource PublisherToolButton}" Margin="0" Content="打开"                                        Command="{Binding OpenPublisherSectionCommand}" CommandParameter="diagrams"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="#E4E7F0" BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding PublishGeothermometers}"/>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="温压计与矿物分类" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding GeoReleaseStatus}" FontSize="12" Foreground="#5C677A" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource PublisherStateChip}" Tag="{Binding GeoReleaseChip}">
                                    <TextBlock FontSize="12" Text="{Binding GeoReleaseChip}"/>
                                </Border>
                                <Button Grid.Column="3" Style="{StaticResource PublisherToolButton}" Margin="0" Content="打开"                                        Command="{Binding OpenPublisherSectionCommand}" CommandParameter="geothermometers"/>
                            </Grid>
                        </Border>
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding PublishEpma}"/>
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="EPMA 计算模板" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding EpmaReleaseStatus}" FontSize="12" Foreground="#5C677A" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource PublisherStateChip}" Tag="{Binding EpmaReleaseChip}">
                                <TextBlock FontSize="12" Text="{Binding EpmaReleaseChip}"/>
                            </Border>
                            <Button Grid.Column="3" Style="{StaticResource PublisherToolButton}" Margin="0" Content="打开"                                    Command="{Binding OpenPublisherSectionCommand}" CommandParameter="epma"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding IsAnnouncementSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- 顶栏：是否纳入本次发布 / 编辑语言 / 只发布这一页 -->
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PublisherPrimaryButton}" Margin="0" Content="发布本页"
                                ToolTip="只发布公告与版本，不影响发布单里其他条目的勾选"
                                Command="{Binding PublishSectionOnlyCommand}" CommandParameter="announcement"
                                IsEnabled="{Binding CanPublishSection}"/>
                        <ComboBox DockPanel.Dock="Right" Width="180" Margin="0,0,8,0" Style="{StaticResource WidgetCombo}"
                                  ItemsSource="{Binding EditLanguageOptions}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedEditLanguage}"/>
                        <TextBlock DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource WidgetFieldLabel}" Text="编辑语言"/>
                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Content="本次发布" IsChecked="{Binding PublishAnnouncement}"/>
                        <Border Style="{StaticResource PublisherStateChip}" Tag="{Binding AnnouncementReleaseChip}" Margin="12,0,0,0" HorizontalAlignment="Left">
                            <TextBlock FontSize="12" Text="{Binding AnnouncementReleaseChip}"/>
                        </Border>
                    </DockPanel>

                    <Border Style="{StaticResource WidgetCard}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PublisherToolButton}" Margin="0" Content="从服务器载入"
                                        Command="{Binding LoadAnnouncementFromServerCommand}"/>
                                <TextBlock Style="{StaticResource WidgetSectionTitle}" Text="版本"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="最低支持版本"/>
                                    <TextBox Text="{Binding MinimumSupportedVersionText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="最新版本"/>
                                    <TextBox Text="{Binding LatestAppVersionText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 工具栏 -->
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Margin="0" Command="{Binding ToggleAnnouncementPreviewCommand}"
                                ToolTip="按上架时间和语言模拟主页轮播的实际效果">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PublisherToolButton}">
                                    <Setter Property="Content" Value="模拟主页"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnnouncementPreview}" Value="True">
                                            <Setter Property="Content" Value="返回编辑"/>
                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PublisherToolButton}" Content="添加" Command="{Binding AddAnnouncementEntryCommand}"/>
                            <Button Style="{StaticResource PublisherToolButton}" Content="复制" ToolTip="以选中的公告为模板新建一条"
                                    Command="{Binding DuplicateAnnouncementEntryCommand}"/>
                            <Button Style="{StaticResource PublisherDangerToolButton}" Content="删除" Command="{Binding RemoveAnnouncementEntryCommand}"/>
                            <Button Style="{StaticResource PublisherToolButton}" Content="导入" Command="{Binding ImportAnnouncementsCatalogCommand}"/>
                            <Button Style="{StaticResource PublisherToolButton}" Content="导出" Command="{Binding ExportAnnouncementsCatalogCommand}"/>
                            <Button Style="{StaticResource PublisherToolButton}" Content="重新载入" ToolTip="放弃本地修改，重新以服务器上的公告为准"
                                    Command="{Binding LoadAnnouncementsEditorFromServerCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 编辑模式：左侧公告列表，右侧实时预览 + 编辑表单 -->
                    <Grid Visibility="{Binding IsAnnouncementPreview, Converter={StaticResource BooleanToVisibilityReConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox VerticalAlignment="Top" Style="{StaticResource WidgetListBox}" MaxHeight="760"
                                 ItemsSource="{Binding AnnouncementEntries}"
                                 SelectedItem="{Binding SelectedAnnouncementEntry}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#8B93A7"
                                                       Text="{Binding LanguageSummary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource WidgetAnnouncementStatusChip}"
                                                Tag="{Binding StatusKey}">
                                            <TextBlock FontSize="11" Foreground="#4B5B70" Text="{Binding StatusText}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Column="2" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Foreground="#8B93A7" Text="左侧选择一条公告开始编辑，或点“添加”新建。"
                                   Visibility="{Binding HasSelectedAnnouncementEntry, Converter={StaticResource BooleanToVisibilityReConverter}}"/>

                        <Border Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource WidgetCard}" Margin="0" Padding="0"
                                Visibility="{Binding HasSelectedAnnouncementEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <!-- 实时预览：改字、换色、换图立刻看到效果；高度与主页公告舞台一致（368 - 66 缩略条 = 302） -->
                                <Border Style="{StaticResource HomeSurfaceCardStyle}" Height="302" CornerRadius="18" Margin="16,16,16,0"
                                        helpers:HomeRoundedClip.Radius="18">
                                    <ContentControl Content="{Binding SelectedAnnouncementLivePreview}"
                                                    ContentTemplate="{StaticResource PublisherAnnouncementPreviewTemplate}"/>
                                </Border>
                                <TextBlock Style="{StaticResource WidgetHint}" Margin="18,6,18,0"
                                           Text="实时预览（按所选编辑语言显示，没填的语言会回退到其他语言）"/>

                                <StackPanel Margin="16,12,16,16">
                                    <!-- 语言填写情况：点击切换编辑语言 -->
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6"
                                               Text="语言（绿：完整　橙：缺标题或正文　灰：未填写；点击切换）"/>
                                    <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding AnnouncementTranslationChips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource WidgetLanguageChip}" Content="{Binding Code}"
                                                        ToolTip="{Binding DisplayName}"
                                                        Command="{Binding DataContext.SelectEditLanguageCommand, RelativeSource={RelativeSource AncestorType=widgets:OfficialTemplatePublisherWidget}}"
                                                        CommandParameter="{Binding Code}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 内容 -->
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="标签"/>
                                    <controls:LocalizedStringControl Margin="0,0,0,10" MinHeight="32" IsSingleLine="True" ShowLanguageChip="True"
                                                                     Value="{Binding SelectedAnnouncementEntry.Tag, Mode=TwoWay}"
                                                                     ContentLanguageContext="{Binding AnnouncementsLanguageContext}"/>
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="标题"/>
                                    <controls:LocalizedStringControl Margin="0,0,0,10" MinHeight="32" IsSingleLine="True" ShowLanguageChip="True"
                                                                     Value="{Binding SelectedAnnouncementEntry.Title, Mode=TwoWay}"
                                                                     ContentLanguageContext="{Binding AnnouncementsLanguageContext}"/>
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="正文"/>
                                    <controls:LocalizedStringControl Margin="0,0,0,10" MinHeight="72" ShowLanguageChip="True"
                                                                     Value="{Binding SelectedAnnouncementEntry.Body, Mode=TwoWay}"
                                                                     ContentLanguageContext="{Binding AnnouncementsLanguageContext}"/>

                                    <!-- 按钮 -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="按钮文字"/>
                                            <controls:LocalizedStringControl MinHeight="32" IsSingleLine="True" ShowLanguageChip="True"
                                                                             Value="{Binding SelectedAnnouncementEntry.ActionLabel, Mode=TwoWay}"
                                                                             ContentLanguageContext="{Binding AnnouncementsLanguageContext}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="按钮地址（文字和地址都填才会显示按钮）"/>
                                            <TextBox Text="{Binding SelectedAnnouncementEntry.ActionUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 外观 -->
                                    <Border Height="1" Background="#E4E7F0" Margin="0,4,0,12"/>
                                    <TextBlock Style="{StaticResource WidgetSectionTitle}" Margin="0,0,0,8" Text="外观"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="背景"/>
                                            <ComboBox Style="{StaticResource WidgetCombo}"
                                                      ItemsSource="{Binding AnnouncementBackgroundModeOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedAnnouncementEntry.BackgroundMode}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Visibility="{Binding SelectedAnnouncementEntry.IsDefaultBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="主题"/>
                                            <ComboBox Style="{StaticResource WidgetCombo}"
                                                      ItemsSource="{Binding AnnouncementThemeOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedAnnouncementEntry.Theme}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Visibility="{Binding SelectedAnnouncementEntry.IsDefaultBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="自定义颜色（留空用主题）"/>
                                            <controls:TextPropertyColorPicker HexColor="{Binding SelectedAnnouncementEntry.BackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Grid.ColumnSpan="3" Visibility="{Binding SelectedAnnouncementEntry.IsImageBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="图片地址（http / https）"/>
                                            <TextBox Text="{Binding SelectedAnnouncementEntry.BackgroundImageUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 展示规则 -->
                                    <Border Height="1" Background="#E4E7F0" Margin="0,4,0,12"/>
                                    <TextBlock Style="{StaticResource WidgetSectionTitle}" Margin="0,0,0,8" Text="展示规则"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="发布日期"/>
                                            <TextBox ToolTip="格式 yyyy-MM-dd" Text="{Binding SelectedAnnouncementEntry.Date, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="优先级（大的靠前）"/>
                                            <TextBox Text="{Binding SelectedAnnouncementEntry.Priority, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="上架（留空立即）"/>
                                            <TextBox ToolTip="格式 yyyy-MM-dd" Text="{Binding SelectedAnnouncementEntry.StartDate, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="下架（留空长期）"/>
                                            <TextBox ToolTip="格式 yyyy-MM-dd" Text="{Binding SelectedAnnouncementEntry.EndDate, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Style="{StaticResource WidgetFieldLabel}" Text="展示给哪些语言的用户"/>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#8B93A7"
                                                   Text="不选则所有语言都显示"/>
                                    </StackPanel>
                                    <ItemsControl Margin="0,0,0,10" ItemsSource="{Binding SelectedAnnouncementEntry.LanguageChoices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,14,6"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="编号（自动生成，一般不用改）"/>
                                    <TextBox Text="{Binding SelectedAnnouncementEntry.Id, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 模拟主页：按所选语言和今天的日期，看主页轮播真正会显示哪些公告 -->
                    <StackPanel Visibility="{Binding IsAnnouncementPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#5C677A" Text="预览语言"/>
                            <ComboBox Width="220" Style="{StaticResource WidgetCombo}"
                                      ItemsSource="{Binding AnnouncementPreviewLanguageOptions}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                      SelectedValue="{Binding AnnouncementPreviewLanguage}"/>
                        </StackPanel>
                        <Border Style="{StaticResource HomeSurfaceCardStyle}" Height="368" CornerRadius="18"
                                helpers:HomeRoundedClip.Radius="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <ContentControl Content="{Binding CurrentAnnouncementPreview}"
                                                    ContentTemplate="{StaticResource PublisherAnnouncementPreviewTemplate}"
                                                    Visibility="{Binding HasAnnouncementPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#8B93A7" TextAlignment="Center" TextWrapping="Wrap" Margin="32"
                                               Text="当前语言下没有正在展示的公告。公告需要有标题，且今天在上架与下架之间。"
                                               Visibility="{Binding HasAnnouncementPreview, Converter={StaticResource BooleanToVisibilityReConverter}}"/>
                                    <Border Background="#CCFFFFFF" CornerRadius="10" Padding="9,3"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,14,18,0" Panel.ZIndex="2"
                                            Visibility="{Binding HasMultipleAnnouncementPreviews, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding AnnouncementPreviewCounterText}" FontSize="12"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   Foreground="{DynamicResource HomeSubBrush}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,22,22" Panel.ZIndex="2"
                                                Visibility="{Binding HasMultipleAnnouncementPreviews, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Style="{StaticResource HomeCarouselRoundButtonStyle}" Margin="0,0,8,0"
                                                Command="{Binding ShowPreviousAnnouncementPreviewCommand}">
                                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                        </Button>
                                        <Button Style="{StaticResource HomeCarouselRoundButtonStyle}"
                                                Command="{Binding ShowNextAnnouncementPreviewCommand}">
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Height="66" BorderBrush="{DynamicResource HomeLineBrush}" BorderThickness="0,1,0,0"
                                        Visibility="{Binding HasAnnouncementPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox ItemsSource="{Binding AnnouncementPreviewItems}"
                                             SelectedItem="{Binding CurrentAnnouncementPreview, Mode=TwoWay}"
                                             ItemContainerStyle="{StaticResource HomeAnnouncementStripItemStyle}"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="16,12">
                                                    <TextBlock Text="{Binding DateText}" FontSize="12"
                                                               Foreground="{DynamicResource HomeSubBrush}"/>
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource HomeAnnouncementStripTitleStyle}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Expander Margin="0,12,0,0" Header="旧版单行公告（只给还不认识新公告的低版本客户端用）"
                              Visibility="{Binding IsAnnouncementPreview, Converter={StaticResource BooleanToVisibilityReConverter}}">
                        <Border Style="{StaticResource WidgetCard}" Padding="16" Margin="0,8,0,0">
                            <TextBox Text="{Binding AnnouncementText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </Expander>
                </StackPanel>

                <StackPanel Visibility="{Binding IsHomeLinksSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PublisherPrimaryButton}" Margin="0" Content="发布本页"
                                ToolTip="只发布导航链接，不影响发布单里其他条目的勾选"
                                Command="{Binding PublishSectionOnlyCommand}" CommandParameter="homeLinks"
                                IsEnabled="{Binding CanPublishSection}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PublisherToolButton}" Margin="0,0,8,0" Content="保存"
                                ToolTip="编辑会自动保存，这里可以立即保存一次"
                                Command="{Binding SaveHomeLinksDraftCommand}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PublisherToolButton}" Content="导入" Command="{Binding ImportHomeLinksCatalogCommand}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PublisherToolButton}" Content="导出" Command="{Binding ExportHomeLinksCatalogCommand}"/>
                        <ComboBox DockPanel.Dock="Right" Width="180" Margin="0,0,8,0" Style="{StaticResource WidgetCombo}"
                                  ItemsSource="{Binding EditLanguageOptions}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedEditLanguage}"/>
                        <TextBlock DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource WidgetFieldLabel}" Text="编辑语言"/>
                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Content="本次发布" IsChecked="{Binding PublishHomeLinks}"/>
                        <Border Style="{StaticResource PublisherStateChip}" Tag="{Binding HomeLinksReleaseChip}" Margin="10,0,0,0" HorizontalAlignment="Left">
                            <TextBlock FontSize="12" Text="{Binding HomeLinksReleaseChip}"/>
                        </Border>
                    </DockPanel>
                    <Grid Height="560">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PublisherToolButton}" Content="分组" Command="{Binding AddHomeLinkGroupCommand}"/>
                            <Button Style="{StaticResource PublisherDangerToolButton}" Margin="0" Content="删除" Command="{Binding RemoveHomeLinkGroupCommand}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PublisherToolButton}" Content="链接" Command="{Binding AddHomeLinkCommand}"/>
                            <Button Style="{StaticResource PublisherDangerToolButton}" Margin="0" Content="删除" Command="{Binding RemoveHomeLinkCommand}"/>
                        </StackPanel>
                        <ListBox Grid.Row="2" Style="{StaticResource WidgetListBox}"
                                 ItemsSource="{Binding HomeLinkGroups}"
                                 SelectedItem="{Binding SelectedHomeLinkGroup}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,2">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LinkCount}" FontSize="11" Foreground="#8B93A7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox Grid.Row="2" Grid.Column="2" Style="{StaticResource WidgetListBox}"
                                 ItemsSource="{Binding SelectedHomeLinkGroup.Links}"
                                 SelectedItem="{Binding SelectedHomeLink}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,2">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Url}" FontSize="11" Foreground="#8B93A7" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource WidgetCard}" Margin="0" Padding="16"
                                Visibility="{Binding HasSelectedHomeLinkGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="分组名称"/>
                                <controls:LocalizedStringControl MinHeight="32" IsSingleLine="True" Margin="0,0,0,10"
                                                                 Value="{Binding SelectedHomeLinkGroup.Title, Mode=TwoWay}"
                                                                 ShowLanguageChip="True"
                                                                 ContentLanguageContext="{Binding HomeLinksLanguageContext}"/>
                                <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="分组编号"/>
                                <TextBox Margin="0,0,0,14" Text="{Binding SelectedHomeLinkGroup.Id, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Visibility="{Binding HasSelectedHomeLink, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Height="1" Background="#E4E7F0" Margin="0,0,0,14"/>
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="标题"/>
                                    <controls:LocalizedStringControl MinHeight="32" IsSingleLine="True" Margin="0,0,0,10"
                                                                     Value="{Binding SelectedHomeLink.Title, Mode=TwoWay}"
                                                                     ShowLanguageChip="True"
                                                                 ContentLanguageContext="{Binding HomeLinksLanguageContext}"/>
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="说明"/>
                                    <controls:LocalizedStringControl MinHeight="32" IsSingleLine="True" Margin="0,0,0,10"
                                                                     Value="{Binding SelectedHomeLink.Description, Mode=TwoWay}"
                                                                     ShowLanguageChip="True"
                                                                 ContentLanguageContext="{Binding HomeLinksLanguageContext}"/>
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="地址"/>
                                    <TextBox Margin="0,0,0,10" Text="{Binding SelectedHomeLink.Url, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="图标"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Width="36" Margin="8,0,0,0" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ThemeAccentBrush}"
                                                   Text="{Binding SelectedHomeLink.Icon}"/>
                                        <TextBox Text="{Binding SelectedHomeLink.Icon, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,12"
                            Visibility="{Binding IsLibrarySection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="全部" Command="{Binding SetPreviewFilterCommand}" CommandParameter="all">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PublisherFilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreviewFilter}" Value="all">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="新增" Command="{Binding SetPreviewFilterCommand}" CommandParameter="new">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PublisherFilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreviewFilter}" Value="new">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="更新" Command="{Binding SetPreviewFilterCommand}" CommandParameter="update">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PublisherFilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreviewFilter}" Value="update">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="移除" Command="{Binding SetPreviewFilterCommand}" CommandParameter="remove">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PublisherFilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreviewFilter}" Value="remove">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="未变化" Command="{Binding SetPreviewFilterCommand}" CommandParameter="same">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PublisherFilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreviewFilter}" Value="same">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Grid Visibility="{Binding IsDiagramsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="520"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PublisherPrimaryButton}" Margin="0" Content="发布本页"
                                ToolTip="只发布图解与分类，不影响发布单里其他条目的勾选"
                                Command="{Binding PublishSectionOnlyCommand}" CommandParameter="diagrams"
                                IsEnabled="{Binding CanPublishSection}"/>
                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Content="本次发布" IsChecked="{Binding PublishDiagrams}"/>
                        <Border Style="{StaticResource PublisherStateChip}" Tag="{Binding DiagramReleaseChip}" Margin="12,0,0,0" HorizontalAlignment="Left">
                            <TextBlock FontSize="12" Text="{Binding DiagramReleaseChip}"/>
                        </Border>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Style="{StaticResource WidgetListBox}"
                                 ItemsSource="{Binding DiagramPreviewView}"
                                 ItemTemplate="{StaticResource PublishDiffTemplate}"
                                 IsSynchronizedWithCurrentItem="False"/>
                        <Border Grid.Column="2" Style="{StaticResource WidgetCard}" Margin="0" Padding="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                                    <TextBlock Text="分类" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="Level1" Command="{Binding SetPlotCategoryLevelCommand}" CommandParameter="Level1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PublisherFilterButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPlotCategoryLevel}" Value="Level1">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Level2" Command="{Binding SetPlotCategoryLevelCommand}" CommandParameter="Level2">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PublisherFilterButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPlotCategoryLevel}" Value="Level2">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Level3" Command="{Binding SetPlotCategoryLevelCommand}" CommandParameter="Level3">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PublisherFilterButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPlotCategoryLevel}" Value="Level3">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Style="{StaticResource PublisherToolButton}" Content="添加" Command="{Binding AddPlotCategoryEntryCommand}"/>
                                        <Button Style="{StaticResource PublisherDangerToolButton}" Content="删除" Command="{Binding RemovePlotCategoryEntryCommand}"/>
                                        <Button Style="{StaticResource PublisherToolButton}" Content="保存" Command="{Binding SavePlotCategoriesDraftCommand}"/>
                                        <Button Style="{StaticResource PublisherToolButton}" Content="导出" Command="{Binding ExportPlotCategoriesCommand}"/>
                                        <Button Style="{StaticResource PublisherToolButton}" Content="导入" Command="{Binding ImportPlotCategoriesCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                                <ScrollViewer DockPanel.Dock="Bottom" Height="248" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12"
                                              Visibility="{Binding HasSelectedPlotCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding SelectedPlotCategoryEntry.LanguageFields}"
                                                  ItemTemplate="{StaticResource CategoryLanguageTemplate}"/>
                                </ScrollViewer>
                                <ListBox Style="{StaticResource WidgetListBox}" Margin="12,0"
                                         ItemsSource="{Binding PlotCategoryEntries}"
                                         SelectedItem="{Binding SelectedPlotCategoryEntry}"
                                         DisplayMemberPath="DisplayTitle"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsGeothermometersSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="520"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PublisherPrimaryButton}" Margin="0" Content="发布本页"
                                ToolTip="只发布温压计与矿物分类，不影响发布单里其他条目的勾选"
                                Command="{Binding PublishSectionOnlyCommand}" CommandParameter="geothermometers"
                                IsEnabled="{Binding CanPublishSection}"/>
                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Content="本次发布" IsChecked="{Binding PublishGeothermometers}"/>
                        <Border Style="{StaticResource PublisherStateChip}" Tag="{Binding GeoReleaseChip}" Margin="12,0,0,0" HorizontalAlignment="Left">
                            <TextBlock FontSize="12" Text="{Binding GeoReleaseChip}"/>
                        </Border>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Style="{StaticResource WidgetListBox}"
                                 ItemsSource="{Binding GeothermometerPreviewView}"
                                 ItemTemplate="{StaticResource PublishDiffTemplate}"
                                 IsSynchronizedWithCurrentItem="False"/>
                        <Border Grid.Column="2" Style="{StaticResource WidgetCard}" Margin="0" Padding="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                                    <TextBlock Text="矿物分类" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource PublisherToolButton}" Content="添加" Command="{Binding AddGeoTMineralEntryCommand}"/>
                                        <Button Style="{StaticResource PublisherDangerToolButton}" Content="删除" Command="{Binding RemoveGeoTMineralEntryCommand}"/>
                                        <Button Style="{StaticResource PublisherToolButton}" Content="保存" Command="{Binding SaveGeoTMineralCategoriesDraftCommand}"/>
                                        <Button Style="{StaticResource PublisherToolButton}" Content="导出" Command="{Binding ExportGeoTMineralCategoriesCommand}"/>
                                        <Button Style="{StaticResource PublisherToolButton}" Content="导入" Command="{Binding ImportGeoTMineralCategoriesCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                                <ScrollViewer DockPanel.Dock="Bottom" Height="248" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12"
                                              Visibility="{Binding HasSelectedMineralCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding SelectedGeoTMineralEntry.LanguageFields}"
                                                  ItemTemplate="{StaticResource CategoryLanguageTemplate}"/>
                                </ScrollViewer>
                                <ListBox Style="{StaticResource WidgetListBox}" Margin="12,0"
                                         ItemsSource="{Binding GeoTMineralEntries}"
                                         SelectedItem="{Binding SelectedGeoTMineralEntry}"
                                         DisplayMemberPath="DisplayTitle"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <StackPanel Visibility="{Binding IsEpmaSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PublisherPrimaryButton}" Margin="0" Content="发布本页"
                                ToolTip="只发布 EPMA 计算模板，不影响发布单里其他条目的勾选"
                                Command="{Binding PublishSectionOnlyCommand}" CommandParameter="epma"
                                IsEnabled="{Binding CanPublishSection}"/>
                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Content="本次发布" IsChecked="{Binding PublishEpma}"/>
                        <Border Style="{StaticResource PublisherStateChip}" Tag="{Binding EpmaReleaseChip}" Margin="12,0,0,0" HorizontalAlignment="Left">
                            <TextBlock FontSize="12" Text="{Binding EpmaReleaseChip}"/>
                        </Border>
                    </DockPanel>
                    <ListBox Style="{StaticResource WidgetListBox}" Height="520"
                             ItemsSource="{Binding EpmaPreviewView}"
                             ItemTemplate="{StaticResource PublishDiffTemplate}"
                             IsSynchronizedWithCurrentItem="False"/>
                </StackPanel>

                <Grid Height="520" Visibility="{Binding IsTargetsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.ColumnSpan="3" VerticalAlignment="Center">
                        <Button Style="{StaticResource PublisherToolButton}" Content="添加" Command="{Binding AddPublishTargetCommand}"/>
                        <Button Style="{StaticResource PublisherToolButton}" Content="上移" Command="{Binding MovePublishTargetUpCommand}"/>
                        <Button Style="{StaticResource PublisherToolButton}" Content="下移" Command="{Binding MovePublishTargetDownCommand}"/>
                        <Button Style="{StaticResource PublisherDangerToolButton}" Margin="0" Content="删除" Command="{Binding RemovePublishTargetCommand}"/>
                    </WrapPanel>
                    <ListBox Grid.Row="2" Style="{StaticResource WidgetListBox}"
                                 ItemsSource="{Binding PublishTargets}"
                                 SelectedItem="{Binding SelectedPublishTarget}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,2">
                                        <TextBlock Text="{Binding ListLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="#8B93A7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource WidgetCard}" Margin="0" Padding="16" VerticalAlignment="Top"
                            Visibility="{Binding HasSelectedPublishTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="名称"/>
                                    <TextBox Margin="0,0,0,10" Text="{Binding SelectedPublishTarget.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="启用"/>
                                    <CheckBox Margin="0,8,0,10" Content="参与上传" IsChecked="{Binding SelectedPublishTarget.Enabled}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="公共根地址"/>
                                    <TextBox Margin="0,0,0,10" Text="{Binding SelectedPublishTarget.PublicBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="SecretId"/>
                                    <TextBox Margin="0,0,0,10" Text="{Binding SelectedPublishTarget.SecretId, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="SecretKey"/>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#8B93A7" Text="已保存"
                                                   Visibility="{Binding SelectedPublishTarget.HasSavedSecretKey, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <PasswordBox x:Name="SecretKeyBox" Style="{StaticResource WidgetPassword}" PasswordChanged="SecretKeyBox_OnPasswordChanged"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="3">
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="Region"/>
                                    <TextBox Margin="0,0,0,10" Text="{Binding SelectedPublishTarget.Region, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2">
                                    <TextBlock Style="{StaticResource WidgetFieldLabel}" Margin="0,0,0,6" Text="Bucket"/>
                                    <TextBox Margin="0,0,0,10" Text="{Binding SelectedPublishTarget.Bucket, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PublisherToolButton}" Content="保存" Command="{Binding SaveCosSettingsCommand}"/>
                                <Button Style="{StaticResource PublisherPrimaryButton}" Content="测试连接"
                                        Command="{Binding TestCosConnectionCommand}" IsEnabled="{Binding IsNotBusy}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="White" Padding="24,10,24,12">
            <StackPanel>
                <Border Background="#F5F7FA" CornerRadius="8">
                    <ScrollViewer Padding="12,8" VerticalScrollBarVisibility="Auto" MaxHeight="96">
                        <TextBlock Text="{Binding LogText}" TextWrapping="Wrap" FontSize="12" Foreground="#4B5B70"
                                   FontFamily="Consolas, Microsoft YaHei UI"/>
                    </ScrollViewer>
                </Border>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsPublishing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding PublishProgressText}" Style="{StaticResource WidgetFieldLabel}"/>
                        <TextBlock Text="{Binding PublishProgress, StringFormat={}{0:0}%}"
                                   Style="{StaticResource WidgetFieldLabel}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource WidgetProgressBar}" Value="{Binding PublishProgress}" Maximum="100"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
