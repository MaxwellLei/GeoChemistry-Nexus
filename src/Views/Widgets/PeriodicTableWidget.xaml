<UserControl x:Class="GeoChemistryNexus.Views.Widgets.PeriodicTableWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:widgets="clr-namespace:GeoChemistryNexus.Views.Widgets"
             xmlns:uc="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:conv="clr-namespace:GeoChemistryNexus.Converter"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             Background="#F5F7FA"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoChemistryNexus;component/Themes/WidgetStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:WidthToAspectHeightConverter x:Key="WidthToAspectHeightConverter"/>
            <Style x:Key="PeriodicTableGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource WidgetAction}"/>
            <Style x:Key="PeriodicTablePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource WidgetPrimaryAction}"/>
            <Style x:Key="PeriodicTableSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource WidgetTextBox}">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">

        <!-- 主区 -->

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid MinWidth="1000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="680"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="300" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左列：顶部工具栏（类别筛选 / 清除 / 搜索 / 定位一字排开） + 周期表 -->
            <StackPanel x:Name="PeriodicTableColumn" Grid.Column="0" VerticalAlignment="Top">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 地球化学类别筛选：同一容器内放切换按钮与 Popup，避免弹层内点击冒泡到按钮 -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource WidgetCaptionDropdown}"
                                  ToolTip="{Binding [periodic_table_field_geochem_class], Source={x:Static lg:LanguageService.Instance}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [periodic_table_field_geochem_class], Source={x:Static lg:LanguageService.Instance}}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Popup Placement="Bottom" VerticalOffset="6" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade"
                           IsOpen="{Binding Children[0].IsChecked, RelativeSource={RelativeSource AncestorType=Grid}, Mode=TwoWay}">
                        <Border Margin="10" Padding="12,12,6,4" Background="White" BorderBrush="#E2E8F0"
                                BorderThickness="1" CornerRadius="10" MaxWidth="420">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="#0F172A"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Style="{StaticResource WidgetCaptionLabel}" Margin="2,0,0,8"
                                           Text="{Binding [periodic_table_field_geochem_class], Source={x:Static lg:LanguageService.Instance}}"/>
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Content="{Binding Title}"
                                                          Style="{StaticResource PeriodicTableFilterChipStyle}"
                                                          IsChecked="{Binding IsActive, Mode=OneWay}"
                                                          Command="{Binding PlacementTarget.DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                          CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Button Grid.Column="1"
                        Style="{StaticResource WidgetCaptionAction}"
                        Content="{Binding [periodic_table_clear_group], Source={x:Static lg:LanguageService.Instance}}"
                        Command="{Binding ClearGroupCommand}"/>
                <Border Grid.Column="2" Style="{StaticResource WidgetCaptionDivider}"/>
                <uc:SearchBox Grid.Column="3" Height="30" Margin="0,0,6,0" VerticalAlignment="Center"
                              FontSize="12.5" IconFontSize="12" Padding="10,0,8,0" CornerRadius="5"
                              Background="White" BorderBrush="#DDE3EB"
                              FocusBorderBrush="{DynamicResource ThemeAccentBrush}"
                              ShowClearButton="True"
                              Placeholder="{Binding [periodic_table_search_tooltip], Source={x:Static lg:LanguageService.Instance}}"
                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <uc:SearchBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding FindNextFromSearchCommand}"/>
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
                    </uc:SearchBox.InputBindings>
                </uc:SearchBox>
                <Button Grid.Column="4"
                        Style="{StaticResource WidgetCaptionPrimary}"
                        Margin="0"
                        Content="{Binding [periodic_table_search_go], Source={x:Static lg:LanguageService.Instance}}"
                        Command="{Binding FindNextFromSearchCommand}"/>
            </Grid>

            <!-- 周期表 -->
            <Border Background="White"
                    BorderBrush="#E5E5EA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8,10,10,6"
                    ClipToBounds="False">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding AbundanceSourceText}"
                               Margin="2,5,0,0"
                               FontSize="11"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"/>

                    <!-- 表格区域：元素网格 + 悬浮标注（不占列宽）。
                         高度按宽度等比换算：18 列 × 9 行（含 f 区）且单元格高:宽 ≈ 1.1，使元素近似正方形、略微竖长 -->
                    <Grid ClipToBounds="False"
                          VerticalAlignment="Top"
                          Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthToAspectHeightConverter}, ConverterParameter='0.55,6'}">
                        <ItemsControl ClipToBounds="False"
                                      ItemsSource="{Binding Elements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Grid.Row" Value="{Binding DisplayRow}"/>
                                    <Setter Property="Grid.Column" Value="{Binding DisplayColumn}"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectElementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            ToolTip="{Binding Name}"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CellBorder"
                                                        Background="{Binding BackgroundBrush}"
                                                        BorderBrush="{Binding BorderBrush}"
                                                        BorderThickness="{Binding BorderThickness}"
                                                        CornerRadius="5"
                                                        SnapsToDevicePixels="True"
                                                        Padding="4,3"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.08" Color="#0F172A"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding AtomicNumberText}"
                                                                   FontSize="9"
                                                                   Foreground="{Binding ForegroundBrush}"
                                                                   Opacity="0.72"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Symbol}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding ForegroundBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CellBorder" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.16" Color="{DynamicResource ThemeAccentColor}"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 悬浮在 f 区左侧空白处，不参与表格列布局 -->
                        <Grid IsHitTestVisible="False"
                              HorizontalAlignment="Left"
                              Margin="2,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="8"
                                       Text="{Binding [periodic_table_label_lanthanides], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="9"
                                       Text="{Binding [periodic_table_label_actinides], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
            </StackPanel>

            <!-- 详情面板：高度与左列（工具栏 + 周期表）保持一致 -->
            <Border Grid.Column="2"
                    VerticalAlignment="Top"
                    Height="{Binding ActualHeight, ElementName=PeriodicTableColumn}"
                    Background="White"
                    BorderBrush="#E5E5EA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#F8FAFC"
                            BorderBrush="#E5E5EA"
                            BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DetailTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DetailSubtitle}"
                                       Margin="12,0,0,0"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,14">
                        <StackPanel>
                            <TextBlock Text="{Binding [periodic_table_section_basic], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableSectionTitleStyle}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding [periodic_table_field_z], Source={x:Static lg:LanguageService.Instance}}"
                                           Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{Binding [periodic_table_field_econf], Source={x:Static lg:LanguageService.Instance}}"
                                           Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding AtomicNumberText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"/>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding ElectronicConfigurationText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <TextBlock Text="{Binding [periodic_table_field_weight], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource PeriodicTableGhostButtonStyle}"
                                        MinHeight="28"
                                        Padding="10,3"
                                        Margin="8,0,0,0"
                                        Content="{Binding [periodic_table_copy], Source={x:Static lg:LanguageService.Instance}}"
                                        Command="{Binding CopyAtomicWeightCommand}"/>
                                <TextBlock Text="{Binding AtomicWeightText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <Border Height="1" Background="#EEF2F7" Margin="0,2,0,12"/>

                            <TextBlock Text="{Binding [periodic_table_section_geochem], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableSectionTitleStyle}"/>

                            <TextBlock Text="{Binding [periodic_table_field_abundance], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                            <TextBlock Text="{Binding AbundanceCrustText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding [periodic_table_field_oxstates], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                            <TextBlock Text="{Binding OxidationStatesText}"
                                       Style="{StaticResource PeriodicTableFieldValueStyle}"/>

                            <Border Height="1" Background="#EEF2F7" Margin="0,2,0,12"/>

                            <TextBlock Text="{Binding [periodic_table_section_oxides], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableSectionTitleStyle}"/>
                            <TextBlock Text="{Binding [periodic_table_oxides_hint], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding Oxides}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC"
                                                BorderBrush="#E5E5EA"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,8">
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PeriodicTableGhostButtonStyle}"
                                                            MinHeight="26"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Content="{Binding [periodic_table_copy_mw], Source={x:Static lg:LanguageService.Instance}}"
                                                            Command="{Binding DataContext.CopyOxideWeightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource PeriodicTableGhostButtonStyle}"
                                                            MinHeight="26"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Margin="4,0,0,0"
                                                            Content="{Binding [periodic_table_copy], Source={x:Static lg:LanguageService.Instance}}"
                                                            Command="{Binding DataContext.CopyOxideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Formula}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding MolecularWeightDisplay}"
                                                               FontSize="11"
                                                               Foreground="#64748B"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding [periodic_table_no_oxides], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="11"
                                       Foreground="#94A3B8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Oxides.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
