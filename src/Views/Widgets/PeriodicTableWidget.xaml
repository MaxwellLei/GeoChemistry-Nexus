<UserControl x:Class="GeoChemistryNexus.Views.Widgets.PeriodicTableWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             Background="#F4F6F8"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 分组、清除与搜索工具栏 -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8,10,0"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Title}"
                                          Style="{StaticResource PeriodicTableFilterChipStyle}"
                                          IsChecked="{Binding IsActive, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="8,0,0,8"
                        Style="{StaticResource PeriodicTableGhostButtonStyle}"
                        Content="{Binding [periodic_table_clear_group], Source={x:Static lg:LanguageService.Instance}}"
                        Command="{Binding ClearGroupCommand}"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="8,0,0,8">
                    <TextBox Width="100"
                             Style="{StaticResource PeriodicTableSearchBoxStyle}"
                             Padding="2,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding [periodic_table_search_tooltip], Source={x:Static lg:LanguageService.Instance}}"/>
                    <Button Margin="6,0,0,0"
                            Style="{StaticResource PeriodicTablePrimaryButtonStyle}"
                            Content="{Binding [periodic_table_search_go], Source={x:Static lg:LanguageService.Instance}}"
                            Command="{Binding FindNextFromSearchCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="680"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- 周期表 -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8,10,10,6"
                    ClipToBounds="False">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding AbundanceSourceText}"
                               Margin="2,5,0,0"
                               FontSize="11"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"/>

                    <!-- 表格区域：元素网格 + 悬浮标注（不占列宽） -->
                    <Grid ClipToBounds="False">
                        <ItemsControl ClipToBounds="False"
                                      ItemsSource="{Binding Elements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" MinHeight="50"/>
                                            <RowDefinition Height="*" MinHeight="50"/>
                                            <RowDefinition Height="*" MinHeight="50"/>
                                            <RowDefinition Height="*" MinHeight="50"/>
                                            <RowDefinition Height="*" MinHeight="50"/>
                                            <RowDefinition Height="*" MinHeight="50"/>
                                            <RowDefinition Height="*" MinHeight="50"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="*" MinHeight="50"/>
                                            <RowDefinition Height="*" MinHeight="50"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Grid.Row" Value="{Binding DisplayRow}"/>
                                    <Setter Property="Grid.Column" Value="{Binding DisplayColumn}"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectElementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            ToolTip="{Binding Name}"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            MinHeight="46"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CellBorder"
                                                        Background="{Binding BackgroundBrush}"
                                                        BorderBrush="{Binding BorderBrush}"
                                                        BorderThickness="{Binding BorderThickness}"
                                                        CornerRadius="5"
                                                        SnapsToDevicePixels="True"
                                                        Padding="4,3"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.08" Color="#0F172A"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding AtomicNumberText}"
                                                                   FontSize="9"
                                                                   Foreground="{Binding ForegroundBrush}"
                                                                   Opacity="0.72"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Symbol}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding ForegroundBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CellBorder" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.16" Color="#0078D4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 悬浮在 f 区左侧空白处，不参与表格列布局 -->
                        <Grid IsHitTestVisible="False"
                              HorizontalAlignment="Left"
                              Margin="2,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="50"/>
                                <RowDefinition Height="*" MinHeight="50"/>
                                <RowDefinition Height="*" MinHeight="50"/>
                                <RowDefinition Height="*" MinHeight="50"/>
                                <RowDefinition Height="*" MinHeight="50"/>
                                <RowDefinition Height="*" MinHeight="50"/>
                                <RowDefinition Height="*" MinHeight="50"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*" MinHeight="50"/>
                                <RowDefinition Height="*" MinHeight="50"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="8"
                                       Text="{Binding [periodic_table_label_lanthanides], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="9"
                                       Text="{Binding [periodic_table_label_actinides], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 详情面板 -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DetailTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DetailSubtitle}"
                                       Margin="12,0,0,0"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,14">
                        <StackPanel>
                            <TextBlock Text="{Binding [periodic_table_section_basic], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableSectionTitleStyle}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding [periodic_table_field_z], Source={x:Static lg:LanguageService.Instance}}"
                                           Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{Binding [periodic_table_field_econf], Source={x:Static lg:LanguageService.Instance}}"
                                           Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding AtomicNumberText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"/>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding ElectronicConfigurationText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <TextBlock Text="{Binding [periodic_table_field_weight], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource PeriodicTableGhostButtonStyle}"
                                        MinHeight="28"
                                        Padding="10,3"
                                        Margin="8,0,0,0"
                                        Content="{Binding [periodic_table_copy], Source={x:Static lg:LanguageService.Instance}}"
                                        Command="{Binding CopyAtomicWeightCommand}"/>
                                <TextBlock Text="{Binding AtomicWeightText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <Border Height="1" Background="#EEF2F7" Margin="0,2,0,12"/>

                            <TextBlock Text="{Binding [periodic_table_section_geochem], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableSectionTitleStyle}"/>

                            <TextBlock Text="{Binding [periodic_table_field_abundance], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                            <TextBlock Text="{Binding AbundanceCrustText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding [periodic_table_field_goldschmidt], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                            <TextBlock Text="{Binding GoldschmidtText}"
                                       Style="{StaticResource PeriodicTableFieldValueStyle}"/>

                            <TextBlock Text="{Binding [periodic_table_field_geochem_class], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                            <TextBlock Text="{Binding GeochemicalClassText}"
                                       Style="{StaticResource PeriodicTableFieldValueStyle}"/>

                            <TextBlock Text="{Binding [periodic_table_field_oxstates], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableFieldLabelStyle}"/>
                            <TextBlock Text="{Binding OxidationStatesText}"
                                       Style="{StaticResource PeriodicTableFieldValueStyle}"/>

                            <Border Height="1" Background="#EEF2F7" Margin="0,2,0,12"/>

                            <TextBlock Text="{Binding [periodic_table_section_oxides], Source={x:Static lg:LanguageService.Instance}}"
                                       Style="{StaticResource PeriodicTableSectionTitleStyle}"/>
                            <TextBlock Text="{Binding [periodic_table_oxides_hint], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding Oxides}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,8">
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PeriodicTableGhostButtonStyle}"
                                                            MinHeight="26"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Content="{Binding [periodic_table_copy_mw], Source={x:Static lg:LanguageService.Instance}}"
                                                            Command="{Binding DataContext.CopyOxideWeightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource PeriodicTableGhostButtonStyle}"
                                                            MinHeight="26"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Margin="4,0,0,0"
                                                            Content="{Binding [periodic_table_copy], Source={x:Static lg:LanguageService.Instance}}"
                                                            Command="{Binding DataContext.CopyOxideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Formula}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding MolecularWeightDisplay}"
                                                               FontSize="11"
                                                               Foreground="#64748B"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding [periodic_table_no_oxides], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="11"
                                       Foreground="#94A3B8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Oxides.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
