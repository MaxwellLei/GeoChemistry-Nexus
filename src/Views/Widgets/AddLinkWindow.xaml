<Window x:Class="GeoChemistryNexus.Views.Widgets.AddLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
        xmlns:controls="clr-namespace:GeoChemistryNexus.Controls"
        mc:Ignorable="d"
        Title="{Binding [add_link],Source={x:Static lg:LanguageService.Instance}}"
        Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Foreground="#1E293B"
        TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}">

    <!-- 无边框窗口：顶部 20 + 标题区 60 为可拖动区域；四周留白用来呈现阴影 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="80" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid Margin="26,20,26,34">
        <!-- 阴影层：不包裹任何内容 -->
        <Border Style="{StaticResource DialogShadowStyle}"/>

        <!-- 内容层：圆角卡片 -->
        <Border Style="{StaticResource DialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题区 -->
                <Grid Grid.Row="0" Height="60" Margin="24,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0"
                            Background="{DynamicResource ThemeAccentSoftBrush}">
                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource ThemeAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource DialogTitleStyle}"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Grid.Column="2" Style="{StaticResource DialogCloseButtonStyle}"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            ToolTip="{Binding [close],Source={x:Static lg:LanguageService.Instance}}"/>
                </Grid>

                <!-- 表单 -->
                <StackPanel Grid.Row="1" Margin="24,2,24,22">
                    <!-- 名称（必填） -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Margin="2,0,0,0"
                                   Text="{Binding [name],Source={x:Static lg:LanguageService.Instance}}"/>
                        <TextBlock Text="*" Foreground="#EF4444" Margin="3,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="TitleBox" Style="{StaticResource DialogTextBoxStyle}" Margin="0,0,0,16"/>

                    <!-- 链接（必填） -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource DialogFieldLabelStyle}" Margin="2,0,0,0"
                                   Text="{Binding [link_url],Source={x:Static lg:LanguageService.Instance}}"/>
                        <TextBlock Text="*" Foreground="#EF4444" Margin="3,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="UrlBox" Style="{StaticResource DialogTextBoxStyle}" Margin="0,0,0,16"/>

                    <TextBlock Style="{StaticResource DialogFieldLabelStyle}"
                               Text="{Binding [description],Source={x:Static lg:LanguageService.Instance}}"/>
                    <TextBox x:Name="DescBox" Style="{StaticResource DialogTextBoxStyle}" Margin="0,0,0,16"/>

                    <TextBlock Style="{StaticResource DialogFieldLabelStyle}"
                               Text="{Binding [icon],Source={x:Static lg:LanguageService.Instance}}"/>
                    <ComboBox x:Name="IconBox" Style="{StaticResource DialogComboBoxStyle}" Margin="0,0,0,16" SelectedValuePath="Code">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Code}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Style="{StaticResource DialogFieldLabelStyle}"
                               Text="{Binding [home_icon_url],Source={x:Static lg:LanguageService.Instance}}"/>
                    <TextBox x:Name="IconUrlBox" Style="{StaticResource DialogTextBoxStyle}"
                             controls:ControlAssist.Placeholder="{Binding [home_icon_url_hint],Source={x:Static lg:LanguageService.Instance}}"/>
                </StackPanel>

                <!-- 操作区 -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#EDF1F6" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,15,15" Padding="24,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource DialogButtonStyle}" Margin="0,0,10,0" IsCancel="True"
                                Content="{Binding [Cancel],Source={x:Static lg:LanguageService.Instance}}"/>
                        <Button Style="{StaticResource DialogPrimaryButtonStyle}" IsDefault="True"
                                Click="Ok_Click"
                                Content="{Binding [Confirm],Source={x:Static lg:LanguageService.Instance}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 本窗口独立的通知中心 -->
        <controls:NotificationHost Panel.ZIndex="1000"
                                   VerticalAlignment="Stretch" HorizontalAlignment="Right"
                                   Margin="0,68,12,12"
                                   Center="{Binding Notifications, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
</Window>
