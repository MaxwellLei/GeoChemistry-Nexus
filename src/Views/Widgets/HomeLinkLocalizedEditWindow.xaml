<widgets:WidgetWindow x:Class="GeoChemistryNexus.Views.Widgets.HomeLinkLocalizedEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
        xmlns:controls="clr-namespace:GeoChemistryNexus.Controls"
        xmlns:widgets="clr-namespace:GeoChemistryNexus.Views.Widgets"
        mc:Ignorable="d"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F5F7FA" WidgetIcon="&#xE774;">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoChemistryNexus;component/Themes/WidgetStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource WidgetFieldLabel}">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 标题栏：确认（取消即关闭窗口） -->
    <widgets:WidgetWindow.CaptionContent>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource WidgetCaptionPrimary}" Margin="0" IsDefault="True"
                    Click="Ok_Click"
                    Content="{Binding [Confirm],Source={x:Static lg:LanguageService.Instance}}"/>
        </StackPanel>
    </widgets:WidgetWindow.CaptionContent>
    <Grid>
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 编辑语言 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource WidgetFieldLabel}" Margin="0,0,10,0"
                           Text="{Binding [home_links_edit_language], Source={x:Static lg:LanguageService.Instance}, FallbackValue=Editing language:}"/>
                <ComboBox x:Name="LanguageBox" Width="200" HorizontalAlignment="Left"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Code"
                          SelectionChanged="LanguageBox_SelectionChanged"/>
            </DockPanel>

            <!-- 表单卡片 -->
            <Border Grid.Row="1" Style="{StaticResource WidgetCard}" Padding="18,16,18,6" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding [name], Source={x:Static lg:LanguageService.Instance}}"/>
                    <controls:LocalizedStringControl x:Name="TitleControl" Margin="0,0,0,14" MinHeight="32"
                                                     ContentLanguageContext="{Binding LanguageContext, RelativeSource={RelativeSource AncestorType=Window}}"/>

                    <TextBlock x:Name="DescriptionLabel" Style="{StaticResource FormLabel}"
                               Text="{Binding [description], Source={x:Static lg:LanguageService.Instance}}"/>
                    <controls:LocalizedStringControl x:Name="DescriptionControl" Margin="0,0,0,14" MinHeight="48"
                                                     ContentLanguageContext="{Binding LanguageContext, RelativeSource={RelativeSource AncestorType=Window}}"/>

                    <!-- 以下字段仅链接模式显示；整体由各控件的 Visibility 控制 -->
                    <StackPanel x:Name="LinkOnlyPanel">
                        <TextBlock Style="{StaticResource FormLabel}"
                                   Text="{Binding [link_url], Source={x:Static lg:LanguageService.Instance}}"/>
                        <TextBox x:Name="UrlBox" Margin="0,0,0,14"/>

                        <TextBlock Style="{StaticResource FormLabel}"
                                   Text="{Binding [icon], Source={x:Static lg:LanguageService.Instance}}"/>
                        <ComboBox x:Name="IconBox" Margin="0,0,0,14" SelectedValuePath="Code">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Code}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Style="{StaticResource FormLabel}"
                                   Text="{Binding [home_icon_url], Source={x:Static lg:LanguageService.Instance}}"/>
                        <TextBox x:Name="IconUrlBox" Margin="0,0,0,10"
                                 controls:ControlAssist.Placeholder="{Binding [home_icon_url_hint], Source={x:Static lg:LanguageService.Instance}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            
        </Grid>

        <!-- 本窗口独立的通知中心 -->
        <controls:NotificationHost Panel.ZIndex="1000"
                                   VerticalAlignment="Stretch" HorizontalAlignment="Right"
                                   Margin="0,8,0,16"
                                   Center="{Binding Notifications, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
</widgets:WidgetWindow>
