<UserControl x:Class="GeoChemistryNexus.Views.Widgets.OxideElementConverterWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:vm="clr-namespace:GeoChemistryNexus.ViewModels"
             xmlns:svc="clr-namespace:GeoChemistryNexus.Services"
             xmlns:widgets="clr-namespace:GeoChemistryNexus.Views.Widgets"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance Type=vm:OxideElementConverterViewModel, IsDesignTimeCreatable=False}"
             Background="#F5F7FA">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoChemistryNexus;component/Themes/WidgetStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 标题栏：换算方向与重置 -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="widgets:WidgetWindow.CaptionContent">
                <Setter.Value>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <RadioButton Style="{StaticResource WidgetCaptionRadio}" GroupName="ConvMode"
                         Content="{Binding [oxide_element_conv_mode_elem_to_oxide], Source={x:Static lg:LanguageService.Instance}}"
                         IsChecked="{Binding IsElemToOxide, Mode=TwoWay}"/>
            <RadioButton Style="{StaticResource WidgetCaptionRadio}" GroupName="ConvMode"
                         Content="{Binding [oxide_element_conv_mode_oxide_to_elem], Source={x:Static lg:LanguageService.Instance}}"
                         IsChecked="{Binding IsOxideToElem, Mode=TwoWay}"/>
            <Border Style="{StaticResource WidgetCaptionDivider}"/>
            <Button Style="{StaticResource WidgetCaptionAction}"
                    Content="{Binding [oxide_element_conv_reset], Source={x:Static lg:LanguageService.Instance}}"
                    Command="{Binding ResetCommand}"/>
        </StackPanel>
                    </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Style>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <TextBlock Text="{Binding [oxide_element_converter_hint], Source={x:Static lg:LanguageService.Instance}}"
                       Style="{StaticResource WidgetHint}"
                       Margin="0,0,0,16"/>

            <!-- ===== 换算卡片 ===== -->
            <Border Style="{StaticResource WidgetCard}" Padding="16">
                <StackPanel>

                    <!-- 条目选择 + 输入值 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 元素/氧化物下拉 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [oxide_element_conv_select_substance], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="12" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Entries}"
                                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayLabel"
                                      Style="{StaticResource WidgetCombo}"
                                      ctrl:ControlAssist.Placeholder="Si / SiO₂"/>
                        </StackPanel>

                        <!-- 输入值 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding InputLabel}"
                                       FontSize="12" Margin="0,0,0,6"
                                       FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}"/>
                            <ctrl:NumericUpDown Value="{Binding InputValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource WidgetNumber}"
                                              Minimum="0" Increment="0.01" DecimalPlaces="4"/>
                        </StackPanel>

                        <!-- 单位切换 -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="wt%"
                                         IsChecked="{Binding IsWtPercent, Mode=TwoWay}"
                                         GroupName="UnitMode"
                                         VerticalContentAlignment="Center"/>
                            <RadioButton Content="ppm"
                                         IsChecked="{Binding IsPpm, Mode=TwoWay}"
                                         GroupName="UnitMode"
                                         VerticalContentAlignment="Center"
                                         Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 换算结果区 -->
                    <Border Margin="0,16,0,0" CornerRadius="8" Padding="16,12"
                            Background="{DynamicResource ThemeAccentSoftBrush}" BorderBrush="{DynamicResource ThemeAccentSoftBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [oxide_element_conv_result_label], Source={x:Static lg:LanguageService.Instance}}"
                                           FontSize="11" Foreground="#5B9BD5" Margin="0,0,0,2"/>
                                <!-- 结果数值 -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ResultText}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                               Visibility="{Binding IsResultValid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding ResultText}"
                                               FontSize="15" Foreground="#E53935"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               Visibility="{Binding IsResultValid, Converter={StaticResource BooleanToVisibilityReConverter}}"/>
                                    <TextBlock Text="{Binding UnitLabel}"
                                               FontSize="15" Foreground="#5B9BD5"
                                               VerticalAlignment="Bottom" Margin="6,0,0,4"
                                               Visibility="{Binding IsResultValid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FormulaText}"
                                           FontSize="12" Foreground="#555"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsResultValid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- 右侧详情列 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"
                                        Visibility="{Binding IsResultValid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- 因子 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [oxide_element_conv_factor_label], Source={x:Static lg:LanguageService.Instance}}"
                                               FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FactorText}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#263549"/>
                                </Grid>
                                <!-- 原子量 -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [oxide_element_conv_mw_elem], Source={x:Static lg:LanguageService.Instance}}"
                                               FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AtomicWeightText}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#263549"/>
                                </Grid>
                                <!-- 氧化物分子量 -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [oxide_element_conv_mw_oxide], Source={x:Static lg:LanguageService.Instance}}"
                                               FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding OxideMwText}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#263549"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ===== 参考表卡片 ===== -->
            <Border Style="{StaticResource WidgetCard}" Padding="0" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding [oxide_element_conv_reference_title], Source={x:Static lg:LanguageService.Instance}}"
                               FontSize="14" FontWeight="SemiBold" Margin="16,16,16,4"/>
                    <TextBlock Text="{Binding [oxide_element_conv_reference_hint], Source={x:Static lg:LanguageService.Instance}}"
                               Style="{StaticResource WidgetHint}"
                               Margin="16,0,16,12"/>

                    <!-- 表头 -->
                    <Border Background="#F5F7FA" BorderBrush="#E5E5EA" BorderThickness="0,1,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding [oxide_element_conv_col_element], Source={x:Static lg:LanguageService.Instance}}"
                                       FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [oxide_element_conv_col_oxide], Source={x:Static lg:LanguageService.Instance}}"
                                       FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding [oxide_element_conv_mw_elem], Source={x:Static lg:LanguageService.Instance}}"
                                       FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding [oxide_element_conv_col_factor_to_oxide], Source={x:Static lg:LanguageService.Instance}}"
                                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding [oxide_element_conv_col_factor_to_elem], Source={x:Static lg:LanguageService.Instance}}"
                                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- 参考表行列表 -->
                    <ItemsControl ItemsSource="{Binding ReferenceRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EDF1F6" BorderThickness="0,0,0,1" Padding="12,9"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding Entry}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#E8F4FF"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5F9FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ElementSymbol}"
                                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ThemeAccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OxideFormula}"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding AtomicWeightText}"
                                                   FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ToOxideText}"
                                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding ToElemText}"
                                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
