<UserControl x:Class="GeoChemistryNexus.Views.Widgets.ChronostratNavigatorWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:vm="clr-namespace:GeoChemistryNexus.ViewModels.Home"
             xmlns:model="clr-namespace:GeoChemistryNexus.Models.Chronostrat"
             xmlns:conv="clr-namespace:GeoChemistryNexus.Converter"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1060"
             Background="White">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>

        <!-- 年代单元行模板（主导航列表）-->
        <DataTemplate x:Key="UnitRowTemplate" DataType="{x:Type model:ChronostratUnitRecord}">
            <Border Height="44" Margin="0,1,0,0" CornerRadius="6" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0A000000"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid Margin="2,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- IUGS 官方颜色块 -->
                    <Border Grid.Column="0" Width="6" CornerRadius="3"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                            <Run Text=" " FontSize="10"/>
                            <Run Text="{Binding SubDisplayName, Mode=OneWay}" Foreground="#8E8E93" FontSize="11" FontWeight="Normal"/>
                        </TextBlock>
                    </StackPanel>
                    <!-- 底界年龄 -->
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               Foreground="#8E8E93" FontSize="11" Margin="4,0,0,0">
                        <Run Text="{Binding StartMa, Mode=OneTime, StringFormat='{}{0:0.###} Ma'}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 面包屑祖先项模板 -->
        <DataTemplate x:Key="AncestorCrumbTemplate" DataType="{x:Type model:ChronostratUnitRecord}">
            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                <Button Content="{Binding DisplayName}"
                        Padding="6,2"
                        Command="{Binding DataContext.SelectUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource ButtonDefault}"
                        FontSize="11"/>
                <TextBlock Text=" ›" VerticalAlignment="Center" Foreground="#C7C7CC" FontSize="11" Margin="2,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- 子节点按钮模板 -->
        <DataTemplate x:Key="ChildUnitTemplate" DataType="{x:Type model:ChronostratUnitRecord}">
            <Button Margin="0,0,6,6" Padding="10,5" FontSize="12"
                    Command="{Binding DataContext.SelectUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource ButtonDefault}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,6,0"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                    <TextBlock Text="{Binding DisplayName}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- 年龄反查路径项模板 -->
        <DataTemplate x:Key="PathItemTemplate" DataType="{x:Type model:ChronostratUnitRecord}">
            <Border Margin="0,2" Padding="8,4" CornerRadius="6" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F2F2F7"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="6" CornerRadius="3"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                        <Run Text=" " FontSize="10"/>
                        <Run Text="{Binding SubDisplayName, Mode=OneWay}" Foreground="#8E8E93" FontSize="10" FontWeight="Normal"/>
                    </TextBlock>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#8E8E93">
                        <Run Text="{Binding LocalizedRank, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 年代地层折叠树节点模板 -->
        <HierarchicalDataTemplate x:Key="ChronostratTreeNodeTemplate"
                                  DataType="{x:Type vm:ChronostratTreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <Border Height="28" Margin="0,1" CornerRadius="4" Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Unit}"/>
                </Border.InputBindings>
                <Grid Margin="0,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- IUGS 官方色条 -->
                    <Border Grid.Column="0" Width="4" Height="18" CornerRadius="2"
                            Background="{Binding Unit.ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                    <!-- 单元多语言名称与副标名称 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" " FontSize="10"/>
                            <Run Text="{Binding SubDisplayName, Mode=OneWay}" Foreground="#8E8E93" FontSize="10"/>
                        </TextBlock>
                    </StackPanel>
                    <!-- 起始年龄 -->
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#8E8E93" FontSize="10" Margin="4,0,0,0">
                        <Run Text="{Binding Unit.StartMa, Mode=OneWay, StringFormat='{}{0:0.#} Ma'}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>

        <!-- 年代地层树项样式 -->
        <Style x:Key="ChronostratTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1C1C1E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="4,2" 
                                    SnapsToDevicePixels="true">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ExpandCollapseToggleStyle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"/>

                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                      ContentSource="Header"/>
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F007AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════ 顶部工具栏 ══════ -->
        <Border Grid.Row="0" Padding="16,14,16,12" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题与版本说明 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [chronostrat_navigator_widget], Source={x:Static lg:LanguageService.Instance}}"
                               FontSize="15" FontWeight="Bold"/>
                    <TextBlock FontSize="10" Foreground="#8E8E93" Margin="0,2,0,0">
                        <Run Text="ICS · v"/>
                        <Run Text="{Binding SourceVersion, Mode=OneTime}"/>
                    </TextBlock>
                </StackPanel>

                <!-- 年龄反查区（无边框，排在查询框左侧）-->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [chronostrat_age_lookup_label], Source={x:Static lg:LanguageService.Instance}}"
                               VerticalAlignment="Center" FontSize="12" Foreground="#8E8E93" Margin="0,0,6,0"/>
                    <hc:NumericUpDown Value="{Binding AgeLookupMa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ModernNumericUpDownStyle}"
                                      Minimum="0" Maximum="4600" Increment="0.1"
                                      DecimalPlaces="3"
                                      Width="90"
                                      VerticalAlignment="Center"/>
                    <TextBlock Text="Ma" VerticalAlignment="Center" FontSize="12" Foreground="#8E8E93" Margin="4,0,8,0"/>
                    <Button Content="{Binding [chronostrat_lookup_btn], Source={x:Static lg:LanguageService.Instance}}"
                            Command="{Binding LookupAgeCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            Padding="12,3" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 搜索框（查询）-->
                <hc:SearchBar Grid.Column="4"
                              Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              hc:InfoElement.Placeholder="{Binding [chronostrat_search_hint], Source={x:Static lg:LanguageService.Instance}}"
                              VerticalAlignment="Center"/>

                <!-- 重置按钮 -->
                <Button Grid.Column="6"
                        Content="{Binding [chronostrat_reset], Source={x:Static lg:LanguageService.Instance}}"
                        Command="{Binding ResetCommand}"
                        Style="{StaticResource ButtonDefault}"
                        Padding="10,4" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══════ 主体内容区 ══════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左侧导航列表 ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 年龄反查结果横幅 -->
                <Border Grid.Row="0" Margin="12,12,12,0" Padding="10,8" CornerRadius="8" Background="#F0F7FF"
                        Visibility="{Binding HasAgeLookupResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding [chronostrat_age_result_label], Source={x:Static lg:LanguageService.Instance}}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding AgeLookupResultText}"
                                   FontSize="12" TextWrapping="Wrap" Foreground="#1C1C1E"/>
                        <TextBlock Text="{Binding [chronostrat_click_hint], Source={x:Static lg:LanguageService.Instance}}"
                                   FontSize="10" Foreground="#8E8E93" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding AgeLookupPath}"
                                      ItemTemplate="{StaticResource PathItemTemplate}"
                                      Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 搜索结果列表（搜索模式）-->
                <Grid Grid.Row="1" Margin="12,10,12,12"
                      Visibility="{Binding IsInSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="11" Foreground="#8E8E93" Margin="4,0,0,6">
                        <Run Text="{Binding [chronostrat_search_results], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding SearchResults.Count, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SearchResults}"
                                      ItemTemplate="{StaticResource UnitRowTemplate}"/>
                    </ScrollViewer>
                </Grid>

                <!-- 经典层级折叠树（非搜索模式）-->
                <Grid Grid.Row="1" Margin="10,8,10,10"
                      Visibility="{Binding IsInSearchMode, Converter={StaticResource BooleanToVisibilityReConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 树形快捷操作栏 -->
                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [chronostrat_chart_tree_title], Source={x:Static lg:LanguageService.Instance}}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding [chronostrat_expand_period], Source={x:Static lg:LanguageService.Instance}}"
                                    Command="{Binding ExpandToPeriodCommand}"
                                    Style="{StaticResource ButtonDefault}"
                                    Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="{Binding [chronostrat_expand_all], Source={x:Static lg:LanguageService.Instance}}"
                                    Command="{Binding ExpandAllCommand}"
                                    Style="{StaticResource ButtonDefault}"
                                    Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="{Binding [chronostrat_collapse_all], Source={x:Static lg:LanguageService.Instance}}"
                                    Command="{Binding CollapseAllCommand}"
                                    Style="{StaticResource ButtonDefault}"
                                    Padding="6,2" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- 可折叠层级树 -->
                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding RootNodes}"
                              ItemTemplate="{StaticResource ChronostratTreeNodeTemplate}"
                              ItemContainerStyle="{StaticResource ChronostratTreeViewItemStyle}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="OnTreeViewSelectedItemChanged"/>
                </Grid>
            </Grid>

            <!-- 分隔线 -->
            <Border Grid.Column="1" Width="1" Background="#E5E5E5" Margin="0,12"/>

            <!-- ── 右侧详情面板 ── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                <Grid>
                    <!-- 未选中时的空白提示 -->
                    <StackPanel Visibility="{Binding HasSelectedUnit, Converter={StaticResource BooleanToVisibilityReConverter}}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
                        <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                   Foreground="#C7C7CC" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding [chronostrat_select_hint], Source={x:Static lg:LanguageService.Instance}}"
                                   FontSize="14" Foreground="#8E8E93" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="260" TextAlignment="Center"/>
                        <TextBlock FontSize="11" Foreground="#8E8E93" Margin="0,16,0,0" HorizontalAlignment="Center">
                            <Run Text="{Binding [chronostrat_source_label], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Hyperlink Command="{Binding OpenSourceCommand}" Foreground="#0078D4">
                                <Run Text="https://github.com/i-c-stratigraphy/chart"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- 已选中时的详情看板 -->
                    <StackPanel Visibility="{Binding HasSelectedUnit, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <!-- 面包屑祖先路径 -->
                        <ItemsControl ItemsSource="{Binding Ancestors}"
                                      ItemTemplate="{StaticResource AncestorCrumbTemplate}"
                                      Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- ❶ 彩色标头卡片 -->
                        <Border CornerRadius="12" Margin="0,0,0,14" Padding="18,14"
                                Background="{Binding SelectedColorHex, Converter={StaticResource HexToBrushConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Rank 徽章 -->
                                <Border Grid.Row="0" HorizontalAlignment="Left" Padding="8,3" CornerRadius="6" Margin="0,0,0,6"
                                        Background="#40FFFFFF">
                                    <TextBlock Text="{Binding SelectedUnitRankDisplayName}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <!-- 多语言名称与年代地层名称 -->
                                <TextBlock Grid.Row="1" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap">
                                    <Run Text="{Binding SelectedUnitDisplayName, Mode=OneWay}"/>
                                    <Run Text="  " FontSize="14"/>
                                    <Run Text="{Binding SelectedUnitStratDisplayName, Mode=OneWay}" FontSize="14" FontWeight="Normal"/>
                                </TextBlock>
                                <!-- 副标名称（国际通用名） -->
                                <TextBlock Grid.Row="2" FontSize="14" Foreground="#D0FFFFFF" Margin="0,4,0,0"
                                           Text="{Binding SelectedUnitSubDisplayName}"/>
                            </Grid>
                        </Border>

                        <!-- ❷ 年代界线信息卡 -->
                        <Border Style="{StaticResource ModernCardStyle}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding [chronostrat_boundary_label], Source={x:Static lg:LanguageService.Instance}}"
                                           Style="{StaticResource ModernGroupTitleStyle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 底界 -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [chronostrat_start_label], Source={x:Static lg:LanguageService.Instance}}"
                                                   FontSize="11" Foreground="#8E8E93" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="18" FontWeight="Bold">
                                            <Run Text="{Binding SelectedUnit.StartMa, Mode=OneWay, StringFormat='{}{0:0.###}'}"/>
                                            <Run Text=" Ma" FontSize="13" FontWeight="Normal" Foreground="#8E8E93"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#FF9500" FontSize="11"
                                                   Visibility="{Binding SelectedUnit.HasStartError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Run Text="± "/>
                                            <Run Text="{Binding SelectedUnit.StartError, Mode=OneWay, StringFormat='{}{0:0.###}'}"/>
                                            <Run Text=" Ma"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 中间箭头 -->
                                    <TextBlock Grid.Column="2" Text="→" FontSize="18" Foreground="#C7C7CC"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <!-- 顶界 -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{Binding [chronostrat_end_label], Source={x:Static lg:LanguageService.Instance}}"
                                                   FontSize="11" Foreground="#8E8E93" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="18" FontWeight="Bold">
                                            <Run Text="{Binding SelectedUnit.EndMa, Mode=OneWay, StringFormat='{}{0:0.###}'}"/>
                                            <Run Text=" Ma" FontSize="13" FontWeight="Normal" Foreground="#8E8E93"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#FF9500" FontSize="11"
                                                   Visibility="{Binding SelectedUnit.HasEndError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Run Text="± "/>
                                            <Run Text="{Binding SelectedUnit.EndError, Mode=OneWay, StringFormat='{}{0:0.###}'}"/>
                                            <Run Text=" Ma"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <!-- 时间跨度 -->
                                <Border Margin="0,12,0,0" Padding="8,6" CornerRadius="6" Background="#F2F2F7">
                                    <TextBlock FontSize="12" HorizontalAlignment="Center">
                                        <Run Text="{Binding [chronostrat_duration_label], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"
                                             Foreground="#8E8E93"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding SelectedUnit.DurationMa, Mode=OneWay, StringFormat='{}{0:0.##}'}" FontWeight="SemiBold"/>
                                        <Run Text=" Ma" Foreground="#8E8E93"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ❸ GSSP 认证状态（有徽章时才显示）-->
                        <Border Padding="16">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ModernCardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoundaryBadgeText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE734;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="#FF9F0A"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="13" FontWeight="SemiBold">
                                        <Run Text="{Binding BoundaryBadgeText, Mode=OneWay}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding [chronostrat_gssp_ratified], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding [chronostrat_gssp_desc], Source={x:Static lg:LanguageService.Instance}}"
                                               Style="{StaticResource ModernSettingsItemHintStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- ❹ IUGS 官方色标卡 -->
                        <Border Style="{StaticResource ModernCardStyle}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding [chronostrat_color_label], Source={x:Static lg:LanguageService.Instance}}"
                                           Style="{StaticResource ModernGroupTitleStyle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 色块预览 -->
                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="8"
                                            Background="{Binding SelectedColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                    <!-- HEX 与 RGB -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding SelectedColorHex}"
                                                       FontSize="15" FontWeight="SemiBold" FontFamily="Consolas"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="{Binding [chronostrat_copy_hex], Source={x:Static lg:LanguageService.Instance}}"
                                                    Command="{Binding CopyHexCommand}"
                                                    Style="{StaticResource ButtonDefault}"
                                                    Padding="8,3" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedColorRgbText}"
                                                       FontSize="13" Foreground="#8E8E93" FontFamily="Consolas"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="{Binding [chronostrat_copy_rgb], Source={x:Static lg:LanguageService.Instance}}"
                                                    Command="{Binding CopyRgbCommand}"
                                                    Style="{StaticResource ButtonDefault}"
                                                    Padding="8,3" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ❺ 复制引用 -->
                        <Border Style="{StaticResource ModernCardStyle}" Padding="16">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding [chronostrat_copy_citation], Source={x:Static lg:LanguageService.Instance}}"
                                        Command="{Binding CopyCitationCommand}"
                                        Style="{StaticResource ButtonDefault}"
                                        Padding="12,5" FontSize="12"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [chronostrat_citation_label], Source={x:Static lg:LanguageService.Instance}}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" Margin="0,0,0,3"/>
                                    <TextBlock FontSize="12" Foreground="#3C3C43" TextWrapping="Wrap">
                                        <Run Text="{Binding SelectedUnit.NameEn, Mode=OneWay}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding SelectedUnit.RankRaw, Mode=OneWay}"/>
                                        <Run Text="): "/>
                                        <Run Text="{Binding SelectedUnit.StartMa, Mode=OneWay, StringFormat='{}{0:0.###} Ma'}"/>
                                        <Run Text=" – "/>
                                        <Run Text="{Binding SelectedUnit.EndMa, Mode=OneWay, StringFormat='{}{0:0.###} Ma'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- ❻ 子单元快速跳转 -->
                        <Border Padding="16">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ModernCardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding [chronostrat_children_label], Source={x:Static lg:LanguageService.Instance}}"
                                           Style="{StaticResource ModernGroupTitleStyle}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Children}"
                                              ItemTemplate="{StaticResource ChildUnitTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ❼ 数据来源脚注与开源地址 -->
                        <StackPanel Margin="0,4,0,16">
                            <TextBlock FontSize="10" Foreground="#8E8E93" TextWrapping="Wrap"
                                       Text="{Binding SourceCitation, Mode=OneTime}"/>
                            <TextBlock FontSize="10" Foreground="#8E8E93" Margin="0,4,0,0">
                                <Run Text="{Binding [chronostrat_source_label], Source={x:Static lg:LanguageService.Instance}, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Hyperlink Command="{Binding OpenSourceCommand}" Foreground="#0078D4">
                                    <Run Text="https://github.com/i-c-stratigraphy/chart"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
