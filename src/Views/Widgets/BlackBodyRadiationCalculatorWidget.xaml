<UserControl x:Class="GeoChemistryNexus.Views.Widgets.BlackBodyRadiationCalculatorWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GeoChemistryNexus.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
             xmlns:widgets="clr-namespace:GeoChemistryNexus.Views.Widgets"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="900"
             Background="#F5F7FA"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeoChemistryNexus;component/Themes/WidgetStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 标题栏：来源与重置 -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="widgets:WidgetWindow.CaptionContent">
                <Setter.Value>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource WidgetCaptionAction}"
                    Content="{Binding [black_body_radiation_calc_reset], Source={x:Static lg:LanguageService.Instance}}"
                    Command="{Binding ResetCommand}"/>
        </StackPanel>
                    </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Style>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*" MinHeight="260"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 整体左右：左=温度+定律，右=光谱 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：上温度，下辐射定律 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource WidgetCard}" Padding="16" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{Binding [black_body_radiation_calc_input], Source={x:Static lg:LanguageService.Instance}}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ctrl:NumericUpDown Grid.Column="0"
                                              Value="{Binding TemperatureKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource WidgetNumber}"
                                              Minimum="1" Maximum="100000" Increment="100"
                                              VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="K"
                                       Style="{StaticResource WidgetHint}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource WidgetCard}" Padding="16" Margin="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding [black_body_radiation_calc_laws], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="13"
                                       Foreground="#C42B1C"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="{Binding [black_body_radiation_calc_stefan_title], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StefanBoltzmannText}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="{Binding [black_body_radiation_calc_wien_title], Source={x:Static lg:LanguageService.Instance}}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding WienText}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding SpectrumPeakText}"
                                       Style="{StaticResource WidgetHint}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 右侧：黑体光谱 -->
            <Border Grid.Column="2" Style="{StaticResource WidgetCard}" Padding="16" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding [black_body_radiation_calc_spectrum], Source={x:Static lg:LanguageService.Instance}}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding [black_body_radiation_calc_spectrum_hint], Source={x:Static lg:LanguageService.Instance}}"
                                   Style="{StaticResource WidgetHint}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="#EDF1F6" BorderThickness="1" CornerRadius="8">
                        <ScottPlot:WpfPlot x:Name="SpectrumPlot"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部：来源 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Binding [black_body_radiation_calc_source_label], Source={x:Static lg:LanguageService.Instance}}"
                       Style="{StaticResource WidgetHint}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource ThemeLinkButtonStyle}" VerticalAlignment="Center"
                    Content="{Binding [black_body_radiation_calc_source_link], Source={x:Static lg:LanguageService.Instance}}"
                    Command="{Binding OpenSourceCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
