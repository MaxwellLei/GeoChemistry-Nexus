<widgets:WidgetWindow x:Class="GeoChemistryNexus.Views.OfficialTemplatePublisherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:GeoChemistryNexus.Controls"
        xmlns:widgets="clr-namespace:GeoChemistryNexus.Views.Widgets"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Height="780" Width="1180"
        MinHeight="640" MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        WidgetIcon="&#xE898;"
        Background="#F5F7FA">

    <Grid>
        <widgets:OfficialTemplatePublisherWidget x:Name="PublisherWidget"/>

        <controls:NotificationHost VerticalAlignment="Stretch" HorizontalAlignment="Right"
                                   Margin="0,52,0,16"
                                   Center="{Binding Notifications, ElementName=RootWindow}"/>
    </Grid>
</widgets:WidgetWindow>
