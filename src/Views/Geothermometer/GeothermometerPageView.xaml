<Page x:Class="GeoChemistryNexus.Views.GeothermometerPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:rg="clr-namespace:unvell.ReoGrid;assembly=unvell.ReoGrid"
      xmlns:local="clr-namespace:GeoChemistryNexus.Views"
      xmlns:uc="clr-namespace:GeoChemistryNexus.Controls"
      xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
      xmlns:hp="clr-namespace:GeoChemistryNexus.Helpers"
      xmlns:models="clr-namespace:GeoChemistryNexus.Models"
      xmlns:vm="clr-namespace:GeoChemistryNexus.ViewModels"
      xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1100"
      Title="GeothermometerPageView"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}">

    <Page.Resources>
        <FontFamily x:Key="IconFont">pack://application:,,,/Data/Icon/#iconfont</FontFamily>
        <cvs:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <cvs:BoolToVisibilityReConverter x:Key="BoolToVisibilityReConverter"/>
        <cvs:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <cvs:GeoTPluginSelectedMultiConverter x:Key="GeoTPluginSelectedMultiConverter"/>
        <hp:BindingProxy x:Key="GridProxy" Data="{Binding ElementName=MyReoGrid}" />
        <hp:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

        <!-- 计算顶栏按钮与 EPMA 保持一致。 -->
        <Style x:Key="GeoTHeaderToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderBrush" Value="#B8BDC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="{x:Static SystemFonts.MessageFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="#000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D1D1D1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#BBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 面板控制小按钮样式（与 CIPW 计算详情一致） -->
        <Style x:Key="PanelControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" 
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                                <Setter Property="Foreground" Value="#333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4D4D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 温压计右键菜单（x:Shared=False：每项独立实例，便于用 ContextMenu.IsOpen 保持悬停高亮） -->
        <ContextMenu x:Key="GeoTPluginContextMenu" x:Shared="False">
            <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding [favorite],Source={x:Static lg:LanguageService.Instance}, FallbackValue=收藏}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsFavorite, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                <Setter Property="Header" Value="{Binding [unfavorite],Source={x:Static lg:LanguageService.Instance}, FallbackValue=取消收藏}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem.Icon>
                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{Binding [geo_ctx_edit],Source={x:Static lg:LanguageService.Instance}, FallbackValue=编辑}"
                      Command="{Binding PlacementTarget.Tag.EditCustomThermometerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsNotInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{Binding [geo_ctx_export_zip],Source={x:Static lg:LanguageService.Instance}, FallbackValue=导出 ZIP}"
                      Command="{Binding PlacementTarget.Tag.ExportPluginCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xe673;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsNotInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{Binding [force_update_template],Source={x:Static lg:LanguageService.Instance}, TargetNullValue='强制更新'}"
                      Command="{Binding PlacementTarget.Tag.ForceUpdatePluginCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                    <Condition Binding="{Binding PlacementTarget.DataContext.IsBuiltIn, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator>
                <Separator.Style>
                    <Style TargetType="Separator" BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                    <Condition Binding="{Binding PlacementTarget.DataContext.IsBuiltIn, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Separator.Style>
            </Separator>
            <MenuItem Header="{Binding [geo_ctx_demote],Source={x:Static lg:LanguageService.Instance}, FallbackValue=降级为自定义}"
                      Command="{Binding PlacementTarget.Tag.ConvertToCustomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#E65100"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                    <Condition Binding="{Binding PlacementTarget.DataContext.IsBuiltIn, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{Binding [geo_ctx_promote],Source={x:Static lg:LanguageService.Instance}, FallbackValue=转换为官方}"
                      Command="{Binding PlacementTarget.Tag.ConvertToOfficialCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#107C10"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                    <Condition Binding="{Binding PlacementTarget.DataContext.IsBuiltIn, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator>
                <Separator.Style>
                    <Style TargetType="Separator" BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsBuiltIn, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlacementTarget.DataContext.IsBuiltIn, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                    <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Separator.Style>
            </Separator>
            <MenuItem Header="{Binding [geo_ctx_delete],Source={x:Static lg:LanguageService.Instance}, FallbackValue=删除}"
                      Command="{Binding PlacementTarget.Tag.DeleteCustomThermometerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Tag="Danger"
                      Foreground="#D13438">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#D13438"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsBuiltIn, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlacementTarget.DataContext.IsBuiltIn, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                    <Condition Binding="{Binding PlacementTarget.Tag.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
        </ContextMenu>

        <!-- ==================== 资源库侧栏（与图解模块左侧面板同一风格：圆角行、淡灰悬停、系统蓝选中） ==================== -->

        <!-- 温压计列表项容器（行高 28、圆角 6；选中为系统蓝填充 + 白字，文字/图标颜色经继承跟随 Foreground） -->
        <Style x:Key="GeoTPluginListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="24,3,8,3"/>
            <Setter Property="Margin" Value="0,1.5,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DiagramLibraryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Tag" Value="{Binding Data, Source={StaticResource ViewModelProxy}}"/>
            <Setter Property="ContextMenu" Value="{StaticResource GeoTPluginContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" MinHeight="28"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding Data.SelectPluginCommand, Source={StaticResource ViewModelProxy}}"
                                              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=DataContext}"/>
                            </Border.InputBindings>
                            <ContentPresenter x:Name="ItemContent"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 选中态以 DiagramLibraryActiveBrush 作为标记值；实际填充色取当前主题主色 -->
                            <Trigger Property="Background" Value="{StaticResource DiagramLibraryActiveBrush}">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Background" Value="{StaticResource DiagramLibraryActiveBrush}"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarSelectedHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 鼠标悬停高亮 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DiagramLibraryHoverBrush}"/>
                </Trigger>
                <!-- 右键菜单打开时保持悬停高亮（指针移到菜单后 IsMouseOver 会变为 False） -->
                <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DiagramLibraryHoverBrush}"/>
                </DataTrigger>
                <!-- 当前选中的温压计 -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource GeoTPluginSelectedMultiConverter}">
                            <Binding Path="DataContext" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="Data.SelectedPlugin" Source="{StaticResource ViewModelProxy}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource DiagramLibraryActiveBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 温压计条目标题（颜色与字重继承自 ListBoxItem） -->
        <Style x:Key="GeoTPluginNameTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <!-- 温压计条目作者行（以透明度降低对比度，选中时同样适用于白字） -->
        <Style x:Key="GeoTPluginMetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="LineHeight" Value="15"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- 条目右侧小图标按钮（下载 / 更新）：白底细边框，在默认与选中蓝底下均清晰 -->
        <Style x:Key="GeoTPluginActionButtonStyle" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#1A000000" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分组图标：随区块类型切换（官方 / 自定义 / 收藏），与图解模块的线条图标一致 -->
        <Style x:Key="GeoTSectionIconStyle" TargetType="Path" BasedOn="{StaticResource DiagramLibraryButtonIconStyle}">
            <Setter Property="Data" Value="M5,4 L19,4 A2,2 0 0 1 21,6 L21,18 A2,2 0 0 1 19,20 L5,20 A2,2 0 0 1 3,18 L3,6 A2,2 0 0 1 5,4 Z M3,9 L21,9 M9,14 L15,14"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SectionKey}" Value="Custom">
                    <Setter Property="Data" Value="M19,21 L19,19 A4,4 0 0 0 15,15 L9,15 A4,4 0 0 0 5,19 L5,21 M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SectionKey}" Value="Favorite">
                    <Setter Property="Data" Value="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 行尾数量文字（与图解模块模板树的计数一致） -->
        <Style x:Key="GeoTSidebarCountTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource DiagramLibrarySecondaryBrush}"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <!-- 分组标题：资源库（仅官方区块上方显示） -->
        <Style x:Key="GeoTLibraryHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource DiagramLibrarySectionHeaderStyle}">
            <Setter Property="Margin" Value="10,2,10,5"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SectionKey}" Value="Official">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 分组标题：我的空间（仅自定义区块上方显示，收藏紧随其后） -->
        <Style x:Key="GeoTWorkspaceHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource DiagramLibrarySectionHeaderStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SectionKey}" Value="Custom">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 温压计条目 DataTemplate -->
        <DataTemplate x:Key="GeoTPluginItemTemplate" DataType="{x:Type models:Geothermometer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 温度计图标：描边颜色跟随所在行的前景色 -->
                <Viewbox Grid.Column="0" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource DiagramLibraryIconStyle}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                              Opacity="0.7"
                              Data="M14,14.76 L14,3.5 A2.5,2.5 0 0 0 9,3.5 L9,14.76 A4.5,4.5 0 1 0 14,14.76 Z"/>
                    </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Style="{StaticResource GeoTPluginNameTextStyle}"/>
                    <TextBlock Style="{StaticResource GeoTPluginMetaTextStyle}">
                        <Run Text="{Binding Author, Mode=OneWay}"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding Year, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </StackPanel>

                <!-- 未安装：下载（仅图标） -->
                <Button Grid.Column="2"
                        Command="{Binding Data.DownloadPluginCommand, Source={StaticResource ViewModelProxy}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding [geo_btn_download],Source={x:Static lg:LanguageService.Instance}, FallbackValue=下载}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GeoTPluginActionButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="&#xe64e;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="13"/>
                </Button>

                <!-- 可更新：更新（仅图标） -->
                <Button Grid.Column="2"
                        Command="{Binding Data.UpdatePluginCommand, Source={StaticResource ViewModelProxy}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding [geo_btn_update],Source={x:Static lg:LanguageService.Instance}, FallbackValue=更新}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GeoTPluginActionButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="&#xe74b;" FontFamily="{StaticResource IconFont}" Foreground="#2E7D32" FontSize="13"/>
                </Button>

                <!-- 自定义标记：半透明灰底，文字颜色继承自所在行 -->
                <Border Grid.Column="3" CornerRadius="4" Background="#22808080" Padding="5,1"
                        VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBuiltIn}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding [geo_label_custom_chip],Source={x:Static lg:LanguageService.Instance}, FallbackValue=自定义}"
                               FontSize="10" Opacity="0.8"/>
                </Border>

                <!-- 需升级软件标记：服务器版本高于当前软件支持的格式 -->
                <Border Grid.Column="3" CornerRadius="4" Background="#22C77700" Padding="5,1"
                        VerticalAlignment="Center" Margin="6,0,0,0"
                        ToolTip="{Binding [status_update_requires_app_upgrade_hint],Source={x:Static lg:LanguageService.Instance}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRequiresAppUpgrade}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding [status_requires_app_upgrade],Source={x:Static lg:LanguageService.Instance}, FallbackValue=需升级软件}"
                               FontSize="10" Foreground="#C77700"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 二级类别分组 DataTemplate（等同图解模块树中的文件夹节点） -->
        <DataTemplate x:Key="GeoTCategoryGroupTemplate" DataType="{x:Type vm:CategoryGroupViewModel}">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PluginCount}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Command="{Binding Data.ToggleCategoryGroupCommand, Source={StaticResource ViewModelProxy}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource DiagramLibraryItemButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource DiagramLibraryChevronStyle}"
                                   Tag="{Binding IsExpanded}"/>
                        <Viewbox Grid.Column="1" Width="14" Height="14" Margin="1.5,0,8.5,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24"><Path Style="{StaticResource DiagramLibraryButtonIconStyle}" Data="M22,19 A2,2 0 0 1 20,21 L4,21 A2,2 0 0 1 2,19 L2,5 A2,2 0 0 1 4,3 L9,3 L11,6 L20,6 A2,2 0 0 1 22,8 Z"/></Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding PluginCount}" Style="{StaticResource GeoTSidebarCountTextStyle}"/>
                    </Grid>
                </Button>

                <ListBox ItemsSource="{Binding Plugins}"
                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="14,0,0,0"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionMode="Single"
                         Focusable="False"
                         SelectedItem="{Binding Data.SelectedPlugin, Source={StaticResource ViewModelProxy}, Mode=OneWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         PreviewMouseWheel="PluginListBox_PreviewMouseWheel"
                         ItemContainerStyle="{StaticResource GeoTPluginListBoxItemStyle}"
                         ItemTemplate="{StaticResource GeoTPluginItemTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 一级侧栏区块 DataTemplate（官方 / 自定义 / 收藏） -->
        <DataTemplate x:Key="GeoTSidebarSectionTemplate" DataType="{x:Type vm:GeoTSidebarSectionViewModel}">
            <StackPanel>
                <!-- 分组标题 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SectionKey}" Value="Official">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="{Binding [library_section],Source={x:Static lg:LanguageService.Instance}, FallbackValue='资源库'}"
                               Style="{StaticResource GeoTLibraryHeaderStyle}" HorizontalAlignment="Left"/>
                    <uc:IconLinkButton Text="{Binding [check_for_template_updates],Source={x:Static lg:LanguageService.Instance}, FallbackValue='检查更新'}"
                                       Command="{Binding Data.CheckForPluginUpdatesCommand, Source={StaticResource ViewModelProxy}}"
                                       Margin="10,0,6,3" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SectionKey}" Value="Custom">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="{Binding [workspace_section],Source={x:Static lg:LanguageService.Instance}, FallbackValue='我的空间'}"
                               Style="{StaticResource GeoTWorkspaceHeaderStyle}" HorizontalAlignment="Left"/>
                    <uc:IconLinkButton Icon="&#xE710;"
                                       Text="{Binding [geo_new_thermometer],Source={x:Static lg:LanguageService.Instance}, FallbackValue='新建温压计'}"
                                       Command="{Binding Data.CreateCustomThermometerCommand, Source={StaticResource ViewModelProxy}}"
                                       Margin="10,0,6,1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>

                <Button Command="{Binding Data.ToggleSidebarSectionCommand, Source={StaticResource ViewModelProxy}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource DiagramLibraryItemButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource DiagramLibraryChevronStyle}"
                                   Tag="{Binding IsExpanded}"/>
                        <Viewbox Grid.Column="1" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24"><Path Style="{StaticResource GeoTSectionIconStyle}"/></Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding TotalCount}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GeoTSidebarCountTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <!-- 二级类别（相对一级缩进 14，与图解模块子树一致） -->
                <ItemsControl ItemsSource="{Binding CategoryGroups}"
                              ItemTemplate="{StaticResource GeoTCategoryGroupTemplate}"
                              Margin="14,0,0,0"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

            </StackPanel>
        </DataTemplate>

        <!-- 主操作按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#004578"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <i:Interaction.Behaviors>
            <hp:FileDropBehavior DropCommand="{Binding ImportPluginFromPathCommand}"
                                 AllowedExtensions="{x:Static hp:TemplatePackageFileExtensions.GeothermometerDropAllowed}"
                                 OverlayFormats="{x:Static hp:TemplatePackageFileExtensions.GeothermometerPrimary}"
                                 KickerText="{Binding [file_drop_geothermometer_kicker], Source={x:Static lg:LanguageService.Instance}}"
                                 HintText="{Binding [file_drop_release_to_import], Source={x:Static lg:LanguageService.Instance}}"
                                 SubHintText="{Binding [file_drop_geothermometer_sub], Source={x:Static lg:LanguageService.Instance}}"
                                 InvalidHintText="{Binding [file_drop_invalid_format], Source={x:Static lg:LanguageService.Instance}}"
                                 InvalidSubHintText="{Binding [file_drop_use_formats_below], Source={x:Static lg:LanguageService.Instance}}"
                                 RecognizedCountFormat="{Binding [file_drop_recognized_count], Source={x:Static lg:LanguageService.Instance}}"/>
        </i:Interaction.Behaviors>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TemplateListColumn" Width="300"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 页面顶栏：菜单 / 返回 + 温压计名称与标签 + 操作按钮（融入主窗口顶部） ==================== -->
        <ContentControl Grid.Row="0" Grid.ColumnSpan="3" Panel.ZIndex="10" Style="{StaticResource PageTitleBarCustomLayoutStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 与模板列表共用列宽，拖动分隔条时名称和标签随帮助文档一起对齐。 -->
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="{Binding Width, ElementName=TemplateListColumn}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalculationWorkspaceVisible}" Value="True">
                                        <Setter Property="Width" Value="Auto"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalculationWorkspaceVisible}" Value="True">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Geothermometer],Source={x:Static lg:LanguageService.Instance}}"
                               VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#0F172A"
                               TextWrapping="NoWrap" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="18,0,18,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalculationWorkspaceVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Source={x:Static vm:ShellLayoutState.Instance}, Path=IsSideBarVisible, Mode=OneWay}" Value="False"/>
                                            <Condition Binding="{Binding Source={x:Static vm:ShellLayoutState.Instance}, Path=UseIconOnlySidebarCollapse, Mode=OneWay}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Margin" Value="56,0,18,0"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                <!-- 文件 / 更新 菜单与批量下载按钮（整页计算界面时隐藏） -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalculationWorkspaceVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Menu Grid.Column="0" Style="{StaticResource TitleBarMenuStyle}">
                        <MenuItem Header="{Binding [File],Source={x:Static lg:LanguageService.Instance}, FallbackValue=文件}">
                            <MenuItem Header="{Binding [geo_menu_new_custom],Source={x:Static lg:LanguageService.Instance}, FallbackValue=新建地质温压计}"
                                      InputGestureText=".gtm.zip"
                                      Command="{Binding CreateCustomThermometerCommand}"/>
                            <MenuItem Header="{Binding [geo_menu_import_zip],Source={x:Static lg:LanguageService.Instance}, FallbackValue=导入地质温压计}"
                                      InputGestureText=".gtm.zip"
                                      Command="{Binding ImportPluginCommand}"/>
                            <Separator />
                            <MenuItem Header="{Binding [geo_menu_open_free_sheet],Source={x:Static lg:LanguageService.Instance}, FallbackValue=打开自由表格}" 
                                      Command="{Binding OpenFreeSheetCommand}"/>
                        </MenuItem>
                    </Menu>
                </Grid>
                </Grid>
                </StackPanel>

                <!-- 返回 / 名称与标签 / 操作按钮 -->
                <Grid Grid.Column="2">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="16,0,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalculationWorkspaceVisible}" Value="True">
                                    <Setter Property="Margin" Value="18,0,0,0"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCalculationWorkspaceVisible}" Value="True"/>
                                        <Condition Binding="{Binding Source={x:Static vm:ShellLayoutState.Instance}, Path=IsSideBarVisible, Mode=OneWay}" Value="False"/>
                                        <Condition Binding="{Binding Source={x:Static vm:ShellLayoutState.Instance}, Path=UseIconOnlySidebarCollapse, Mode=OneWay}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Margin" Value="56,0,0,0"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：返回模板库 + 选中的温压计信息 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding BackToTemplateLibraryCommand}"
                                Style="{StaticResource GeoTHeaderToolbarButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="{Binding [return_to_template_library], Source={x:Static lg:LanguageService.Instance}, FallbackValue=返回}"
                                Visibility="{Binding IsCalculationWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe61f;" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,1,6,0"/>
                                <TextBlock Text="{Binding [return_to_template_library], Source={x:Static lg:LanguageService.Instance}, FallbackValue=返回}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                        <!-- 选中时的信息：名称 + 标签（单行） -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPlugin}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- 温压计名称 -->
                            <TextBlock Text="{Binding SelectedPluginDisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>

                            <!-- 类型标签与能力（跟随主题色；整页计算界面不显示） -->
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCalculationWorkspaceVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ItemsControl ItemsSource="{Binding SelectedPlugin.Tags}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ThemeTagChipBorderStyle}">
                                                <TextBlock Text="{Binding Mode=OneWay}" Style="{StaticResource ThemeTagChipTextStyle}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding SelectedPlugin.Capabilities}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ThemeTagChipBorderStyle}">
                                                <TextBlock Text="{Binding Mode=OneWay}" FontWeight="SemiBold" Style="{StaticResource ThemeTagChipTextStyle}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                        </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 右侧：操作按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPlugin}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- ===== 未安装：显示【下载】按钮 ===== -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding DownloadPluginCommand}"
                                CommandParameter="{Binding SelectedPlugin}"
                                ToolTip="{Binding [geo_btn_download],Source={x:Static lg:LanguageService.Instance}, FallbackValue=下载}"
                                Visibility="{Binding IsDownloadSelectedButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe64e;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding [geo_btn_download],Source={x:Static lg:LanguageService.Instance}, FallbackValue=下载}" 
                                           VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- ===== 模板库：应用（原右侧页面底部的应用按钮） ===== -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,4" Margin="2,0"
                                Command="{Binding ApplyPluginCommand}"
                                CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                Visibility="{Binding IsApplyButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding [geo_btn_apply],Source={x:Static lg:LanguageService.Instance}, FallbackValue=应用}"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ===== 服务器新版本需要升级软件：提示（已有旧版时仍可应用旧版） ===== -->
                        <TextBlock Text="{Binding SelectedPluginUpgradeHint}" ToolTip="{Binding SelectedPluginUpgradeHint}"
                                   Foreground="#C77700" FontSize="12" MaxWidth="360" Margin="8,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsSelectedPluginRequiresAppUpgrade, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- ===== 应用后：显示【帮助说明】【导出】【重置】 ===== -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPluginApplied}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- 帮助文档切换按钮 -->
                            <Button Style="{StaticResource GeoTHeaderToolbarButtonStyle}"
                                    Command="{Binding ToggleHelpDocumentCommand}"
                                    ToolTip="{Binding [geo_tooltip_help],Source={x:Static lg:LanguageService.Instance}, FallbackValue=帮助说明}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xe665;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding [geo_btn_help],Source={x:Static lg:LanguageService.Instance}, FallbackValue=帮助说明}" 
                                               VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- 导出当前工作表按钮 -->
                            <Button Style="{StaticResource GeoTHeaderToolbarButtonStyle}"
                                    Command="{Binding ExportWorksheetCommand}"
                                    CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                    ToolTip="{Binding [geo_tooltip_export_csv],Source={x:Static lg:LanguageService.Instance}, FallbackValue=导出当前工作表为CSV}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xe673;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding [geo_btn_export],Source={x:Static lg:LanguageService.Instance}, FallbackValue=导出}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- 重置按钮（功能等同于应用） -->
                            <Button Style="{StaticResource GeoTHeaderToolbarButtonStyle}"
                                    Command="{Binding ApplyPluginCommand}"
                                    CommandParameter="{Binding Data, Source={StaticResource GridProxy}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding [geo_btn_reset],Source={x:Static lg:LanguageService.Instance}, FallbackValue=重置}" 
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- 下载 / 更新全部：顶栏最右侧（整页计算界面时隐藏） -->
                    <Button Grid.Column="2" Margin="12,0,16,0"
                            Command="{Binding BatchActionCommand}"
                            ToolTip="{Binding BatchActionTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BatchActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBatchHeaderButtonVisible}" Value="True"/>
                                            <Condition Binding="{Binding IsCalculationWorkspaceVisible}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding BatchActionText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- ==================== 左侧：矿物导航面板 ==================== -->
        <DockPanel Grid.Row="1" Grid.Column="0" TextElement.FontFamily="Segoe UI, Microsoft YaHei UI"
                   Background="{StaticResource DiagramLibraryBackgroundBrush}">

            <!-- 搜索框 + 筛选按钮 -->
            <Border DockPanel.Dock="Top" Margin="10,12,10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <uc:SearchBox Grid.Column="0" Height="32" Margin="0,0,8,0" FontSize="13" IconFontSize="13"
                                  Padding="9,0,8,0" CornerRadius="8"
                                  Background="#1F767680" BorderBrush="Transparent"
                                  FocusBackground="White"
                                  FocusBorderBrush="{DynamicResource ThemeAccentBrush}"
                                  Foreground="{StaticResource DiagramLibraryTextBrush}"
                                  IconBrush="{StaticResource DiagramLibraryIconBrush}"
                                  PlaceholderBrush="{StaticResource DiagramLibrarySecondaryBrush}"
                                  Placeholder="{Binding [geo_placeholder_search],Source={x:Static lg:LanguageService.Instance}, FallbackValue=搜索...}"
                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 筛选按钮（实心主题色 + 已选数量角标） -->
                    <Grid Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center">
                        <Button x:Name="TagFilterButton"
                                Style="{StaticResource GeoTFilterButtonStyle}"
                                Command="{Binding ToggleTagFilterMenuCommand}"
                                ToolTip="{Binding [geo_tooltip_tag_filter], Source={x:Static lg:LanguageService.Instance}, FallbackValue=按标签筛选}">
                            <TextBlock Text="&#xe8b6;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                        </Button>

                        <Border MinWidth="17" Height="17" CornerRadius="9"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-5,-5,0" Padding="4,0"
                                Background="{StaticResource AppDangerBrush}"
                                BorderBrush="{StaticResource DiagramLibraryBackgroundBrush}"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                Visibility="{Binding HasActiveTagFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ActiveTagFilterCount}" Foreground="White"
                                       FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Popup PlacementTarget="{Binding ElementName=TagFilterButton}"
                           Placement="Bottom"
                           HorizontalOffset="-12"
                           VerticalOffset="-2"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           IsOpen="{Binding IsTagFilterMenuOpen, Mode=TwoWay}">
                        <Border Margin="12,4,12,16" Width="272"
                                Background="White" CornerRadius="8"
                                BorderBrush="#E3E6EF" BorderThickness="1"
                                Padding="4,8,4,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#16204A" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.14"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- 气泡内搜索 -->
                                <uc:SearchBox Height="28" Margin="4,0,4,6" FontSize="12" IconFontSize="12"
                                              Padding="8,0,6,0" CornerRadius="6"
                                              Background="White" BorderBrush="#DFE3EE"
                                              FocusBorderBrush="{DynamicResource ThemeAccentBrush}"
                                              Foreground="{StaticResource GeoTFilterInkBrush}"
                                              IconBrush="{StaticResource GeoTFilterMuteBrush}"
                                              PlaceholderBrush="{StaticResource GeoTFilterMuteBrush}"
                                              ShowClearButton="True"
                                              Placeholder="{Binding [geo_filter_search_placeholder], Source={x:Static lg:LanguageService.Instance}, FallbackValue=搜索矿物或能力…}"
                                              Text="{Binding TagFilterSearchText, UpdateSourceTrigger=PropertyChanged}"/>

                                <Grid MinHeight="96">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧：矿物标签 -->
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <Grid Height="22" Margin="6,0">
                                            <TextBlock Text="{Binding [geo_filter_mineral_tags], Source={x:Static lg:LanguageService.Instance}, FallbackValue=矿物标签}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GeoTFilterMuteBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Style="{StaticResource GeoTFilterLinkButtonStyle}"
                                                    Content="{Binding TagSelectAllText}"
                                                    Command="{Binding ToggleSelectAllTagsCommand}"
                                                    Visibility="{Binding HasVisibleTagFilters, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableTagFilters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:GeoTTagFilterItemViewModel}">
                                                        <CheckBox Style="{StaticResource GeoTFilterCheckBoxStyle}"
                                                                  Content="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Visibility="{Binding IsFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Text="{Binding [geo_msg_no_tags_available], Source={x:Static lg:LanguageService.Instance}, FallbackValue=暂无可用标签}"
                                                   FontSize="11.5" Foreground="{StaticResource GeoTFilterMuteBrush}" Margin="6,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAvailableTagFilters}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding [geo_filter_no_match], Source={x:Static lg:LanguageService.Instance}, FallbackValue=无匹配}"
                                                   FontSize="11.5" Foreground="{StaticResource GeoTFilterMuteBrush}" Margin="6,4"
                                                   Visibility="{Binding ShowTagFilterNoMatch, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="1" Background="{StaticResource GeoTFilterLineBrush}" VerticalAlignment="Stretch"/>

                                    <!-- 右侧：能力 -->
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                        <Grid Height="22" Margin="6,0">
                                            <TextBlock Text="{Binding [geo_filter_capabilities], Source={x:Static lg:LanguageService.Instance}, FallbackValue=能力}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GeoTFilterMuteBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Style="{StaticResource GeoTFilterLinkButtonStyle}"
                                                    Content="{Binding CapabilitySelectAllText}"
                                                    Command="{Binding ToggleSelectAllCapabilitiesCommand}"
                                                    Visibility="{Binding HasVisibleCapabilityFilters, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableCapabilityFilters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:GeoTTagFilterItemViewModel}">
                                                        <CheckBox Style="{StaticResource GeoTFilterCheckBoxStyle}"
                                                                  Content="{Binding DisplayName}"
                                                                  Tag="{Binding SecondaryText}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Visibility="{Binding IsFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Text="{Binding [geo_filter_no_match], Source={x:Static lg:LanguageService.Instance}, FallbackValue=无匹配}"
                                                   FontSize="11.5" Foreground="{StaticResource GeoTFilterMuteBrush}" Margin="6,4"
                                                   Visibility="{Binding ShowCapabilityFilterNoMatch, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 底部：已选摘要 + 清除 -->
                                <Border Margin="0,6,0,0" Padding="6,4"
                                        BorderBrush="{StaticResource GeoTFilterLineBrush}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <TextBlock Text="{Binding TagFilterSelectedSummary}"
                                                   FontSize="11" Foreground="{StaticResource GeoTFilterSubBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button HorizontalAlignment="Right"
                                                Style="{StaticResource GeoTFilterLinkButtonStyle}"
                                                Content="{Binding [geo_filter_clear], Source={x:Static lg:LanguageService.Instance}, FallbackValue=清除}"
                                                Command="{Binding ClearTagFiltersCommand}"
                                                IsEnabled="{Binding HasActiveTagFilter}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- 温压计导航列表 / 搜索无结果提示 -->
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsSearchNoResults, Converter={StaticResource BoolToVisibilityReConverter}}">
                    <StackPanel Margin="10,6,10,14">
                        <ItemsControl ItemsSource="{Binding SidebarSections}"
                                      ItemTemplate="{StaticResource GeoTSidebarSectionTemplate}"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Margin="16,24"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Visibility="{Binding IsSearchNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- 动态空状态图标 -->
                    <Viewbox Width="150" Height="140" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Canvas Width="200" Height="185">
                            <Canvas.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="GeoFloatT" Storyboard.TargetProperty="Y"
                                                             From="0" To="-6" Duration="0:0:2.25">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GeoShadowS" Storyboard.TargetProperty="ScaleX"
                                                             From="1" To="0.86" Duration="0:0:2.25">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GeoShadow" Storyboard.TargetProperty="Opacity"
                                                             From="0.6" To="0.35" Duration="0:0:2.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="GeoScanT" Storyboard.TargetProperty="X"
                                                             From="0" To="-5" Duration="0:0:2.75">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GeoScanT" Storyboard.TargetProperty="Y"
                                                             From="0" To="-4" Duration="0:0:2.75">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GeoScanR" Storyboard.TargetProperty="Angle"
                                                             From="0" To="-4" Duration="0:0:2.75">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="GeoMercuryS" Storyboard.TargetProperty="ScaleY"
                                                             From="1" To="0.72" Duration="0:0:1.6">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="GeoSpark1" Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="0.95" Duration="0:0:1.5"/>
                                            <DoubleAnimation Storyboard.TargetName="GeoSpark1S" Storyboard.TargetProperty="ScaleX"
                                                             From="0.8" To="1.18" Duration="0:0:1.5"/>
                                            <DoubleAnimation Storyboard.TargetName="GeoSpark1S" Storyboard.TargetProperty="ScaleY"
                                                             From="0.8" To="1.18" Duration="0:0:1.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True" BeginTime="0:0:1.2">
                                            <DoubleAnimation Storyboard.TargetName="GeoSpark2" Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="0.95" Duration="0:0:1.9"/>
                                            <DoubleAnimation Storyboard.TargetName="GeoSpark2S" Storyboard.TargetProperty="ScaleX"
                                                             From="0.8" To="1.18" Duration="0:0:1.9"/>
                                            <DoubleAnimation Storyboard.TargetName="GeoSpark2S" Storyboard.TargetProperty="ScaleY"
                                                             From="0.8" To="1.18" Duration="0:0:1.9"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Canvas.Triggers>

                            <!-- 光晕与阴影 -->
                            <Ellipse Canvas.Left="28" Canvas.Top="23" Width="144" Height="144">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="{DynamicResource ThemeArtStrongA1FColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource ThemeArtStrongA08Color}" Offset="0.7"/>
                                        <GradientStop Color="{DynamicResource ThemeArtStrongA00Color}" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="GeoShadow" Canvas.Left="48" Canvas.Top="157" Width="104" Height="14"
                                     Fill="#CBD5E1" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="GeoShadowS"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- 等温压虚线环 -->
                            <Ellipse Canvas.Left="36" Canvas.Top="76" Width="128" Height="52"
                                     Stroke="#CBD5E1" StrokeThickness="1.2" StrokeDashArray="3.3 3.3" Opacity="0.7"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-14"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Path Data="M38,125 C65,142 135,142 162,125" Stroke="#E2E8F0" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                            <!-- 悬浮主体 -->
                            <Canvas>
                                <Canvas.RenderTransform><TranslateTransform x:Name="GeoFloatT"/></Canvas.RenderTransform>
                                <Polygon Points="56,76 72,66 84,82 84,138 56,138" Stroke="#94A3B8" StrokeThickness="1.6" StrokeLineJoin="Round">
                                    <Polygon.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                            <GradientStop Color="#5994A3B8" Offset="0"/>
                                            <GradientStop Color="#1F64748B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Polygon.Fill>
                                </Polygon>
                                <Polygon Points="74,60 95,40 95,140 74,140" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.7" StrokeLineJoin="Round">
                                    <Polygon.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                            <GradientStop Color="{DynamicResource ThemeArtLighterA73Color}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource ThemeArtStrongA26Color}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Polygon.Fill>
                                </Polygon>
                                <Polygon Points="95,40 114,58 114,140 95,140" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.7" StrokeLineJoin="Round">
                                    <Polygon.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                            <GradientStop Color="{DynamicResource ThemeArtStrongA47Color}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource ThemeArtDarkA14Color}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Polygon.Fill>
                                </Polygon>
                                <Polyline Points="74,60 95,70 114,58" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" Opacity="0.65"/>
                                <Line X1="82" Y1="82" X2="82" Y2="122" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.75"/>
                                <Line X1="82" Y1="72" X2="82" Y2="76" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.75"/>

                                <!-- 温压计 -->
                                <Rectangle Canvas.Left="119" Canvas.Top="46" Width="14" Height="62" RadiusX="7" RadiusY="7" Fill="White" Stroke="#64748B" StrokeThickness="1.8"/>
                                <Ellipse Canvas.Left="115" Canvas.Top="99" Width="22" Height="22" Fill="White" Stroke="#64748B" StrokeThickness="1.8"/>
                                <Line X1="136" Y1="56" X2="142" Y2="56" Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="136" Y1="66" X2="140" Y2="66" Stroke="#CBD5E1" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="136" Y1="76" X2="142" Y2="76" Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="136" Y1="86" X2="140" Y2="86" Stroke="#CBD5E1" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="136" Y1="96" X2="142" Y2="96" Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Rectangle Canvas.Left="123.5" Canvas.Top="62" Width="5" Height="44" RadiusX="2.5" RadiusY="2.5">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{DynamicResource ThemeArtLighterColor}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource ThemeArtStrongColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="GeoMercuryS" CenterX="126" CenterY="96"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Canvas.Left="119.5" Canvas.Top="103.5" Width="13" Height="13" Fill="{DynamicResource ThemeArtStrongBrush}"/>
                                <Ellipse Canvas.Left="122" Canvas.Top="106" Width="4" Height="4" Fill="{DynamicResource ThemeArtMistBrush}"/>

                                <!-- 岩石基座 -->
                                <Path Data="M44,138 L142,138 L134,148 L52,148 Z" Fill="#E2E8F0" Stroke="#94A3B8" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                            </Canvas>

                            <!-- 放大镜 -->
                            <Canvas>
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="GeoScanR" CenterX="135" CenterY="128"/>
                                        <TranslateTransform x:Name="GeoScanT"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Ellipse Canvas.Left="112" Canvas.Top="102" Width="40" Height="40" Fill="#D1FFFFFF" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="2.4"/>
                                <Ellipse Canvas.Left="117" Canvas.Top="107" Width="30" Height="30" Stroke="{DynamicResource ThemeArtSoftBorderBrush}" StrokeThickness="1.2" StrokeDashArray="5 3.3"/>
                                <Path Data="M121,113 A14,14 0 0 1 136,108" Stroke="{DynamicResource ThemeArtLighterBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M128.5,117.5 C128.5,114.5 135.5,114.5 135.5,118.5 C135.5,121 132,121.5 132,124" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse Canvas.Left="130.7" Canvas.Top="127.2" Width="2.6" Height="2.6" Fill="{DynamicResource ThemeArtStrongBrush}"/>
                                <Line X1="146.5" Y1="136.5" X2="160" Y2="150" Stroke="{DynamicResource ThemeArtStrongBrush}" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="146.5" Y1="136.5" X2="150" Y2="140" Stroke="#64748B" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>

                            <!-- 闪烁星点 -->
                            <Path x:Name="GeoSpark1" Data="M50,50 L51.8,56.2 L58,58 L51.8,59.8 L50,66 L48.2,59.8 L42,58 L48.2,56.2 Z" Fill="{DynamicResource ThemeArtLighterBrush}" Opacity="0.25">
                                <Path.RenderTransform><ScaleTransform x:Name="GeoSpark1S" CenterX="50" CenterY="58"/></Path.RenderTransform>
                            </Path>
                            <Path x:Name="GeoSpark2" Data="M152,48 L153.2,52.8 L158,54 L153.2,55.2 L152,60 L150.8,55.2 L146,54 L150.8,52.8 Z" Fill="#94A3B8" Opacity="0.25">
                                <Path.RenderTransform><ScaleTransform x:Name="GeoSpark2S" CenterX="152" CenterY="54"/></Path.RenderTransform>
                            </Path>
                            <Ellipse Canvas.Left="39.8" Canvas.Top="105.8" Width="4.4" Height="4.4" Fill="#CBD5E1"/>
                            <Ellipse Canvas.Left="157.5" Canvas.Top="93.5" Width="5" Height="5" Fill="{DynamicResource ThemeArtMistBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock FontSize="13"
                               Foreground="{StaticResource DiagramLibrarySecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Text="{Binding [geo_hint_no_search_results], Source={x:Static lg:LanguageService.Instance}, FallbackValue=未找到匹配的温压计模板。}"/>
                    <uc:TemplateFeedbackHint FontSize="12"
                                             Foreground="{StaticResource DiagramLibrarySecondaryBrush}"
                                             Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- 分隔条 -->
        <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <!-- 两侧填充与相邻面板一致的底色，避免 4px 间隙露出页面白色背景 -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="{StaticResource DiagramLibraryBackgroundBrush}"/>
                        <Rectangle Grid.Column="1" Fill="#F5F5F5"/>
                        <Rectangle Grid.ColumnSpan="2" Width="1" HorizontalAlignment="Center" Fill="#E0E0E0"/>
                    </Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ==================== 右侧：模板帮助；应用后展开为整页计算界面 ==================== -->
        <Grid Grid.Row="1" Background="#F5F5F5">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Grid.Column" Value="2"/>
                    <Setter Property="Grid.ColumnSpan" Value="1"/>
                    <Setter Property="Panel.ZIndex" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCalculationWorkspaceVisible}" Value="True">
                            <Setter Property="Grid.Column" Value="0"/>
                            <Setter Property="Grid.ColumnSpan" Value="3"/>
                            <Setter Property="Panel.ZIndex" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 下方：帮助文档区域 / ReoGrid 表格 + 计算详情面板 -->
            <Grid Grid.Row="1">
                <!-- 未选中模板时，提示位于右侧区域正中 -->
                <uc:EmptyStateView IconKind="Geothermometer"
                                   IconSize="260"
                                   TitleFontSize="16"
                                   TitleForeground="#999"
                                   Title="{Binding [geo_hint_select_thermometer],Source={x:Static lg:LanguageService.Instance}, FallbackValue=请从左侧面板选择温压计}">
                    <uc:EmptyStateView.Style>
                        <Style TargetType="uc:EmptyStateView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectHintVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </uc:EmptyStateView.Style>
                </uc:EmptyStateView>

                <!-- 自定义温压计为空：动态插画 + 提示文本，位于右侧区域正中 -->
                <uc:EmptyStateView IconKind="PersonalGeothermometer"
                                   IconSize="260"
                                   TitleFontSize="14"
                                   TitleForeground="#999"
                                   MaxWidth="360"
                                   Margin="24"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Title="{Binding [geo_hint_no_personal],Source={x:Static lg:LanguageService.Instance}, FallbackValue=暂无个人温压计，可通过「文件」菜单新建或导入。}">
                    <uc:EmptyStateView.Description>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Style="{StaticResource EmptyStatePrimaryButtonStyle}"
                                    Command="{Binding CreateCustomThermometerCommand}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding [empty_state_new],Source={x:Static lg:LanguageService.Instance}, FallbackValue=新建}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource EmptyStateSecondaryButtonStyle}"
                                    Command="{Binding ImportPluginCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding [empty_state_import],Source={x:Static lg:LanguageService.Instance}, FallbackValue=导入}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </uc:EmptyStateView.Description>
                    <uc:EmptyStateView.Style>
                        <Style TargetType="uc:EmptyStateView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCustomEmptyStateVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </uc:EmptyStateView.Style>
                </uc:EmptyStateView>

                <!-- 收藏为空：动态插画 + 提示文本，位于右侧区域正中 -->
                <uc:EmptyStateView IconKind="Geothermometer"
                                   IconSize="260"
                                   TitleFontSize="14"
                                   TitleForeground="#999"
                                   MaxWidth="360"
                                   Margin="24"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Title="{Binding [favorites_empty_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=还没有收藏的模板。在模板上右键即可收藏。}">
                    <uc:EmptyStateView.Style>
                        <Style TargetType="uc:EmptyStateView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavoriteEmptyStateVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </uc:EmptyStateView.Style>
                </uc:EmptyStateView>

                <!-- ==================== 数据表格区域（整页计算界面且未打开帮助时显示） ==================== -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCalculationWorkspaceVisible}" Value="True"/>
                                        <Condition Binding="{Binding IsHelpDocVisible}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TableRow" Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="DetailRow" Height="Auto"/>
                    </Grid.RowDefinitions>

                    <uc:ReoGridTableHost x:Name="WorksheetTable" Grid.Row="0" Style="{StaticResource ReoGridTableHostStyle}"
                                         UseBuiltInCellEditor="False"
                                         ResetLayoutCommand="{Binding ResetWorksheetLayoutCommand}"
                                         SelectedCellContent="{Binding SelectedCellContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         SelectedCellAddress="{Binding SelectedCellAddress}"
                                         IsSelectedCellReadOnly="False">
                        <rg:ReoGridControl x:Name="MyReoGrid" SheetTabVisible="False"/>
                    </uc:ReoGridTableHost>

                    <!-- 表格与计算详情之间的可拖动分隔条 -->
                    <GridSplitter x:Name="DetailSplitter" Grid.Row="1"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  Background="Transparent"
                                  ShowsPreview="True"
                                  Visibility="Collapsed"
                                  DragCompleted="OnDetailSplitterDragCompleted"
                                  Cursor="SizeNS">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="Transparent">
                                    <Border Height="1" VerticalAlignment="Center" Background="#E0E0E0"/>
                                </Grid>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- ==================== 计算详情面板（始终显示在底部） ==================== -->
                    <Border x:Name="DetailPanelBorder" Grid.Row="2" BorderBrush="#D4D4D4" BorderThickness="0,1,0,0"
                            Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 面板标题栏 -->
                            <Border Grid.Row="0" Background="#F8F8FA" Padding="12,8" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" MinHeight="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" 
                                               FontSize="14" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    
                                    <!-- 有数据时显示：计算详情 - Row X -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCalculationData}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding [geo_section_calc_details],Source={x:Static lg:LanguageService.Instance}, FallbackValue=计算详情}" 
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
                                        <TextBlock Text=" - " FontSize="12" Foreground="#999" Margin="4,0"/>
                                        <TextBlock Text="{Binding SelectedRowInfo}" FontSize="12" Foreground="#666" 
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                    </StackPanel>
                                    
                                    <!-- 无数据时显示：请选择数据行 -->
                                    <TextBlock Grid.Column="1" Text="{Binding [geo_hint_select_data_row],Source={x:Static lg:LanguageService.Instance}, FallbackValue=请选择数据行}" 
                                               FontSize="13" Foreground="#999" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCalculationData}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 右侧：展开时显示导出/复制，其后为展开/收缩 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDetailPanelMinimized}" Value="False"/>
                                                                <Condition Binding="{Binding HasCalculationData}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource PanelControlButtonStyle}"
                                                    Command="{Binding ExportCalculationDetailsCommand}"
                                                    ToolTip="{Binding [geo_tooltip_export_calc_details], Source={x:Static lg:LanguageService.Instance}, FallbackValue=导出计算详情为 CSV}"
                                                    Margin="0,0,2,0">
                                                <TextBlock Text="&#xe673;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                            </Button>
                                            <Button Style="{StaticResource PanelControlButtonStyle}"
                                                    Command="{Binding CopyCalculationDetailsCommand}"
                                                    ToolTip="{Binding [geo_tooltip_copy_calc_details], Source={x:Static lg:LanguageService.Instance}, FallbackValue=复制计算详情到剪贴板}">
                                                <TextBlock Text="&#xe63e;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                            </Button>
                                        </StackPanel>
                                        <Button Style="{StaticResource PanelControlButtonStyle}"
                                                Click="OnToggleDetailExpandClick"
                                                ToolTip="{Binding [cipw_tooltip_expand], Source={x:Static lg:LanguageService.Instance}, FallbackValue=展开/收缩}">
                                            <TextBlock x:Name="DetailExpandIcon" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 计算步骤列表 + 异步加载遮罩 -->
                            <Grid Grid.Row="1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDetailPanelMinimized}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <ScrollViewer x:Name="CalculationDetailScrollViewer"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Padding="0">
                                    <ItemsControl ItemsSource="{Binding CalculationSteps}" Margin="8,4,8,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,1" Padding="10,6" CornerRadius="4"
                                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                                                    <Setter Property="Background" Value="#FFFDE7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsResult}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                    <Setter Property="Background" Value="#FAFAFA"/>
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasCustomBackground}" Value="True">
                                                                    <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource HexToBrushConverter}}"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F5F5F7"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.ToggleCalculationGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto" MinWidth="160"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 分组折叠箭头（仅分隔标题） -->
                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource ThemeAccentBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Setter Property="Text" Value="&#xE70D;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE76C;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- 步骤名称 -->
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="Foreground" Value="#555"/>
                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsResult}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            <Setter Property="FontSize" Value="11"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                                        </TextBlock>

                                                        <!-- 步骤值（分隔行隐藏） -->
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="Consolas"/>
                                                                    <Setter Property="Foreground" Value="#333"/>
                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsResult}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                            <Setter Property="FontSize" Value="13"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding Value, Mode=OneWay}"/>
                                                        </TextBlock>

                                                        <!-- 描述（分隔行隐藏） -->
                                                        <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="11" 
                                                                   Foreground="#999" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Description}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 计算详情异步加载遮罩（与帮助文档一致） -->
                                <Border Background="#CCFFFFFF"
                                        Panel.ZIndex="10"
                                        Visibility="{Binding IsCalculationDetailsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ProgressBar Style="{StaticResource FlatProgressBarStyle}"
                                                     Width="180"
                                                     IsIndeterminate="True"
                                                     Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding [loading_status], Source={x:Static lg:LanguageService.Instance}, FallbackValue=加载中...}"
                                                   FontSize="13"
                                                   Foreground="#666"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== 帮助文档区域（IsHelpDocVisible=True 时显示） ==================== -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHelpDocVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 帮助文档内容 -->
                    <Border Grid.Row="0" Background="White" Margin="0">
                        <Grid>
                            <RichTextBox x:Name="HelpDocRichTextBox" IsReadOnly="True" 
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Padding="20,16" BorderThickness="0">
                                <RichTextBox.Resources>
                                    <Style TargetType="{x:Type FlowDocument}">
                                        <Setter Property="ColumnWidth" Value="999999"/>
                                        <Setter Property="IsOptimalParagraphEnabled" Value="True"/>
                                        <Setter Property="PagePadding" Value="10"/>
                                    </Style>
                                </RichTextBox.Resources>
                                <FlowDocument />
                            </RichTextBox>

                            <!-- 帮助文档异步加载遮罩 -->
                            <Border Background="#CCFFFFFF"
                                    Panel.ZIndex="10"
                                    Visibility="{Binding IsHelpDocLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ProgressBar Style="{StaticResource FlatProgressBarStyle}"
                                                 Width="180"
                                                 IsIndeterminate="True"
                                                 Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding [loading_status], Source={x:Static lg:LanguageService.Instance}, FallbackValue=加载中...}"
                                               FontSize="13"
                                               Foreground="#666"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 计算界面帮助：关闭后回到表格 -->
                    <Border Grid.Row="1" Background="#F8F8FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                            Padding="20,12"
                            Visibility="{Binding IsCalculationWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="#888"
                                       Text="{Binding [geo_placeholder_help_read_confirm], Source={x:Static lg:LanguageService.Instance}, FallbackValue=阅读文档后点击确认继续。}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ConfirmAndShowTableCommand}"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding [close], Source={x:Static lg:LanguageService.Instance}, FallbackValue=关闭}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 温压计更新遮罩层 -->
        <Border Grid.RowSpan="2" Grid.ColumnSpan="3"
                Panel.ZIndex="1000"
                Background="#80000000"
                Visibility="{Binding IsUpdateOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="12"
                    Width="420"
                    Padding="36,28"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#333"
                               HorizontalAlignment="Center"
                               LineHeight="24"
                               Padding="0,2"
                               Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding [geo_msg_checking_update], Source={x:Static lg:LanguageService.Instance}, FallbackValue=Checking for updates...}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdateProgressIndeterminate}" Value="False">
                                        <Setter Property="Text" Value="{Binding [geo_msg_downloading_update], Source={x:Static lg:LanguageService.Instance}, FallbackValue=Downloading...}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       FontSize="13"
                                       Foreground="#666"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Padding="0,2"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12"
                                       Foreground="#888"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Padding="0,2"
                                       LineHeight="16"
                                       Text="{Binding UpdateProgress, StringFormat={}{0:0}%}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdateProgressIndeterminate}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ProgressBar Grid.Row="1"
                                       Style="{StaticResource FlatProgressBarStyle}"
                                       Maximum="100"
                                       Value="{Binding UpdateProgress}"
                                       IsIndeterminate="{Binding IsUpdateProgressIndeterminate}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
