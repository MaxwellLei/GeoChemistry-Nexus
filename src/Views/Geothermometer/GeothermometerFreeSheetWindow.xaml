<Window x:Class="GeoChemistryNexus.Views.GeothermometerFreeSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rg="clr-namespace:unvell.ReoGrid;assembly=unvell.ReoGrid"
        xmlns:hp="clr-namespace:GeoChemistryNexus.Helpers"
        xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:GeoChemistryNexus.Controls"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="{Binding WindowTitle}"
        Width="1200" Height="720"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#F5F7FA" Foreground="#263549"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>


    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/GeoChemistryNexus;component/Themes/EditorStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <FontFamily x:Key="IconFont">pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont</FontFamily>
        <hp:BindingProxy x:Key="GridProxy" Data="{Binding ElementName=FreeReoGrid}" />

        <Style x:Key="ToolbarGroupBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,3,6,3"/>
        </Style>

        <Style x:Key="ToolbarGroupLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#7A8798"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="ToolbarButtonIconStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EAF0F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DDE7F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF0F7"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#D8E9FF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarTextButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorAction}">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style x:Key="ExportButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarTextButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
      </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Native caption hit testing preserves drag, double click and edge resizing. -->
        <Border Background="#F5F7FA" BorderBrush="#DFE5ED" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel x:Name="WorksheetActions" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Button Style="{StaticResource ToolbarTextButtonStyle}"
                                        Command="{Binding ImportWorksheetCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        Content="{Binding [geo_free_sheet_import], Source={x:Static lg:LanguageService.Instance}}"/>
                                <Button Style="{StaticResource ExportButtonStyle}"
                                        Command="{Binding ExportWorksheetCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        Content="{Binding [geo_btn_export], Source={x:Static lg:LanguageService.Instance}}"/>
                                <Button Style="{StaticResource ToolbarTextButtonStyle}"
                                        Command="{Binding ClearWorksheetCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        Content="{Binding [geo_free_sheet_clear], Source={x:Static lg:LanguageService.Instance}}"/>
                    </StackPanel>
                    <Button x:Name="CaptionMinimizeButton" Style="{StaticResource EditorCaption}" Content="&#xe67a;" Click="MinimizeClick"
                            AutomationProperties.Name="{Binding [epma_editor_minimize], Source={x:Static lg:LanguageService.Instance}}"
                            ToolTip="{Binding [epma_editor_minimize], Source={x:Static lg:LanguageService.Instance}}"/>
                    <Button x:Name="CaptionMaximizeButton" Click="MaximizeClick" Style="{StaticResource EditorCaptionMaximize}"
                            AutomationProperties.Name="{Binding [epma_editor_maximize], Source={x:Static lg:LanguageService.Instance}}"
                            ToolTip="{Binding [epma_editor_maximize], Source={x:Static lg:LanguageService.Instance}}"/>
                    <Button x:Name="CaptionCloseButton" Style="{StaticResource EditorCaptionClose}" Content="&#xeaf2;" Click="CloseClick"
                            AutomationProperties.Name="{Binding [close], Source={x:Static lg:LanguageService.Instance}}"
                            ToolTip="{Binding [close], Source={x:Static lg:LanguageService.Instance}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="18,0,12,0" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ThemeAccentBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding WindowTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DFE5ED" BorderThickness="1" CornerRadius="9" Padding="4,5" Margin="0,0,0,12">
                <WrapPanel x:Name="FormattingToolbar">
                    <!-- 编辑 -->
                    <Border Style="{StaticResource ToolbarGroupBorderStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding UndoCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [undo], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding RedoCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [redo], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                                <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                              IsChecked="{Binding IsFormatPainterActive, Mode=TwoWay}"
                                              Command="{Binding ToggleFormatPainterCommand}"
                                              CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                              ToolTip="{Binding [geo_free_sheet_format_painter], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe6bb;" FontSize="14"/>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Style="{StaticResource ToolbarGroupLabelStyle}"
                                       Text="{Binding [geo_free_sheet_group_edit], Source={x:Static lg:LanguageService.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 字体 -->
                    <Border Style="{StaticResource ToolbarGroupBorderStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:FontFamilyControl Width="140" Margin="0,0,2,0" VerticalAlignment="Center"
                                                            FontFamilyName="{Binding SelectedFontName, Mode=TwoWay}"
                                                            ToolTip="{Binding [font_name], Source={x:Static lg:LanguageService.Instance}}"/>
                                <controls:FontSizeControl Width="64" Margin="2,0" VerticalAlignment="Center"
                                                          FontSizeValue="{Binding SelectedFontSize, Mode=TwoWay}"
                                                          ToolTip="{Binding [FontSize], Source={x:Static lg:LanguageService.Instance}}"/>
                                <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                              IsChecked="{Binding IsBold, Mode=OneWay}"
                                              Command="{Binding ToggleBoldCommand}"
                                              CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                              ToolTip="{Binding [geo_help_bold], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe7ed;" FontSize="14"/>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                              IsChecked="{Binding IsItalic, Mode=OneWay}"
                                              Command="{Binding ToggleItalicCommand}"
                                              CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                              ToolTip="{Binding [geo_free_sheet_italic], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe7ee;" FontSize="14"/>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ToolbarToggleStyle}"
                                              IsChecked="{Binding IsUnderline, Mode=OneWay}"
                                              Command="{Binding ToggleUnderlineCommand}"
                                              CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                              ToolTip="{Binding [geo_free_sheet_underline], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe7f0;" FontSize="14"/>
                                </ToggleButton>
                                <controls:ToolbarColorButton Margin="2,0,0,0"
                                                             IconFontFamily="{StaticResource IconFont}"
                                                             IconText="&#xe7ef;"
                                                             SelectedColor="{Binding SelectedTextColor, Mode=TwoWay}"
                                                             ToolTip="{Binding [font_color], Source={x:Static lg:LanguageService.Instance}}"/>
                                <controls:ToolbarColorButton Margin="2,0,0,0"
                                                             IconFontFamily="{StaticResource IconFont}"
                                                             IconText="&#xe7eb;"
                                                             SelectedColor="{Binding SelectedFillColor, Mode=TwoWay}"
                                                             ToolTip="{Binding [geo_free_sheet_fill_color], Source={x:Static lg:LanguageService.Instance}}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource ToolbarGroupLabelStyle}"
                                       Text="{Binding [geo_free_sheet_group_font], Source={x:Static lg:LanguageService.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 对齐 -->
                    <Border Style="{StaticResource ToolbarGroupBorderStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding AlignLeftCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [geo_free_sheet_align_left], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock Text="&#xE8E4;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding AlignCenterCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [geo_free_sheet_align_center], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock Text="&#xE8E3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding AlignRightCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [geo_free_sheet_align_right], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock Text="&#xE8E2;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding MergeCellsCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [geo_free_sheet_merge], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe780;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource ToolbarGroupLabelStyle}"
                                       Text="{Binding [geo_free_sheet_group_align], Source={x:Static lg:LanguageService.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 单元格 -->
                    <Border Style="{StaticResource ToolbarGroupBorderStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding AddRowUpCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [data_toolbar_add_row_above_tooltip], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe615;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding AddRowDownCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [data_toolbar_add_row_below_tooltip], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe613;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding DeleteRowCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [data_toolbar_delete_row_tooltip], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe89f;" FontSize="14" Foreground="#C2413B"/>
                                </Button>
                                <Rectangle Width="1" Height="20" Fill="#E2E8F0" Margin="4,0"/>
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding AddColumnLeftCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [geo_free_sheet_insert_col_left], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe611;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding AddColumnRightCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [geo_free_sheet_insert_col_right], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe610;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonIconStyle}"
                                        Command="{Binding DeleteColumnCommand}"
                                        CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                                        ToolTip="{Binding [geo_free_sheet_delete_col], Source={x:Static lg:LanguageService.Instance}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xe907;" FontSize="14" Foreground="#C2413B"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource ToolbarGroupLabelStyle}"
                                       Text="{Binding [geo_free_sheet_group_cells], Source={x:Static lg:LanguageService.Instance}}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#DFE5ED" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#F0F6FF" BorderBrush="#DCE9FB" BorderThickness="1" CornerRadius="5" Padding="8,0">
                                <TextBlock Text="{Binding SelectedCellAddress}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ThemeAccentBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="fx" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" FontSize="15" Foreground="#7A8798"/>
                            <TextBox x:Name="FormulaEditor" Grid.Column="2" Text="{Binding SelectedCellContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsSelectedCellEditable}" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                     Padding="6,0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                     AutomationProperties.Name="{Binding [epma_cell_content], Source={x:Static lg:LanguageService.Instance}}"/>
                        </Grid>
                    </Border>
                    <controls:ReoGridTableHost x:Name="WorksheetHost" Grid.Row="1" Margin="1,0,1,5"
                                               Style="{StaticResource ReoGridTableHostStyle}" ShowWorksheetBar="False" UseBuiltInCellEditor="False">
                        <rg:ReoGridControl x:Name="FreeReoGrid" SheetTabVisible="False"/>
                    </controls:ReoGridTableHost>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#EFF2F6" BorderBrush="#DFE5ED" BorderThickness="0,1,0,0" Padding="18,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCellAddress}" Foreground="#66768B" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding StatusHint}" FontSize="11" Foreground="#66768B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <controls:NotificationHost Grid.RowSpan="3" Panel.ZIndex="1000" VerticalAlignment="Stretch" HorizontalAlignment="Right"
                                   Margin="0,44,0,16" Center="{Binding Notifications, ElementName=RootWindow}"/>
    </Grid>
</Window>
