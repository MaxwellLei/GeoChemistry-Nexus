<Grid x:Class="GeoChemistryNexus.Views.SettingPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GeoChemistryNexus.Views"
      xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
      xmlns:helpers="clr-namespace:GeoChemistryNexus.Helpers"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      UseLayoutRounding="True" TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}">

    <!--Settings page-->
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" MinWidth="200" MaxWidth="290"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 页面顶栏：与其他模块一致，只显示模块名称 -->
    <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource PageTitleBarStyle}"
                    Tag="{Binding [Setting],Source={x:Static lg:LanguageService.Instance}, FallbackValue=Settings}"/>

    <!-- Sidebar -->
    <Border Grid.Row="1" Grid.Column="0" Background="#F2F2F7" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
        <StackPanel Margin="16,16,16,20">

            <!--Routine Settings-->
            <RadioButton Style="{StaticResource ModernSidebarRadioButton}" GroupName="SettingSideBar"
                         IsChecked="True" Command="{Binding CommonPageCommand}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.General}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding [NormalSetting],Source={x:Static lg:LanguageService.Instance}}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!--Drawing settings-->
            <RadioButton Style="{StaticResource ModernSidebarRadioButton}" GroupName="SettingSideBar"
                         Command="{Binding PlotPageCommand}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Plot}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding [PlotSetting],Source={x:Static lg:LanguageService.Instance}}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!--Geothermometer settings-->
            <RadioButton Style="{StaticResource ModernSidebarRadioButton}" GroupName="SettingSideBar"
                         Command="{Binding GeothermometerPageCommand}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Thermo}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding [GeothermometerSetting],Source={x:Static lg:LanguageService.Instance}, FallbackValue=地质温压计设置}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!--EPMA settings-->
            <RadioButton Style="{StaticResource ModernSidebarRadioButton}" GroupName="SettingSideBar"
                         Command="{Binding EpmaPageCommand}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Epma}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding [epma_setting],Source={x:Static lg:LanguageService.Instance}, FallbackValue=EPMA设置}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!--Shortcuts-->
            <RadioButton Style="{StaticResource ModernSidebarRadioButton}" GroupName="SettingSideBar"
                         Command="{Binding ShortcutPageCommand}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Shortcuts}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding [shortcuts_title],Source={x:Static lg:LanguageService.Instance}, FallbackValue=快捷键}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!--About-->
            <RadioButton Style="{StaticResource ModernSidebarRadioButton}" GroupName="SettingSideBar"
                         Command="{Binding AboutPageCommand}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.About}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding [About],Source={x:Static lg:LanguageService.Instance}}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
    </Border>

    <!-- Content Area -->
    <Grid Grid.Row="1" Grid.Column="1" Background="#F5F5F7" ClipToBounds="True">
        <Frame Name="SettingNav" NavigationUIVisibility="Hidden" BorderThickness="0" Background="Transparent">
            <i:Interaction.Behaviors>
                <helpers:FrameNavigationTransitionBehavior/>
            </i:Interaction.Behaviors>
        </Frame>
    </Grid>

</Grid>

