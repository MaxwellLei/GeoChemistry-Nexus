<Page x:Class="GeoChemistryNexus.Views.SEpmaPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="600"
      Title="SEpmaPageView"
      UseLayoutRounding="True" TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="75,20,75,40" MaxWidth="800" HorizontalAlignment="Stretch">

                <!-- VERSION INFO -->
                <TextBlock Text="{Binding [geo_field_version],Source={x:Static lg:LanguageService.Instance}, FallbackValue=版本}" Style="{StaticResource ModernSettingsGroupTitle}"/>
                <Border Style="{StaticResource ModernSettingsCard}">
                    <StackPanel>
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [epma_current_app_format_version],Source={x:Static lg:LanguageService.Instance}, FallbackValue=当前软件 EPMA 计算包版本}" FontSize="13"/>
                                <TextBlock Text="{Binding [epma_current_app_format_version_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=当前软件支持的 EPMA 计算包格式版本（只读）}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentEpmaVersion}" VerticalAlignment="Center"
                                       FontSize="13" Foreground="Gray" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DEFAULTS -->
                <TextBlock Text="{Binding [geothermometer_defaults],Source={x:Static lg:LanguageService.Instance}, FallbackValue=默认设置}" Style="{StaticResource ModernSettingsGroupTitle}"/>
                <Border Style="{StaticResource ModernSettingsCard}">
                    <StackPanel>
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [default_worksheet_row_count],Source={x:Static lg:LanguageService.Instance}, FallbackValue=默认初始表格行数}" FontSize="13"/>
                                <TextBlock Text="{Binding [default_worksheet_row_count_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=新建或重置数据表格时的默认初始行数}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding DefaultWorksheetRowCounts}"
                                      SelectedValue="{Binding DefaultWorksheetRowCount}"
                                      FontSize="12"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      Width="100"
                                      Height="30"
                                      Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- UPDATE SETTINGS -->
                <TextBlock Text="{Binding [automatic_updates],Source={x:Static lg:LanguageService.Instance}, FallbackValue=更新设置}" Style="{StaticResource ModernSettingsGroupTitle}"/>
                <Border Style="{StaticResource ModernSettingsCard}">
                    <StackPanel>
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [auto_check_epma_updates],Source={x:Static lg:LanguageService.Instance}, FallbackValue=自动检查 EPMA 计算模板更新}" FontSize="13"/>
                                <TextBlock Text="{Binding [auto_check_epma_updates_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=进入 EPMA 页面时自动检查计算模板是否有更新}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding AutoCheckEpmaUpdate}" Grid.Column="1" Style="{StaticResource ToggleButtonSwitch}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DEVELOPER OPTIONS -->
                <StackPanel Visibility="{Binding IsDeveloperMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding [developer_settings],Source={x:Static lg:LanguageService.Instance}, FallbackValue=开发者选项}" Style="{StaticResource ModernSettingsGroupTitle}"/>
                    <Border Style="{StaticResource ModernSettingsCard}">
                        <StackPanel>
                            <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [epma_reset_database],Source={x:Static lg:LanguageService.Instance}, FallbackValue=重置 EPMA 计算模板数据库}" FontSize="13"/>
                                    <TextBlock Text="{Binding [epma_reset_database_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=清空本地 EPMA 计算模板数据库并恢复内置官方模板}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                                </StackPanel>
                                <Button Content="{Binding [clear],Source={x:Static lg:LanguageService.Instance}, FallbackValue=清空}"
                                        Command="{Binding ResetEpmaDatabaseCommand}"
                                        Grid.Column="1" VerticalAlignment="Center"
                                        Width="Auto" Padding="15,0" Height="30"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
