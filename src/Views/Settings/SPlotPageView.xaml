<Page x:Class="GeoChemistryNexus.Views.SPlotPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
      xmlns:local="clr-namespace:GeoChemistryNexus.Views"
      xmlns:models="clr-namespace:GeoChemistryNexus.Models"
      xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
      xmlns:helpers="clr-namespace:GeoChemistryNexus.Helpers"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="600"
      Title="SPlotPageView"
      UseLayoutRounding="True" TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}">

    <Page.Resources>
        <cvs:TemplateCardSizePresetToDisplayConverter x:Key="TemplateCardSizePresetToDisplayConverter"/>
    </Page.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="75,20,75,40" MaxWidth="800" HorizontalAlignment="Stretch">

                <!-- EXTERNAL APPLICATIONS -->
                <TextBlock Text="{Binding [external_applications],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource ModernSettingsGroupTitle}"/>
                <Border Style="{StaticResource ModernSettingsCard}">
                    <StackPanel>
                        <!-- CorelDRAW -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="CorelDRAW" FontSize="13"/>
                                <TextBlock Text="{Binding [coreldraw_path_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=设置 CorelDRAW 可执行文件路径，用于打开矢量图}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding CorelDRAWPath}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" Foreground="Gray" TextAlignment="Right" Width="220" Margin="0,0,8,0"/>
                                <Button Content="..." Command="{Binding SelectCorelDRAWPathCommand}" Width="40" Height="28"/>
                            </StackPanel>
                        </Grid>
                        
                        <Border Height="1" Background="#E5E5E5" Margin="16,0,0,0"/>

                        <!-- Inkscape -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Inkscape" FontSize="13"/>
                                <TextBlock Style="{StaticResource ModernSettingsItemHintStyle}">
                                    <Run Text="{Binding [inkscape_path_hint],Source={x:Static lg:LanguageService.Instance}, Mode=OneWay, FallbackValue=设置 Inkscape 可执行文件路径，用于打开矢量图}"/>
                                    <Run Text=" "/>
                                    <Hyperlink Command="{Binding OpenInkscapeDownloadCommand}" Foreground="{DynamicResource ThemeAccentBrush}">
                                        <Run Text="{Binding [inkscape_get_it],Source={x:Static lg:LanguageService.Instance}, Mode=OneWay, FallbackValue=如果没有，点我获取}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding InkscapePath}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" Foreground="Gray" TextAlignment="Right" Width="220" Margin="0,0,8,0"/>
                                <Button Content="..." Command="{Binding SelectInkscapePathCommand}" Width="40" Height="28"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#E5E5E5" Margin="16,0,0,0"/>

                        <!-- Illustrator -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Adobe Illustrator" FontSize="13"/>
                                <TextBlock Text="{Binding [adobe_illustrator_path_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=设置 Adobe Illustrator 可执行文件路径，用于打开矢量图}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding AdobeIllustratorPath}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" Foreground="Gray" TextAlignment="Right" Width="220" Margin="0,0,8,0"/>
                                <Button Content="..." Command="{Binding SelectAdobeIllustratorPathCommand}" Width="40" Height="28"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- PLOT DEFAULTS -->
                <TextBlock Text="{Binding [plot_defaults],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource ModernSettingsGroupTitle}"/>
                <Border Style="{StaticResource ModernSettingsCard}">
                    <StackPanel>
                        <!-- Default Expand Level -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [default_diagram_expand_level],Source={x:Static lg:LanguageService.Instance}}" FontSize="13"/>
                                <TextBlock Text="{Binding [default_diagram_expand_level_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=图解分类树默认展开到的层级深度}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <ComboBox SelectedValue="{Binding DefaultTreeExpandLevel}" FontSize="12" VerticalAlignment="Center" 
                                      HorizontalAlignment="Right" SelectedValuePath="Content" Width="80" Height="30" Grid.Column="1">
                                <ComboBox.Items>
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                </ComboBox.Items>
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="#E5E5E5" Margin="16,0,0,0"/>

                        <!-- Default App -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [default_third_party_editor],Source={x:Static lg:LanguageService.Instance}}" FontSize="13"/>
                                <TextBlock Text="{Binding [default_third_party_editor_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=编辑或导出矢量图时默认打开的第三方软件}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource ThirdPartyEditorComboBoxStyle}"
                                      ItemsSource="{Binding ThirdPartyEditorOptions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedThirdPartyApp}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 选中“自定义”时展开：程序路径输入 -->
                        <StackPanel Margin="16,0,16,12"
                                    Visibility="{Binding IsCustomEditorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource ThirdPartyEditorPathPanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [editor_program_path],Source={x:Static lg:LanguageService.Instance}}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource HomeSubBrush}"/>
                                    <TextBox Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" SpellCheck.IsEnabled="False"
                                             Text="{Binding CustomThirdPartyAppPath, UpdateSourceTrigger=LostFocus}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource ThirdPartyEditorPathTextBoxStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCustomPathInvalid}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button Grid.Column="2" Height="30" Padding="14,0" FontSize="12"
                                            Content="{Binding [editor_browse],Source={x:Static lg:LanguageService.Instance}}"
                                            Command="{Binding SelectCustomThirdPartyAppPathCommand}"/>
                                </Grid>
                            </Border>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ThirdPartyEditorPathHintStyle}">
                                        <Setter Property="Text" Value="{Binding [editor_custom_path_hint],Source={x:Static lg:LanguageService.Instance}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomPathInvalid}" Value="True">
                                                <Setter Property="Text" Value="{Binding [editor_custom_path_invalid],Source={x:Static lg:LanguageService.Instance}}"/>
                                                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Border Height="1" Background="#E5E5E5" Margin="16,0,0,0"/>

                        <!-- Object Selection Trigger -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [object_selection_trigger],Source={x:Static lg:LanguageService.Instance}}" FontSize="13"/>
                                <TextBlock Text="{Binding [object_selection_trigger_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=在绘图画布上选中图形对象的鼠标操作方式}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="32" Width="140"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Style="{StaticResource HomeSegmentedWrapStyle}">
                                <Grid>
                                    <i:Interaction.Behaviors>
                                        <helpers:HomeSegmentedThumbBehavior Indicator="{Binding ElementName=SelectionTriggerThumb}"/>
                                    </i:Interaction.Behaviors>
                                    <Grid x:Name="SelectionTriggerThumb" HorizontalAlignment="Left" VerticalAlignment="Top"
                                          IsHitTestVisible="False" Visibility="Collapsed"
                                          SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Border Background="#14000000" CornerRadius="4" Margin="0,1,0,0"/>
                                        <Border Background="White" CornerRadius="4" Margin="0,0,0,1"/>
                                    </Grid>
                                    <ListBox Background="Transparent" BorderThickness="0" Padding="0"
                                             ItemContainerStyle="{StaticResource TemplateCardSizeSegmentedItemStyle}"
                                             SelectedValuePath="Tag" SelectedValue="{Binding ObjectSelectionTrigger, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBoxItem Tag="SingleClick"
                                                     Content="{Binding [single_click],Source={x:Static lg:LanguageService.Instance}}"/>
                                        <ListBoxItem Tag="DoubleClick"
                                                     Content="{Binding [double_click],Source={x:Static lg:LanguageService.Instance}}"/>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="#E5E5E5" Margin="16,0,0,0"/>

                        <!-- Mouse Snap Auto Recognition Frame Rate -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [mouse_snap_auto_recognition_frame_rate],Source={x:Static lg:LanguageService.Instance}}" FontSize="13"/>
                                <TextBlock Text="{Binding [mouse_snap_auto_recognition_frame_rate_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=鼠标吸附自动识别时的刷新帧率，越高越流畅但更耗性能}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding MouseSnapAutoRecognitionFrameRates}"
                                      SelectedValue="{Binding MouseSnapAutoRecognitionFrameRate}"
                                      FontSize="12"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      Width="100"
                                      Height="30"
                                      Grid.Column="1"/>
                        </Grid>

                        <Border Height="1" Background="#E5E5E5" Margin="16,0,0,0"/>

                        <!-- Default Worksheet Row Count -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [default_worksheet_row_count],Source={x:Static lg:LanguageService.Instance}}" FontSize="13"/>
                                <TextBlock Text="{Binding [default_worksheet_row_count_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=新建或重置数据表格时的默认初始行数}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding DefaultWorksheetRowCounts}"
                                      SelectedValue="{Binding DefaultWorksheetRowCount}"
                                      FontSize="12"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      Width="100"
                                      Height="30"
                                      Grid.Column="1"/>
                        </Grid>

                        <Border Height="1" Background="#E5E5E5" Margin="16,0,0,0"/>

                        <!-- Template Card Appearance -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [template_card_appearance],Source={x:Static lg:LanguageService.Instance}}" FontSize="13"/>
                                <TextBlock Text="{Binding [template_card_appearance_hint],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="32" Width="140"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Style="{StaticResource HomeSegmentedWrapStyle}">
                                <Grid>
                                    <i:Interaction.Behaviors>
                                        <helpers:HomeSegmentedThumbBehavior Indicator="{Binding ElementName=CardAppearanceThumb}"/>
                                    </i:Interaction.Behaviors>
                                    <Grid x:Name="CardAppearanceThumb" HorizontalAlignment="Left" VerticalAlignment="Top"
                                          IsHitTestVisible="False" Visibility="Collapsed"
                                          SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Border Background="#14000000" CornerRadius="4" Margin="0,1,0,0"/>
                                        <Border Background="White" CornerRadius="4" Margin="0,0,0,1"/>
                                    </Grid>
                                    <ListBox Background="Transparent" BorderThickness="0" Padding="0"
                                             ItemContainerStyle="{StaticResource TemplateCardSizeSegmentedItemStyle}"
                                             SelectedValuePath="Tag" SelectedValue="{Binding TemplateCardAppearance, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBoxItem Tag="{x:Static models:TemplateCardAppearance.Regular}"
                                                     Content="{Binding [template_card_appearance_regular],Source={x:Static lg:LanguageService.Instance}}"/>
                                        <ListBoxItem Tag="{x:Static models:TemplateCardAppearance.Frameless}"
                                                     Content="{Binding [template_card_appearance_frameless],Source={x:Static lg:LanguageService.Instance}}"/>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="#E5E5E5" Margin="16,0,0,0"/>

                        <!-- Template Card Size Preset -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [template_card_size_preset],Source={x:Static lg:LanguageService.Instance}}" FontSize="13"/>
                                <TextBlock Text="{Binding [template_card_size_preset_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=图解模板库中卡片的显示尺寸}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Height="32" Width="140"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Style="{StaticResource HomeSegmentedWrapStyle}">
                                <Grid>
                                    <i:Interaction.Behaviors>
                                        <helpers:HomeSegmentedThumbBehavior Indicator="{Binding ElementName=CardSizeThumb}"/>
                                    </i:Interaction.Behaviors>
                                    <!-- 选中滑块单独成层，阴影不作用在文字上 -->
                                    <Grid x:Name="CardSizeThumb"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          IsHitTestVisible="False"
                                          Visibility="Collapsed"
                                          SnapsToDevicePixels="True"
                                          UseLayoutRounding="True">
                                        <Border Background="#14000000" CornerRadius="4" Margin="0,1,0,0"/>
                                        <Border Background="White" CornerRadius="4" Margin="0,0,0,1"/>
                                    </Grid>
                                    <ListBox Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             ItemContainerStyle="{StaticResource TemplateCardSizeSegmentedItemStyle}"
                                             ItemsSource="{Binding TemplateCardSizePresetOptions}"
                                             SelectedItem="{Binding TemplateCardSizePreset, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource TemplateCardSizePresetToDisplayConverter}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           SnapsToDevicePixels="True"
                                                           UseLayoutRounding="True"
                                                           TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}"
                                                           TextOptions.TextRenderingMode="ClearType"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="#E5E5E5" Margin="16,0,0,0"/>

                        <!-- Current Diagram Version (Read-Only) -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [current_diagram_version],Source={x:Static lg:LanguageService.Instance}}" FontSize="13"/>
                                <TextBlock Text="{Binding [current_diagram_version_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=当前软件支持的图解模板格式版本（只读）}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentDiagramVersion}" VerticalAlignment="Center" 
                                       FontSize="13" Foreground="Gray" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- AUTOMATIC UPDATES -->
                <TextBlock Text="{Binding [automatic_updates],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource ModernSettingsGroupTitle}"/>
                <Border Style="{StaticResource ModernSettingsCard}">
                    <StackPanel>
                        <!-- Template Updates -->
                        <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [auto_check_diagram_template_updates],Source={x:Static lg:LanguageService.Instance}}" FontSize="13"/>
                                <TextBlock Text="{Binding [auto_check_diagram_template_updates_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=启动时自动检查图解模板是否有更新}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleButtonSwitch}" IsChecked="{Binding AutoCheckTemplateUpdate}" 
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DEVELOPER OPTIONS -->
                <StackPanel Visibility="{Binding IsDeveloperMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding [developer_settings],Source={x:Static lg:LanguageService.Instance}, FallbackValue=开发者选项}" Style="{StaticResource ModernSettingsGroupTitle}"/>
                    <Border Style="{StaticResource ModernSettingsCard}">
                        <StackPanel>
                            <!-- Reset Diagram Database -->
                            <Grid MinHeight="56" Background="Transparent" Margin="16,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [reset_diagram_database],Source={x:Static lg:LanguageService.Instance}, FallbackValue=重置图解数据库}" FontSize="13"/>
                                    <TextBlock Text="{Binding [reset_diagram_database_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=清空本地图解模板数据库}" Style="{StaticResource ModernSettingsItemHintStyle}"/>
                                </StackPanel>
                                <Button Content="{Binding [clear],Source={x:Static lg:LanguageService.Instance}, FallbackValue=清空}"
                                        Command="{Binding ResetDiagramDatabaseCommand}"
                                        Grid.Column="1" VerticalAlignment="Center"
                                        Width="Auto" Padding="15,0" Height="30"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
