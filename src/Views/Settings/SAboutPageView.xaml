<Page x:Class="GeoChemistryNexus.Views.SAboutPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
      xmlns:vm="clr-namespace:GeoChemistryNexus.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="600"
      Title="SAboutPageView"
      UseLayoutRounding="True" TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}">
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="75,20,75,40" MaxWidth="800" HorizontalAlignment="Stretch">

                <!-- ===== Hero：元素格 + 软件名称 / 版本 / 简介 ===== -->
                <Border Style="{StaticResource AboutCardStyle}" Background="{StaticResource AboutHeroGridBrush}" CornerRadius="14" Margin="0">
                    <Border CornerRadius="13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0.35"/>
                                <GradientStop Color="#E0FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid Margin="28,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 元素格 -->
                            <Grid Style="{StaticResource AboutElementGroupStyle}">
                                <Border Style="{StaticResource AboutElementShadowStyle}"/>
                                <Border Style="{StaticResource AboutElementRingStyle}">
                                    <Border Background="{DynamicResource ThemeAccentBrush}" CornerRadius="14" Padding="14,12">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding UnlockDeveloperModeCommand}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding Version}" Style="{StaticResource AboutBondTileIndexStyle}" FontSize="11" Opacity="0.85"/>
                                                <TextBlock Text="GPL-3.0" Style="{StaticResource AboutBondTileIndexStyle}" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- 品牌矢量图标（随主题色变色），放在白色圆角底座上保证各主题下都清晰 -->
                                            <Border Grid.Row="1" Width="68" Height="68" Padding="11" CornerRadius="16"
                                                    Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="16" ShadowDepth="6" Direction="270"/>
                                                </Border.Effect>
                                                <ContentControl Template="{StaticResource BrandGlyphTemplate}"/>
                                            </Border>

                                            <TextBlock Grid.Row="2" Text="Gn" FontSize="38" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Grid.Row="3" Text="GeoChemistry Nexus" FontSize="11" Foreground="White" Opacity="0.85" Margin="0,2,0,0"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>

                            <!-- 文字 -->
                            <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GeoChemistry Nexus" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource HomeInkBrush}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                                    <TextBlock FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource HomeSubBrush}" Margin="0,0,18,0">
                                        <Run Text="Version "/><Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource HomeInkBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="GPL-3.0" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource HomeSubBrush}" Margin="0,0,18,0"/>
                                    <TextBlock Text="Windows" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource HomeSubBrush}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding [AboutTagline],Source={x:Static lg:LanguageService.Instance}}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding [AboutInfo1],Source={x:Static lg:LanguageService.Instance}}"
                                           FontSize="13" Foreground="{DynamicResource HomeInkBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- ===== 社区 ===== -->
                <Grid Margin="0,28,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [community],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource HomeSectionTitleTextStyle}"/>
                    <Border Grid.Column="1" Height="1" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource HomeLineBrush}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Email -->
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource AboutBondButtonStyle}"
                            Command="{Binding CopyTextCommand}" CommandParameter="maxwelllei@qq.com">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource AboutBondTileStyle}" Background="{DynamicResource ThemeAccentBrush}">
                                <Grid>
                                    <TextBlock Text="01" Style="{StaticResource AboutBondTileIndexStyle}"/>
                                    <TextBlock Text="Em" Style="{StaticResource AboutBondTileSymbolStyle}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [about_email],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource AboutBondLabelStyle}"/>
                                <TextBlock Text="maxwelllei@qq.com" Style="{StaticResource AboutBondValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- QQ Group：点击复制群号 -->
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource AboutBondButtonStyle}"
                            Command="{Binding CopyTextCommand}" CommandParameter="1076647740">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource AboutBondTileStyle}" Background="{DynamicResource ThemeAccentLightBrush}">
                                <Grid>
                                    <TextBlock Text="02" Style="{StaticResource AboutBondTileIndexStyle}"/>
                                    <TextBlock Text="Qq" Style="{StaticResource AboutBondTileSymbolStyle}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [about_qq_group],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource AboutBondLabelStyle}"/>
                                <TextBlock Text="1076647740" Style="{StaticResource AboutBondValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Discord -->
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource AboutBondButtonStyle}"
                            Command="{Binding OpenUrlCommand}" CommandParameter="https://discord.com/invite/mRm8dbwa4W">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource AboutBondTileStyle}" Background="{DynamicResource ThemeAccentDarkBrush}">
                                <Grid>
                                    <TextBlock Text="03" Style="{StaticResource AboutBondTileIndexStyle}"/>
                                    <TextBlock Text="Dc" Style="{StaticResource AboutBondTileSymbolStyle}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [about_discord],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource AboutBondLabelStyle}"/>
                                <TextBlock Text="discord.com/invite/mRm8dbwa4W" Style="{StaticResource AboutBondValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- GitHub -->
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource AboutBondButtonStyle}"
                            Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/MaxwellLei/GeoChemistry-Nexus">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource AboutBondTileStyle}" Background="{DynamicResource ThemeAccentDeepBrush}">
                                <Grid>
                                    <TextBlock Text="04" Style="{StaticResource AboutBondTileIndexStyle}"/>
                                    <TextBlock Text="Gh" Style="{StaticResource AboutBondTileSymbolStyle}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GitHub" Style="{StaticResource AboutBondLabelStyle}"/>
                                <TextBlock Text="MaxwellLei/GeoChemistry-Nexus" Style="{StaticResource AboutBondValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Star Request：虚线提示框 -->
                <Grid Margin="0,12,0,0">
                    <Border Background="{DynamicResource ThemeAccentSoftBrush}" CornerRadius="12"/>
                    <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="1"
                               StrokeDashArray="4 3" Opacity="0.45" Margin="0.5"/>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{DynamicResource ThemeAccentBrush}"
                              Data="M12,2.5 L14.9,8.6 L21.5,9.4 L16.6,14 L17.9,20.6 L12,17.3 L6.1,20.6 L7.4,14 L2.5,9.4 L9.1,8.6 Z"/>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding [AboutInfo2],Source={x:Static lg:LanguageService.Instance}}"
                                   FontSize="13" Foreground="{DynamicResource ThemeAccentDarkBrush}"/>
                    </Grid>
                </Grid>

                <!-- ===== 感谢支持：技术栈 + 开源组件 ===== -->
                <TextBlock Text="{Binding [ThankSupport],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource ModernSettingsGroupTitle}" Margin="16,26,0,8"/>
                <Border Style="{StaticResource AboutCardStyle}">
                    <StackPanel>
                        <!-- 技术栈 -->
                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [about_tech_stack],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource AboutRowKeyStyle}"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding TechStackTags}"
                                          ItemTemplate="{StaticResource AboutAccentChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource HomeLineBrush}" Margin="16,0,0,0"/>

                        <!-- 开源组件 -->
                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [about_open_source],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource AboutRowKeyStyle}"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding OpenSourceLibraries}"
                                          ItemTemplate="{StaticResource AboutChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 特别感谢 ===== -->
                <TextBlock Text="{Binding [SpecialThanks],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource ModernSettingsGroupTitle}" Margin="16,16,0,8"/>
                <Border Style="{StaticResource AboutCardStyle}">
                    <ItemsControl ItemsSource="{Binding SpecialThanksNames}" Margin="20,18,20,8"
                                  ItemTemplate="{StaticResource AboutThanksItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <!-- Footer -->
                <TextBlock Text="{Binding [AboutInfo3],Source={x:Static lg:LanguageService.Instance}}" 
                           FontSize="12" Foreground="{DynamicResource HomeSubBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           LineHeight="20" Margin="0,26,0,0" HorizontalAlignment="Center"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
