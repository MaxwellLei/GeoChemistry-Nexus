<Window x:Class="GeoChemistryNexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeoChemistryNexus"
        xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
        xmlns:services="clr-namespace:GeoChemistryNexus.Services"
        xmlns:controls="clr-namespace:GeoChemistryNexus.Controls"
        xmlns:converter="clr-namespace:GeoChemistryNexus.Converter"
        xmlns:helpers="clr-namespace:GeoChemistryNexus.Helpers"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="{DynamicResource AppTextFormattingMode}"
        WindowStartupLocation="Manual" Loaded="Window_Loaded" Closing="Window_Closing" SourceInitialized="Window_SourceInitialized"
        Title="{Binding Title}" Height="750" Width="1360" MinHeight="500" MinWidth="800" BorderThickness="0">
    
    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0：页面顶部的工具栏按钮需要可直接点击；拖动由 WindowDragHelper 附加属性提供 -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15" GlassFrameThickness="1"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converter:BorderClipConverter x:Key="BorderClipConverter"/>

        <!-- 现代化风格侧边栏按钮（即时 hover/选中反馈，避免动画拖沓） -->
        <Style x:Key="ModernSideButton" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <!-- 展开态图标中心 = 8 + 10 + 10 = 28，与图标模式（宽 56）居中位置一致，切换时图标不跳动 -->
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="border" Background="Transparent" CornerRadius="9" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D000000"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentGradientBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarSelectedHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧边栏折叠按钮（panel-left 图标） -->
        <Style x:Key="SidebarToggleIconStyle" TargetType="{x:Type Path}">
            <Setter Property="Data" Value="M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M9,3 V21"/>
            <Setter Property="Stroke" Value="#64748B"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <Style x:Key="SidebarToggleButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏上的展开按钮：仅在「完全收起」模式且侧边栏已收起时显示 -->
        <Style x:Key="TitleBarSidebarToggleButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarToggleButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSideBarVisible}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UseIconOnlySidebarCollapse}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 侧边栏头部的折叠按钮：
             图标模式：始终显示在左上角；
             完全收起模式：展开时显示在右侧，收起后隐藏（由标题栏按钮接管） -->
        <Style x:Key="SidebarHeaderToggleButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarToggleButton}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseIconOnlySidebarCollapse}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="Margin" Value="13,0,0,0"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding UseIconOnlySidebarCollapse}" Value="False"/>
                        <Condition Binding="{Binding IsSideBarVisible}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarNavButton" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource ModernSideButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSideBarNavCentered}" Value="True">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarLabelTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSideBarInIconMode}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SidebarLabelFadeOut">
                            <Storyboard>
                                <!-- 先随边栏宽度裁切收缩，末段再淡出文字 -->
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.14"
                                                 BeginTime="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseIn"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SidebarLabelFadeOut"/>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.2"
                                                 BeginTime="0:0:0.1">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <!-- 图标模式：收掉文字宽度以便水平居中，但保留高度，避免 Collapsed 导致行高变矮、图标上跳 -->
                <DataTrigger Binding="{Binding IsSideBarNavCentered}" Value="True">
                    <Setter Property="Width" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarNavItemPanelStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSideBarNavCentered}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Window Control Button Style (Dark Text) -->
        <Style x:Key="ModernWinBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ModernCloseBtn" TargetType="{x:Type Button}">
             <Setter Property="Background" Value="Transparent"/>
             <Setter Property="Foreground" Value="#333"/>
             <Setter Property="FontSize" Value="14"/>
             <Setter Property="FontFamily" Value="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/#iconfont"/>
             <Setter Property="Width" Value="46"/>
             <Setter Property="Height" Value="44"/>
             <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
             <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borderClose" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" CornerRadius="0,10,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- 最大化时去除圆角 -->
                            <DataTrigger Binding="{Binding IsWindowMaximized}" Value="True">
                                <Setter TargetName="borderClose" Property="CornerRadius" Value="0"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
             </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container: shadow on empty sibling Border so content (incl. plot) is not rasterized by Effect -->
    <Grid>
        <!-- Shadow layer only (no children) — DropShadowEffect must not wrap real content -->
        <Border IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F5F5F7"/>
                    <Setter Property="CornerRadius" Value="10"/>
                    <Setter Property="BorderBrush" Value="#D1D1D1"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Margin" Value="15"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWindowMaximized}" Value="True">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="CornerRadius" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Effect" Value="{x:Null}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Content layer — no Effect, so ScottPlot / text stay sharp -->
        <Border x:Name="ShellBorder">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F5F5F7"/>
                    <Setter Property="CornerRadius" Value="10"/>
                    <Setter Property="BorderBrush" Value="#D1D1D1"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Margin" Value="15"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWindowMaximized}" Value="True">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="CornerRadius" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        <Grid>
            <Grid.Clip>
                <MultiBinding Converter="{StaticResource BorderClipConverter}">
                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                    <Binding Path="CornerRadius" ElementName="ShellBorder"/>
                    <Binding Path="BorderThickness" ElementName="ShellBorder"/>
                </MultiBinding>
            </Grid.Clip>
            <!-- Left-right layout: full-height sidebar | (title bar over content) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 无独立标题栏：各页面顶部自带 PageTitleBar（见 Styles.xaml），页面内容铺满整个右列。
                     下面两个控件悬浮在页面顶栏之上，页面顶栏已在右侧/左侧为它们预留空间。 -->

                <!-- 右上角：窗口控制按钮（通知中心 / 最小化 / 最大化 / 关闭） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="100">
                    <!-- 通知中心：点击展开 / 收起历史面板，右上角红点显示未读数 -->
                    <Button Style="{StaticResource NotificationBellButtonStyle}"
                            Command="{Binding ToggleHistoryCommand, Source={x:Static services:NotificationManager.Instance}}"
                            ToolTip="{Binding [notification_center_title],Source={x:Static lg:LanguageService.Instance}}"/>
                    <Border Width="1" Height="16" Background="#D0D0D0" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <Button Content="&#xe67a;" Style="{StaticResource ModernWinBtn}" Command="{Binding MinimizeWindowCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{Binding [minimize],Source={x:Static lg:LanguageService.Instance}}"/>
                    <Button Command="{Binding MaximizeWindowCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{Binding [maximize],Source={x:Static lg:LanguageService.Instance}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernWinBtn}">
                                <Setter Property="Content" Value="&#xf2b2;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Content" Value="&#xf2b4;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#xeaf2;" Style="{StaticResource ModernCloseBtn}" Command="{Binding CloseWindowCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{Binding [close],Source={x:Static lg:LanguageService.Instance}}"/>
                </StackPanel>

                <!-- 左上角：侧边栏完全收起时用于重新展开（侧边栏可见时由侧边栏头部的按钮负责） -->
                <Button Grid.Column="1" Command="{Binding ToggleSideBarCommand}" Style="{StaticResource TitleBarSidebarToggleButton}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,7,0,0" Panel.ZIndex="100">
                    <Path Style="{StaticResource SidebarToggleIconStyle}"/>
                </Button>

                <!-- 现代化可折叠侧边栏 -->
                <Border Grid.Column="0" Background="{DynamicResource ThemeSidebarBrush}" BorderBrush="#140F172A" BorderThickness="0,0,1,0" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="232"/>
                            <Setter Property="Margin" Value="0"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSideBarVisible}" Value="False"/>
                                        <Condition Binding="{Binding UseIconOnlySidebarCollapse}" Value="False"/>
                                        <Condition Binding="{Binding SidebarCollapseModeTransition}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <StopStoryboard BeginStoryboardName="SidebarIconCollapse"/>
                                        <StopStoryboard BeginStoryboardName="SidebarExpand"/>
                                        <BeginStoryboard x:Name="SidebarIconToHiddenCollapse">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 From="56" To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                    From="0" To="0" Duration="0:0:0.3">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSideBarVisible}" Value="False"/>
                                        <Condition Binding="{Binding UseIconOnlySidebarCollapse}" Value="True"/>
                                        <Condition Binding="{Binding SidebarCollapseModeTransition}" Value="2"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <StopStoryboard BeginStoryboardName="SidebarFullCollapse"/>
                                        <StopStoryboard BeginStoryboardName="SidebarExpand"/>
                                        <BeginStoryboard x:Name="SidebarHiddenToIconExpand">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 From="0" To="56" Duration="0:0:0.28">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                    From="0" To="0" Duration="0:0:0.28">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                </MultiDataTrigger>
                                <!-- 全部收起动画 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSideBarVisible}" Value="False"/>
                                        <Condition Binding="{Binding UseIconOnlySidebarCollapse}" Value="False"/>
                                        <Condition Binding="{Binding SidebarCollapseModeTransition}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <StopStoryboard BeginStoryboardName="SidebarHiddenToIconExpand"/>
                                        <StopStoryboard BeginStoryboardName="SidebarIconCollapse"/>
                                        <StopStoryboard BeginStoryboardName="SidebarExpand"/>
                                        <BeginStoryboard x:Name="SidebarFullCollapse">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                    To="0" Duration="0:0:0.3">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSideBarVisible}" Value="False"/>
                                        <Condition Binding="{Binding UseIconOnlySidebarCollapse}" Value="True"/>
                                        <Condition Binding="{Binding SidebarCollapseModeTransition}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <StopStoryboard BeginStoryboardName="SidebarIconToHiddenCollapse"/>
                                        <StopStoryboard BeginStoryboardName="SidebarFullCollapse"/>
                                        <StopStoryboard BeginStoryboardName="SidebarExpand"/>
                                        <BeginStoryboard x:Name="SidebarIconCollapse">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="56" Duration="0:0:0.28">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                    To="0" Duration="0:0:0.28">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsSideBarVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <StopStoryboard BeginStoryboardName="SidebarIconToHiddenCollapse"/>
                                        <StopStoryboard BeginStoryboardName="SidebarHiddenToIconExpand"/>
                                        <StopStoryboard BeginStoryboardName="SidebarFullCollapse"/>
                                        <StopStoryboard BeginStoryboardName="SidebarIconCollapse"/>
                                        <BeginStoryboard x:Name="SidebarExpand">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="232" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                    To="0" Duration="0:0:0.32">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- 侧边栏内容（带淡入淡出动画） -->
                    <!-- Margin 右侧 -1：抵消边框 1px 占位，使图标模式下导航按钮左右留白对称 -->
                    <Grid Margin="0,0,-1,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSideBarVisible}" Value="False"/>
                                            <Condition Binding="{Binding UseIconOnlySidebarCollapse}" Value="False"/>
                                            <Condition Binding="{Binding SidebarCollapseModeTransition}" Value="1"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <StopStoryboard BeginStoryboardName="ContentIconModeFadeIn"/>
                                            <BeginStoryboard x:Name="ContentIconToHiddenFadeOut">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseIn"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSideBarVisible}" Value="False"/>
                                            <Condition Binding="{Binding UseIconOnlySidebarCollapse}" Value="True"/>
                                            <Condition Binding="{Binding SidebarCollapseModeTransition}" Value="2"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <StopStoryboard BeginStoryboardName="ContentFadeOut"/>
                                            <BeginStoryboard x:Name="ContentHiddenToIconFadeIn">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.12">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSideBarVisible}" Value="False"/>
                                            <Condition Binding="{Binding UseIconOnlySidebarCollapse}" Value="False"/>
                                            <Condition Binding="{Binding SidebarCollapseModeTransition}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <StopStoryboard BeginStoryboardName="ContentHiddenToIconFadeIn"/>
                                            <BeginStoryboard x:Name="ContentFadeOut">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseIn"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSideBarVisible}" Value="False"/>
                                            <Condition Binding="{Binding UseIconOnlySidebarCollapse}" Value="True"/>
                                            <Condition Binding="{Binding SidebarCollapseModeTransition}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <StopStoryboard BeginStoryboardName="ContentIconToHiddenFadeOut"/>
                                            <StopStoryboard BeginStoryboardName="ContentFadeOut"/>
                                            <BeginStoryboard x:Name="ContentIconModeFadeIn">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.12">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsSideBarVisible}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <StopStoryboard BeginStoryboardName="ContentIconToHiddenFadeOut"/>
                                            <StopStoryboard BeginStoryboardName="ContentHiddenToIconFadeIn"/>
                                            <StopStoryboard BeginStoryboardName="ContentFadeOut"/>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.2"
                                                                     BeginTime="0:0:0.08">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- 侧边栏顶部：标题 + 折叠按钮（图标模式下标题淡出） -->
                        <Grid Height="44" VerticalAlignment="Top">
                            <Border Background="Transparent" BorderBrush="#8CE2E8F0" BorderThickness="0,0,0,1"
                                    helpers:WindowDragHelper.IsDragHandle="True"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="GeoChemistry Nexus" VerticalAlignment="Center"
                                           Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="18,0,0,0"/>
                                            <Style.Triggers>
                                                <!-- 图标模式：折叠按钮在左上角，标题让到按钮右侧 -->
                                                <DataTrigger Binding="{Binding UseIconOnlySidebarCollapse}" Value="True">
                                                    <Setter Property="Margin" Value="52,0,0,0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSideBarInIconMode}" Value="True">
                                                    <Setter Property="Opacity" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button Command="{Binding ToggleSideBarCommand}" Style="{StaticResource SidebarHeaderToggleButton}">
                                <Path Style="{StaticResource SidebarToggleIconStyle}"/>
                            </Button>
                        </Grid>

                        <StackPanel Margin="0,56,0,0" VerticalAlignment="Top">
                            <!-- Home -->
                            <RadioButton Name="RadioButton1" Style="{StaticResource SidebarNavButton}" GroupName="SideBar" 
                                         Command="{Binding HomePageCommand}" CommandParameter="{Binding ElementName=MyNav}" IsChecked="True"
                                         ToolTip="{Binding [home],Source={x:Static lg:LanguageService.Instance}}">
                                <StackPanel Style="{StaticResource SidebarNavItemPanelStyle}">
                                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Home}"/>
                                    <TextBlock Text="{Binding [home],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource SidebarLabelTextStyle}"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Plot -->
                            <RadioButton Name="RadioButton2" Style="{StaticResource SidebarNavButton}" GroupName="SideBar" 
                                         Command="{Binding PlotPageCommand}" CommandParameter="{Binding ElementName=MyNav}"
                                         IsChecked="{Binding IsPlotPageSelected, Mode=TwoWay}"
                                         ToolTip="{Binding [Plot],Source={x:Static lg:LanguageService.Instance}}">
                                <StackPanel Style="{StaticResource SidebarNavItemPanelStyle}">
                                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Plot}"/>
                                    <TextBlock Text="{Binding [Plot],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource SidebarLabelTextStyle}"/>
                                </StackPanel>
                            </RadioButton>
                            
                            <!-- Geothermometer -->
                            <RadioButton Name="RadioButton3" Style="{StaticResource SidebarNavButton}" GroupName="SideBar" 
                                         Command="{Binding GTMNewPageCommand}" CommandParameter="{Binding ElementName=MyNav}"
                                         ToolTip="{Binding [Geothermometer],Source={x:Static lg:LanguageService.Instance}}">
                                <StackPanel Style="{StaticResource SidebarNavItemPanelStyle}">
                                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Thermo}"/>
                                    <TextBlock Text="{Binding [Geothermometer],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource SidebarLabelTextStyle}"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- EPMA -->
                            <RadioButton Name="RadioButtonEpma" Style="{StaticResource SidebarNavButton}" GroupName="SideBar"
                                         Command="{Binding EpmaPageCommand}" CommandParameter="{Binding ElementName=MyNav}"
                                         AutomationProperties.Name="{Binding [epma_title],Source={x:Static lg:LanguageService.Instance}}"
                                         ToolTip="{Binding [epma_title],Source={x:Static lg:LanguageService.Instance}}">
                                <StackPanel Style="{StaticResource SidebarNavItemPanelStyle}">
                                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Epma}"/>
                                    <TextBlock Text="{Binding [epma_title],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource SidebarLabelTextStyle}"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- CIPW -->
                            <RadioButton Name="RadioButton5" Style="{StaticResource SidebarNavButton}" GroupName="SideBar" 
                                         Command="{Binding CipwPageCommand}" CommandParameter="{Binding ElementName=MyNav}"
                                         ToolTip="{Binding [cipw_norm],Source={x:Static lg:LanguageService.Instance}, FallbackValue='CIPW 标准'}">
                                <StackPanel Style="{StaticResource SidebarNavItemPanelStyle}">
                                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Cipw}"/>
                                    <TextBlock Text="{Binding [cipw_norm],Source={x:Static lg:LanguageService.Instance}, FallbackValue='CIPW 标准'}" Style="{StaticResource SidebarLabelTextStyle}"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Niggli -->
                            <RadioButton Name="RadioButtonNiggli" Style="{StaticResource SidebarNavButton}" GroupName="SideBar" 
                                         Command="{Binding NiggliPageCommand}" CommandParameter="{Binding ElementName=MyNav}"
                                         ToolTip="{Binding [niggli_norm],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Niggli 标准'}">
                                <StackPanel Style="{StaticResource SidebarNavItemPanelStyle}">
                                    <ContentControl Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Niggli}" Content="{StaticResource GeoIcon.Niggli.Dash}"/>
                                    <TextBlock Text="{Binding [niggli_norm],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Niggli 标准'}" Style="{StaticResource SidebarLabelTextStyle}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Settings at the bottom -->
                        <StackPanel VerticalAlignment="Bottom" Margin="0">
                            <Border Height="1" Background="#B3E2E8F0" Margin="0,0,0,9"/>
                            <RadioButton Name="RadioButton4" Style="{StaticResource SidebarNavButton}" GroupName="SideBar"
                                         IsChecked="{Binding IsSettingsPageSelected, Mode=TwoWay}"
                                         Command="{Binding SettingPageCommand}" CommandParameter="{Binding ElementName=MyNav}"
                                         ToolTip="{Binding [Setting],Source={x:Static lg:LanguageService.Instance}}">
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSideBarNavCentered}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Grid.Column="0" Style="{StaticResource LineIconStyle}" Tag="{StaticResource GeoIcon.Settings}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [Setting],Source={x:Static lg:LanguageService.Instance}}" Style="{StaticResource SidebarLabelTextStyle}"/>
                                    <!-- 快捷键提示 -->
                                    <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="6,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0D000000"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Background" Value="#26FFFFFF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSideBarInIconMode}" Value="True">
                                                        <Setter Property="Opacity" Value="0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSideBarNavCentered}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Ctrl+," FontFamily="Consolas" FontSize="10" FontWeight="Normal">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                            <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <Border Height="9"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Content -->
                <Border x:Name="NavContentBorder" Grid.Column="1" Background="#F5F5F7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleSideBarSurface}" Value="True">
                                    <Setter Property="CornerRadius" Value="0,10,10,0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWindowMaximized}" Value="True">
                                    <Setter Property="CornerRadius" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Clip>
                        <MultiBinding Converter="{StaticResource BorderClipConverter}">
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </Border.Clip>
                    <Grid>
                        <!-- 页面顶栏静态底衬：模块切换渐显期间保持 44px 顶栏底色与分割线稳定不断裂 -->
                        <Border Height="44" VerticalAlignment="Top" Background="#F2F2F7"
                                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
                        <Frame Name="MyNav" NavigationUIVisibility="Hidden" BorderThickness="0" Background="Transparent">
                            <i:Interaction.Behaviors>
                                <helpers:FrameNavigationTransitionBehavior SplitPageHeader="True"/>
                            </i:Interaction.Behaviors>
                        </Frame>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Modal Mask -->
            <Border Background="#40000000" Panel.ZIndex="950"
                    Visibility="{Binding IsModal, Source={x:Static services:NotificationManager.Instance}, Converter={StaticResource BooleanToVisibilityConverter}}"
                    IsHitTestVisible="True"/>

            <!-- 点击面板之外的区域自动收起历史面板（透明点击层；留出顶部 44px，铃铛按钮仍可正常切换） -->
            <Border Panel.ZIndex="890" Margin="0,44,0,0" Background="Transparent"
                    Visibility="{Binding IsHistoryOpen, Source={x:Static services:NotificationManager.Instance}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseHistoryCommand, Source={x:Static services:NotificationManager.Instance}}"/>
                    <MouseBinding MouseAction="RightClick" Command="{Binding CloseHistoryCommand, Source={x:Static services:NotificationManager.Instance}}"/>
                </Border.InputBindings>
            </Border>

            <!-- 通知中心历史面板：从右侧滑出，位于标题栏按钮下方 -->
            <controls:NotificationHistoryPanel Panel.ZIndex="900"
                                               HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                               Margin="0,44,0,0"
                                               DataContext="{x:Static services:NotificationManager.Instance}"/>

            <!-- 居中 Sheet 对话框（确认 / 三按钮 / 单选），盖在模态遮罩之上 -->
            <ItemsControl Panel.ZIndex="1001" Focusable="False"
                          Width="412" HorizontalAlignment="Center" VerticalAlignment="Center"
                          ItemsSource="{Binding Dialogs, Source={x:Static services:NotificationManager.Instance}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:NotificationSheet/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 右下角 Toast 区：历史面板展开时整体左移让位 -->
            <controls:NotificationHost Panel.ZIndex="1000"
                                       VerticalAlignment="Stretch" HorizontalAlignment="Right"
                                       VerticalContentAlignment="Bottom"
                                       ShowDialogs="False"
                                       Center="{x:Static services:NotificationManager.Instance}">
                <controls:NotificationHost.Style>
                    <Style TargetType="controls:NotificationHost">
                        <Setter Property="Margin" Value="0,52,0,6"/>
                        <Style.Triggers>
                            <!-- 本样式会覆盖控件内置的空闲折叠样式，必须在此重复，否则空的整列叠加层会拦截右侧区域的鼠标 -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Center.Notifications.Count, RelativeSource={RelativeSource Self}}" Value="0"/>
                                    <Condition Binding="{Binding Center.Dialogs.Count, RelativeSource={RelativeSource Self}}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsHistoryOpen, Source={x:Static services:NotificationManager.Instance}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,52,340,6" Duration="0:0:0.38">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,52,0,6" Duration="0:0:0.3">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:NotificationHost.Style>
            </controls:NotificationHost>

            <!-- Notify Icon (Tray) -->
            <controls:TrayIcon x:Name="notifyIcon" Text="GeoChemistry Nexus" Icon="pack://application:,,,/GeoChemistryNexus;component/Data/Icon/GeoChemistryNexus_Icon.ico">
                <controls:TrayIcon.ContextMenu>
                    <ContextMenu MinWidth="136">
                        <MenuItem Header="{Binding [Show],Source={x:Static lg:LanguageService.Instance}}" Click="ShowWindow"/>
                        <Separator/>
                        <MenuItem Header="{Binding [Exit],Source={x:Static lg:LanguageService.Instance}}" Click="ShutDownWindow"/>
                    </ContextMenu>
                </controls:TrayIcon.ContextMenu>
            </controls:TrayIcon>

        </Grid>
        </Border>
    </Grid>
</Window>

