<Page x:Class="GeoChemistryNexus.Views.NiggliPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:rg="clr-namespace:unvell.ReoGrid;assembly=unvell.ReoGrid"
      xmlns:cvs="clr-namespace:GeoChemistryNexus.Converter"
      xmlns:hp="clr-namespace:GeoChemistryNexus.Helpers"
      xmlns:lg="clr-namespace:GeoChemistryNexus.Services"
      xmlns:ctrl="clr-namespace:GeoChemistryNexus.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1100"
      Title="NiggliPageView">

    <Page.Resources>
        <cvs:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <hp:BindingProxy x:Key="GridProxy" Data="{Binding ElementName=NiggliReoGrid}" />
        <hp:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

        <!-- 工具栏按钮样式 -->
        <Style x:Key="NiggliToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B8BDC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontFamily" Value="{x:Static SystemFonts.MessageFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="#000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D1D1D1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#BBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 计算按钮样式（主操作） -->
        <Style x:Key="NiggliCalculateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8BDC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="{x:Static SystemFonts.MessageFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#004578"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶部：工具栏 ==================== -->
        <!-- 页面顶栏：模块名称 + 工具栏（融入主窗口顶部） -->
        <ContentControl Grid.Row="0" Style="{StaticResource PageTitleBarStyle}"
                        Tag="{Binding [niggli_norm],Source={x:Static lg:LanguageService.Instance}, FallbackValue='Niggli 标准'}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：标题已由顶栏模块名称取代 -->

                <!-- Fe³⁺/ΣFe：未实测 FeO / Fe₂O₃ 时，按此比例把全铁拆成二价铁和三价铁。单行芯片，避免撑高顶栏。 -->
                <Border Grid.Column="0" Style="{StaticResource TitleBarParamChipStyle}">
                    <Border.ToolTip>
                        <TextBlock>
                            <Run Text="Fe&#x00B3;&#x207A;/ΣFe  ·  "/>
                            <Run Text="{Binding [niggli_default_value_text],Source={x:Static lg:LanguageService.Instance}, Mode=OneWay, FallbackValue=默认 0.15}"/>
                            <Run Text="  ·  Le Maitre, 2002"/>
                        </TextBlock>
                    </Border.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TitleBarParamChipLabelStyle}">
                            <TextBlock Text="Fe&#x00B3;&#x207A;/ΣFe" Style="{StaticResource TitleBarParamChipLabelTextStyle}"/>
                        </Border>
                        <TextBox x:Name="Fe3FractionTextBox" Style="{StaticResource TitleBarParamChipTextBoxStyle}"
                                 Text="{Binding Fe3Fraction, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                 LostFocus="OnFe3FractionLostFocus"/>
                    </StackPanel>
                </Border>

                <!-- 右侧：操作按钮组 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 算法说明 -->
                    <Button Style="{StaticResource NiggliToolbarButtonStyle}"
                            ToolTip="{Binding [niggli_tooltip_help],Source={x:Static lg:LanguageService.Instance}, FallbackValue='查看 Barth-Niggli Catanorm 与尼格里参数算法说明'}"
                            Click="OnHelpClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [niggli_btn_help],Source={x:Static lg:LanguageService.Instance}, FallbackValue=说明}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 填充示例 -->
                    <Button Style="{StaticResource NiggliToolbarButtonStyle}"
                            ToolTip="{Binding [niggli_tooltip_example],Source={x:Static lg:LanguageService.Instance}, FallbackValue='填充示例数据（花岗岩、玄武岩、响岩）'}"
                            Command="{Binding FillExampleCommand}"
                            CommandParameter="{Binding Data, Source={StaticResource GridProxy}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [niggli_btn_example],Source={x:Static lg:LanguageService.Instance}, FallbackValue=示例}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 导出结果 -->
                    <Button Style="{StaticResource NiggliToolbarButtonStyle}"
                            ToolTip="{Binding [niggli_tooltip_export],Source={x:Static lg:LanguageService.Instance}, FallbackValue='导出计算结果到 CSV 文件'}"
                            Command="{Binding ExportCsvCommand}"
                            CommandParameter="{Binding Data, Source={StaticResource GridProxy}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [niggli_btn_export],Source={x:Static lg:LanguageService.Instance}, FallbackValue=导出}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 清除数据 -->
                    <Button Style="{StaticResource NiggliToolbarButtonStyle}"
                            ToolTip="{Binding [niggli_tooltip_clear],Source={x:Static lg:LanguageService.Instance}, FallbackValue='清除所有输入和计算结果'}"
                            Command="{Binding ClearDataCommand}"
                            CommandParameter="{Binding Data, Source={StaticResource GridProxy}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding [niggli_btn_clear],Source={x:Static lg:LanguageService.Instance}, FallbackValue=清除}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 分隔符 -->
                    <Rectangle Width="1" Height="18" Fill="#E0E0E0" Margin="8,0" VerticalAlignment="Center"/>

                    <!-- 执行计算（主操作） -->
                    <Button Style="{StaticResource NiggliCalculateButtonStyle}"
                            Command="{Binding CalculateCommand}"
                            CommandParameter="{Binding Data, Source={StaticResource GridProxy}}"
                            ToolTip="{Binding [niggli_tooltip_calculate],Source={x:Static lg:LanguageService.Instance}, FallbackValue='执行 Niggli 标准分子矿物计算'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" 
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding [niggli_btn_calculate],Source={x:Static lg:LanguageService.Instance}, FallbackValue=执行计算}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- ==================== 中间：全宽数据表格 ==================== -->
        <!-- 完整的数据工作表由公共控件统一提供：顶栏、列头分组行 / 单位、行头状态点、右侧检查器与底部状态栏。 -->
        <ctrl:ReoGridTableHost x:Name="WorksheetTable" Grid.Row="1" Style="{StaticResource ReoGridTableHostStyle}"
                               IsInspectorOpen="{Binding IsInspectorOpen, Mode=TwoWay}"
                               InspectorTitle="{Binding [niggli_diagnostic_details],Source={x:Static lg:LanguageService.Instance}, FallbackValue=计算详情}">
            <!-- 右侧检查器：当前选中样品的计算详情（内容由本模块自己决定） -->
            <ctrl:ReoGridTableHost.Inspector>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 摘要：选中样品 + 硅 / 铝饱和度徽章 -->
                    <Border Grid.Row="0" Padding="14,10" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasDiagnosticData, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRowInfo}" FontSize="13" FontWeight="SemiBold" Foreground="#333" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSilicaUndersaturated}" Value="True">
                                                    <Setter Property="Background" Value="#FFF3E0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource ThemeAccentDarkBrush}">
                                        <Run Text="Si: "/>
                                        <Run Text="{Binding SelectedSilicaState, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="4" Background="#F3E5F5" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" Foreground="#6A1B9A">
                                        <Run Text="Al: "/>
                                        <Run Text="{Binding SelectedAluminaState, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                        <Grid>
                            <!-- 未选中已计算的样品时的提示 -->
                            <TextBlock Text="{Binding [niggli_select_row_hint],Source={x:Static lg:LanguageService.Instance}, FallbackValue=选择数据行查看计算详情}"
                                       FontSize="12" Foreground="#999" Margin="14,12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDiagnosticData}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding DiagnosticItems}" Margin="8,6,8,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,1" Padding="10,4" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                                            <Setter Property="Background" Value="#FFFDE7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter Property="Background" Value="#FAFAFA"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F5F5F7"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 项目名称 -->
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="12"/>
                                                            <Setter Property="Foreground" Value="#555"/>
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="FontSize" Value="11"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                </TextBlock>

                                                <!-- 项目值 -->
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           FontFamily="Consolas" FontSize="12" Foreground="#333"
                                                           Text="{Binding Value}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </ctrl:ReoGridTableHost.Inspector>
            <rg:ReoGridControl x:Name="NiggliReoGrid"/>
        </ctrl:ReoGridTableHost>
    </Grid>
</Page>